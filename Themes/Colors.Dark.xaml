<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Full-black palette (Cursor / PhpStorm style) — same keys as Colors.xaml -->
    <Color x:Key="Color.Surface.Base">#000000</Color>
    <Color x:Key="Color.Surface.Shell">#0A0A0A</Color>
    <Color x:Key="Color.Surface.Raised">#111111</Color>
    <Color x:Key="Color.Surface.Card">#141414</Color>
    <Color x:Key="Color.Surface.Input">#0D0D0D</Color>
    <Color x:Key="Color.Surface.Overlay">#CC000000</Color>

    <Color x:Key="Color.Border.Subtle">#222222</Color>
    <Color x:Key="Color.Border.Strong">#333333</Color>

    <Color x:Key="Color.Text.Primary">#E8E8E8</Color>
    <Color x:Key="Color.Text.Secondary">#C8C8C8</Color>
    <Color x:Key="Color.Text.Muted">#8A8A8A</Color>
    <Color x:Key="Color.Text.Inverse">#000000</Color>

    <Color x:Key="Color.Accent.Primary">#4C8DFF</Color>
    <Color x:Key="Color.Accent.PrimaryHover">#6AA0FF</Color>
    <Color x:Key="Color.Accent.Secondary">#7B61FF</Color>
    <Color x:Key="Color.Accent.SecondaryHover">#9683FF</Color>

    <Color x:Key="Color.Status.Success">#3DDC84</Color>
    <Color x:Key="Color.Status.Warning">#E6B84D</Color>
    <Color x:Key="Color.Status.Error">#FF5C6A</Color>
    <Color x:Key="Color.Status.Info">#5BB8FF</Color>

    <Color x:Key="Color.Status.SuccessSurface">#0A1A12</Color>
    <Color x:Key="Color.Status.WarningSurface">#1A1408</Color>
    <Color x:Key="Color.Status.ErrorSurface">#1A0A0C</Color>
    <Color x:Key="Color.Status.InfoSurface">#0A121A</Color>

    <SolidColorBrush x:Key="Surface.Base" Color="{StaticResource Color.Surface.Base}" />
    <SolidColorBrush x:Key="Surface.Shell" Color="{StaticResource Color.Surface.Shell}" />
    <SolidColorBrush x:Key="Surface.Raised" Color="{StaticResource Color.Surface.Raised}" />
    <SolidColorBrush x:Key="Surface.Card" Color="{StaticResource Color.Surface.Card}" />
    <SolidColorBrush x:Key="Surface.Input" Color="{StaticResource Color.Surface.Input}" />
    <SolidColorBrush x:Key="Surface.Overlay" Color="{StaticResource Color.Surface.Overlay}" />

    <SolidColorBrush x:Key="Border.Subtle" Color="{StaticResource Color.Border.Subtle}" />
    <SolidColorBrush x:Key="Border.Strong" Color="{StaticResource Color.Border.Strong}" />

    <SolidColorBrush x:Key="Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Text.Muted" Color="{StaticResource Color.Text.Muted}" />
    <SolidColorBrush x:Key="Text.Inverse" Color="{StaticResource Color.Text.Inverse}" />

    <SolidColorBrush x:Key="Accent.Primary" Color="{StaticResource Color.Accent.Primary}" />
    <SolidColorBrush x:Key="Accent.PrimaryHover" Color="{StaticResource Color.Accent.PrimaryHover}" />
    <SolidColorBrush x:Key="Accent.Secondary" Color="{StaticResource Color.Accent.Secondary}" />
    <SolidColorBrush x:Key="Accent.SecondaryHover" Color="{StaticResource Color.Accent.SecondaryHover}" />

    <SolidColorBrush x:Key="Status.Success" Color="{StaticResource Color.Status.Success}" />
    <SolidColorBrush x:Key="Status.Warning" Color="{StaticResource Color.Status.Warning}" />
    <SolidColorBrush x:Key="Status.Error" Color="{StaticResource Color.Status.Error}" />
    <SolidColorBrush x:Key="Status.Info" Color="{StaticResource Color.Status.Info}" />

    <SolidColorBrush x:Key="Status.SuccessSurface" Color="{StaticResource Color.Status.SuccessSurface}" />
    <SolidColorBrush x:Key="Status.WarningSurface" Color="{StaticResource Color.Status.WarningSurface}" />
    <SolidColorBrush x:Key="Status.ErrorSurface" Color="{StaticResource Color.Status.ErrorSurface}" />
    <SolidColorBrush x:Key="Status.InfoSurface" Color="{StaticResource Color.Status.InfoSurface}" />

    <SolidColorBrush x:Key="State.Hover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="State.Pressed" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="State.DisabledOverlay" Color="#AA0A0A0A" />
    <SolidColorBrush x:Key="Shadow.Color" Color="#99000000" />

    <SolidColorBrush x:Key="Log.Success" Color="#5CFFB0" />
</ResourceDictionary>
