{
  "schema": "gitdeploypro-theme/v1",
  "id": "midnight-blue",
  "displayName": "Midnight Blue",
  "basedOn": "dark",
  "version": "3",
  "skin": "midnight-blue",
  "author": "GitDeployPro",
  "palette": {
    "Surface.Base": "#03060C",
    "Surface.Shell": "#070B13",
    "Surface.Raised": "#0B111C",
    "Surface.Card": "#0E1523",
    "Surface.Input": "#080D17",
    "Surface.Overlay": "#CC01040A",
    "Border.Subtle": "#1A2538",
    "Border.Strong": "#2A3A55",
    "Text.Primary": "#E8EEFB",
    "Text.Secondary": "#C3CEE3",
    "Text.Muted": "#7F8FA9",
    "Text.Inverse": "#03060C",
    "Accent.Primary": "#4C8DFF",
    "Accent.PrimaryHover": "#6AA0FF",
    "Accent.Secondary": "#7B61FF",
    "Accent.SecondaryHover": "#9683FF",
    "Status.Success": "#3DDC84",
    "Status.Warning": "#E6B84D",
    "Status.Error": "#FF5C6A",
    "Status.Info": "#5BB8FF",
    "Status.SuccessSurface": "#07170F",
    "Status.WarningSurface": "#1A1507",
    "Status.ErrorSurface": "#1A090C",
    "Status.InfoSurface": "#071524",
    "State.Hover": "#1478AAFF",
    "State.Pressed": "#2278AAFF",
    "State.DisabledOverlay": "#AA070B13",
    "Shadow.Color": "#99000000",
    "Log.Success": "#5CFFB0",
    "Tree.SearchMatchBackground": "#E6B84D",
    "Tree.SearchMatchForeground": "#03060C",
    "Chat.BubbleIn": "#131C2C",
    "Chat.BubbleOut": "#4C8DFF",
    "Chat.BubbleInText": "#E8EEFB",
    "Chat.BubbleOutText": "#FFFFFF",
    "Chat.Composer": "#080D17",
    "Chat.Unread": "#4C8DFF",
    "Chat.ThreadHover": "#1478AAFF",
    "Accent.Soft": "#244C8DFF",
    "Accent.Glow": "#664C8DFF",
    "Shell.Glow": "#334C8DFF",
    "Shell.AmbientA": "#1A4C8DFF",
    "Shell.AmbientB": "#127B61FF"
  },
  "deploy": {
    "shell": {
      "pageBackground": "@Surface.Base",
      "railBackground": "@Surface.Shell",
      "dockBackground": "@Surface.Card",
      "splitter": "@Border.Strong",
      "bottomResizeGrip": "@Border.Strong",
      "bottomResizeBorder": "@Border.Subtle"
    },
    "header": {
      "title": "@Text.Primary",
      "subtitle": "@Text.Muted"
    },
    "branches": {
      "summaryBackground": "@Surface.Input",
      "summaryForeground": "@Text.Secondary",
      "actionBackground": "@Accent.Secondary",
      "actionForeground": "@Text.Primary",
      "rollbackBackground": "@Surface.Raised",
      "pushBadgeBackground": "@Status.WarningSurface",
      "pushBadgeForeground": "@Status.Warning"
    },
    "changedFiles": {
      "rowBackground": "@Surface.Card",
      "statusAdded": "#2E7D32",
      "statusModified": "#FF8F00",
      "statusDeleted": "#C62828",
      "statusDefault": "#808080"
    },
    "directUpload": {
      "statusCardBackground": "@Surface.Input",
      "treeSelection": "#1A2538",
      "treeHover": "#131C2C",
      "folderIcon": "@Status.Warning",
      "fileIcon": "@Text.Secondary",
      "mappedRowBackground": "@Status.SuccessSurface",
      "gitClean": "@Status.Success",
      "gitModified": "@Status.Error",
      "gitUntracked": "@Status.Info",
      "gitIgnored": "@Text.Muted",
      "gitConflicted": "@Status.Warning"
    },
    "tree": {
      "searchMatchBackground": "@Tree.SearchMatchBackground",
      "searchMatchForeground": "@Tree.SearchMatchForeground"
    },
    "ftp": {
      "chrome": {
        "treeSelection": "#1A3A6E",
        "treeSelectionText": "#FFFFFF",
        "checkboxModeActive": "#2A4A7AAA",
        "overlay": "#CC01040A",
        "skeleton1": "#1A2538",
        "skeleton2": "#131C2C",
        "skeleton3": "#0E1523"
      },
      "fileTypes": {
        "directory": {
          "icon": "#FFE7B95B",
          "badgeBg": "#1F4A391A",
          "badgeBorder": "#3A7C5E2A",
          "badgeFg": "#FFE7B95B"
        },
        "placeholder": {
          "icon": "#FF8B96A6",
          "badgeBg": "#1F2C3440",
          "badgeBorder": "#3A3D4C5F",
          "badgeFg": "#FF8B96A6"
        },
        "defaultFile": {
          "icon": "#FFAAB5C4",
          "badgeBg": "#1F2E3948",
          "badgeBorder": "#3A3D5268",
          "badgeFg": "#FFAAB5C4"
        },
        "config": {
          "icon": "#FF74B6F5",
          "badgeBg": "#1F1E3752",
          "badgeBorder": "#3A2A4D73",
          "badgeFg": "#FF74B6F5"
        },
        "php": {
          "icon": "#FFB0A3FF",
          "badgeBg": "#1F3E3658",
          "badgeBorder": "#3A5A4B87",
          "badgeFg": "#FFB0A3FF"
        },
        "js": {
          "icon": "#FFF7DF5E",
          "badgeBg": "#1F4A4212",
          "badgeBorder": "#3A7B6A1D",
          "badgeFg": "#FFF7DF5E"
        },
        "ts": {
          "icon": "#FF74A9FF",
          "badgeBg": "#1F1A3252",
          "badgeBorder": "#3A264A75",
          "badgeFg": "#FF74A9FF"
        },
        "css": {
          "icon": "#FF64D2FF",
          "badgeBg": "#1F193C50",
          "badgeBorder": "#3A2A5C75",
          "badgeFg": "#FF64D2FF"
        },
        "html": {
          "icon": "#FFFFAE72",
          "badgeBg": "#1F4A2E18",
          "badgeBorder": "#3A6F4528",
          "badgeFg": "#FFFFAE72"
        },
        "json": {
          "icon": "#FF7EE2A8",
          "badgeBg": "#1F1E4030",
          "badgeBorder": "#3A2D654A",
          "badgeFg": "#FF7EE2A8"
        },
        "sql": {
          "icon": "#FFFF9A86",
          "badgeBg": "#1F4C2822",
          "badgeBorder": "#3A7B3D35",
          "badgeFg": "#FFFF9A86"
        },
        "img": {
          "icon": "#FFFFA5D6",
          "badgeBg": "#1F4A203A",
          "badgeBorder": "#3A75305C",
          "badgeFg": "#FFFFA5D6"
        },
        "zip": {
          "icon": "#FFC8A879",
          "badgeBg": "#1F3D2B1F",
          "badgeBorder": "#3A5D4330",
          "badgeFg": "#FFC8A879"
        },
        "md": {
          "icon": "#FF8FC4FF",
          "badgeBg": "#1F1F3755",
          "badgeBorder": "#3A305079",
          "badgeFg": "#FF8FC4FF"
        },
        "txt": {
          "icon": "#FFB7C0CD",
          "badgeBg": "#1F2A3342",
          "badgeBorder": "#3A3E4D62",
          "badgeFg": "#FFB7C0CD"
        },
        "sh": {
          "icon": "#FF8EE39A",
          "badgeBg": "#1F1A3D29",
          "badgeBorder": "#3A28613F",
          "badgeFg": "#FF8EE39A"
        }
      }
    },
    "logs": {
      "background": "@Surface.Input",
      "foreground": "@Text.Secondary",
      "success": "@Log.Success",
      "warning": "@Status.Warning",
      "error": "@Status.Error"
    },
    "terminal": {
      "hostBackground": "#03060C",
      "statusConnected": "#32CD32",
      "statusDisconnected": "#808080",
      "statusConnecting": "#FF4500",
      "statusError": "#FF0000",
      "presetsDrawerBackground": "#070B13",
      "presetsDrawerBorder": "@Border.Subtle",
      "presetsHeaderForeground": "@Text.Primary",
      "presetsChipBackground": "#0E1523",
      "suggestionGhost": "#E6D07A",
      "suggestionListBackground": "#0E1523",
      "suggestionListActive": "#2A2618",
      "suggestionListBorder": "@Border.Subtle",
      "xterm": {
        "background": "#03060C",
        "foreground": "#E8EEFB",
        "cursor": "#00ff00",
        "selectionBackground": "rgba(128,128,128,0.35)"
      },
      "textPresets": [
        "#D4D4D4",
        "#FFFFFF",
        "#00FF00",
        "#00FFFF",
        "#FFFF00"
      ]
    },
    "editor": {
      "webviewBackground": "#03060C",
      "monacoTheme": "vs-dark",
      "fallbackBackground": "#03060C",
      "fallbackForeground": "@Text.Primary",
      "completionBackground": "#070B13",
      "completionListBackground": "#11161E",
      "completionBorder": "@Border.Strong",
      "syntaxComment": "#6A9955",
      "syntaxString": "#CE9178",
      "syntaxKeyword": "#569CD6",
      "syntaxFunction": "#DCDCAA",
      "syntaxNumber": "#B5CEA8",
      "syntaxDataType": "#4EC9B0",
      "tabClose": "@Text.Muted",
      "tabCloseOnAccent": "#FFFFFFFF",
      "actionActiveForeground": "@Status.Warning",
      "actionActiveBackground": "@Status.WarningSurface",
      "actionActiveBorder": "@Status.Warning"
    },
    "diff": {
      "contextBg": "#070B13",
      "hunkBg": "#0E1523",
      "metaBg": "#101820",
      "addedBg": "#07170F",
      "removedBg": "#1A090C",
      "headerBg": "#03060C"
    }
  }
}
