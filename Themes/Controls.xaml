<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:GitDeployPro.Behaviors"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">
    <DropShadowEffect x:Key="App.CardShadow"
                      BlurRadius="24"
                      ShadowDepth="6"
                      Opacity="0.28"
                      Color="{Binding Color, Source={StaticResource Shadow.Color}}" />

    <Style x:Key="App.CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="{StaticResource Spacing.CardPadding}" />
    </Style>

    <Style x:Key="App.PanelStyle" TargetType="Border" BasedOn="{StaticResource App.CardStyle}">
        <Setter Property="Background" Value="{StaticResource Surface.Raised}" />
    </Style>

    <Style x:Key="App.Button.Base" TargetType="Button">
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Padding" Value="{StaticResource Spacing.ButtonPadding}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.App}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Surface.Input}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="buttonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Button}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="buttonBorder" Property="Background" Value="{StaticResource State.Hover}" />
                            <Setter TargetName="buttonBorder" Property="BorderBrush" Value="{StaticResource Border.Strong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="buttonBorder" Property="Background" Value="{StaticResource State.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="buttonBorder" Property="Background" Value="{StaticResource State.DisabledOverlay}" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
                            <Setter TargetName="buttonBorder" Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="App.Button.Primary" TargetType="Button" BasedOn="{StaticResource App.Button.Base}">
        <Setter Property="Background" Value="{StaticResource Accent.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent.Primary}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
    </Style>

    <Style x:Key="App.Button.Secondary" TargetType="Button" BasedOn="{StaticResource App.Button.Base}">
        <Setter Property="Background" Value="{StaticResource Accent.Secondary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent.Secondary}" />
    </Style>

    <Style x:Key="App.Button.Ghost" TargetType="Button" BasedOn="{StaticResource App.Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
    </Style>

    <Style x:Key="App.Button.Success" TargetType="Button" BasedOn="{StaticResource App.Button.Base}">
        <Setter Property="Background" Value="{StaticResource Status.Success}" />
        <Setter Property="BorderBrush" Value="{StaticResource Status.Success}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Inverse}" />
    </Style>

    <Style x:Key="App.Button.Danger" TargetType="Button" BasedOn="{StaticResource App.Button.Base}">
        <Setter Property="Background" Value="{StaticResource Status.Error}" />
        <Setter Property="BorderBrush" Value="{StaticResource Status.Error}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
    </Style>

    <Style x:Key="App.Button.Compact" TargetType="Button" BasedOn="{StaticResource App.Button.Base}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="{StaticResource Spacing.ButtonPaddingDense}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    </Style>

    <Style x:Key="App.Button.Toolbar" TargetType="Button" BasedOn="{StaticResource App.Button.Compact}">
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="Background" Value="{StaticResource Surface.Input}" />
    </Style>

    <Style x:Key="App.Button.Pill" TargetType="Button" BasedOn="{StaticResource App.Button.Compact}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="buttonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Chip}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="buttonBorder" Property="Background" Value="{StaticResource State.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="buttonBorder" Property="Background" Value="{StaticResource State.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="buttonBorder" Property="Background" Value="{StaticResource State.DisabledOverlay}" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="App.IconButton" TargetType="Button" BasedOn="{StaticResource App.Button.Ghost}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="App.IconButton.Close" TargetType="Button" BasedOn="{StaticResource App.IconButton}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="Editor.ToolbarIconButton" TargetType="Button" BasedOn="{StaticResource App.IconButton}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource State.Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="active">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Status.WarningSurface}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Status.Warning}" />
                            <Setter Property="Foreground" Value="{StaticResource Status.Warning}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="App.SidebarNavButton" TargetType="Button" BasedOn="{StaticResource App.Button.Ghost}">
        <Setter Property="Height" Value="42" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="NavBorder"
                            CornerRadius="10"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavBorder" Property="Background" Value="{StaticResource State.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="NavBorder" Property="Background" Value="{StaticResource State.Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="App.InputTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.App}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Surface.Input}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{StaticResource Text.Primary}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent.Primary}" />
    </Style>

    <Style x:Key="App.InputTextBox.Multiline" TargetType="TextBox" BasedOn="{StaticResource App.InputTextBox}">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="96" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="10,10" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AcceptsReturn" Value="True" />
    </Style>

    <!-- Full-panel log viewer: must override implicit App.InputTextBox (fixed Height=38, VCenter). -->
    <Style x:Key="App.LogTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsReadOnlyCaretVisible" Value="False" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <!-- Neutral like IDE consoles; keep Log.Success for status chips elsewhere. -->
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="CaretBrush" Value="{StaticResource Text.Primary}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent.Primary}" />
    </Style>

    <Style x:Key="App.InputPasswordBox" TargetType="PasswordBox">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.App}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Surface.Input}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{StaticResource Text.Primary}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent.Primary}" />
    </Style>

    <Style x:Key="App.ComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource State.Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Accent.Primary}" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="App.InputComboBox" TargetType="ComboBox">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.App}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Surface.Input}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource App.ComboBoxItemStyle}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="behaviors:ComboBoxSearchBehavior.EnableAutoSearch" Value="True" />
        <Setter Property="behaviors:ComboBoxSearchBehavior.SearchThreshold" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="ComboBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Input}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>

                                <!-- Make whole body clickable, not only the arrow -->
                                <ToggleButton x:Name="BodyToggle"
                                              Grid.Column="0"
                                              Focusable="False"
                                              IsTabStop="False"
                                              ClickMode="Press"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

                                <ContentPresenter x:Name="ContentSite"
                                                  Grid.Column="0"
                                                  Margin="10,0,8,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />

                                <TextBox x:Name="PART_EditableTextBox"
                                         Grid.Column="0"
                                         Margin="10,0,8,0"
                                         VerticalAlignment="Center"
                                         HorizontalContentAlignment="Left"
                                         VerticalContentAlignment="Center"
                                         Foreground="{TemplateBinding Foreground}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Visibility="Hidden" />

                                <ToggleButton x:Name="DropDownToggle"
                                              Grid.Column="1"
                                              Focusable="False"
                                              IsTabStop="False"
                                              ClickMode="Press"
                                              Background="Transparent"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="1,0,0,0"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Path Width="10"
                                          Height="6"
                                          Stretch="Fill"
                                          Fill="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 0 0 L 10 0 L 5 6 Z" />
                                </ToggleButton>
                            </Grid>
                        </Border>

                        <!-- PART_Popup is required for ComboBox behavior -->
                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               PlacementTarget="{Binding ElementName=ComboBorder}"
                               Placement="Bottom"
                               Focusable="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border x:Name="PopupBorder"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{StaticResource Surface.Shell}"
                                    BorderBrush="{StaticResource Border.Strong}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border x:Name="PART_SearchHost"
                                            Grid.Row="0"
                                            Visibility="Collapsed"
                                            Margin="2,2,2,6"
                                            Background="{StaticResource Surface.Base}"
                                            BorderBrush="{StaticResource Border.Subtle}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Input}"
                                            Padding="6">
                                        <TextBox x:Name="PART_SearchBox"
                                                 Style="{StaticResource App.InputTextBox}"
                                                 Height="34"
                                                 mah:TextBoxHelper.Watermark="Search..." />
                                    </Border>
                                    <ScrollViewer Grid.Row="1" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource Border.Strong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource Accent.Primary}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource Accent.Primary}" />
                            <Setter TargetName="ComboBorder" Property="Background" Value="{StaticResource Surface.Raised}" />
                            <Setter TargetName="DropDownToggle" Property="Background" Value="{StaticResource State.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
                            <Setter TargetName="ComboBorder" Property="Background" Value="{StaticResource State.DisabledOverlay}" />
                            <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="PopupBorder" Property="MinHeight" Value="40" />
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BodyToggle" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource App.InputComboBox}" />
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource App.ComboBoxItemStyle}" />

    <Style x:Key="App.TabItemStyle" TargetType="TabItem">
        <Setter Property="FontSize" Value="{StaticResource FontSize.BodyLarge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,2"
                            CornerRadius="8,8,0,0">
                        <ContentPresenter HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource Accent.Primary}" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource State.Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="App.StatusBadge.Warning" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Status.WarningSurface}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style x:Key="App.StatusBadge.Success" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Status.SuccessSurface}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style x:Key="App.StatusBadge.Error" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Status.ErrorSurface}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style x:Key="App.StatusBadge.Info" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Status.InfoSurface}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style x:Key="App.LogContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface.Input}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="App.ModalShell" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface.Raised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="22" />
    </Style>

    <Style x:Key="App.ModalOverlay" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface.Overlay}" />
    </Style>

    <Style x:Key="App.ModalHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource App.SectionTitleTextStyle}">
        <Setter Property="FontSize" Value="24" />
    </Style>

    <Style x:Key="App.ListBox.Host" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="App.ListView.Host" TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="App.ListBoxItem.Transparent" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="App.ListBoxItem.Card" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{StaticResource Surface.Input}"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Input}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Surface.Raised}" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Border.Strong}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Surface.Raised}" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Accent.Primary}" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="App.ListViewItem.Row" TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="RowBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <GridViewRowPresenter Margin="4,0"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource State.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource Surface.Raised}" />
                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource Accent.Primary}" />
                            <Setter TargetName="RowBorder" Property="BorderThickness" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="App.ContextMenu" TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource Surface.Shell}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.App}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18"
                                              ShadowDepth="4"
                                              Opacity="0.35"
                                              Color="#AA000000" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True"
                                    Grid.IsSharedSizeScope="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="App.ContextMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" SharedSizeGroup="MenuIconColumn" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                                <ColumnDefinition Width="14" SharedSizeGroup="MenuArrowColumn" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter x:Name="IconPresenter"
                                              Grid.Column="0"
                                              ContentSource="Icon"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0" />
                            <ContentPresenter x:Name="HeaderPresenter"
                                              Grid.Column="1"
                                              ContentSource="Header"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                            <TextBlock x:Name="GestureText"
                                       Grid.Column="2"
                                       Margin="12,0,4,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Text.Muted}"
                                       FontSize="{StaticResource FontSize.Caption}"
                                       Text="{TemplateBinding InputGestureText}" />
                            <Path x:Name="SubmenuArrow"
                                  Grid.Column="3"
                                  Width="5"
                                  Height="8"
                                  Margin="2,0,0,0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"
                                  Data="M0,0 L5,4 L0,8 Z"
                                  Fill="{StaticResource Text.Muted}"
                                  Visibility="Collapsed"
                                  SnapsToDevicePixels="True" />

                            <!-- Required for Windows-style hover submenu -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   HorizontalOffset="2"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right"
                                   PlacementTarget="{Binding ElementName=ItemBorder}"
                                   PopupAnimation="Fade"
                                   VerticalOffset="-4">
                                <Border Background="{StaticResource Surface.Shell}"
                                        BorderBrush="{StaticResource Border.Strong}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="6"
                                        MinWidth="180">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18"
                                                          ShadowDepth="4"
                                                          Opacity="0.35"
                                                          Color="#AA000000" />
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True"
                                                Grid.IsSharedSizeScope="True"
                                                KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource State.Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                            <Setter TargetName="SubmenuArrow" Property="Fill" Value="{StaticResource Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource State.Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                            <Setter TargetName="SubmenuArrow" Property="Fill" Value="{StaticResource Text.Primary}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="danger">
                            <Setter Property="Foreground" Value="{StaticResource Status.Error}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="danger" />
                                <Condition Property="IsHighlighted" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Status.ErrorSurface}" />
                            <Setter Property="Foreground" Value="{StaticResource Status.Error}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="App.ContextMenuSeparator" TargetType="Separator">
        <Setter Property="Margin" Value="4,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1"
                            Background="{StaticResource Border.Subtle}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="App.DataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Border.Subtle}" />
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource Border.Subtle}" />
        <Setter Property="RowBackground" Value="{StaticResource Surface.Shell}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource Surface.Input}" />
    </Style>

    <Style x:Key="App.DataGridColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Surface.Card}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style x:Key="App.CheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.App}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Box"
                                Grid.Column="0"
                                Width="18"
                                Height="18"
                                CornerRadius="4"
                                BorderThickness="1"
                                BorderBrush="{StaticResource Border.Subtle}"
                                Background="{StaticResource Surface.Input}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                            <Grid>
                                <Path x:Name="CheckGlyph"
                                      Data="M 3 9 L 7 13 L 15 5"
                                      Stroke="{StaticResource Text.Inverse}"
                                      StrokeThickness="2.1"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                                <Path x:Name="IndeterminateGlyph"
                                      Data="M 4 9 L 14 9"
                                      Stroke="{StaticResource Text.Inverse}"
                                      StrokeThickness="2.1"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <ContentPresenter Grid.Column="1"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Border.Strong}" />
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Surface.Raised}" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource State.Pressed}" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent.Primary}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent.Primary}" />
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent.Secondary}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent.Secondary}" />
                            <Setter TargetName="IndeterminateGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent.Primary}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.58" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource State.DisabledOverlay}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource App.CheckBox}" />

    <Style TargetType="Button" BasedOn="{StaticResource App.Button.Ghost}" />
    <Style TargetType="ContextMenu" BasedOn="{StaticResource App.ContextMenu}" />
    <Style TargetType="MenuItem" BasedOn="{StaticResource App.ContextMenuItem}" />
    <Style TargetType="TextBox" BasedOn="{StaticResource App.InputTextBox}" />
    <Style TargetType="PasswordBox" BasedOn="{StaticResource App.InputPasswordBox}" />
    <Style TargetType="ListBox" BasedOn="{StaticResource App.ListBox.Host}" />
    <Style TargetType="ListView" BasedOn="{StaticResource App.ListView.Host}" />

    <Style TargetType="DataGrid" BasedOn="{StaticResource App.DataGrid}" />
    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource App.DataGridColumnHeader}" />

    <Style x:Key="App.TreeViewItem.Expander" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Width="16" Height="16">
                        <Path x:Name="Arrow"
                              Data="M 1,1 L 1,9 L 7,5 Z"
                              Fill="{StaticResource Text.Muted}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Path.RenderTransform>
                        </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Arrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Header background stretches the full row (PHPStorm-style), not just the text width. -->
    <Style x:Key="App.TreeViewItem.FullRow" TargetType="TreeViewItem">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2,2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="19" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="Expander"
                                          Style="{StaticResource App.TreeViewItem.Expander}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            <Border x:Name="Bd"
                                    Grid.Column="1"
                                    MinHeight="22"
                                    HorizontalAlignment="Stretch"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="PART_Header"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="19" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ItemsPresenter x:Name="ItemsHost"
                                            Grid.Column="1" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Backward compatibility keys -->
    <Style x:Key="ModernButtonStyle" TargetType="Button" BasedOn="{StaticResource App.Button.Primary}" />
    <Style x:Key="DetachPageButtonStyle" TargetType="Button" BasedOn="{StaticResource App.Button.Ghost}">
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="13" />
    </Style>
</ResourceDictionary>
