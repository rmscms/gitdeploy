<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>1.4.20</Version>
    <AssemblyVersion>1.4.20.0</AssemblyVersion>
    <FileVersion>1.4.20.0</FileVersion>
    <!-- Required so release EXE alone starts on clean PCs (WPF/WebView2 natives inside the bundle). -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="MySqlConnector" Version="2.5.0" />
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <Resource Include="icon.ico" />
    <PackageReference Include="FluentFTP" Version="53.0.2" />
    <PackageReference Include="HandyControls" Version="3.5.0" />
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SharpCompress" Version="0.36.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\SqlSyntax.xshd" />
    <EmbeddedResource Include="Resources\CodeViewer.html" />
    <EmbeddedResource Include="Resources\TerminalHost.html" />
    <EmbeddedResource Include="Resources\Localization\en.json" />
    <EmbeddedResource Include="Resources\Localization\fa.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Themes\Packs\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Themes\Packs\*.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\TerminalSuggestionsImport.sample.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
