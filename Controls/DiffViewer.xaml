<UserControl x:Class="GitDeployPro.Controls.DiffViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             x:Name="Root">
    <Border Background="{StaticResource Surface.Shell}" CornerRadius="8" Padding="15" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,5">
                <TextBlock Text="{Binding Title, ElementName=Root}" 
                           FontSize="16" 
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Text.Primary}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Status, ElementName=Root}"
                           FontSize="12"
                           Foreground="{StaticResource Text.Muted}"/>
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource Border.Subtle}" Height="1" Margin="0,5"/>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <avalon:TextEditor x:Name="DiffEditor"
                                   FontFamily="{StaticResource FontFamily.Mono}"
                                   FontSize="12"
                                   Background="{StaticResource Surface.Input}"
                                   Foreground="{StaticResource Text.Secondary}"
                                   ShowLineNumbers="True"
                                   IsReadOnly="True"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"
                                   Padding="4"
                                   BorderThickness="0"/>

                <StackPanel x:Name="EmptyState"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="{Binding EmptyMessage, ElementName=Root}"
                               FontSize="13"
                               Foreground="{StaticResource Text.Muted}"
                               TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>

