<UserControl x:Class="GitDeployPro.Controls.SavedCommandsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="72"
             d:DesignWidth="640">
    <UserControl.Resources>
        <Style x:Key="SavedCmd.SlimCombo" TargetType="ComboBox" BasedOn="{StaticResource App.InputComboBox}">
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style x:Key="SavedCmd.SlimTextBox" TargetType="TextBox" BasedOn="{StaticResource App.InputTextBox}">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SavedCmd.ModeToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource State.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Surface.Raised}" />
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Border.Strong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SavedCmd.Button" TargetType="Button" BasedOn="{StaticResource App.Button.Ghost}">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="{StaticResource State.Hover}" />
                                <Setter TargetName="buttonBorder" Property="BorderBrush" Value="{StaticResource Border.Strong}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="{StaticResource State.Pressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="buttonBorder" Property="Background" Value="{StaticResource State.DisabledOverlay}" />
                                <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SavedCmd.Button.Primary" TargetType="Button" BasedOn="{StaticResource SavedCmd.Button}">
            <Setter Property="Background" Value="{StaticResource Accent.Primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent.Primary}" />
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        </Style>
        <Style x:Key="SavedCmd.Button.Secondary" TargetType="Button" BasedOn="{StaticResource SavedCmd.Button}">
            <Setter Property="Background" Value="{StaticResource Accent.Secondary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent.Secondary}" />
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        </Style>
        <Style x:Key="SavedCmd.IconButton" TargetType="Button" BasedOn="{StaticResource SavedCmd.Button}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <Border x:Name="RootBorder"
            Background="{StaticResource Surface.Card}"
            BorderBrush="{StaticResource Border.Subtle}"
            BorderThickness="0"
            Padding="8,4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,4">
                <TextBlock x:Name="TitleText"
                           DockPanel.Dock="Left"
                           Text="Saved commands"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Text.Primary}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />

                <Button DockPanel.Dock="Right"
                        Content="✕"
                        Style="{StaticResource SavedCmd.IconButton}"
                        Margin="4,0,0,0"
                        ToolTip="Close"
                        Click="Close_Click" />

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="6,0,0,0">
                    <ToggleButton x:Name="DockModeToggle"
                                  Content="Dock"
                                  Style="{StaticResource SavedCmd.ModeToggle}"
                                  ToolTip="Open as a strip above the terminal"
                                  Checked="DockModeToggle_Checked"
                                  Unchecked="DockModeToggle_Unchecked" />
                    <ToggleButton x:Name="FloatModeToggle"
                                  Content="Float"
                                  Style="{StaticResource SavedCmd.ModeToggle}"
                                  Margin="0"
                                  ToolTip="Open as a helper window (terminal stays usable)"
                                  Checked="FloatModeToggle_Checked"
                                  Unchecked="FloatModeToggle_Unchecked" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="6,0,0,0">
                    <Button Content="Run"
                            Style="{StaticResource SavedCmd.Button.Primary}"
                            Margin="0,0,4,0"
                            Click="Run_Click"
                            ToolTip="Send selected command" />
                    <Button Content="Del"
                            Style="{StaticResource SavedCmd.Button}"
                            Click="Delete_Click"
                            ToolTip="Delete selected preset" />
                </StackPanel>

                <Border x:Name="ChipHost"
                        Background="{StaticResource Surface.Raised}"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="2"
                        VerticalAlignment="Center">
                    <ComboBox x:Name="PresetComboBox"
                              Height="24"
                              Style="{StaticResource SavedCmd.SlimCombo}"
                              DisplayMemberPath="Title"
                              SelectedValuePath="Id"
                              ToolTip="Command presets" />
                </Border>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PresetTitleBox"
                         Grid.Column="0"
                         Margin="0,0,4,0"
                         Style="{StaticResource SavedCmd.SlimTextBox}"
                         ToolTip="Preset title" />
                <TextBox x:Name="PresetCommandBox"
                         Grid.Column="1"
                         Margin="0,0,4,0"
                         Style="{StaticResource SavedCmd.SlimTextBox}"
                         ToolTip="Command to save / send" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Save"
                            Margin="0,0,4,0"
                            Style="{StaticResource SavedCmd.Button.Secondary}"
                            Click="Save_Click"
                            ToolTip="Save command preset" />
                    <Button Content="Send"
                            Style="{StaticResource SavedCmd.Button}"
                            Click="Send_Click"
                            ToolTip="Send command box text" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
