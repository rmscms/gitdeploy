<UserControl x:Class="GitDeployPro.Controls.TerminalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GitDeployPro.Controls"
             xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:GitDeployPro.Services.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="Terminal.ToolButton" TargetType="Button" BasedOn="{StaticResource App.Button.Ghost}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="Terminal.ToolToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource State.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Surface.Raised}" />
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Terminal.SlimCombo" TargetType="ComboBox" BasedOn="{StaticResource App.InputComboBox}">
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style x:Key="Terminal.SlimTextBox" TargetType="TextBox" BasedOn="{StaticResource App.InputTextBox}">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Terminal.DrawerButton" TargetType="Button" BasedOn="{StaticResource App.Button.Ghost}">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="{StaticResource State.Hover}" />
                                <Setter TargetName="buttonBorder" Property="BorderBrush" Value="{StaticResource Border.Strong}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="{StaticResource State.Pressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="buttonBorder" Property="Background" Value="{StaticResource State.DisabledOverlay}" />
                                <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Terminal.DrawerButton.Primary" TargetType="Button" BasedOn="{StaticResource Terminal.DrawerButton}">
            <Setter Property="Background" Value="{StaticResource Accent.Primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent.Primary}" />
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        </Style>
        <Style x:Key="Terminal.DrawerButton.Secondary" TargetType="Button" BasedOn="{StaticResource Terminal.DrawerButton}">
            <Setter Property="Background" Value="{StaticResource Accent.Secondary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent.Secondary}" />
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Surface.Base}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition x:Name="CommandBarRow" Height="0" />
            <RowDefinition x:Name="PresetsDrawerRowDef" Height="0" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Slim status / actions bar -->
        <Border Grid.Row="0"
                Background="{StaticResource Surface.Shell}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="0,0,0,1"
                Padding="10,0,8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusIndicator"
                            Width="8"
                            Height="8"
                            CornerRadius="4"
                            Background="{StaticResource Text.Muted}"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0" />
                    <TextBlock x:Name="StatusText"
                               Text="Disconnected"
                               Foreground="{StaticResource Text.Muted}"
                               VerticalAlignment="Center"
                               FontSize="11" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="PresetsDrawerToggle"
                                  Content="⌘"
                                  Style="{StaticResource Terminal.ToolToggle}"
                                  Width="28"
                                  Height="26"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  ToolTip="{loc:T deploy.tip.presetsDetail}"
                                  Checked="PresetsDrawerToggle_Checked"
                                  Unchecked="PresetsDrawerToggle_Unchecked" />
                    <Button x:Name="DetachButton"
                            Content="⧉"
                            Style="{StaticResource Terminal.ToolButton}"
                            Width="28"
                            Height="26"
                            FontSize="13"
                            Click="DetachButton_Click"
                            ToolTip="{loc:T deploy.tip.floatTerminal}" />
                    <Button x:Name="ClearButton"
                            Content="🧹"
                            Style="{StaticResource Terminal.ToolButton}"
                            Click="ClearButton_Click"
                            ToolTip="{loc:T deploy.tip.clearTerminal}" />
                    <ToggleButton x:Name="TypeToggleButton"
                                  Content="⌶"
                                  Style="{StaticResource Terminal.ToolToggle}"
                                  ToolTip="{loc:T deploy.tip.focusInput}"
                                  Checked="TypeToggleButton_Checked"
                                  Unchecked="TypeToggleButton_Unchecked"
                                  IsChecked="True" />
                    <ComboBox x:Name="FontSizeCombo"
                              Width="44"
                              Style="{StaticResource Terminal.SlimCombo}"
                              SelectedIndex="2"
                              Margin="0,0,2,0"
                              SelectionChanged="FontSizeCombo_SelectionChanged"
                              ToolTip="{loc:T deploy.tip.terminalFont}">
                        <ComboBoxItem Content="10" />
                        <ComboBoxItem Content="12" />
                        <ComboBoxItem Content="14" />
                        <ComboBoxItem Content="16" />
                        <ComboBoxItem Content="18" />
                        <ComboBoxItem Content="20" />
                    </ComboBox>
                    <ComboBox x:Name="TextColorCombo"
                              Width="64"
                              Style="{StaticResource Terminal.SlimCombo}"
                              SelectedIndex="0"
                              Margin="0,0,2,0"
                              SelectionChanged="TextColorCombo_SelectionChanged"
                              ToolTip="{loc:T deploy.tip.terminalColor}">
                        <ComboBoxItem Content="Gray" Tag="#D4D4D4" />
                        <ComboBoxItem Content="White" Tag="#FFFFFF" />
                        <ComboBoxItem Content="Green" Tag="#00FF00" />
                        <ComboBoxItem Content="Cyan" Tag="#00FFFF" />
                        <ComboBoxItem Content="Yellow" Tag="#FFFF00" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Optional target strip (Terminal page multi-target) -->
        <Border x:Name="CommandBarPanel"
                Grid.Row="1"
                Background="{StaticResource Surface.Shell}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="0,0,0,1"
                Padding="10,0,8,0"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="TerminalTargetCombo"
                          Width="180"
                          Style="{StaticResource Terminal.SlimCombo}"
                          Margin="0,0,8,0"
                          ToolTip="{loc:T deploy.tip.terminalTarget}"
                          SelectionChanged="TerminalTargetCombo_SelectionChanged" />
            </StackPanel>
        </Border>

        <!-- Compact presets strip ABOVE the terminal (Dock mode). Float mode uses a helper window. -->
        <Border x:Name="PresetsDrawerPanel"
                Grid.Row="2"
                BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource Border.Subtle}"
                Visibility="Collapsed">
            <local:SavedCommandsPanel x:Name="DockedSavedCommandsPanel" />
        </Border>

        <!-- Terminal screen -->
        <Grid x:Name="TerminalHostGrid" Grid.Row="3" Background="#0C0C0C">
            <wv:WebView2 x:Name="TerminalWebView"
                         DefaultBackgroundColor="#FF0C0C0C" />

            <Border x:Name="TypingOverlay"
                    Background="#66000000"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <TextBlock Text="Typing disabled"
                           Foreground="#E0E0E0"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
