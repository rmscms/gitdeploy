<UserControl x:Class="GitDeployPro.Controls.ModemUsageCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:GitDeployPro.Behaviors"
             xmlns:loc="clr-namespace:GitDeployPro.Services.Localization">
    <Border Style="{StaticResource App.CardStyle}" Margin="{StaticResource Spacing.CardMargin}" Padding="14">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Accent.Soft}" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Path behaviors:AppIcon.Kind="wifi" behaviors:AppIcon.Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Accent.Primary}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T modem.card.title}" Style="{StaticResource App.SectionTitleTextStyle}" FontSize="14" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource App.CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border x:Name="StatusBadge" Grid.Column="2" Style="{StaticResource App.StatusBadge.Success}" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed">
                    <TextBlock x:Name="StatusBadgeText" FontWeight="Bold" FontSize="12" />
                </Border>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MessagesButton" Style="{StaticResource App.Button.Ghost}" Height="30" Padding="10,0" Margin="0,0,6,0" FontSize="11"
                            ToolTip="{loc:T sms.title}" Click="MessagesButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path behaviors:AppIcon.Kind="chat" behaviors:AppIcon.Size="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:T sms.title}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ResetButton" Style="{StaticResource App.IconButton}" Width="30" Height="30" Margin="0,0,6,0"
                            ToolTip="{loc:T modem.card.reset}" Click="ResetButton_Click">
                        <Path behaviors:AppIcon.Kind="undo" behaviors:AppIcon.Size="15" />
                    </Button>
                    <Button x:Name="RefreshButton" Style="{StaticResource App.IconButton}" Width="30" Height="30"
                            ToolTip="{loc:T modem.card.refresh}" Click="RefreshButton_Click">
                        <Path behaviors:AppIcon.Kind="refresh" behaviors:AppIcon.Size="16" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Not configured -->
            <Border x:Name="EmptyPanel" Style="{StaticResource App.PanelStyle}" Padding="14" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{loc:T modem.card.notConfigured}" Style="{StaticResource App.MutedTextStyle}" TextWrapping="Wrap" />
                    <Button Content="{loc:T modem.card.setup}" Style="{StaticResource App.Button.Primary}" Height="32" MinWidth="110"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Click="SetupButton_Click" />
                </StackPanel>
            </Border>

            <!-- Data -->
            <StackPanel x:Name="DataPanel" Visibility="Collapsed">
                <Border x:Name="OfflineBanner" Style="{StaticResource App.StatusBadge.Warning}" HorizontalAlignment="Stretch" Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock x:Name="OfflineText" Foreground="{StaticResource Status.Warning}" FontSize="12" TextWrapping="Wrap" />
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Gauge -->
                    <Grid Width="170" Height="150" VerticalAlignment="Center">
                        <Canvas x:Name="GaugeCanvas" Width="170" Height="150" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock x:Name="GaugePercentText" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource Text.Primary}" />
                            <TextBlock x:Name="GaugeCaptionText" Style="{StaticResource App.CaptionTextStyle}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Stats -->
                    <Grid Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource App.PanelStyle}" Padding="10,8" Margin="0,0,6,6">
                            <StackPanel>
                                <TextBlock Text="{loc:T modem.card.used}" Style="{StaticResource App.CaptionTextStyle}" />
                                <TextBlock x:Name="UsedText" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Text.Primary}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource App.PanelStyle}" Padding="10,8" Margin="6,0,0,6">
                            <StackPanel>
                                <TextBlock Text="{loc:T modem.card.remaining}" Style="{StaticResource App.CaptionTextStyle}" />
                                <TextBlock x:Name="RemainingText" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Status.Success}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource App.PanelStyle}" Padding="10,8" Margin="0,0,6,6">
                            <StackPanel>
                                <TextBlock Text="{loc:T modem.card.download}" Style="{StaticResource App.CaptionTextStyle}" />
                                <StackPanel Orientation="Horizontal">
                                    <Path behaviors:AppIcon.Kind="arrow-down" behaviors:AppIcon.Size="13" Margin="0,0,5,0" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Status.Info}" />
                                    <TextBlock x:Name="DownText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource App.PanelStyle}" Padding="10,8" Margin="6,0,0,6">
                            <StackPanel>
                                <TextBlock Text="{loc:T modem.card.upload}" Style="{StaticResource App.CaptionTextStyle}" />
                                <StackPanel Orientation="Horizontal">
                                    <Path behaviors:AppIcon.Kind="arrow-up" behaviors:AppIcon.Size="13" Margin="0,0,5,0" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Accent.Primary}" />
                                    <TextBlock x:Name="UpText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="ForecastText" Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource App.MutedTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </Grid>
                </Grid>

                <!-- Charts -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:T modem.card.daily}" Style="{StaticResource App.CaptionTextStyle}" Margin="0,0,0,4" />
                        <Canvas x:Name="BarsCanvas" Height="64" SizeChanged="Canvas_SizeChanged" ClipToBounds="True" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock x:Name="RateText" DockPanel.Dock="Right" Style="{StaticResource App.CaptionTextStyle}" />
                            <TextBlock Text="{loc:T modem.card.speed}" Style="{StaticResource App.CaptionTextStyle}" />
                        </DockPanel>
                        <Canvas x:Name="SparkCanvas" Height="64" SizeChanged="Canvas_SizeChanged" ClipToBounds="True" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="SmsText" Style="{StaticResource App.MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock x:Name="UpdatedText" Style="{StaticResource App.CaptionTextStyle}" Opacity="0.7" Margin="0,8,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
