<UserControl x:Class="GitDeployPro.Controls.DirectUploadWorkspaceControl"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:behaviors="clr-namespace:GitDeployPro.Behaviors"
      mc:Ignorable="d"
      Background="{StaticResource Surface.Base}"
      d:DesignHeight="600"
      d:DesignWidth="800">

    <ScrollViewer x:Name="RootScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
        <Grid x:Name="ContentRootGrid" Margin="{StaticResource Spacing.PageMargin}">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="PageHeaderRowDefinition" Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="PageHeaderRow" Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="📤" FontSize="34" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Direct Upload" Style="{StaticResource App.PageTitleTextStyle}" />
                        <TextBlock Text="Select files and folders to upload directly via FTP"
                                   Style="{StaticResource App.PageSubtitleTextStyle}"
                                   Margin="2,4,0,0" />
                        <TextBlock x:Name="ConnectionInfoText"
                                   Text="Detecting connection..."
                                   FontSize="13"
                                   Foreground="{StaticResource Status.Info}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Upload actions stay above the file tree so the bottom Terminal dock cannot cover them -->
            <Border x:Name="UploadProcessSection"
                    Grid.Row="1"
                    Background="{StaticResource Surface.Card}"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" ItemHeight="28">
                        <CheckBox x:Name="UseSessionCheck"
                                  Content="Crash Recovery"
                                  IsChecked="True"
                                  Foreground="{StaticResource Text.Primary}"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,4"
                                  ToolTip="Keeps a log of uploaded files to resume if connection fails." />
                        <CheckBox x:Name="OverwriteCheck"
                                  Content="Overwrite"
                                  IsChecked="True"
                                  Foreground="{StaticResource Text.Muted}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,4" />
                        <TextBlock x:Name="SessionStatusText"
                                   Text=""
                                   Foreground="{StaticResource Status.Warning}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,4" />
                        <Button x:Name="DeleteSessionButton"
                                Content="🗑️ Clear"
                                Visibility="Collapsed"
                                Style="{StaticResource App.Button.Ghost}"
                                Foreground="{StaticResource Status.Error}"
                                FontSize="11"
                                Height="26"
                                Padding="8,0"
                                VerticalAlignment="Center"
                                Margin="0,0,0,4"
                                Click="DeleteSessionButton_Click"
                                ToolTip="Delete the saved session file manually" />
                    </WrapPanel>

                    <Border Grid.Row="1"
                            Background="#141A24"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,6,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" LastChildFill="True">
                                <Border Width="8"
                                        Height="8"
                                        CornerRadius="4"
                                        Background="{StaticResource Accent.Primary}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0" />
                                <TextBlock x:Name="StatusText"
                                           Text="Ready."
                                           Foreground="{StaticResource Text.Primary}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock x:Name="UploadDetailText"
                                       Grid.Row="1"
                                       Text=""
                                       Foreground="{StaticResource Text.Secondary}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="16,4,0,0" />
                            <ProgressBar x:Name="UploadProgressBar"
                                         Grid.Row="2"
                                         Height="8"
                                         Margin="0,8,0,0"
                                         Background="{StaticResource Surface.Input}"
                                         Foreground="{StaticResource Accent.Primary}"
                                         Value="0" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="1.6*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StopButton"
                                Grid.Column="0"
                                Content="⛔ STOP"
                                Height="38"
                                FontSize="12"
                                FontWeight="Bold"
                                Style="{StaticResource App.Button.Danger}"
                                IsEnabled="False"
                                Click="StopButton_Click" />
                        <Button x:Name="StartUploadButton"
                                Grid.Column="2"
                                Content="🚀 START UPLOAD"
                                Height="38"
                                FontSize="12"
                                FontWeight="Bold"
                                Style="{StaticResource App.Button.Primary}"
                                Click="StartUploadButton_Click" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Style="{StaticResource App.CardStyle}"
                    Padding="15"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="RefreshButton"
                                Click="RefreshButton_Click"
                                Style="{StaticResource App.Button.Ghost}"
                                Margin="0,0,10,0"
                                ToolTip="Re-scan the project folder from disk">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" Foreground="{StaticResource Status.Info}" Margin="0,0,5,0" />
                                <TextBlock Text="Refresh from Disk" Foreground="{StaticResource Text.Secondary}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SelectAllButton" Click="SelectAllButton_Click" Style="{StaticResource App.Button.Ghost}" Margin="10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="☑️" Foreground="{StaticResource Status.Success}" Margin="0,0,5,0" />
                                <TextBlock Text="Select All" Foreground="{StaticResource Text.Secondary}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DeselectAllButton" Click="DeselectAllButton_Click" Style="{StaticResource App.Button.Ghost}" Margin="10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⬜" Foreground="{StaticResource Status.Error}" Margin="0,0,5,0" />
                                <TextBlock Text="Deselect All" Foreground="{StaticResource Text.Secondary}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="Total Files: " Foreground="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                        <TextBlock x:Name="TotalFilesText" Text="0" Foreground="{StaticResource Text.Primary}" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,15,0" />
                        <TextBlock Text="Selected: " Foreground="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                        <TextBlock x:Name="SelectedFilesText" Text="0" Foreground="{StaticResource Status.Success}" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource App.CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="10,8,10,4"
                               FontSize="11"
                               Foreground="{StaticResource Text.Muted}"
                               TextWrapping="Wrap"
                               Text="Legend: green name = clean · red = changed · blue = untracked · grey = ignored · green background = path mapping" />

                    <TreeView x:Name="FileTreeView"
                              Grid.Row="1"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="10"
                              Focusable="True"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              behaviors:ContextMenuSelectionBehavior.Enable="True"
                              PreviewKeyDown="FileTreeView_PreviewKeyDown"
                              MouseRightButtonUp="FileTreeView_MouseRightButtonUp">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="Padding" Value="4,2" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Border Background="{Binding RowBackground}"
                                    CornerRadius="4"
                                    Padding="4,2"
                                    Margin="0,1">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"
                                              Click="ItemCheckBox_Click" />
                                    <TextBlock Text="{Binding Icon}"
                                               Foreground="{Binding IconColor}"
                                               Margin="0,0,6,0"
                                               FontFamily="Segoe UI Emoji" />
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{Binding NameBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SizeDisplay}"
                                               FontSize="11"
                                               Foreground="{StaticResource Text.Muted}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding SizeVisibility}" />
                                    <Border Background="{StaticResource Status.SuccessSurface}"
                                            CornerRadius="3"
                                            Padding="5,1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding MappedBadgeVisibility}">
                                        <TextBlock Text="{Binding MappedBadgeText}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Status.Success}" />
                                    </Border>
                                    <TextBlock Text="{Binding GitBadgeText}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding GitBadgeBrush}"
                                               Visibility="{Binding GitBadgeVisibility}" />
                                    <TextBlock Text="{Binding UploadBadgeText}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding UploadBadgeBrush}"
                                               Visibility="{Binding UploadBadgeVisibility}" />
                                </StackPanel>
                            </Border>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                </Grid>
            </Border>

            <Border x:Name="UploadLogSection"
                    Grid.Row="4"
                    Style="{StaticResource App.CardStyle}"
                    MinHeight="180"
                    Margin="0,15,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="{StaticResource Surface.Shell}"
                            CornerRadius="12,12,0,0"
                            Padding="10,8">
                        <TextBlock Text="📋 Upload Log"
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="10">
                        <TextBox x:Name="UploadLogTextBox"
                                 Background="Transparent"
                                 Foreground="{StaticResource Log.Success}"
                                 FontFamily="{StaticResource FontFamily.Mono}"
                                 FontSize="11"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 BorderThickness="0"
                                 Text="Ready. Waiting for upload..." />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
