<UserControl x:Class="GitDeployPro.Controls.DirectUploadWorkspaceControl"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GitDeployPro.Services.Localization"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:behaviors="clr-namespace:GitDeployPro.Behaviors"
      xmlns:local="clr-namespace:GitDeployPro.Controls"
      mc:Ignorable="d"
      Background="{StaticResource Surface.Base}"
      d:DesignHeight="600"
      d:DesignWidth="800">

    <Grid>
        <Grid x:Name="ContentRootGrid" Margin="{StaticResource Spacing.PageMargin}">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="PageHeaderRowDefinition" Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="PageHeaderRow" Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="📤" FontSize="34" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Direct Upload" Style="{StaticResource App.PageTitleTextStyle}" />
                        <TextBlock Text="Select files and folders to upload directly via FTP"
                                   Style="{StaticResource App.PageSubtitleTextStyle}"
                                   Margin="2,4,0,0" />
                        <TextBlock x:Name="ConnectionInfoText"
                                   Text="Detecting connection..."
                                   FontSize="13"
                                   Foreground="{StaticResource Status.Info}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Upload actions stay above the file tree so the bottom Terminal dock cannot cover them -->
            <Border x:Name="UploadProcessSection"
                    Grid.Row="1"
                    Background="{StaticResource Surface.Card}"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <WrapPanel x:Name="UploadOptionsPanel" Grid.Row="0" ItemHeight="28">
                        <CheckBox x:Name="UseSessionCheck"
                                  Content="Crash Recovery"
                                  IsChecked="True"
                                  Foreground="{StaticResource Text.Primary}"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,4"
                                  ToolTip="{loc:T deploy.tip.crashRecoveryDetail}" />
                        <CheckBox x:Name="OverwriteCheck"
                                  Content="Overwrite"
                                  IsChecked="True"
                                  Foreground="{StaticResource Text.Muted}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,4"
                                  ToolTip="{loc:T deploy.tip.overwriteDetail}" />
                        <CheckBox x:Name="AutoDiskSyncCheck"
                                  Content="Auto Sync Disk"
                                  IsChecked="True"
                                  Foreground="{StaticResource Text.Primary}"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,4"
                                  Checked="AutoDiskSyncCheck_Changed"
                                  Unchecked="AutoDiskSyncCheck_Changed"
                                  ToolTip="{loc:T deploy.tip.autoSyncDetail}" />
                        <TextBlock x:Name="SessionStatusText"
                                   Text=""
                                   Foreground="{StaticResource Status.Warning}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,4" />
                        <Button x:Name="DeleteSessionButton"
                                Content="🗑️ Clear"
                                Visibility="Collapsed"
                                Style="{StaticResource App.Button.Ghost}"
                                Foreground="{StaticResource Status.Error}"
                                FontSize="11"
                                Height="26"
                                Padding="8,0"
                                VerticalAlignment="Center"
                                Margin="0,0,0,4"
                                Click="DeleteSessionButton_Click"
                                ToolTip="{loc:T deploy.tip.clearSessionDetail}" />
                    </WrapPanel>

                    <Border x:Name="UploadStatusCard"
                            Grid.Row="1"
                            Background="{StaticResource Surface.Input}"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,6,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" LastChildFill="True">
                                <Button x:Name="CompactStopButton"
                                        DockPanel.Dock="Right"
                                        Content="Stop"
                                        Visibility="Collapsed"
                                        Style="{StaticResource App.Button.Danger}"
                                        Height="24"
                                        MinWidth="52"
                                        FontSize="11"
                                        Padding="8,0"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Click="StopButton_Click"
                                        ToolTip="{loc:T deploy.tip.stopUpload}" />
                                <Border Width="8"
                                        Height="8"
                                        CornerRadius="4"
                                        Background="{StaticResource Accent.Primary}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0" />
                                <TextBlock x:Name="StatusText"
                                           Text="Ready."
                                           Foreground="{StaticResource Text.Primary}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock x:Name="UploadDetailText"
                                       Grid.Row="1"
                                       Text=""
                                       Foreground="{StaticResource Text.Secondary}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="16,4,0,0" />
                            <ProgressBar x:Name="UploadProgressBar"
                                         Grid.Row="2"
                                         Height="8"
                                         Margin="0,8,0,0"
                                         Background="{StaticResource Surface.Input}"
                                         Foreground="{StaticResource Accent.Primary}"
                                         Value="0" />
                        </Grid>
                    </Border>

                    <Grid x:Name="UploadActionButtonsRow" Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="1.6*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StopButton"
                                Grid.Column="0"
                                Content="⛔ STOP"
                                Height="38"
                                FontSize="12"
                                FontWeight="Bold"
                                Style="{StaticResource App.Button.Danger}"
                                IsEnabled="False"
                                Click="StopButton_Click" />
                        <Button x:Name="StartUploadButton"
                                Grid.Column="2"
                                Content="🚀 START UPLOAD"
                                Height="38"
                                FontSize="12"
                                FontWeight="Bold"
                                Style="{StaticResource App.Button.Primary}"
                                Click="StartUploadButton_Click" />
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="ToolbarSection"
                    Grid.Row="2"
                    Style="{StaticResource App.CardStyle}"
                    Padding="15"
                    Margin="0,0,0,10">
                <!-- Wrap buttons + counters so narrow docks stack instead of overlapping. -->
                <WrapPanel Orientation="Horizontal">
                    <WrapPanel x:Name="ToolbarButtonsPanel" Orientation="Horizontal" Margin="0,0,8,4">
                        <Button x:Name="RefreshButton"
                                Click="RefreshButton_Click"
                                Style="{StaticResource App.Button.Ghost}"
                                Margin="0,0,6,0"
                                MinWidth="28"
                                ToolTip="{loc:T deploy.tip.refreshDiskDetail}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" Foreground="{StaticResource Status.Info}" Margin="0,0,5,0" />
                                <TextBlock x:Name="RefreshButtonLabel" Text="Refresh from Disk" Foreground="{StaticResource Text.Secondary}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SelectAllButton"
                                Click="SelectAllButton_Click"
                                Style="{StaticResource App.Button.Ghost}"
                                Margin="0,0,6,0"
                                MinWidth="28"
                                ToolTip="{loc:T deploy.selectAll}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="☑️" Foreground="{StaticResource Status.Success}" Margin="0,0,5,0" />
                                <TextBlock x:Name="SelectAllButtonLabel" Text="Select All" Foreground="{StaticResource Text.Secondary}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DeselectAllButton"
                                Click="DeselectAllButton_Click"
                                Style="{StaticResource App.Button.Ghost}"
                                Margin="0,0,0,0"
                                MinWidth="28"
                                ToolTip="{loc:T deploy.deselectAll}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⬜" Foreground="{StaticResource Status.Error}" Margin="0,0,5,0" />
                                <TextBlock x:Name="DeselectAllButtonLabel" Text="Deselect All" Foreground="{StaticResource Text.Secondary}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <StackPanel x:Name="ToolbarStatsPanel"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,2,0,4">
                        <TextBlock Text="Total Files: " Foreground="{StaticResource Text.Muted}" VerticalAlignment="Center" FontSize="11" />
                        <TextBlock x:Name="TotalFilesText" Text="0" Foreground="{StaticResource Text.Primary}" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,12,0" FontSize="11" />
                        <TextBlock Text="Selected: " Foreground="{StaticResource Text.Muted}" VerticalAlignment="Center" FontSize="11" />
                        <TextBlock x:Name="SelectedFilesText" Text="0" Foreground="{StaticResource Status.Success}" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="11" />
                    </StackPanel>
                </WrapPanel>
            </Border>

            <Border x:Name="TreeSection"
                    Grid.Row="3"
                    Style="{StaticResource App.CardStyle}"
                    ToolTip="{loc:T deploy.tip.legend}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TreeLegendText"
                               Grid.Row="0"
                               Margin="10,8,10,4"
                               FontSize="11"
                               Foreground="{StaticResource Text.Muted}"
                               TextWrapping="Wrap"
                               Text="Legend: green name = clean · red = changed · blue = untracked · grey = ignored · green background = path mapping" />

                    <Border x:Name="LocalTreeSearchBar"
                            Grid.Row="1"
                            Margin="10,0,10,6"
                            Padding="6,4"
                            CornerRadius="6"
                            Background="{StaticResource Surface.Input}"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LocalTreeSearchBox"
                                     Style="{StaticResource App.InputTextBox}"
                                     FontSize="12"
                                     VerticalContentAlignment="Center"
                                     TextChanged="LocalTreeSearchBox_TextChanged"
                                     PreviewKeyDown="LocalTreeSearchBox_PreviewKeyDown" />
                            <Button x:Name="LocalTreeSearchClearButton"
                                    Grid.Column="1"
                                    Margin="6,0,0,0"
                                    Width="26"
                                    Height="26"
                                    Style="{StaticResource App.IconButton}"
                                    Foreground="{StaticResource Text.Muted}"
                                    Click="LocalTreeSearchClear_Click"
                                    Content="✕" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                    <TreeView x:Name="FileTreeView"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="10"
                              Focusable="True"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              behaviors:ContextMenuSelectionBehavior.Enable="True"
                              behaviors:TreeViewExtendedSelectionBehavior.Enable="True"
                              PreviewKeyDown="FileTreeView_PreviewKeyDown"
                              PreviewTextInput="FileTreeView_PreviewTextInput"
                              MouseRightButtonUp="FileTreeView_MouseRightButtonUp"
                              MouseDoubleClick="FileTreeView_MouseDoubleClick">
                    <TreeView.Resources>
                        <!-- Theme-aware selection (tracks live palette brushes). -->
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                         Color="{Binding Color, Source={StaticResource State.Pressed}}" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                         Color="{Binding Color, Source={StaticResource State.Hover}}" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                         Color="{Binding Color, Source={StaticResource Text.Primary}}" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                                         Color="{Binding Color, Source={StaticResource Text.Primary}}" />
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <Style x:Name="FileTreeItemStyle"
                               TargetType="{x:Type TreeViewItem}"
                               BasedOn="{StaticResource App.TreeViewItem.FullRow}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Padding" Value="3,1" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource State.Hover}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource State.Hover}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource State.Pressed}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Border Background="{Binding RowBackground}"
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="3"
                                    Padding="2,1"
                                    Margin="0,0">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0"
                                              Click="ItemCheckBox_Click" />
                                    <TextBlock Text="{Binding Icon}"
                                               Foreground="{Binding IconColor}"
                                               Margin="0,0,4,0"
                                               FontFamily="Segoe UI Emoji" />
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding NamePrefix, Mode=OneWay}" Foreground="{Binding NameBrush}" />
                                        <Run Text="{Binding NameMatch, Mode=OneWay}"
                                             Background="{DynamicResource Tree.SearchMatchBackground}"
                                             Foreground="{DynamicResource Tree.SearchMatchForeground}"
                                             FontWeight="SemiBold" />
                                        <Run Text="{Binding NameSuffix, Mode=OneWay}" Foreground="{Binding NameBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding SizeDisplay}"
                                               FontSize="10"
                                               Foreground="{StaticResource Text.Muted}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding SizeVisibility}" />
                                    <Border Background="{StaticResource Status.SuccessSurface}"
                                            CornerRadius="3"
                                            Padding="4,0"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding MappedBadgeVisibility}">
                                        <TextBlock Text="{Binding MappedBadgeText}"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Status.Success}" />
                                    </Border>
                                    <TextBlock Text="{Binding GitBadgeText}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding GitBadgeBrush}"
                                               Visibility="{Binding GitBadgeVisibility}" />
                                    <TextBlock Text="{Binding UploadBadgeText}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding UploadBadgeBrush}"
                                               Visibility="{Binding UploadBadgeVisibility}" />
                                </StackPanel>
                            </Border>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                    <ListBox x:Name="LocalTreeSearchResults"
                             Visibility="Collapsed"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="6,0"
                             Style="{StaticResource App.ListBox.Host}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewKeyDown="LocalTreeSearchResults_PreviewKeyDown"
                             PreviewMouseLeftButtonUp="LocalTreeSearchResults_PreviewMouseLeftButtonUp">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource App.ListBoxItem.Transparent}">
                                <Setter Property="Padding" Value="6,4" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Hit"
                                                    Background="Transparent"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Hit" Property="Background" Value="{StaticResource State.Hover}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Hit" Property="Background" Value="{StaticResource State.Pressed}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}"
                                               Foreground="{Binding IconColor}"
                                               Margin="0,0,8,0"
                                               FontFamily="Segoe UI Emoji"
                                               VerticalAlignment="Center" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="{StaticResource FontFamily.Mono}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding PathPrefix, Mode=OneWay}" Foreground="{StaticResource Text.Secondary}" />
                                        <Run Text="{Binding PathMatch, Mode=OneWay}"
                                             Background="{DynamicResource Tree.SearchMatchBackground}"
                                             Foreground="{DynamicResource Tree.SearchMatchForeground}"
                                             FontWeight="SemiBold" />
                                        <Run Text="{Binding PathSuffix, Mode=OneWay}" Foreground="{StaticResource Text.Secondary}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="LocalTreeSearchEmpty"
                               Visibility="Collapsed"
                               Margin="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource Text.Muted}"
                               Text="No matching files or folders" />
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="UploadLogSection"
                    Grid.Row="4"
                    Style="{StaticResource App.CardStyle}"
                    MinHeight="180"
                    Margin="0,15,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="{StaticResource Surface.Shell}"
                            CornerRadius="12,12,0,0"
                            Padding="10,8">
                        <TextBlock Text="📋 Upload Log"
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="10">
                        <TextBox x:Name="UploadLogTextBox"
                                 Background="Transparent"
                                 Foreground="{StaticResource Log.Success}"
                                 FontFamily="{StaticResource FontFamily.Mono}"
                                 FontSize="11"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 BorderThickness="0"
                                 Text="Ready. Waiting for upload..." />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

    <local:LocalFileEditorControl x:Name="LocalEditor"
                                  Visibility="Collapsed"
                                  Panel.ZIndex="60" />
    <local:TransferMonitorPanel x:Name="UploadTransferMonitor"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Width="400"
                                MaxHeight="460"
                                Margin="12,12,12,20"
                                Panel.ZIndex="80"
                                Visibility="Collapsed"/>
    </Grid>
</UserControl>
