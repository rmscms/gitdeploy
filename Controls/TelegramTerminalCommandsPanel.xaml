<UserControl x:Class="GitDeployPro.Controls.TelegramTerminalCommandsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="320"
             d:DesignWidth="720">
    <StackPanel>
        <TextBlock x:Name="CurrentProjectText"
                   Text="Current project: (none)"
                   Foreground="{StaticResource Text.Muted}"
                   FontSize="11"
                   Margin="0,0,0,8"
                   TextWrapping="Wrap" />

        <TextBlock Text="Trusted one-line commands shown as inline buttons while Telegram SSH terminal is open. Free-text lines still use the safety guard."
                   Foreground="{StaticResource Text.Muted}"
                   FontSize="10"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <WrapPanel Margin="0,0,0,10">
            <Button x:Name="AddButton"
                    Content="Add preset"
                    Height="30"
                    MinWidth="100"
                    Margin="0,0,8,0"
                    Style="{StaticResource App.Button.Primary}"
                    Click="AddButton_Click" />
            <Button x:Name="GoBuildTemplateButton"
                    Content="Go build template"
                    Height="30"
                    MinWidth="120"
                    Style="{StaticResource App.Button.Ghost}"
                    Click="GoBuildTemplateButton_Click" />
        </WrapPanel>

        <ListView x:Name="CommandsListView"
                  MinHeight="120"
                  MaxHeight="260"
                  BorderBrush="{StaticResource Border.Subtle}"
                  Background="{StaticResource Surface.Card}"
                  SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Label" Width="120" DisplayMemberBinding="{Binding Description}" />
                    <GridViewColumn Header="Command" Width="320" DisplayMemberBinding="{Binding CommandPreview}" />
                    <GridViewColumn Header="Notify" Width="60" DisplayMemberBinding="{Binding NotifyLabel}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="EditButton"
                    Content="Edit"
                    Height="28"
                    MinWidth="72"
                    Margin="0,0,8,0"
                    Style="{StaticResource App.Button.Ghost}"
                    Click="EditButton_Click" />
            <Button x:Name="DeleteButton"
                    Content="Delete"
                    Height="28"
                    MinWidth="72"
                    Style="{StaticResource App.Button.Ghost}"
                    Click="DeleteButton_Click" />
        </StackPanel>
    </StackPanel>
</UserControl>
