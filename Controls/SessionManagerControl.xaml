<UserControl x:Class="GitDeployPro.Controls.SessionManagerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:GitDeployPro.Services.Localization"
             xmlns:local="clr-namespace:GitDeployPro.Models"
             Background="{StaticResource Surface.Base}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource Surface.Card}" Padding="10" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Border.Subtle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filter -->
                <TextBox x:Name="FilterTextBox"
                         Grid.Column="0"
                         mah:TextBoxHelper.Watermark="Filter..."
                         Style="{StaticResource App.InputTextBox}"
                         Margin="0,0,8,0"
                         ToolTip="{loc:T session.tip.filter}"
                         TextChanged="FilterTextBox_TextChanged"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Width="32" Height="32" Margin="2,0,0,0"
                            Style="{StaticResource App.IconButton}"
                            Background="Transparent"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="1"
                            Foreground="{StaticResource Text.Muted}"
                            ToolTip="{loc:T session.tip.link}"
                            Click="LinkButton_Click">
                        <ui:SymbolIcon Symbol="Link24" Filled="False" FontSize="14"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Width="32" Height="32" Margin="2,0,0,0"
                            Style="{StaticResource App.IconButton}"
                            Background="Transparent"
                            BorderBrush="{StaticResource Status.Success}"
                            BorderThickness="1"
                            Foreground="{StaticResource Status.Success}"
                            ToolTip="{loc:T session.tip.addFolder}"
                            Click="AddFolderButton_Click">
                        <ui:SymbolIcon Symbol="FolderAdd24" Filled="False" FontSize="14"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Width="32" Height="32" Margin="2,0,0,0"
                            Style="{StaticResource App.IconButton}"
                            Background="Transparent"
                            BorderBrush="{StaticResource Status.Error}"
                            BorderThickness="1"
                            Foreground="{StaticResource Status.Error}"
                            ToolTip="{loc:T session.tip.remove}"
                            Click="RemoveButton_Click">
                        <ui:SymbolIcon Symbol="Subtract24" Filled="False" FontSize="14"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TreeView -->
        <Grid Grid.Row="1">
            <Border Background="{StaticResource Surface.Shell}" Padding="10">
                <TreeView x:Name="SessionsTreeView" 
                          Background="Transparent" 
                          BorderThickness="0"
                          SelectedItemChanged="SessionsTreeView_SelectedItemChanged"
                          AllowDrop="True"
                          DragOver="SessionsTreeView_DragOver"
                          Drop="SessionsTreeView_Drop"
                          ContextMenuOpening="SessionsTreeView_ContextMenuOpening">
                    <TreeView.Resources>
                        <Style TargetType="{x:Type TreeViewItem}" x:Key="NoExpanderTreeViewItemStyle">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                                        <StackPanel>
                                            <Border x:Name="Bd" 
                                                   Background="Transparent" 
                                                   Padding="2"
                                                   MinHeight="22">
                                                <ContentPresenter x:Name="PART_Header" 
                                                                 ContentSource="Header" 
                                                                 HorizontalAlignment="Left"/>
                                            </Border>
                                            <ItemsPresenter x:Name="ItemsHost" 
                                                           Margin="15,0,0,0"
                                                           Visibility="Visible"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsExpanded" Value="false">
                                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="true">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent.Primary}"/>
                                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="true"/>
                                                    <Condition Property="IsSelected" Value="false"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource State.Hover}"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource NoExpanderTreeViewItemStyle}">
                            <Setter Property="AllowDrop" Value="True"/>
                            <Setter Property="ContextMenu" Value="{x:Null}"/>
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TreeViewItem_PreviewMouseLeftButtonDown"/>
                            <EventSetter Event="MouseLeftButtonUp" Handler="TreeViewItem_MouseLeftButtonUp"/>
                            <EventSetter Event="MouseDoubleClick" Handler="TreeViewItem_MouseDoubleClick"/>
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="TreeViewItem_PreviewMouseRightButtonDown"/>
                            <EventSetter Event="PreviewMouseMove" Handler="TreeViewItem_PreviewMouseMove"/>
                            <EventSetter Event="DragOver" Handler="TreeViewItem_DragOver"/>
                            <EventSetter Event="Drop" Handler="TreeViewItem_Drop"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                    <Setter Property="IsExpanded" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Border Background="Transparent" 
                                    Padding="2" 
                                    Margin="0"
                                    PreviewMouseLeftButtonDown="ItemContent_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="ItemContent_PreviewMouseMove"
                                    Control.MouseDoubleClick="ItemContent_MouseDoubleClick"
                                    MouseRightButtonUp="ItemContent_MouseRightButtonUp">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" 
                                              Foreground="{Binding IconColor}"
                                              Margin="0,0,8,0" 
                                              FontSize="16"
                                              FontFamily="Segoe UI Emoji"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DisplayNameWithIndicator}" 
                                              VerticalAlignment="Center"
                                              FontSize="14"
                                              Foreground="{StaticResource Text.Secondary}"/>
                                    <TextBlock Text="{Binding ConnectionType}" 
                                              FontSize="11" 
                                              Foreground="{StaticResource Text.Muted}" 
                                              Margin="8,0,0,0" 
                                              VerticalAlignment="Center"
                                              Visibility="{Binding ConnectionTypeVisibility}"/>
                                </StackPanel>
                            </Border>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>
        </Grid>
    </Grid>
</UserControl>

