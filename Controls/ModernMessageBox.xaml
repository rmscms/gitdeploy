<Window x:Class="GitDeployPro.Controls.ModernMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification" Height="230" Width="430"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Grid Background="{StaticResource Surface.Overlay}">
        <Border Width="430"
                MinHeight="220"
                Padding="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource Surface.Raised}"
                BorderBrush="{StaticResource Border.Strong}"
                BorderThickness="1"
                CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="8" Opacity="0.45" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock x:Name="IconText" Text="ℹ️" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleText"
                               Text="Title"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Primary}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           x:Name="MessageText"
                           Text="Message content goes here..."
                           FontSize="14"
                           Foreground="{StaticResource Text.Secondary}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Top"
                           LineHeight="21" />

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,18,0,0">
                    <Button x:Name="ExtraButton"
                            Content="No"
                            Height="36"
                            Width="110"
                            Margin="0,0,10,0"
                            Style="{StaticResource App.Button.Secondary}"
                            Visibility="Collapsed"
                            Click="ExtraButton_Click" />

                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Height="36"
                            Width="96"
                            Margin="0,0,10,0"
                            Style="{StaticResource App.Button.Ghost}"
                            Visibility="Collapsed"
                            Click="CancelButton_Click" />

                    <Button x:Name="OkButton"
                            Content="OK"
                            Height="36"
                            Width="96"
                            Style="{StaticResource App.Button.Primary}"
                            Click="OkButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
