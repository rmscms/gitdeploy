<Window
        xmlns:loc="clr-namespace:GitDeployPro.Services.Localization" x:Class="GitDeployPro.Controls.ModernMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:behaviors="clr-namespace:GitDeployPro.Behaviors"
        Title="Notification"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- theme/assets/css/core.css: .scrim + .modal.sm (420, radius 14, header/footer on Surface.Shell, hero circle 56) -->
    <Window.Resources>
        <Style x:Key="Dialog.ActionButton" TargetType="Button" BasedOn="{StaticResource App.Button.Base}">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Dialog.DismissButton" TargetType="Button" BasedOn="{StaticResource App.IconButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid x:Name="ScrimGrid"
          Background="{StaticResource Surface.Overlay}"
          MouseLeftButtonDown="Scrim_MouseLeftButtonDown">
        <Border x:Name="DialogCard"
                Width="420"
                MinWidth="380"
                MaxWidth="560"
                Opacity="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource Surface.Raised}"
                BorderBrush="{StaticResource Border.Strong}"
                BorderThickness="1"
                CornerRadius="14"
                SnapsToDevicePixels="True"
                MouseLeftButtonDown="DialogCard_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="60"
                                  ShadowDepth="24"
                                  Opacity="0.75"
                                  Color="{Binding Color, Source={StaticResource Shadow.Color}}" />
            </Border.Effect>

            <Border CornerRadius="13" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- .modal-h -->
                    <Border Grid.Row="0"
                            Background="{StaticResource Surface.Shell}"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="0,0,0,1"
                            Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  x:Name="HeaderIcon"
                                  behaviors:AppIcon.Kind="alert"
                                  behaviors:AppIcon.Size="16"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center"
                                  TextElement.Foreground="{DynamicResource Accent.Primary}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TitleText"
                                           Text="Title"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Text.Primary}"
                                           TextWrapping="Wrap" />
                                <!-- kind label kept for code that fills it; hidden in the HTML design -->
                                <TextBlock x:Name="KindLabel" Text="Info" Visibility="Collapsed" />
                            </StackPanel>
                            <Button ToolTip="{loc:T ui.tip.DismissButton}" x:Name="DismissButton"
                                    Grid.Column="2"
                                    Style="{StaticResource Dialog.DismissButton}"
                                    VerticalAlignment="Center"
                                    Click="DismissButton_Click"
                                    Visibility="Collapsed">
                                <Path behaviors:AppIcon.Kind="x" behaviors:AppIcon.Size="14" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- .modal-b : centered hero circle + message -->
                    <StackPanel Grid.Row="1" Margin="22,22,22,20">
                        <Border x:Name="IconBadge"
                                Width="56"
                                Height="56"
                                CornerRadius="28"
                                Margin="0,0,0,14"
                                HorizontalAlignment="Center"
                                Background="{StaticResource Status.InfoSurface}">
                            <ui:SymbolIcon x:Name="DialogIcon"
                                           Symbol="Info24"
                                           Filled="False"
                                           FontSize="28"
                                           Foreground="{StaticResource Status.Info}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="MessageText"
                                   Text="Message content goes here..."
                                   FontSize="13.5"
                                   Foreground="{StaticResource Text.Secondary}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   LineHeight="21"
                                   LineStackingStrategy="BlockLineHeight" />
                        <!-- 4px accent bar from the old design: kept (collapsed) because code colours it -->
                        <Border x:Name="AccentBar" Height="0" Visibility="Collapsed" Background="{StaticResource Status.Info}" />
                    </StackPanel>

                    <!-- .modal-f -->
                    <Border Grid.Row="2"
                            Background="{StaticResource Surface.Shell}"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="0,1,0,0"
                            Padding="18,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button ToolTip="{loc:T ui.tip.ExtraButton}" x:Name="ExtraButton"
                                    Content="No"
                                    Style="{StaticResource Dialog.ActionButton}"
                                    Margin="0,0,8,0"
                                    Visibility="Collapsed"
                                    Click="ExtraButton_Click" />
                            <Button ToolTip="{loc:T ui.tip.CancelButton}" x:Name="CancelButton"
                                    Content="Cancel"
                                    Style="{StaticResource Dialog.ActionButton}"
                                    Margin="0,0,8,0"
                                    Visibility="Collapsed"
                                    Click="CancelButton_Click" />
                            <Button ToolTip="{loc:T ui.tip.OkButton}" x:Name="OkButton"
                                    Content="OK"
                                    Style="{StaticResource Dialog.ActionButton}"
                                    Background="{StaticResource Accent.Primary}"
                                    BorderBrush="{StaticResource Accent.Primary}"
                                    Foreground="{StaticResource Skin.OnAccent}"
                                    IsDefault="True"
                                    Click="OkButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
