<UserControl x:Class="GitDeployPro.Controls.LocalFileEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{StaticResource Surface.Base}">
    <Border Style="{StaticResource App.CardStyle}" Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="CloseButton"
                        Grid.Column="0"
                        Content="Close"
                        Height="28"
                        MinWidth="72"
                        Margin="0,0,8,0"
                        Style="{StaticResource App.Button.Ghost}"
                        Foreground="{StaticResource Status.Error}"
                        BorderBrush="{StaticResource Status.Error}"
                        Click="CloseButton_Click" />

                <TextBlock x:Name="PathText"
                           Grid.Column="1"
                           Text="No file open"
                           FontSize="12"
                           Foreground="{StaticResource Text.Secondary}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <Button x:Name="RevertButton"
                        Grid.Column="2"
                        Content="Revert"
                        Height="28"
                        MinWidth="72"
                        Margin="0,0,8,0"
                        Style="{StaticResource App.Button.Ghost}"
                        IsEnabled="False"
                        Click="RevertButton_Click" />

                <Button x:Name="SaveButton"
                        Grid.Column="3"
                        Content="Save"
                        Height="28"
                        MinWidth="88"
                        Style="{StaticResource App.Button.Primary}"
                        IsEnabled="False"
                        Click="SaveButton_Click" />
            </Grid>

            <TextBlock x:Name="StatusText"
                       Grid.Row="1"
                       Margin="0,0,0,8"
                       FontSize="11"
                       Foreground="{StaticResource Text.Muted}"
                       Text="Ready." />

            <Grid Grid.Row="2">
                <avalon:TextEditor x:Name="CodeEditor"
                                   FontFamily="{StaticResource FontFamily.Mono}"
                                   FontSize="13"
                                   ShowLineNumbers="True"
                                   WordWrap="False"
                                   Background="{StaticResource Surface.Input}"
                                   Foreground="{StaticResource Text.Primary}"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto" />

                <wv:WebView2 x:Name="EditorWebView"
                             Visibility="Collapsed"
                             DefaultBackgroundColor="#FF1E1E1E" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
