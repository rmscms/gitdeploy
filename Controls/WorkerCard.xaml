<UserControl
        xmlns:loc="clr-namespace:GitDeployPro.Services.Localization" x:Class="GitDeployPro.Controls.WorkerCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:GitDeployPro.Behaviors"
             x:Name="Root">
    <!-- Live worker row: icon, title, state badge, striped progress, stats, pause/cancel. States: Running / Paused / Queued / Done / Failed.
         Colours come from theme tokens (Accent.*, Status.*, Surface.*), so every theme pack restyles it. -->
    <Border x:Name="CardBorder"
            Background="{DynamicResource Surface.Card}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="0">
        <Grid>
            <Border x:Name="StateBar"
                    Width="3"
                    HorizontalAlignment="Left"
                    CornerRadius="12,0,0,12"
                    Background="{DynamicResource Border.Strong}" />
            <Grid Margin="14,11,12,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="IconBox"
                        Grid.RowSpan="2"
                        Width="36"
                        Height="36"
                        CornerRadius="10"
                        Margin="0,0,12,0"
                        VerticalAlignment="Top"
                        Background="{DynamicResource Accent.Soft}">
                    <Path x:Name="IconPath"
                          behaviors:AppIcon.Kind="{Binding IconKind, ElementName=Root}"
                          behaviors:AppIcon.Size="18"
                          TextElement.Foreground="{DynamicResource Accent.Primary}" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title, ElementName=Root}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{DynamicResource Text.Primary}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Border x:Name="StateBadge"
                                Margin="8,0,0,0"
                                Padding="7,1"
                                CornerRadius="5"
                                Background="{DynamicResource Accent.Soft}"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="StateText"
                                       Text="Running"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Accent.Primary}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Description, ElementName=Root}"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Muted}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <Button ToolTip="{loc:T ui.tip.PauseButton}" x:Name="PauseButton"
                            Width="28"
                            Height="28"
                            Margin="0,0,2,0"
                            Style="{StaticResource App.IconButton}"
                            Click="PauseButton_Click">
                        <Path x:Name="PauseIcon"
                              behaviors:AppIcon.Kind="pause"
                              behaviors:AppIcon.Size="14"
                              TextElement.Foreground="{DynamicResource Text.Secondary}" />
                    </Button>
                    <Button ToolTip="{loc:T ui.tip.CancelButton}" x:Name="CancelButton"
                            Width="28"
                            Height="28"
                            Style="{StaticResource App.IconButton}"
                            Click="CancelButton_Click">
                        <Path behaviors:AppIcon.Kind="x"
                              behaviors:AppIcon.Size="14"
                              TextElement.Foreground="{DynamicResource Text.Secondary}" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                    <ProgressBar x:Name="Bar"
                                 Style="{StaticResource App.ProgressBar}"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding Progress, ElementName=Root}" />
                    <Grid Margin="0,6,0,0">
                        <TextBlock x:Name="PercentText"
                                   FontFamily="{StaticResource FontFamily.Mono}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding StatsText, ElementName=Root}"
                                   FontFamily="{StaticResource FontFamily.Mono}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Text.Muted}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
