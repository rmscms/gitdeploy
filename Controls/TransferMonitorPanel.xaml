<UserControl
        xmlns:loc="clr-namespace:GitDeployPro.Services.Localization" x:Class="GitDeployPro.Controls.TransferMonitorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:GitDeployPro.Behaviors"
             xmlns:local="clr-namespace:GitDeployPro.Controls"
             MinWidth="340"
             MaxWidth="560">
    <UserControl.Resources>
        <local:WorkerStateStringConverter x:Key="WorkerStateConv"/>
        <local:WorkerProgressConverter x:Key="WorkerProgressConv"/>
    </UserControl.Resources>
    <Border Background="{DynamicResource Surface.Card}"
            BorderBrush="{DynamicResource Border.Strong}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="18,16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.55"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel>
                <Button ToolTip="{loc:T ui.tip.HideButton}" x:Name="HideButton"
                        DockPanel.Dock="Right"
                        Content="Hide"
                        Height="26"
                        MinWidth="60"
                        Padding="12,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource App.Button.Ghost}"
                        Click="HideButton_Click"/>
                <Border DockPanel.Dock="Left"
                        Width="36" Height="36"
                        CornerRadius="10"
                        Margin="0,0,12,0"
                        Background="{DynamicResource Status.InfoSurface}"
                        BorderBrush="{DynamicResource Status.Info}"
                        BorderThickness="1">
                    <Path behaviors:AppIcon.Kind="upload"
                          behaviors:AppIcon.Size="18"
                          TextElement.Foreground="{DynamicResource Status.Info}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SessionTitle"
                               Text="Transfer"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Text.Primary}"/>
                    <TextBlock x:Name="HeadlineText"
                               Margin="0,2,0,0"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Status.Info}"
                               Text="Waiting…"/>
                </StackPanel>
            </DockPanel>

            <ProgressBar x:Name="OverallBar"
                         Grid.Row="2"
                         Margin="0,14,0,0"
                         Style="{StaticResource App.ProgressBar}"
                         Minimum="0"
                         Maximum="100"
                         Value="0"/>

            <TextBlock x:Name="PercentText"
                       Grid.Row="3"
                       Margin="0,6,0,0"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Accent.Primary}"
                       Text=""/>

            <TextBlock Grid.Row="4"
                       Margin="0,14,0,6"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Text.Primary}"
                       Text="Workers"/>
            <ScrollViewer Grid.Row="5" MaxHeight="210" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="WorkerList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:WorkerCard Margin="0,0,0,6"
                                              Title="{Binding IdLabel}"
                                              Description="{Binding FileName}"
                                              StatsText="{Binding Detail}"
                                              IconKind="upload"
                                              ShowControls="False"
                                              State="{Binding State, Converter={StaticResource WorkerStateConv}, Mode=OneWay}"
                                              Progress="{Binding State, Converter={StaticResource WorkerProgressConv}, Mode=OneWay}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="6"
                    Margin="0,10,0,0"
                    Background="{DynamicResource Surface.Base}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,6">
                <ScrollViewer x:Name="LogScroll"
                              MaxHeight="150"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText"
                               TextWrapping="Wrap"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="{DynamicResource Text.Secondary}"/>
                </ScrollViewer>
            </Border>

            <TextBlock x:Name="FooterText"
                       Grid.Row="7"
                       Margin="0,10,0,0"
                       FontSize="10"
                       Foreground="{DynamicResource Text.Muted}"
                       Text="Hide only closes this window. Transfer keeps running."/>
        </Grid>
    </Border>
</UserControl>
