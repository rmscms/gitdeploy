<UserControl x:Class="GitDeployPro.Controls.DeployRemoteWorkspaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:behaviors="clr-namespace:GitDeployPro.Behaviors"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:loc="clr-namespace:GitDeployPro.Services.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="SaveUploadButtonDefaultStyle" TargetType="Button" BasedOn="{StaticResource App.Button.Primary}" />
        <Style x:Key="SaveUploadButtonDirtyStyle" TargetType="Button" BasedOn="{StaticResource App.Button.Primary}">
            <Setter Property="Background" Value="{StaticResource Status.Warning}" />
            <Setter Property="BorderBrush" Value="{StaticResource Status.Warning}" />
            <Setter Property="Foreground" Value="{StaticResource Text.Inverse}" />
        </Style>
        <!-- Compact PhpStorm-like FTP toolbar icons -->
        <Style x:Key="FtpToolbarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource App.IconButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource State.Hover}" />
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="ConnectionPanel"
                Grid.Row="0"
                Panel.ZIndex="6"
                Background="{StaticResource Surface.Shell}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="0,0,0,1"
                Padding="6,4"
                Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="ConnectionComboBox"
                              Grid.Column="0"
                              Height="26"
                              MinHeight="26"
                              Margin="0,0,4,0"
                              Padding="8,0"
                              FontSize="12"
                              VerticalContentAlignment="Center"
                              Style="{StaticResource App.InputComboBox}"
                              DisplayMemberPath="Name"
                              SelectionChanged="ConnectionComboBox_SelectionChanged" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="EditConnectionButton"
                                Style="{StaticResource FtpToolbarIconButtonStyle}"
                                Content="✎"
                                ToolTip="{loc:T deploy.tip.editConnections}"
                                Click="EditConnectionButton_Click" />
                        <Button x:Name="RefreshButton"
                                Style="{StaticResource FtpToolbarIconButtonStyle}"
                                Content="↻"
                                ToolTip="{loc:T deploy.tip.refreshRemote}"
                                Click="RefreshButton_Click" />
                        <Button x:Name="ConnectionToggleButton"
                                Style="{StaticResource FtpToolbarIconButtonStyle}"
                                Content="⚡"
                                Margin="0"
                                ToolTip="{loc:T deploy.tip.connect}"
                                Click="ConnectionToggleButton_Click" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1"
                           x:Name="StatusTextBlock"
                           Margin="2,4,0,0"
                           Foreground="{StaticResource Text.Muted}"
                           FontSize="10.5"
                           Text="Remote workspace is idle." />
            </Grid>
        </Border>

        <Grid x:Name="WorkspaceBodyGrid"
              Grid.Row="1">
            <Border x:Name="RemoteBrowserPanel"
                    Style="{StaticResource App.CardStyle}"
                    Padding="6"
                    Visibility="Visible">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Remote files"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Primary}" />
                        <Border x:Name="MappingBanner"
                                Margin="0,6,0,0"
                                Padding="8,6"
                                CornerRadius="6"
                                Background="{StaticResource Surface.Input}"
                                BorderBrush="{StaticResource Border.Subtle}"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <TextBlock x:Name="MappingBannerText"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{StaticResource Status.Info}"
                                       Text="Path mapping is active for this connection." />
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <TreeView x:Name="RemoteTreeView"
                                  ItemsSource="{Binding RootNodes}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  behaviors:ContextMenuSelectionBehavior.Enable="True"
                                  MouseRightButtonUp="RemoteTreeView_MouseRightButtonUp"
                                  MouseDoubleClick="RemoteTreeView_MouseDoubleClick">
                            <TreeView.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2B65D9" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2B65D9" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF" />
                            </TreeView.Resources>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    <Setter Property="Margin" Value="0,1,0,1" />
                                    <Setter Property="Padding" Value="2" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <EventSetter Event="Expanded"
                                                 Handler="RemoteTreeItem_Expanded" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <Grid Margin="0,1,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding IconGlyph}"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{Binding IconColor}" />

                                        <Border Grid.Column="1"
                                                MinWidth="32"
                                                Margin="0,0,8,0"
                                                CornerRadius="4"
                                                Background="{Binding BadgeBackground}"
                                                BorderBrush="{Binding BadgeBorder}"
                                                BorderThickness="1"
                                                Padding="5,1"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding BadgeText}"
                                                       Foreground="{Binding BadgeForeground}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="12" />
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <Border x:Name="RemoteEmptyState"
                                Visibility="Collapsed"
                                CornerRadius="10"
                                BorderBrush="{StaticResource Border.Subtle}"
                                BorderThickness="1"
                                Background="{StaticResource Surface.Input}"
                                Padding="16"
                                Margin="2"
                                IsHitTestVisible="False">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="📂"
                                           FontSize="22"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource Text.Muted}" />
                                <TextBlock Text="No files loaded yet"
                                           Margin="0,8,0,0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Text.Primary}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="RemoteEmptyHintText"
                                           Margin="0,4,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource Text.Muted}"
                                           HorizontalAlignment="Center"
                                           Text="Connect or refresh to load remote files." />
                            </StackPanel>
                        </Border>

                        <Border x:Name="RemoteLoadingOverlay"
                                Visibility="Collapsed"
                                Background="#AF151C26"
                                CornerRadius="10"
                                BorderBrush="{StaticResource Border.Strong}"
                                BorderThickness="1"
                                Margin="2"
                                Panel.ZIndex="5">
                            <Border Width="260"
                                    Padding="14"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    CornerRadius="10"
                                    Background="{StaticResource Surface.Raised}"
                                    BorderBrush="{StaticResource Border.Strong}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔄"
                                                   FontSize="15"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="RemoteLoadingTitleText"
                                                   Text="Connecting to remote..."
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Text.Primary}" />
                                    </StackPanel>
                                    <TextBlock x:Name="RemoteLoadingDetailText"
                                               Margin="0,6,0,0"
                                               Text="Please wait while we fetch files."
                                               FontSize="11"
                                               Foreground="{StaticResource Text.Muted}"
                                               TextWrapping="Wrap" />
                                    <ProgressBar x:Name="RemoteLoadingProgressBar"
                                                 Margin="0,10,0,0"
                                                 Height="5"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 IsIndeterminate="True"
                                                 Background="{StaticResource Surface.Input}"
                                                 Foreground="{StaticResource Accent.Primary}"
                                                 BorderThickness="0" />
                                    <StackPanel Margin="0,10,0,0">
                                        <Border Height="6" Margin="0,0,0,6" CornerRadius="3" Background="#213D4F66"/>
                                        <Border Height="6" Margin="0,0,0,6" CornerRadius="3" Background="#1B3D4F66" Width="200" HorizontalAlignment="Left"/>
                                        <Border Height="6" CornerRadius="3" Background="#163D4F66" Width="170" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="RemoteEditorPanel"
                    Style="{StaticResource App.CardStyle}"
                    Padding="8,6,8,8"
                    Visibility="Collapsed">
                <ScrollViewer x:Name="EditorPanelScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch">
                    <Grid MinWidth="480"
                          MinHeight="{Binding ActualHeight, ElementName=EditorPanelScrollViewer}"
                          VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="CloseEditorOverlayButton"
                                    Grid.Column="0"
                                    Content="Close"
                                    Height="26"
                                    MinWidth="68"
                                    Margin="0,0,6,0"
                                    Style="{StaticResource App.Button.Ghost}"
                                    Foreground="{StaticResource Status.Error}"
                                    BorderBrush="{StaticResource Status.Error}"
                                    ToolTip="{loc:T deploy.tip.closeEditor}"
                                    Click="CloseEditorOverlayButton_Click" />

                            <TextBlock x:Name="EditorPathText"
                                       Grid.Column="1"
                                       Text="Select a remote file to edit"
                                       Foreground="{StaticResource Text.Secondary}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />

                            <ComboBox x:Name="EditorFontSizeComboBox"
                                      Grid.Column="2"
                                      Width="74"
                                      Height="26"
                                      Margin="6,0,6,0"
                                      Style="{StaticResource App.InputComboBox}"
                                      ItemsSource="{Binding EditorFontSizes}"
                                      SelectionChanged="EditorFontSizeComboBox_SelectionChanged"
                                      ToolTip="{loc:T deploy.tip.editorFont}" />

                            <Button x:Name="RevertButton"
                                    Grid.Column="3"
                                    Content="Revert"
                                    Height="26"
                                    MinWidth="72"
                                    Margin="6,0,6,0"
                                    Style="{StaticResource App.Button.Ghost}"
                                    IsEnabled="False"
                                    ToolTip="{loc:T deploy.tip.revert}"
                                    Click="RevertButton_Click" />

                            <Button x:Name="SaveUploadButton"
                                    Grid.Column="4"
                                    Content="Save/Upload"
                                    Height="26"
                                    MinWidth="96"
                                    Style="{StaticResource SaveUploadButtonDefaultStyle}"
                                    IsEnabled="False"
                                    ToolTip="{loc:T deploy.tip.saveUpload}"
                                    Click="SaveUploadButton_Click" />
                        </Grid>

                        <TextBlock x:Name="EditorStatusText"
                                   Margin="0,3,0,0"
                                   Foreground="{StaticResource Text.Muted}"
                                   FontSize="10"
                                   Text="No file loaded." />

                        <!-- Fixed-height strip: always reserved so Save/Upload never jumps the editor -->
                        <Border x:Name="UploadStatusStrip"
                                Margin="0,4,0,0"
                                Height="32"
                                Background="{StaticResource Surface.Input}"
                                BorderBrush="{StaticResource Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="UploadStatusLabel"
                                               Grid.Column="0"
                                               Text=""
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Accent.Primary}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <TextBlock x:Name="UploadProgressHintText"
                                               Grid.Column="1"
                                               Text=""
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Text.Muted}" />
                                </Grid>
                                <ProgressBar x:Name="UploadProgressBar"
                                             Grid.Row="1"
                                             Margin="0,4,0,0"
                                             Height="5"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="0"
                                             Visibility="Visible"
                                             IsIndeterminate="False"
                                             Background="{StaticResource Border.Subtle}"
                                             Foreground="{StaticResource Accent.Primary}"
                                             BorderThickness="0" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Border x:Name="EditorTabsHostBorder"
                            Grid.Row="1"
                            Margin="0,0,0,6"
                            Background="{StaticResource Surface.Input}"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4,3,4,1">
                        <ListBox x:Name="EditorTabsListBox"
                                 Style="{StaticResource App.ListBox.Host}"
                                 ItemsSource="{Binding OpenSessions}"
                                 BorderThickness="0"
                                 Background="{StaticResource Surface.Input}"
                                 SelectionChanged="EditorTabsListBox_SelectionChanged"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,6,0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="TabBorder"
                                            Background="{StaticResource Surface.Card}"
                                            BorderBrush="{StaticResource Border.Subtle}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="7,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding TabLabel}"
                                                       FontSize="11"
                                                       FontFamily="{StaticResource FontFamily.Mono}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Grid.Column="1"
                                                    Content="✕"
                                                    Width="18"
                                                    Height="18"
                                                    Padding="0"
                                                    Margin="0"
                                                    Tag="{Binding}"
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    Foreground="{StaticResource Text.Muted}"
                                                    FontSize="10"
                                                    ToolTip="{loc:T deploy.tip.closeTab}"
                                                    Click="CloseTabButton_Click" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource Accent.Primary}" />
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource Accent.Primary}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Grid Grid.Row="2">
                        <wv:WebView2 x:Name="EditorWebView"
                                     Visibility="Visible"
                                     DefaultBackgroundColor="#FF1E1E1E" />

                        <TextBox x:Name="EditorFallbackTextBox"
                                 Visibility="Collapsed"
                                 Style="{x:Null}"
                                 Background="{StaticResource Surface.Input}"
                                 Foreground="{StaticResource Text.Primary}"
                                 BorderBrush="{StaticResource Border.Subtle}"
                                 BorderThickness="1"
                                 Padding="10"
                                 MinHeight="280"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Stretch"
                                 VerticalContentAlignment="Top"
                                 HorizontalContentAlignment="Left"
                                 FontFamily="{StaticResource FontFamily.Mono}"
                                 FontSize="13"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextChanged="EditorFallbackTextBox_TextChanged"
                                 TextWrapping="NoWrap" />
                    </Grid>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border x:Name="OperationLogContainer"
                Grid.Row="2"
                Panel.ZIndex="7"
                Style="{StaticResource App.CardStyle}"
                Margin="0,10,0,0"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Background="{StaticResource Surface.Shell}"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="0,0,0,1"
                        Padding="8,4">
                    <Grid>
                        <TextBlock Text="{loc:T deploy.ftpLogTitle}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Muted}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="ToggleOperationLogButton"
                                Content="{loc:T deploy.ftpLogShow}"
                                HorizontalAlignment="Right"
                                Style="{StaticResource FtpToolbarIconButtonStyle}"
                                Width="Auto"
                                MinWidth="72"
                                Height="24"
                                Padding="8,0"
                                FontSize="11"
                                ToolTip="{loc:T deploy.tip.toggleFtpLog}"
                                Click="ToggleOperationLogButton_Click" />
                    </Grid>
                </Border>
                <ScrollViewer x:Name="OperationLogScrollViewer"
                              Grid.Row="1"
                              MaxHeight="120"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed"
                              Padding="8">
                    <TextBlock x:Name="OperationLogText"
                               Text="Remote workspace log is empty."
                               FontFamily="{StaticResource FontFamily.Mono}"
                               FontSize="11"
                               Foreground="{StaticResource Text.Muted}"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
