<Page x:Class="GitDeployPro.Pages.DirectUploadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:behaviors="clr-namespace:GitDeployPro.Behaviors"
      mc:Ignorable="d" 
      Title="DirectUploadPage"
      Background="{StaticResource Surface.Base}" d:DesignHeight="600" d:DesignWidth="800">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
    <Grid Margin="{StaticResource Spacing.PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="📤" FontSize="34" VerticalAlignment="Center" Margin="0,0,14,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Direct Upload" Style="{StaticResource App.PageTitleTextStyle}" />
                    <TextBlock Text="Select files and folders to upload directly via FTP"
                               Style="{StaticResource App.PageSubtitleTextStyle}"
                               Margin="2,4,0,0" />
                    <TextBlock x:Name="ConnectionInfoText"
                               Text="Detecting connection..."
                               FontSize="13"
                               Foreground="{StaticResource Status.Info}"
                               Margin="0,6,0,0" />
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="🗖 Pop-out"
                    Style="{StaticResource DetachPageButtonStyle}"
                    Click="DetachDirectUploadPage_Click" />
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource App.CardStyle}"
                Padding="15"
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="RefreshButton"
                            Click="RefreshButton_Click"
                            Style="{StaticResource App.Button.Ghost}"
                            Margin="0,0,10,0"
                            ToolTip="Re-scan the project folder from disk">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Foreground="{StaticResource Status.Info}" Margin="0,0,5,0" />
                            <TextBlock Text="Refresh from Disk" Foreground="{StaticResource Text.Secondary}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SelectAllButton" Click="SelectAllButton_Click" Style="{StaticResource App.Button.Ghost}" Margin="10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☑️" Foreground="{StaticResource Status.Success}" Margin="0,0,5,0" />
                            <TextBlock Text="Select All" Foreground="{StaticResource Text.Secondary}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeselectAllButton" Click="DeselectAllButton_Click" Style="{StaticResource App.Button.Ghost}" Margin="10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬜" Foreground="{StaticResource Status.Error}" Margin="0,0,5,0" />
                            <TextBlock Text="Deselect All" Foreground="{StaticResource Text.Secondary}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Total Files: " Foreground="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TotalFilesText" Text="0" Foreground="{StaticResource Text.Primary}" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,15,0" />

                    <TextBlock Text="Selected: " Foreground="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                    <TextBlock x:Name="SelectedFilesText" Text="0" Foreground="{StaticResource Status.Success}" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource App.CardStyle}">
            <TreeView x:Name="FileTreeView"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="10"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      behaviors:ContextMenuSelectionBehavior.Enable="True"
                      MouseRightButtonUp="FileTreeView_MouseRightButtonUp">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="{x:Type TreeViewItem}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="Padding" Value="4,2" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      Click="ItemCheckBox_Click" />
                            <TextBlock Text="{Binding Icon}"
                                       Foreground="{Binding IconColor}"
                                       Margin="0,0,6,0"
                                       FontFamily="Segoe UI Emoji" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SizeDisplay}"
                                       FontSize="11"
                                       Foreground="{StaticResource Text.Muted}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding SizeVisibility}" />
                            <TextBlock Text="{Binding UploadBadgeText}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding UploadBadgeBrush}"
                                       Visibility="{Binding UploadBadgeVisibility}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <CheckBox x:Name="UseSessionCheck"
                              Content="Enable Crash Recovery"
                              IsChecked="True"
                              Foreground="{StaticResource Text.Primary}"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"
                              ToolTip="Keeps a log of uploaded files to resume if connection fails." />

                    <TextBlock x:Name="SessionStatusText"
                               Text=""
                               Foreground="{StaticResource Status.Warning}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />

                    <Button x:Name="DeleteSessionButton"
                            Content="🗑️ Clear Session"
                            Visibility="Collapsed"
                            Style="{StaticResource App.Button.Ghost}"
                            Foreground="{StaticResource Status.Error}"
                            FontSize="11"
                            VerticalAlignment="Center"
                            Click="DeleteSessionButton_Click"
                            ToolTip="Delete the saved session file manually" />

                    <CheckBox x:Name="OverwriteCheck"
                              Content="Force Overwrite"
                              IsChecked="True"
                              Foreground="{StaticResource Text.Muted}"
                              Margin="15,0,0,0"
                              VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="StatusText" Text="Ready." Foreground="{StaticResource Text.Muted}" FontSize="13" Margin="0,0,0,5" />
                <TextBlock x:Name="UploadDetailText" Text="" Foreground="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,5" />
                <ProgressBar x:Name="UploadProgressBar"
                             Height="6"
                             Margin="0,0,20,0"
                             Background="{StaticResource Surface.Input}"
                             Foreground="{StaticResource Accent.Primary}"
                             Value="0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="StopButton"
                        Content="⛔ STOP"
                        Height="45"
                        Width="100"
                        Margin="0,0,10,0"
                        FontSize="14"
                        FontWeight="Bold"
                        Style="{StaticResource App.Button.Danger}"
                        IsEnabled="False"
                        Click="StopButton_Click" />

                <Button x:Name="StartUploadButton"
                        Content="🚀 START UPLOAD"
                        Height="45"
                        Width="170"
                        FontSize="14"
                        FontWeight="Bold"
                        Style="{StaticResource App.Button.Primary}"
                        Click="StartUploadButton_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="4"
                Style="{StaticResource App.CardStyle}"
                MinHeight="180"
                Margin="0,15,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource Surface.Shell}"
                        CornerRadius="12,12,0,0"
                        Padding="10,8">
                    <TextBlock Text="📋 Upload Log"
                               Foreground="{StaticResource Text.Secondary}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="10">
                    <TextBox x:Name="UploadLogTextBox"
                             Background="Transparent"
                             Foreground="{StaticResource Log.Success}"
                             FontFamily="{StaticResource FontFamily.Mono}"
                             FontSize="11"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             BorderThickness="0"
                             Text="Ready. Waiting for upload..." />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</Page>