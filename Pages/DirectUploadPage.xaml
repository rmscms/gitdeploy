<Page x:Class="GitDeployPro.Pages.DirectUploadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:GitDeployPro.Controls"
      Title="DirectUploadPage"
      Background="{StaticResource Surface.Base}">
    <Grid>
        <controls:DirectUploadWorkspaceControl x:Name="Workspace" CompactMode="False" />
        <Button Content="🗖 Pop-out"
                Style="{StaticResource DetachPageButtonStyle}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,24,24,0"
                Panel.ZIndex="5"
                Click="DetachDirectUploadPage_Click" />
    </Grid>
</Page>
