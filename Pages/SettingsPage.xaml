<Page x:Class="GitDeployPro.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:controls="clr-namespace:GitDeployPro.Controls"
      xmlns:behaviors="clr-namespace:GitDeployPro.Behaviors"
      xmlns:loc="clr-namespace:GitDeployPro.Services.Localization"
      Title="SettingsPage"
      Background="{DynamicResource Surface.Base}"
      Foreground="{DynamicResource Text.Primary}">
    <Page.Resources>
        <Style x:Key="Settings.NavButton" TargetType="Button" BasedOn="{StaticResource App.SidebarNavButton}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style x:Key="Settings.NavButton.Active" TargetType="Button" BasedOn="{StaticResource Settings.NavButton}">
            <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
            <Setter Property="Foreground" Value="{DynamicResource Accent.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Settings.Expander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="Background" Value="{DynamicResource Surface.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <DockPanel>
                                <ToggleButton ToolTip="{loc:T ui.tip.HeaderToggle}" x:Name="HeaderToggle"
                                              DockPanel.Dock="Top"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="14,12"
                                              Cursor="Hand"
                                              HorizontalContentAlignment="Stretch"
                                              FocusVisualStyle="{x:Null}">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="HeaderBg"
                                                                Background="{TemplateBinding Background}"
                                                                CornerRadius="12,12,0,0"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Stretch"
                                                                              VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="HeaderBg" Property="Background" Value="{DynamicResource Surface.Raised}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                                        <Border x:Name="ChevronHost"
                                                Grid.Column="1"
                                                Width="28"
                                                Height="28"
                                                CornerRadius="14"
                                                Background="{DynamicResource Surface.Raised}"
                                                BorderBrush="{DynamicResource Border.Subtle}"
                                                BorderThickness="1"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                            <Path x:Name="ChevronPath"
                                                  Data="M 0,0 L 5,5 L 10,0"
                                                  Stroke="{DynamicResource Text.Secondary}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Width="10"
                                                  Height="6"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="0" />
                                                </Path.RenderTransform>
                                            </Path>
                                        </Border>
                                    </Grid>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite"
                                                  DockPanel.Dock="Bottom"
                                                  Margin="14,0,14,14"
                                                  Visibility="Collapsed" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ChevronPath" Property="Stroke" Value="{DynamicResource Accent.Primary}" />
                                <Setter TargetName="ChevronHost" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                <Setter TargetName="ChevronPath" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
                                <Setter TargetName="ChevronHost" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                <Setter TargetName="ChevronPath" Property="Stroke" Value="{DynamicResource Accent.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Settings.ToolbarCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Text.Primary}" />
        </Style>
    </Page.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header (Deploy-like) -->
        <Border Grid.Row="0"
                Background="{StaticResource Surface.Shell}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="8"
                        Background="{StaticResource Surface.Raised}"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="1"
                        Margin="0,0,10,0">
                    <Path behaviors:AppIcon.Kind="settings" behaviors:AppIcon.Size="18" TextElement.Foreground="{DynamicResource Accent.Primary}" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Settings"
                               Foreground="{StaticResource Text.Primary}"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="SettingsSectionSubtitle"
                               Text="Project path, startup, updates, and danger zone."
                               Foreground="{StaticResource Text.Muted}"
                               FontSize="11" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{StaticResource Surface.Shell}"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8,12"
                    Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="SECTIONS"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource Text.Muted}"
                               Margin="10,0,0,8" />
                    <TextBlock DockPanel.Dock="Bottom" Text="Ctrl+S to save  -  Ctrl+F to search" FontSize="10" Foreground="{DynamicResource Text.Muted}" Margin="10,10,0,0" TextWrapping="Wrap" />
                    <StackPanel>
                        <Button ToolTip="{loc:T ui.tip.SettingsNav}" x:Name="NavGeneralButton"
                                Style="{StaticResource Settings.NavButton.Active}"
                                Click="SettingsNav_Click"
                                Tag="general">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Path behaviors:AppIcon.Kind="folder-open" behaviors:AppIcon.Size="16" Margin="0,0,10,0" TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Grid.Column="1" Text="General" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button ToolTip="{loc:T ui.tip.SettingsNav}" x:Name="NavServerButton"
                                Style="{StaticResource Settings.NavButton}"
                                Click="SettingsNav_Click"
                                Tag="server">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Path behaviors:AppIcon.Kind="cloud" behaviors:AppIcon.Size="16" Margin="0,0,10,0" TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Grid.Column="1" Text="Server" VerticalAlignment="Center" />
                                <Border x:Name="NavServerBadge" Grid.Column="2" Visibility="Collapsed" CornerRadius="8" Padding="6,1" Margin="6,0,0,0" Background="{DynamicResource Surface.Raised}" VerticalAlignment="Center">
                                    <TextBlock x:Name="NavServerBadgeText" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" MaxWidth="60" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Grid>
                        </Button>
                        <Button ToolTip="{loc:T ui.tip.SettingsNav}" x:Name="NavGitButton"
                                Style="{StaticResource Settings.NavButton}"
                                Click="SettingsNav_Click"
                                Tag="git">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Path behaviors:AppIcon.Kind="git-branch" behaviors:AppIcon.Size="16" Margin="0,0,10,0" TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Grid.Column="1" Text="Git" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button ToolTip="{loc:T ui.tip.SettingsNav}" x:Name="NavTerminalButton"
                                Style="{StaticResource Settings.NavButton}"
                                Click="SettingsNav_Click"
                                Tag="terminal">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Path behaviors:AppIcon.Kind="terminal" behaviors:AppIcon.Size="16" Margin="0,0,10,0" TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Grid.Column="1" Text="Terminal" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button ToolTip="{loc:T ui.tip.SettingsNav}" x:Name="NavTelegramButton"
                                Style="{StaticResource Settings.NavButton}"
                                Click="SettingsNav_Click"
                                Tag="telegram">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Path behaviors:AppIcon.Kind="chat" behaviors:AppIcon.Size="16" Margin="0,0,10,0" TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Grid.Column="1" Text="Telegram" VerticalAlignment="Center" />
                                <Border x:Name="NavTelegramBadge" Grid.Column="2" Visibility="Collapsed" CornerRadius="8" Padding="6,1" Margin="6,0,0,0" Background="{DynamicResource Surface.Raised}" VerticalAlignment="Center">
                                    <TextBlock x:Name="NavTelegramBadgeText" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" MaxWidth="60" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Grid>
                        </Button>
                        <Button ToolTip="{loc:T ui.tip.SettingsNav}" x:Name="NavAiAgentButton"
                                Style="{StaticResource Settings.NavButton}"
                                Click="SettingsNav_Click"
                                Tag="ai-agent">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Path behaviors:AppIcon.Kind="cpu" behaviors:AppIcon.Size="16" Margin="0,0,10,0" TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Grid.Column="1" Text="AI agent" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button ToolTip="{loc:T ui.tip.SettingsNav}" x:Name="NavVpnButton"
                                Style="{StaticResource Settings.NavButton}"
                                Click="SettingsNav_Click"
                                Tag="vpn">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Path behaviors:AppIcon.Kind="globe" behaviors:AppIcon.Size="16" Margin="0,0,10,0" TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Grid.Column="1" Text="{loc:T vpn.nav}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content -->
            <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="{DynamicResource Surface.Input}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,8" Height="38">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path behaviors:AppIcon.Kind="search" behaviors:AppIcon.Size="16" Margin="12,0,8,0" TextElement.Foreground="{DynamicResource Text.Muted}" />
                    <TextBlock Grid.Column="1" Text="Search settings in this section..." IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0" FontSize="13" Foreground="{DynamicResource Text.Muted}" x:Name="SettingsSearchPlaceholder" />
                    <TextBox x:Name="SettingsSearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Text.Primary}" CaretBrush="{DynamicResource Text.Primary}" VerticalContentAlignment="Center" FontSize="13" TextChanged="SettingsSearchBox_TextChanged" />
                    <Button ToolTip="{loc:T ui.tip.SettingsSearchClearButton}" x:Name="SettingsSearchClearButton" Grid.Column="2" Width="28" Height="28" Margin="0,0,6,0" Padding="0" Style="{StaticResource App.IconButton}" Visibility="Collapsed" Click="SettingsSearchClear_Click">
                        <Path behaviors:AppIcon.Kind="x" behaviors:AppIcon.Size="14" TextElement.Foreground="{DynamicResource Text.Muted}" />
                    </Button>
                </Grid>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="{StaticResource Surface.Base}"
                          Padding="2,0,2,16">
                <Grid>
                    <!-- GENERAL -->
                    <StackPanel x:Name="SettingsPanelGeneral">
                        <Border Style="{StaticResource Settings.ToolbarCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Workspace"
                                               FontSize="11"
                                               Foreground="{StaticResource Text.Muted}" />
                                    <TextBlock x:Name="WorkspacePathHint"
                                               Text="{Binding Text, ElementName=LocalPathTextBox}"
                                               FontSize="12"
                                               FontFamily="{StaticResource FontFamily.Mono}"
                                               Foreground="{StaticResource Text.Secondary}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Button ToolTip="{loc:T ui.tip.BrowseLocalButton}" x:Name="BrowseLocalButton"
                                        Grid.Column="1"
                                        Content="Browse"
                                        Height="32"
                                        MinWidth="88"
                                        Style="{StaticResource App.Button.Ghost}"
                                        Click="BrowseLocalButton_Click" />
                            </Grid>
                        </Border>

                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Accent.Soft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path behaviors:AppIcon.Kind="folder-open" behaviors:AppIcon.Size="16" TextElement.Foreground="{DynamicResource Accent.Primary}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Local project" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Select the folder GitDeploy Pro manages"
                                                   FontSize="10"
                                                   Foreground="{StaticResource Text.Muted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Text="Project folder" Margin="0,0,0,6" Style="{StaticResource App.MutedTextStyle}" FontSize="11" />
                                <TextBox x:Name="LocalPathTextBox" Style="{StaticResource App.InputTextBox}" />
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Accent.Soft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path behaviors:AppIcon.Kind="sliders" behaviors:AppIcon.Size="16" TextElement.Foreground="{DynamicResource Text.Secondary}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Configuration file" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Git ignore helper for project metadata"
                                                   FontSize="10"
                                                   Foreground="{StaticResource Text.Muted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="AddToGitIgnoreCheckBox"
                                          Content="Add config file to .gitignore"
                                          IsChecked="True"
                                          Foreground="{StaticResource Text.Secondary}"
                                          FontSize="12"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />
                                <Button ToolTip="{loc:T ui.tip.AddGitIgnore}" Content="Add Now"
                                        Height="28"
                                        Padding="12,0"
                                        Style="{StaticResource App.Button.Ghost}"
                                        Click="AddGitIgnore_Click" />
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Accent.Soft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path behaviors:AppIcon.Kind="layers" behaviors:AppIcon.Size="16" TextElement.Foreground="{DynamicResource Accent.Primary}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock x:Name="ProjectKindSectionTitle"
                                                   Text="Project type"
                                                   FontWeight="SemiBold"
                                                   FontSize="13" />
                                        <TextBlock x:Name="ProjectKindSectionHint"
                                                   Text="How Telegram and deploy shortcuts treat this project"
                                                   FontSize="10"
                                                   Foreground="{StaticResource Text.Muted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock x:Name="ProjectKindLabel"
                                           Text="Project type"
                                           Margin="0,0,0,6"
                                           Style="{StaticResource App.MutedTextStyle}"
                                           FontSize="11" />
                                <ComboBox x:Name="ProjectKindComboBox"
                                          Height="34"
                                          Style="{StaticResource App.InputComboBox}" />
                                <TextBlock x:Name="ProjectKindNoteText"
                                           Margin="0,8,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource Text.Muted}"
                                           TextWrapping="Wrap"
                                           Text="Web/FTP projects show Deploy on Telegram. Desktop or agent-only projects hide it." />
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Accent.Soft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path behaviors:AppIcon.Kind="globe" behaviors:AppIcon.Size="16" TextElement.Foreground="{DynamicResource Accent.Primary}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock x:Name="LanguageSectionTitle"
                                                   Text="Language"
                                                   FontWeight="SemiBold"
                                                   FontSize="13" />
                                        <TextBlock x:Name="LanguageSectionHint"
                                                   Text="Tooltip language for button descriptions. Default is English."
                                                   FontSize="10"
                                                   Foreground="{StaticResource Text.Muted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock x:Name="LanguageLabel"
                                           Text="Language"
                                           Margin="0,0,0,6"
                                           Style="{StaticResource App.MutedTextStyle}"
                                           FontSize="11" />
                                <ComboBox x:Name="UiLanguageComboBox"
                                          Height="34"
                                          Style="{StaticResource App.InputComboBox}"
                                          SelectedValuePath="Code"
                                          SelectionChanged="UiLanguageComboBox_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock x:Name="LanguageNoteText"
                                           Margin="0,8,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource Text.Muted}"
                                           TextWrapping="Wrap"
                                           Text="Persian translates button tooltips only. Menus and layout stay English (LTR)." />
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Accent.Soft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path behaviors:AppIcon.Kind="file-text" behaviors:AppIcon.Size="16" TextElement.Foreground="{DynamicResource Accent.Primary}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock x:Name="EditorPrefTitle"
                                                   Text="Editor"
                                                   FontWeight="SemiBold"
                                                   FontSize="13" />
                                        <TextBlock x:Name="EditorPrefHint"
                                                   Text="How files open on the Deploy page (all projects)"
                                                   FontSize="10"
                                                   Foreground="{StaticResource Text.Muted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <RadioButton x:Name="EditorOpenDockRadio"
                                             GroupName="DeployEditorOpenMode"
                                             Content="Docked in Deploy (current)"
                                             Foreground="{StaticResource Text.Secondary}"
                                             FontSize="12"
                                             IsChecked="True"
                                             Checked="EditorOpenModeRadio_Checked" />
                                <RadioButton x:Name="EditorOpenFloatRadio"
                                             GroupName="DeployEditorOpenMode"
                                             Content="Float window"
                                             Foreground="{StaticResource Text.Secondary}"
                                             FontSize="12"
                                             Margin="0,8,0,0"
                                             Checked="EditorOpenModeRadio_Checked" />
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Accent.Soft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path behaviors:AppIcon.Kind="monitor" behaviors:AppIcon.Size="16" TextElement.Foreground="{DynamicResource Text.Secondary}" />
                                    </Border>
                                    <TextBlock Text="Startup &amp; tray" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <CheckBox x:Name="LaunchOnStartupCheckBox"
                                          Content="Launch GitDeploy Pro when Windows starts"
                                          Foreground="{StaticResource Text.Secondary}"
                                          FontSize="12" />
                                <CheckBox x:Name="ShowBackupLocalhostWarningCheckBox"
                                          Content="Show localhost warning in Backup Scheduler"
                                          Foreground="{StaticResource Text.Secondary}"
                                          FontSize="12"
                                          Margin="0,8,0,0" />
                                <CheckBox x:Name="MinimizeToTrayCheckBox"
                                          Content="Minimize and close to system tray"
                                          Foreground="{StaticResource Text.Secondary}"
                                          FontSize="12"
                                          Margin="0,8,0,0" />
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Accent.Soft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path behaviors:AppIcon.Kind="upload" behaviors:AppIcon.Size="16" TextElement.Foreground="{DynamicResource Text.Secondary}" />
                                    </Border>
                                    <TextBlock Text="Software updates" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock x:Name="UpdateVersionText" Text="Current version: -" Foreground="{StaticResource Text.Secondary}" FontSize="12" />
                                <TextBlock x:Name="UpdateLastCheckText" Text="Last automatic check: never" Foreground="{StaticResource Text.Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <Button ToolTip="{loc:T ui.tip.CheckForUpdatesButton}" x:Name="CheckForUpdatesButton"
                                        Content="Check for updates now"
                                        Height="32"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        MinWidth="170"
                                        Style="{StaticResource App.Button.Ghost}"
                                        Click="CheckForUpdatesButton_Click" />
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Accent.Soft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path behaviors:AppIcon.Kind="settings" behaviors:AppIcon.Size="16" TextElement.Foreground="{DynamicResource Text.Secondary}" />
                                    </Border>
                                    <TextBlock Text="Windows startup audit" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock x:Name="StartupAuditSummaryText" Text="Startup status will be loaded..." Foreground="{StaticResource Text.Secondary}" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock x:Name="StartupCurrentExeText" Text="Current exe: -" Foreground="{StaticResource Text.Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="StartupPrimaryEntryText" Text="Primary startup value: -" Foreground="{StaticResource Text.Muted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="Detected GitDeploy startup entries:" Foreground="{StaticResource Text.Muted}" FontSize="11" Margin="0,8,0,4" />
                                <TextBox x:Name="StartupEntriesTextBox"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="72"
                                         MaxHeight="110"
                                         FontSize="11"
                                         Background="{StaticResource Surface.Input}"
                                         BorderBrush="{StaticResource Border.Subtle}"
                                         Foreground="{StaticResource Text.Secondary}"
                                         FontFamily="{StaticResource FontFamily.Mono}" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button ToolTip="{loc:T ui.tip.RefreshStartupAuditButton}" x:Name="RefreshStartupAuditButton" Content="Refresh" Height="30" Padding="12,0" Margin="0,0,8,8" Style="{StaticResource App.Button.Ghost}" Click="RefreshStartupAuditButton_Click" />
                                    <Button ToolTip="{loc:T ui.tip.UseCurrentStartupButton}" x:Name="UseCurrentStartupButton" Content="Use this version" Height="30" Padding="12,0" Margin="0,0,8,8" Style="{StaticResource App.Button.Primary}" Click="UseCurrentStartupButton_Click" />
                                    <Button ToolTip="{loc:T ui.tip.RemoveStartupEntriesButton}" x:Name="RemoveStartupEntriesButton" Content="Remove startup entries" Height="30" Padding="12,0" Margin="0,0,0,8" Style="{StaticResource App.Button.Ghost}" Click="RemoveStartupEntriesButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Accent.Soft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path behaviors:AppIcon.Kind="alert" behaviors:AppIcon.Size="16" TextElement.Foreground="{DynamicResource Status.Error}" />
                                    </Border>
                                    <TextBlock Text="Danger zone" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Status.Error}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <Border Background="{StaticResource Status.ErrorSurface}"
                                    BorderBrush="{StaticResource Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Remove this project from GitDeploy Pro only. Files stay on disk."
                                               Foreground="{StaticResource Text.Secondary}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8" />
                                    <TextBlock x:Name="DangerProjectPathText"
                                               Foreground="{StaticResource Text.Muted}"
                                               FontFamily="{StaticResource FontFamily.Mono}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"
                                               Text="No project selected." />
                                    <Button ToolTip="{loc:T ui.tip.RemoveProjectFromAppButton}" x:Name="RemoveProjectFromAppButton"
                                            Content="Remove project from app"
                                            Height="32"
                                            HorizontalAlignment="Left"
                                            Padding="14,0"
                                            Style="{StaticResource App.Button.Danger}"
                                            Click="RemoveProjectFromAppButton_Click" />
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>

                    <!-- TERMINAL -->
                    <StackPanel x:Name="SettingsPanelTerminal" Visibility="Collapsed">
                        <Border Style="{StaticResource Settings.ToolbarCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="TerminalAppearanceTitle"
                                           Text="Appearance"
                                           FontWeight="SemiBold"
                                           FontSize="15" />
                                <TextBlock x:Name="TerminalAppearanceHint"
                                           Text="Font size and text color for every terminal. Same for all projects."
                                           FontSize="11"
                                           Foreground="{StaticResource Text.Muted}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="TerminalFontLabel"
                                                   Text="Font size"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Text.Muted}"
                                                   Margin="0,0,0,6" />
                                        <ComboBox x:Name="SettingsTerminalFontCombo"
                                                  Height="34"
                                                  Style="{StaticResource App.InputComboBox}"
                                                  SelectionChanged="SettingsTerminalAppearance_Changed">
                                            <ComboBoxItem Content="10" />
                                            <ComboBoxItem Content="12" />
                                            <ComboBoxItem Content="14" />
                                            <ComboBoxItem Content="16" />
                                            <ComboBoxItem Content="18" />
                                            <ComboBoxItem Content="20" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="TerminalColorLabel"
                                                   Text="Text color"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Text.Muted}"
                                                   Margin="0,0,0,6" />
                                        <ComboBox x:Name="SettingsTerminalColorCombo"
                                                  Height="34"
                                                  Style="{StaticResource App.InputComboBox}"
                                                  SelectionChanged="SettingsTerminalAppearance_Changed">
                                            <ComboBoxItem Content="Gray" Tag="#D4D4D4" />
                                            <ComboBoxItem Content="White" Tag="#FFFFFF" />
                                            <ComboBoxItem Content="Green" Tag="#00FF00" />
                                            <ComboBoxItem Content="Cyan" Tag="#00FFFF" />
                                            <ComboBoxItem Content="Yellow" Tag="#FFFF00" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Settings.ToolbarCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Terminal suggestions"
                                           FontWeight="SemiBold"
                                           FontSize="15" />
                                <TextBlock Text="Autocomplete commands with ghost text · Global or per-project scope"
                                           FontSize="11"
                                           Foreground="{StaticResource Text.Muted}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <controls:TerminalSuggestionsSettingsPanel x:Name="TerminalSuggestionsPanel" />
                    </StackPanel>

                    <!-- SERVER -->
                    <StackPanel x:Name="SettingsPanelServer" Visibility="Collapsed">
                        <Border Style="{StaticResource Settings.ToolbarCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Accent.Soft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path behaviors:AppIcon.Kind="cloud" behaviors:AppIcon.Size="16" TextElement.Foreground="{DynamicResource Accent.Primary}" />
                                    </Border>
                                    <TextBlock Text="Connection profile" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Assign one or more FTP/SFTP profiles. The default is used by Commit and Sync."
                                           Foreground="{StaticResource Text.Muted}"
                                           FontSize="11"
                                           Margin="0,0,0,10"
                                           TextWrapping="Wrap" />
                                <ListBox x:Name="AssignedFtpProfilesList"
                                         MinHeight="72"
                                         MaxHeight="220"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Style="{StaticResource App.ListBox.Host}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="AssignedFtpProfilesList_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource App.ListBoxItem.Transparent}">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,8"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="AssignedFtpRow"
                                                    Background="{StaticResource Surface.Input}"
                                                    BorderBrush="{StaticResource Border.Subtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="13"
                                                                       Foreground="{StaticResource Text.Primary}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <Border Margin="8,0,0,0"
                                                                    Background="{StaticResource Status.SuccessSurface}"
                                                                    CornerRadius="4"
                                                                    Padding="6,2"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding DefaultBadgeVisibility}">
                                                                <TextBlock Text="Default"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource Status.Success}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Host}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource Text.Muted}"
                                                                   Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="★"
                                                                Width="28"
                                                                Height="28"
                                                                Padding="0"
                                                                Margin="0,0,4,0"
                                                                Style="{StaticResource App.IconButton}"
                                                                ToolTip="{loc:T deploy.tip.setFtpDefault}"
                                                                Click="SetDefaultFtpButton_Click"
                                                                IsEnabled="{Binding CanSetDefault}"/>
                                                        <Button Content="−"
                                                                Width="28"
                                                                Height="28"
                                                                Padding="0"
                                                                Style="{StaticResource App.IconButton}"
                                                                ToolTip="{loc:T deploy.tip.removeFtpProfile}"
                                                                Click="RemoveAssignedFtpButton_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                    <Setter TargetName="AssignedFtpRow" Property="Background" Value="{StaticResource Status.SuccessSurface}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="AssignedFtpEmptyText"
                                           Text="No FTP/SFTP profile assigned to this project."
                                           Foreground="{StaticResource Text.Muted}"
                                           FontSize="11"
                                           Margin="0,0,0,10"
                                           Visibility="Collapsed"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="AddFtpProfileComboBox"
                                              Grid.Column="0"
                                              Height="36"
                                              Style="{StaticResource App.InputComboBox}"
                                              DisplayMemberPath="DisplayName" />
                                    <Button x:Name="AddFtpProfileButton"
                                            Grid.Column="1"
                                            Content="Add"
                                            Height="36"
                                            Margin="8,0,0,0"
                                            Padding="12,0"
                                            Style="{StaticResource App.Button.Ghost}"
                                            ToolTip="{loc:T deploy.tip.addFtpProfile}"
                                            Click="AddFtpProfileButton_Click" />
                                    <Button ToolTip="{loc:T ui.tip.ManageConnectionsButton}" x:Name="ManageConnectionsButton"
                                            Grid.Column="2"
                                            Content="Manage profiles"
                                            Height="36"
                                            Margin="8,0,0,0"
                                            Padding="12,0"
                                            Style="{StaticResource App.Button.Primary}"
                                            Click="ManageConnectionsButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Settings.ToolbarCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Accent.Soft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path behaviors:AppIcon.Kind="key" behaviors:AppIcon.Size="16" TextElement.Foreground="{DynamicResource Status.Info}" />
                                    </Border>
                                    <TextBlock Text="Default SSH (Deploy + Telegram)"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Text.Primary}" />
                                </StackPanel>
                                <TextBlock Text="SSH profile used first in Deploy terminal and Telegram. Falls back to default FTP when it uses SSH."
                                           Foreground="{StaticResource Text.Muted}"
                                           FontSize="11"
                                           Margin="0,0,0,10"
                                           TextWrapping="Wrap" />
                                <ComboBox x:Name="DefaultSshProfileComboBox"
                                          Height="36"
                                          Style="{StaticResource App.InputComboBox}"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="DefaultSshProfileComboBox_SelectionChanged" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Settings.ToolbarCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Accent.Soft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path behaviors:AppIcon.Kind="shield" behaviors:AppIcon.Size="16" TextElement.Foreground="{DynamicResource Accent.Primary}" />
                                    </Border>
                                    <TextBlock Text="Server config backup"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Text.Primary}" />
                                </StackPanel>
                                <TextBlock Text="Export or restore FTP, SSH, and database profiles as an encrypted JSON file."
                                           Foreground="{StaticResource Text.Muted}"
                                           FontSize="11"
                                           Margin="0,0,0,10"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Backup password" Foreground="{StaticResource Text.Muted}" FontSize="11" Margin="0,0,0,4" />
                                <PasswordBox x:Name="ServerBackupPasswordBox"
                                             Height="34"
                                             Margin="0,0,0,10"
                                             Style="{StaticResource App.InputPasswordBox}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button ToolTip="{loc:T ui.tip.ExportServerConfigButton}" Content="Export…"
                                            Height="34"
                                            Padding="14,0"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource App.Button.Ghost}"
                                            Click="ExportServerConfigButton_Click" />
                                    <Button ToolTip="{loc:T ui.tip.ImportServerConfigButton}" Content="Import…"
                                            Height="34"
                                            Padding="14,0"
                                            Style="{StaticResource App.Button.Primary}"
                                            Click="ImportServerConfigButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Settings.ToolbarCard}" Background="{StaticResource Surface.Input}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Host" Grid.Row="0" Foreground="{StaticResource Text.Muted}" FontSize="11" Margin="0,0,0,8" />
                                <TextBlock x:Name="PreviewHostText" Grid.Row="0" Grid.Column="1" Foreground="{StaticResource Text.Primary}" FontWeight="SemiBold" FontSize="12" Text="-" />
                                <TextBlock Text="Protocol" Grid.Row="1" Foreground="{StaticResource Text.Muted}" FontSize="11" Margin="0,0,0,8" />
                                <TextBlock x:Name="PreviewProtocolText" Grid.Row="1" Grid.Column="1" Foreground="{StaticResource Text.Secondary}" FontSize="12" Text="-" />
                                <TextBlock Text="User" Grid.Row="2" Foreground="{StaticResource Text.Muted}" FontSize="11" Margin="0,0,0,8" />
                                <TextBlock x:Name="PreviewUserText" Grid.Row="2" Grid.Column="1" Foreground="{StaticResource Text.Secondary}" FontSize="12" Text="-" />
                                <TextBlock Text="Root path" Grid.Row="3" Foreground="{StaticResource Text.Muted}" FontSize="11" />
                                <TextBlock x:Name="PreviewPathText" Grid.Row="3" Grid.Column="1" Foreground="{StaticResource Status.Success}" FontSize="12" Text="-" />
                            </Grid>
                        </Border>

                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Accent.Soft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path behaviors:AppIcon.Kind="sliders" behaviors:AppIcon.Size="16" TextElement.Foreground="{DynamicResource Text.Secondary}" />
                                    </Border>
                                    <TextBlock Text="Setup wizard &amp; recovery" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <Button ToolTip="{loc:T ui.tip.ReSetupButton}" x:Name="ReSetupButton"
                                        Content="Re-run setup wizard"
                                        Height="34"
                                        HorizontalAlignment="Left"
                                        Padding="14,0"
                                        Style="{StaticResource App.Button.Ghost}"
                                        Click="ReSetupButton_Click" />
                                <Border Background="{StaticResource Status.InfoSurface}"
                                        BorderBrush="{StaticResource Border.Subtle}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Reinitialize project setup"
                                                   Foreground="{StaticResource Status.Info}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13" />
                                        <TextBlock Text="Remove setup artifacts, then run the wizard cleanly."
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,10" />
                                        <CheckBox x:Name="ResetGitInSettingsCheckBox" Content="Remove .git folder" Foreground="{StaticResource Text.Primary}" FontSize="12" Margin="0,0,0,6" />
                                        <CheckBox x:Name="ResetConfigInSettingsCheckBox" Content="Remove .gitdeploy.config" Foreground="{StaticResource Text.Primary}" FontSize="12" Margin="0,0,0,10" />
                                        <Button ToolTip="{loc:T ui.tip.ResetAndRunSetupButton}" x:Name="ResetAndRunSetupButton"
                                                Content="Reset and run wizard"
                                                Height="34"
                                                HorizontalAlignment="Left"
                                                Padding="14,0"
                                                Style="{StaticResource App.Button.Danger}"
                                                Click="ResetAndRunSetupButton_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- GIT -->
                    <StackPanel x:Name="SettingsPanelGit" Visibility="Collapsed">
                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Accent.Soft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path behaviors:AppIcon.Kind="git-branch" behaviors:AppIcon.Size="16" TextElement.Foreground="{DynamicResource Accent.Primary}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Git configuration" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Remote, branches, and deploy automation"
                                                   FontSize="10"
                                                   Foreground="{StaticResource Text.Muted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Text="Remote repository URL (origin)" Margin="0,0,0,6" Style="{StaticResource App.MutedTextStyle}" FontSize="11" />
                                <TextBox x:Name="RemoteUrlTextBox"
                                         Style="{StaticResource App.InputTextBox}"
                                         Foreground="{StaticResource Status.Info}"
                                         Margin="0,0,0,10" />
                                <TextBlock Text="SSH private key (for git@ remotes)"
                                           Margin="0,0,0,6"
                                           Style="{StaticResource App.MutedTextStyle}"
                                           FontSize="11" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SshKeyPathTextBox"
                                             Grid.Column="0"
                                             Style="{StaticResource App.InputTextBox}"
                                             VerticalAlignment="Center" />
                                    <Button ToolTip="{loc:T ui.tip.BrowseSshKeyButton}" Grid.Column="1"
                                            Content="Browse"
                                            Height="32"
                                            Padding="12,0"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource App.Button.Ghost}"
                                            Click="BrowseSshKeyButton_Click" />
                                    <Button ToolTip="{loc:T ui.tip.TestSshKeyButton}" Grid.Column="2"
                                            Content="Test"
                                            Height="32"
                                            Padding="12,0"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource App.Button.Ghost}"
                                            Click="TestSshKeyButton_Click" />
                                </Grid>
                                <Button ToolTip="{loc:T ui.tip.OpenSshKeyHelperButton}" Content="Open SSH key helper"
                                        Height="30"
                                        HorizontalAlignment="Left"
                                        Padding="12,0"
                                        Margin="0,0,0,10"
                                        Style="{StaticResource App.Button.Ghost}"
                                        Click="OpenSshKeyHelperButton_Click" />
                                <Border x:Name="GitPushStatusBadge"
                                        Style="{StaticResource App.StatusBadge.Warning}"
                                        Margin="0,0,0,10"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Accent.Soft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Path behaviors:AppIcon.Kind="cloud" behaviors:AppIcon.Size="16" TextElement.Foreground="{DynamicResource Status.Warning}" />
                                        </Border>
                                        <TextBlock x:Name="GitPushStatusText"
                                                   Text="Pending push"
                                                   FontSize="12"
                                                   Foreground="{StaticResource Status.Warning}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Default source branch" Margin="0,0,0,6" Style="{StaticResource App.MutedTextStyle}" FontSize="11" />
                                        <ComboBox x:Name="DefaultSourceBranchComboBox" Height="36" Style="{StaticResource App.InputComboBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Default target branch" Margin="0,0,0,6" Style="{StaticResource App.MutedTextStyle}" FontSize="11" />
                                        <ComboBox x:Name="DefaultTargetBranchComboBox" Height="36" Style="{StaticResource App.InputComboBox}" />
                                    </StackPanel>
                                </Grid>
                                <Button ToolTip="{loc:T ui.tip.RefreshBranchesButton}" x:Name="RefreshBranchesButton"
                                        Content="Refresh branches"
                                        Height="30"
                                        HorizontalAlignment="Left"
                                        Padding="12,0"
                                        Margin="0,0,0,12"
                                        Style="{StaticResource App.Button.Ghost}"
                                        Click="RefreshBranchesButton_Click" />
                                <CheckBox x:Name="AutoInitGitCheckBox" Content="Auto-init Git if not exists" IsChecked="True" Foreground="{StaticResource Text.Secondary}" FontSize="12" Margin="0,3" />
                                <CheckBox x:Name="AutoCommitCheckBox" Content="Auto-commit before deploy" IsChecked="True" Foreground="{StaticResource Text.Secondary}" FontSize="12" Margin="0,3" />
                                <CheckBox x:Name="AutoPushCheckBox" Content="Auto-push after deploy" IsChecked="False" Foreground="{StaticResource Text.Secondary}" FontSize="12" Margin="0,3" />
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="{loc:T settings.deployDefaultWorkers}"
                                               FontSize="11"
                                               Foreground="{StaticResource Text.Muted}"
                                               Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="DeployDefaultWorkersTextBox"
                                                 Width="52"
                                                 Height="32"
                                                 MaxLength="1"
                                                 VerticalContentAlignment="Center"
                                                 HorizontalContentAlignment="Center"
                                                 Style="{StaticResource App.InputTextBox}" />
                                        <TextBlock Text="{loc:T settings.deployDefaultWorkersHint}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource Text.Muted}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"
                                                   MaxWidth="420" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Accent.Soft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path behaviors:AppIcon.Kind="x-circle" behaviors:AppIcon.Size="16" TextElement.Foreground="{DynamicResource Text.Secondary}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Ignored files" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="This project's .gitignore only — Add/Remove from Direct Upload stays in sync"
                                                   FontSize="10"
                                                   Foreground="{StaticResource Text.Muted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <ItemsControl x:Name="IgnorePatternItemsControl"
                                              Margin="0,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Surface.Raised}"
                                                    BorderBrush="{StaticResource Border.Subtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10,6"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding}"
                                                               VerticalAlignment="Center"
                                                               FontFamily="{StaticResource FontFamily.Mono}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource Log.Success}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Button ToolTip="{loc:T ui.tip.RemoveIgnorePattern}" Grid.Column="1"
                                                            Content="Remove"
                                                            Height="28"
                                                            MinWidth="78"
                                                            Padding="10,0"
                                                            Margin="8,0,0,0"
                                                            Tag="{Binding}"
                                                            Style="{StaticResource App.Button.Ghost}"
                                                            Click="RemoveIgnorePattern_Click" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="IgnorePatternEmptyText"
                                           Text="No ignore lines in this project."
                                           FontSize="11"
                                           Foreground="{StaticResource Text.Muted}"
                                           Margin="0,0,0,10"
                                           Visibility="Collapsed" />
                                <TextBox x:Name="ExcludePatternsTextBox"
                                         Style="{StaticResource App.InputTextBox.Multiline}"
                                         MinHeight="160"
                                         VerticalScrollBarVisibility="Auto"
                                         Foreground="{StaticResource Log.Success}"
                                         FontFamily="{StaticResource FontFamily.Mono}"
                                         FontSize="12"
                                         LostFocus="ExcludePatternsTextBox_LostFocus" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- VPN -->
                    <StackPanel x:Name="SettingsPanelVpn" Visibility="Collapsed">
                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Accent.Soft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path behaviors:AppIcon.Kind="globe" behaviors:AppIcon.Size="16" TextElement.Foreground="{DynamicResource Accent.Primary}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{loc:T vpn.title}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{loc:T vpn.subtitle}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource Text.Muted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <CheckBox x:Name="VpnEnabledCheckBox"
                                          Content="{loc:T vpn.enabled}"
                                          Foreground="{StaticResource Text.Secondary}"
                                          FontSize="12"
                                          Margin="0,0,0,10" />
                                <TextBlock Text="{loc:T vpn.provider}" Margin="0,0,0,6" Style="{StaticResource App.MutedTextStyle}" FontSize="11" />
                                <ComboBox x:Name="VpnProviderCombo"
                                          Height="34"
                                          SelectionChanged="VpnProviderCombo_SelectionChanged">
                                    <ComboBoxItem Content="OpenVPN Connect" Tag="OpenVpnConnect" />
                                    <ComboBoxItem Content="OpenVPN GUI (Community)" Tag="OpenVpn" />
                                </ComboBox>

                                <TextBlock x:Name="VpnExePathLabel"
                                           Text="{loc:T vpn.exePath}"
                                           Margin="0,12,0,6"
                                           Style="{StaticResource App.MutedTextStyle}"
                                           FontSize="11" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="VpnGuiPathTextBox"
                                             Style="{StaticResource App.InputTextBox}"
                                             mah:TextBoxHelper.Watermark="C:\Program Files\OpenVPN Connect\OpenVPNConnect.exe" />
                                    <Button ToolTip="{loc:T ui.tip.VpnDetectButton}" Grid.Column="1"
                                            Content="{loc:T vpn.detect}"
                                            Height="34"
                                            MinWidth="88"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource App.Button.Ghost}"
                                            Click="VpnDetectButton_Click" />
                                </Grid>

                                <TextBlock Text="{loc:T vpn.profile}" Margin="0,12,0,6" Style="{StaticResource App.MutedTextStyle}" FontSize="11" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="VpnProfileCombo"
                                              Height="34"
                                              SelectedValuePath="Name">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayLabel}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button ToolTip="{loc:T ui.tip.VpnRefreshProfilesButton}" Grid.Column="1"
                                            Content="{loc:T vpn.refreshProfiles}"
                                            Height="34"
                                            MinWidth="88"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource App.Button.Ghost}"
                                            Click="VpnRefreshProfilesButton_Click" />
                                </Grid>

                                <CheckBox x:Name="VpnConnectOnStartupCheckBox"
                                          Content="{loc:T vpn.connectOnStartup}"
                                          Foreground="{StaticResource Text.Secondary}"
                                          FontSize="12"
                                          Margin="0,12,0,0" />
                                <CheckBox x:Name="VpnAutoReconnectCheckBox"
                                          Content="{loc:T vpn.autoReconnect}"
                                          Foreground="{StaticResource Text.Secondary}"
                                          FontSize="12"
                                          Margin="0,8,0,0" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="{loc:T vpn.healthInterval}" Margin="0,0,0,6" Style="{StaticResource App.MutedTextStyle}" FontSize="11" />
                                        <TextBox x:Name="VpnHealthIntervalTextBox"
                                                 Style="{StaticResource App.InputTextBox}"
                                                 Text="30" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="{loc:T vpn.maxAttempts}" Margin="0,0,0,6" Style="{StaticResource App.MutedTextStyle}" FontSize="11" />
                                        <TextBox x:Name="VpnMaxAttemptsTextBox"
                                                 Style="{StaticResource App.InputTextBox}"
                                                 mah:TextBoxHelper.Watermark="0 = unlimited"
                                                 Text="0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{loc:T vpn.probeHost}" Margin="0,12,0,6" Style="{StaticResource App.MutedTextStyle}" FontSize="11" />
                                <TextBox x:Name="VpnProbeHostTextBox"
                                         Style="{StaticResource App.InputTextBox}"
                                         mah:TextBoxHelper.Watermark="optional e.g. 10.8.0.1" />

                                <WrapPanel Margin="0,14,0,8">
                                    <Button ToolTip="{loc:T ui.tip.VpnConnectButton}" Content="{loc:T vpn.connect}"
                                            Height="32"
                                            MinWidth="96"
                                            Margin="0,0,8,8"
                                            Style="{StaticResource App.Button.Primary}"
                                            Click="VpnConnectButton_Click" />
                                    <Button ToolTip="{loc:T ui.tip.VpnDisconnectButton}" Content="{loc:T vpn.disconnect}"
                                            Height="32"
                                            MinWidth="96"
                                            Margin="0,0,8,8"
                                            Style="{StaticResource App.Button.Ghost}"
                                            Click="VpnDisconnectButton_Click" />
                                    <Button ToolTip="{loc:T ui.tip.VpnReconnectButton}" Content="{loc:T vpn.reconnect}"
                                            Height="32"
                                            MinWidth="96"
                                            Margin="0,0,8,8"
                                            Style="{StaticResource App.Button.Ghost}"
                                            Click="VpnReconnectButton_Click" />
                                    <Button ToolTip="{loc:T ui.tip.VpnSaveButton}" Content="{loc:T vpn.save}"
                                            Height="32"
                                            MinWidth="96"
                                            Margin="0,0,0,8"
                                            Style="{StaticResource App.Button.Secondary}"
                                            Click="VpnSaveButton_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="VpnStatusText"
                                           FontSize="11"
                                           Foreground="{StaticResource Text.Muted}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T vpn.statusIdle}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- TELEGRAM -->
                    <StackPanel x:Name="SettingsPanelTelegram" Visibility="Collapsed">
                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Accent.Soft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path behaviors:AppIcon.Kind="chat" behaviors:AppIcon.Size="16" TextElement.Foreground="{DynamicResource Accent.Primary}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Telegram bot" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Long-poll while GitDeploy is running. Each project is a separate chat."
                                                   FontSize="10"
                                                   Foreground="{StaticResource Text.Muted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <CheckBox x:Name="TelegramEnabledCheckBox"
                                          Content="Enable Telegram polling"
                                          Foreground="{StaticResource Text.Secondary}"
                                          FontSize="12"
                                          Margin="0,0,0,14" />

                                <TextBlock Text="Bot token" Margin="0,0,0,6" Style="{StaticResource App.MutedTextStyle}" FontSize="11" />
                                <PasswordBox x:Name="TelegramTokenBox"
                                             Height="34"
                                             PasswordChanged="TelegramTokenBox_PasswordChanged" />
                                <TextBlock x:Name="TelegramTokenHint"
                                           Margin="0,6,0,14"
                                           FontSize="11"
                                           Foreground="{StaticResource Text.Muted}"
                                           TextWrapping="Wrap" />

                                <TextBlock Text="Allowed user ids" Margin="0,0,0,6" Style="{StaticResource App.MutedTextStyle}" FontSize="11" />
                                <TextBox x:Name="TelegramAllowedIdsTextBox"
                                         Style="{StaticResource App.InputTextBox}"
                                         mah:TextBoxHelper.Watermark="123456789, 987654321" />
                                <TextBlock Text="Only these Telegram user ids can send. Get yours from @userinfobot."
                                           Margin="0,6,0,14"
                                           FontSize="11"
                                           Foreground="{StaticResource Text.Muted}"
                                           TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button ToolTip="{loc:T ui.tip.TelegramTestButton}" Content="Test connection"
                                            Height="32"
                                            MinWidth="120"
                                            Style="{StaticResource App.Button.Ghost}"
                                            Click="TelegramTestButton_Click" />
                                    <Button ToolTip="{loc:T ui.tip.TelegramSaveButton}" Content="Save Telegram"
                                            Height="32"
                                            MinWidth="120"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource App.Button.Primary}"
                                            Click="TelegramSaveButton_Click" />
                                </StackPanel>
                                <TextBlock x:Name="TelegramStatusText"
                                           FontSize="11"
                                           Foreground="{StaticResource Text.Muted}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="True" Margin="0,12,0,0">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Accent.Soft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path behaviors:AppIcon.Kind="key" behaviors:AppIcon.Size="16" TextElement.Foreground="{DynamicResource Accent.Primary}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Telegram terminal presets" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Project-scoped inline buttons (trusted commands with &amp;&amp;, sudo, restart)."
                                                   FontSize="10"
                                                   Foreground="{StaticResource Text.Muted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander.Header>
                            <controls:TelegramTerminalCommandsPanel x:Name="TelegramTerminalCommandsPanel" />
                        </Expander>
                    </StackPanel>

                    <!-- AI AGENT -->
                    <StackPanel x:Name="SettingsPanelAiAgent" Visibility="Collapsed">
                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Accent.Soft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path behaviors:AppIcon.Kind="cpu" behaviors:AppIcon.Size="16" TextElement.Foreground="{DynamicResource Accent.Primary}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock x:Name="AgentEngineSectionTitle" Text="Default engine" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock x:Name="AgentEngineSectionHint" Text="Telegram /engine can override this anytime." FontSize="10" Foreground="{StaticResource Text.Muted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <ComboBox x:Name="AgentEngineComboBox" Height="34" Style="{StaticResource App.InputComboBox}">
                                    <ComboBoxItem Content="Cursor" Tag="cursor" IsSelected="True" />
                                    <ComboBoxItem Content="Claude Code" Tag="claude" />
                                </ComboBox>

                                <CheckBox x:Name="TelegramQuietProgressCheckBox"
                                          Content="Telegram quiet progress (Still working every 30s — hide edit/thinking on Telegram)"
                                          Foreground="{StaticResource Text.Secondary}"
                                          FontSize="12"
                                          Margin="0,14,0,4" />
                                <TextBlock Text="Applies to all engines (Cursor and Claude). Unchecked = tool/thinking lines on Telegram. Checked = only a short Still working ping every 30 seconds. In-app chat still shows full progress."
                                           Margin="24,0,0,4"
                                           FontSize="11"
                                           Foreground="{StaticResource Text.Muted}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>

<Expander Style="{StaticResource Settings.Expander}" IsExpanded="True" Margin="0,12,0,0">
                            <Expander.Header>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Accent.Soft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Path behaviors:AppIcon.Kind="code" behaviors:AppIcon.Size="16" TextElement.Foreground="{DynamicResource Accent.Primary}" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Cursor agent" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Forward real chat messages to Cursor CLI (agent -p --force --trust)."
                                                       FontSize="10"
                                                       Foreground="{StaticResource Text.Muted}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <StackPanel>
                                <CheckBox x:Name="CursorAgentEnabledCheckBox"
                                          Content="Enable Cursor bridge for project chats"
                                          Foreground="{StaticResource Text.Secondary}"
                                          FontSize="12"
                                          Margin="0,0,0,10" />

                                <TextBlock FontSize="11"
                                           Margin="0,0,0,12"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource Text.Muted}">
                                    <Run Text="Guide: " />
                                    <Hyperlink NavigateUri="https://cursor.com/docs/cli/overview"
                                               RequestNavigate="CursorDocsLink_RequestNavigate">
                                        <Run Text="cursor.com/docs/cli/overview" Foreground="{StaticResource Accent.Primary}" />
                                    </Hyperlink>
                                </TextBlock>

                                <TextBlock Text="Agent executable (optional)" Margin="0,0,0,6" Style="{StaticResource App.MutedTextStyle}" FontSize="11" />
                                <TextBox x:Name="CursorAgentPathTextBox"
                                         Style="{StaticResource App.InputTextBox}"
                                         mah:TextBoxHelper.Watermark="Leave empty to auto-detect agent / cursor-agent" />
                                <TextBlock Text="On Windows GitDeploy can install Cursor CLI for you, or paste the full path to agent.exe."
                                           Margin="0,6,0,14"
                                           FontSize="11"
                                           Foreground="{StaticResource Text.Muted}"
                                           TextWrapping="Wrap" />

                                <TextBlock Text="Model (optional)" Margin="0,0,0,6" Style="{StaticResource App.MutedTextStyle}" FontSize="11" />
                                <TextBox x:Name="CursorAgentModelTextBox"
                                         Style="{StaticResource App.InputTextBox}"
                                         mah:TextBoxHelper.Watermark="e.g. composer-2.5" />

                                <TextBlock Text="Turn timeout (minutes)" Margin="0,14,0,6" Style="{StaticResource App.MutedTextStyle}" FontSize="11" />
                                <TextBox x:Name="CursorAgentTurnTimeoutMinutesTextBox"
                                         Style="{StaticResource App.InputTextBox}"
                                         Width="120"
                                         HorizontalAlignment="Left"
                                         mah:TextBoxHelper.Watermark="30" />
                                <TextBlock Text="How long one Cursor turn (Build / chat) may run before GitDeploy stops it. Default 30. Allowed 5–180."
                                           Margin="0,6,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource Text.Muted}"
                                           TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,10">
                                    <Button ToolTip="{loc:T ui.tip.CursorInstallButton}" x:Name="CursorInstallButton"
                                            Content="Install CLI"
                                            Height="32"
                                            MinWidth="120"
                                            Style="{StaticResource App.Button.Primary}"
                                            Click="CursorInstallButton_Click" />
                                    <Button ToolTip="{loc:T ui.tip.CursorDetectButton}" Content="Detect agent"
                                            Height="32"
                                            MinWidth="120"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource App.Button.Ghost}"
                                            Click="CursorDetectButton_Click" />
                                    <Button ToolTip="{loc:T ui.tip.CursorSaveButton}" Content="Save Cursor"
                                            Height="32"
                                            MinWidth="120"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource App.Button.Ghost}"
                                            Click="CursorSaveButton_Click" />
                                    <Button ToolTip="{loc:T ui.tip.CursorHelpButton}" Content="Login &amp; Test"
                                            Height="32"
                                            MinWidth="120"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource App.Button.Ghost}"
                                            Click="CursorHelpButton_Click" />
                                </StackPanel>
                                <TextBlock x:Name="CursorStatusText"
                                           FontSize="11"
                                           Foreground="{StaticResource Text.Muted}"
                                           TextWrapping="Wrap" />

                                <Border Margin="0,16,0,0"
                                        Padding="12"
                                        Background="{StaticResource Surface.Card}"
                                        BorderBrush="{StaticResource Border.Subtle}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Text="Cursor disk cleanup"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="{StaticResource Text.Primary}" />
                                        <TextBlock x:Name="CursorDiskSummaryText"
                                                   Margin="0,6,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Text.Muted}"
                                                   TextWrapping="Wrap"
                                                   Text="—" />
                                        <TextBlock Margin="0,6,0,10"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Text.Muted}"
                                                   TextWrapping="Wrap"
                                                   Text="Safe frees backup DB + old agent CLI + UI caches. Never deletes live state.vscdb (chats). Also available in Telegram: /cursorcache" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button ToolTip="{loc:T ui.tip.CursorDiskRefresh}" Content="Refresh"
                                                    Height="32"
                                                    MinWidth="100"
                                                    Style="{StaticResource App.Button.Ghost}"
                                                    Click="CursorDiskRefresh_Click" />
                                            <Button ToolTip="{loc:T ui.tip.CursorDiskSafeClear}" Content="Safe clear"
                                                    Height="32"
                                                    MinWidth="120"
                                                    Margin="8,0,0,0"
                                                    Style="{StaticResource App.Button.Primary}"
                                                    Click="CursorDiskSafeClear_Click" />
                                            <Button ToolTip="{loc:T ui.tip.CursorDiskAggressiveClear}" Content="Aggressive"
                                                    Height="32"
                                                    MinWidth="110"
                                                    Margin="8,0,0,0"
                                                    Style="{StaticResource App.Button.Ghost}"
                                                    Click="CursorDiskAggressiveClear_Click" />
                                        </StackPanel>
                                        <TextBlock x:Name="CursorDiskResultText"
                                                   Margin="0,8,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Text.Muted}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,16,0,0"
                                        Padding="12"
                                        Background="{StaticResource Surface.Card}"
                                        BorderBrush="{StaticResource Border.Subtle}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Text="Cursor chats by project"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="{StaticResource Text.Primary}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="10"
                                                   Foreground="{StaticResource Text.Muted}"
                                                   TextWrapping="Wrap"
                                                   Text="Only deletes old chat rows (composerHeaders + chat KV). Never touches login / cursorAuth / secrets in ItemTable." />
                                        <TextBlock x:Name="CursorChatsSummaryText"
                                                   Margin="0,6,0,8"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Text.Muted}"
                                                   TextWrapping="Wrap"
                                                   Text="—" />

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="Delete older than"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="{StaticResource Text.Secondary}"
                                                       Margin="0,0,8,0" />
                                            <ComboBox x:Name="CursorChatsDaysCombo"
                                                      Width="110"
                                                      Height="32"
                                                      Style="{StaticResource App.InputComboBox}"
                                                      SelectionChanged="CursorChatsDaysCombo_SelectionChanged">
                                                <ComboBoxItem Content="7 days" Tag="7" IsSelected="True" />
                                                <ComboBoxItem Content="14 days" Tag="14" />
                                                <ComboBoxItem Content="30 days" Tag="30" />
                                                <ComboBoxItem Content="90 days" Tag="90" />
                                            </ComboBox>
                                            <CheckBox x:Name="CursorChatsVacuumCheck"
                                                      Content="Compact DB (VACUUM)"
                                                      Margin="14,0,0,0"
                                                      VerticalAlignment="Center"
                                                      FontSize="11"
                                                      Foreground="{StaticResource Text.Secondary}"
                                                      IsChecked="False"
                                                      ToolTip="Optional. Shrinks state.vscdb after delete. Slow on large DBs; needed to reclaim freelist GB." />
                                            <CheckBox x:Name="CursorChatsPurgeOrphansCheck"
                                                      Content="Purge orphan blobs"
                                                      Margin="14,0,0,0"
                                                      VerticalAlignment="Center"
                                                      FontSize="11"
                                                      Foreground="{StaticResource Text.Secondary}"
                                                      IsChecked="True"
                                                      ToolTip="Deletes agentKv:blob / composer.content hashes not referenced anymore. This is usually most of the 10–20GB bloat." />
                                        </StackPanel>

                                        <ListView x:Name="CursorChatsList"
                                                  Height="200"
                                                  BorderBrush="{StaticResource Border.Subtle}"
                                                  BorderThickness="1"
                                                  Background="{StaticResource Surface.Input}"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Width="36">
                                                        <GridViewColumn.Header>
                                                            <CheckBox x:Name="CursorChatsSelectAll"
                                                                      Click="CursorChatsSelectAll_Click"
                                                                      ToolTip="Select / clear all" />
                                                        </GridViewColumn.Header>
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                          VerticalAlignment="Center" />
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Project" Width="180" DisplayMemberBinding="{Binding DisplayName}" />
                                                    <GridViewColumn Header="Chats" Width="55" DisplayMemberBinding="{Binding ChatCount}" />
                                                    <GridViewColumn Header="Old" Width="50" DisplayMemberBinding="{Binding OlderThanDaysCount}" />
                                                    <GridViewColumn Header="Last activity" Width="125" DisplayMemberBinding="{Binding NewestLocal}" />
                                                </GridView>
                                            </ListView.View>
                                        </ListView>

                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button ToolTip="{loc:T ui.tip.CursorChatsRefresh}" x:Name="CursorChatsRefreshBtn"
                                                    Content="Refresh chats"
                                                    Height="32"
                                                    MinWidth="110"
                                                    Style="{StaticResource App.Button.Ghost}"
                                                    Click="CursorChatsRefresh_Click" />
                                            <Button ToolTip="{loc:T ui.tip.CursorChatsDeleteOld}" x:Name="CursorChatsDeleteBtn"
                                                    Content="Delete old chats"
                                                    Height="32"
                                                    MinWidth="140"
                                                    Margin="8,0,0,0"
                                                    Style="{StaticResource App.Button.Primary}"
                                                    Click="CursorChatsDeleteOld_Click" />
                                        </StackPanel>
                                        <ProgressBar x:Name="CursorChatsProgress"
                                                     Height="8"
                                                     Margin="0,10,0,0"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="0"
                                                     Visibility="Collapsed" />
                                        <TextBlock x:Name="CursorChatsProgressText"
                                                   Margin="0,6,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   TextWrapping="Wrap"
                                                   Visibility="Collapsed" />
                                        <TextBlock x:Name="CursorChatsResultText"
                                                   Margin="0,8,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Text.Muted}"
                                                   TextWrapping="Wrap" />

                                        <Border Margin="0,14,0,0"
                                                Padding="10"
                                                Background="{StaticResource Surface.Input}"
                                                BorderBrush="{StaticResource Border.Subtle}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <StackPanel>
                                                <CheckBox x:Name="CursorAutoCleanEnabledCheck"
                                                          Content="Auto-clean daily (while GitDeployPro is open)"
                                                          FontSize="11"
                                                          FontWeight="SemiBold"
                                                          Foreground="{StaticResource Text.Primary}"
                                                          Checked="CursorAutoClean_Changed"
                                                          Unchecked="CursorAutoClean_Changed" />
                                                <TextBlock Margin="0,4,0,8"
                                                           FontSize="10"
                                                           Foreground="{StaticResource Text.Muted}"
                                                           TextWrapping="Wrap"
                                                           Text="Runs once per day at the time below (next run shown under Run now). Enabling does NOT run immediately. Skips if Cursor is open unless Force-quit is on — Force-quit closes Cursor only at the scheduled time." />

                                                <WrapPanel Orientation="Horizontal">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                                                        <TextBlock Text="Older than"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource Text.Secondary}"
                                                                   Margin="0,0,6,0" />
                                                        <ComboBox x:Name="CursorAutoCleanDaysCombo"
                                                                  Width="100"
                                                                  Height="30"
                                                                  Style="{StaticResource App.InputComboBox}"
                                                                  SelectionChanged="CursorAutoClean_Changed">
                                                            <ComboBoxItem Content="7 days" Tag="7" />
                                                            <ComboBoxItem Content="14 days" Tag="14" />
                                                            <ComboBoxItem Content="30 days" Tag="30" IsSelected="True" />
                                                            <ComboBoxItem Content="90 days" Tag="90" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                                                        <TextBlock Text="Time"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource Text.Secondary}"
                                                                   Margin="0,0,6,0" />
                                                        <TextBox x:Name="CursorAutoCleanTimeBox"
                                                                 Width="64"
                                                                 Height="30"
                                                                 Text="03:30"
                                                                 VerticalContentAlignment="Center"
                                                                 Style="{StaticResource App.InputTextBox}"
                                                                 LostFocus="CursorAutoClean_Changed" />
                                                    </StackPanel>
                                                    <CheckBox x:Name="CursorAutoCleanOrphansCheck"
                                                              Content="Orphans"
                                                              Margin="0,0,12,6"
                                                              VerticalAlignment="Center"
                                                              FontSize="11"
                                                              Foreground="{StaticResource Text.Secondary}"
                                                              IsChecked="True"
                                                              Checked="CursorAutoClean_Changed"
                                                              Unchecked="CursorAutoClean_Changed" />
                                                    <CheckBox x:Name="CursorAutoCleanVacuumCheck"
                                                              Content="VACUUM"
                                                              Margin="0,0,12,6"
                                                              VerticalAlignment="Center"
                                                              FontSize="11"
                                                              Foreground="{StaticResource Text.Secondary}"
                                                              IsChecked="True"
                                                              Checked="CursorAutoClean_Changed"
                                                              Unchecked="CursorAutoClean_Changed" />
                                                    <CheckBox x:Name="CursorAutoCleanDiskCheck"
                                                              Content="Cache + backups"
                                                              Margin="0,0,12,6"
                                                              VerticalAlignment="Center"
                                                              FontSize="11"
                                                              Foreground="{StaticResource Text.Secondary}"
                                                              IsChecked="True"
                                                              Checked="CursorAutoClean_Changed"
                                                              Unchecked="CursorAutoClean_Changed" />
                                                    <CheckBox x:Name="CursorAutoCleanForceQuitCheck"
                                                              Content="Force-quit Cursor"
                                                              Margin="0,0,12,6"
                                                              VerticalAlignment="Center"
                                                              FontSize="11"
                                                              Foreground="{StaticResource Text.Secondary}"
                                                              IsChecked="False"
                                                              Checked="CursorAutoClean_Changed"
                                                              Unchecked="CursorAutoClean_Changed" />
                                                </WrapPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Button ToolTip="{loc:T ui.tip.CursorAutoCleanRunNow}" x:Name="CursorAutoCleanRunNowBtn"
                                                            Content="Run now"
                                                            Height="30"
                                                            MinWidth="90"
                                                            Style="{StaticResource App.Button.Ghost}"
                                                            Click="CursorAutoCleanRunNow_Click" />
                                                    <TextBlock x:Name="CursorAutoCleanStatusText"
                                                               Margin="12,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="10"
                                                               Foreground="{StaticResource Text.Muted}"
                                                               TextWrapping="Wrap"
                                                               Text="—" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="True" Margin="0,12,0,0">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Accent.Soft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path behaviors:AppIcon.Kind="cpu" behaviors:AppIcon.Size="16" TextElement.Foreground="{DynamicResource Accent.Primary}" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Claude Code agent" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Forward real chat messages to Claude Code CLI (claude -p, stream-json)."
                                                   FontSize="10"
                                                   Foreground="{StaticResource Text.Muted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <CheckBox x:Name="ClaudeAgentEnabledCheckBox"
                                          Content="Enable Claude Code bridge for project chats"
                                          Foreground="{StaticResource Text.Secondary}"
                                          FontSize="12"
                                          Margin="0,0,0,10" />
                                <TextBlock FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{StaticResource Text.Muted}">
                                    <Run Text="Install with npm, run " />
                                    <Run Text="claude" FontFamily="Consolas" />
                                    <Run Text=" once in a terminal to log in, then pick Claude as the engine above. Guide: " />
                                    <Hyperlink NavigateUri="https://docs.claude.com/en/docs/claude-code/overview"
                                               RequestNavigate="CursorDocsLink_RequestNavigate">
                                        <Run Text="Claude Code docs" Foreground="{StaticResource Accent.Primary}" />
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock Text="Claude executable (optional)" Margin="0,0,0,6" Style="{StaticResource App.MutedTextStyle}" FontSize="11" />
                                <TextBox x:Name="ClaudeCliPathTextBox" Style="{StaticResource App.InputTextBox}"
                                         mah:TextBoxHelper.Watermark="Leave empty to auto-detect claude" />
                                <TextBlock Text="Model (optional)" Margin="0,14,0,6" Style="{StaticResource App.MutedTextStyle}" FontSize="11" />
                                <TextBox x:Name="ClaudeAgentModelTextBox" Style="{StaticResource App.InputTextBox}"
                                         mah:TextBoxHelper.Watermark="sonnet | opus | haiku — empty = Claude Code default" />
                                <TextBlock Text="Permission mode" Margin="0,14,0,6" Style="{StaticResource App.MutedTextStyle}" FontSize="11" />
                                <ComboBox x:Name="ClaudePermissionModeComboBox" Height="34" Style="{StaticResource App.InputComboBox}">
                                    <ComboBoxItem Content="Bypass permissions (full access, unattended)" Tag="bypassPermissions" IsSelected="True" />
                                    <ComboBoxItem Content="Accept edits (file edits only)" Tag="acceptEdits" />
                                </ComboBox>
                                <TextBlock Text="Max minutes per turn (5-180)" Margin="0,14,0,6" Style="{StaticResource App.MutedTextStyle}" FontSize="11" />
                                <TextBox x:Name="ClaudeTurnTimeoutTextBox" Style="{StaticResource App.InputTextBox}" MaxWidth="120" HorizontalAlignment="Left" />
                                <WrapPanel Orientation="Horizontal" Margin="0,16,0,10">
                                    <Button ToolTip="{loc:T ui.tip.ClaudeInstallButton}" Content="Install CLI"
                                            Height="32"
                                            MinWidth="110"
                                            Margin="0,0,8,8"
                                            Style="{StaticResource App.Button.Primary}"
                                            Click="ClaudeInstallButton_Click" />
                                    <Button ToolTip="{loc:T ui.tip.ClaudeDetectButton}" Content="Detect Claude"
                                            Height="32"
                                            MinWidth="110"
                                            Margin="0,0,8,8"
                                            Style="{StaticResource App.Button.Ghost}"
                                            Click="ClaudeDetectButton_Click" />
                                    <Button ToolTip="{loc:T ui.tip.ClaudeSaveButton}" Content="Save Claude"
                                            Height="32"
                                            MinWidth="110"
                                            Margin="0,0,8,8"
                                            Style="{StaticResource App.Button.Ghost}"
                                            Click="ClaudeSaveButton_Click" />
                                    <Button ToolTip="{loc:T ui.tip.ClaudeHelpButton}" Content="Login &amp; Test"
                                            Height="32"
                                            MinWidth="120"
                                            Margin="0,0,8,8"
                                            Style="{StaticResource App.Button.Ghost}"
                                            Click="ClaudeHelpButton_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="ClaudeStatusText" FontSize="11" Foreground="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    <!-- THEMES -->
                </Grid>
            </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- Sticky action bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource Surface.Shell}"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,8"
                Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="DirtyDot" Width="8" Height="8" Fill="{DynamicResource Status.Success}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="DirtyStatusText" Text="All changes saved" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                    <TextBlock Text="Changes apply to the current project and global preferences."
                               Foreground="{DynamicResource Text.Muted}"
                               FontSize="11"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button ToolTip="{loc:T ui.tip.DiscardChanges}" x:Name="DiscardChangesButton"
                            Height="34"
                            MinWidth="100"
                            Margin="0,0,8,0"
                            Padding="14,0"
                            Style="{StaticResource App.Button.Ghost}"
                            Click="DiscardChanges_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path behaviors:AppIcon.Kind="undo" behaviors:AppIcon.Size="14" Margin="0,0,8,0" TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Discard" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button ToolTip="{loc:T ui.tip.SaveSettings}" x:Name="SaveSettingsButton"
                            Height="34"
                            MinWidth="140"
                            Padding="14,0"
                            Style="{StaticResource App.Button.Primary}"
                            Click="SaveSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path behaviors:AppIcon.Kind="save" behaviors:AppIcon.Size="14" Margin="0,0,8,0" TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Save settings" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
