<Page x:Class="GitDeployPro.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:controls="clr-namespace:GitDeployPro.Controls"
      xmlns:loc="clr-namespace:GitDeployPro.Services.Localization"
      Title="SettingsPage"
      Background="{StaticResource Surface.Base}">
    <Page.Resources>
        <Style x:Key="Settings.NavButton" TargetType="Button" BasedOn="{StaticResource App.SidebarNavButton}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style x:Key="Settings.NavButton.Active" TargetType="Button" BasedOn="{StaticResource Settings.NavButton}">
            <Setter Property="Background" Value="{StaticResource Surface.Raised}" />
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent.Primary}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Settings.Expander" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
            <Setter Property="Background" Value="{StaticResource Surface.Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <DockPanel>
                                <ToggleButton x:Name="HeaderToggle"
                                              DockPanel.Dock="Top"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="14,12"
                                              Cursor="Hand"
                                              HorizontalContentAlignment="Stretch"
                                              FocusVisualStyle="{x:Null}">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="HeaderBg"
                                                                Background="{TemplateBinding Background}"
                                                                CornerRadius="10,10,0,0"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Stretch"
                                                                              VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="HeaderBg" Property="Background" Value="{StaticResource Surface.Raised}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                                        <Border x:Name="ChevronHost"
                                                Grid.Column="1"
                                                Width="28"
                                                Height="28"
                                                CornerRadius="14"
                                                Background="{StaticResource Surface.Raised}"
                                                BorderBrush="{StaticResource Border.Subtle}"
                                                BorderThickness="1"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                            <Path x:Name="ChevronPath"
                                                  Data="M 0,0 L 5,5 L 10,0"
                                                  Stroke="{StaticResource Text.Secondary}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Width="10"
                                                  Height="6"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="0" />
                                                </Path.RenderTransform>
                                            </Path>
                                        </Border>
                                    </Grid>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite"
                                                  DockPanel.Dock="Bottom"
                                                  Margin="14,0,14,14"
                                                  Visibility="Collapsed" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ChevronPath" Property="Stroke" Value="{StaticResource Accent.Primary}" />
                                <Setter TargetName="ChevronHost" Property="BorderBrush" Value="{StaticResource Accent.Primary}" />
                                <Setter TargetName="ChevronPath" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource Border.Strong}" />
                                <Setter TargetName="ChevronHost" Property="BorderBrush" Value="{StaticResource Accent.Primary}" />
                                <Setter TargetName="ChevronPath" Property="Stroke" Value="{StaticResource Accent.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Settings.ToolbarCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface.Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Page.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header (Deploy-like) -->
        <Border Grid.Row="0"
                Background="{StaticResource Surface.Shell}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="8"
                        Background="{StaticResource Surface.Raised}"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="1"
                        Margin="0,0,10,0">
                    <ui:SymbolIcon Symbol="Settings24"
                                   FontSize="16"
                                   Foreground="{StaticResource Accent.Primary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Settings"
                               Foreground="{StaticResource Text.Primary}"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="SettingsSectionSubtitle"
                               Text="Project path, startup, updates, and danger zone."
                               Foreground="{StaticResource Text.Muted}"
                               FontSize="11" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{StaticResource Surface.Shell}"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8,12"
                    Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="SECTIONS"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource Text.Muted}"
                               Margin="10,0,0,8" />
                    <StackPanel>
                        <Button x:Name="NavGeneralButton"
                                Style="{StaticResource Settings.NavButton.Active}"
                                Click="SettingsNav_Click"
                                Tag="general">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Folder24" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="General" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavServerButton"
                                Style="{StaticResource Settings.NavButton}"
                                Click="SettingsNav_Click"
                                Tag="server">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Cloud24" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Server" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavGitButton"
                                Style="{StaticResource Settings.NavButton}"
                                Click="SettingsNav_Click"
                                Tag="git">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="BranchFork24" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Git" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavTerminalButton"
                                Style="{StaticResource Settings.NavButton}"
                                Click="SettingsNav_Click"
                                Tag="terminal">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="KeyCommand24" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Terminal" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavThemesButton"
                                Style="{StaticResource Settings.NavButton}"
                                Click="SettingsNav_Click"
                                Tag="themes">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="PaintBrush24" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Themes" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="{StaticResource Surface.Base}"
                          Padding="2,0,2,16">
                <Grid>
                    <!-- GENERAL -->
                    <StackPanel x:Name="SettingsPanelGeneral">
                        <Border Style="{StaticResource Settings.ToolbarCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Workspace"
                                               FontSize="11"
                                               Foreground="{StaticResource Text.Muted}" />
                                    <TextBlock x:Name="WorkspacePathHint"
                                               Text="{Binding Text, ElementName=LocalPathTextBox}"
                                               FontSize="12"
                                               FontFamily="{StaticResource FontFamily.Mono}"
                                               Foreground="{StaticResource Text.Secondary}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Button x:Name="BrowseLocalButton"
                                        Grid.Column="1"
                                        Content="Browse"
                                        Height="32"
                                        MinWidth="88"
                                        Style="{StaticResource App.Button.Ghost}"
                                        Click="BrowseLocalButton_Click" />
                            </Grid>
                        </Border>

                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="15" Margin="0,0,8,0" Foreground="{StaticResource Accent.Primary}" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Local project" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Select the folder GitDeploy Pro manages"
                                                   FontSize="10"
                                                   Foreground="{StaticResource Text.Muted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Text="Project folder" Margin="0,0,0,6" Style="{StaticResource App.MutedTextStyle}" FontSize="11" />
                                <TextBox x:Name="LocalPathTextBox" Style="{StaticResource App.InputTextBox}" />
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Wrench24" FontSize="15" Margin="0,0,8,0" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Configuration file" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Git ignore helper for project metadata"
                                                   FontSize="10"
                                                   Foreground="{StaticResource Text.Muted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="AddToGitIgnoreCheckBox"
                                          Content="Add config file to .gitignore"
                                          IsChecked="True"
                                          Foreground="{StaticResource Text.Secondary}"
                                          FontSize="12"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />
                                <Button Content="Add Now"
                                        Height="28"
                                        Padding="12,0"
                                        Style="{StaticResource App.Button.Ghost}"
                                        Click="AddGitIgnore_Click" />
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Globe24" FontSize="15" Margin="0,0,8,0" Foreground="{StaticResource Accent.Primary}" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock x:Name="LanguageSectionTitle"
                                                   Text="Language"
                                                   FontWeight="SemiBold"
                                                   FontSize="13" />
                                        <TextBlock x:Name="LanguageSectionHint"
                                                   Text="Tooltip language for button descriptions. Default is English."
                                                   FontSize="10"
                                                   Foreground="{StaticResource Text.Muted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock x:Name="LanguageLabel"
                                           Text="Language"
                                           Margin="0,0,0,6"
                                           Style="{StaticResource App.MutedTextStyle}"
                                           FontSize="11" />
                                <ComboBox x:Name="UiLanguageComboBox"
                                          Height="34"
                                          Style="{StaticResource App.InputComboBox}"
                                          SelectedValuePath="Code"
                                          SelectionChanged="UiLanguageComboBox_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock x:Name="LanguageNoteText"
                                           Margin="0,8,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource Text.Muted}"
                                           TextWrapping="Wrap"
                                           Text="Persian translates button tooltips only. Menus and layout stay English (LTR)." />
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DocumentText24" FontSize="15" Margin="0,0,8,0" Foreground="{StaticResource Accent.Primary}" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock x:Name="EditorPrefTitle"
                                                   Text="Editor"
                                                   FontWeight="SemiBold"
                                                   FontSize="13" />
                                        <TextBlock x:Name="EditorPrefHint"
                                                   Text="How files open on the Deploy page (all projects)"
                                                   FontSize="10"
                                                   Foreground="{StaticResource Text.Muted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <RadioButton x:Name="EditorOpenDockRadio"
                                             GroupName="DeployEditorOpenMode"
                                             Content="Docked in Deploy (current)"
                                             Foreground="{StaticResource Text.Secondary}"
                                             FontSize="12"
                                             IsChecked="True"
                                             Checked="EditorOpenModeRadio_Checked" />
                                <RadioButton x:Name="EditorOpenFloatRadio"
                                             GroupName="DeployEditorOpenMode"
                                             Content="Float window"
                                             Foreground="{StaticResource Text.Secondary}"
                                             FontSize="12"
                                             Margin="0,8,0,0"
                                             Checked="EditorOpenModeRadio_Checked" />
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Desktop24" FontSize="15" Margin="0,0,8,0" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                                    <TextBlock Text="Startup &amp; tray" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <CheckBox x:Name="LaunchOnStartupCheckBox"
                                          Content="Launch GitDeploy Pro when Windows starts"
                                          Foreground="{StaticResource Text.Secondary}"
                                          FontSize="12" />
                                <CheckBox x:Name="ShowBackupLocalhostWarningCheckBox"
                                          Content="Show localhost warning in Backup Scheduler"
                                          Foreground="{StaticResource Text.Secondary}"
                                          FontSize="12"
                                          Margin="0,8,0,0" />
                                <CheckBox x:Name="MinimizeToTrayCheckBox"
                                          Content="Minimize and close to system tray"
                                          Foreground="{StaticResource Text.Secondary}"
                                          FontSize="12"
                                          Margin="0,8,0,0" />
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="15" Margin="0,0,8,0" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                                    <TextBlock Text="Software updates" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock x:Name="UpdateVersionText" Text="Current version: -" Foreground="{StaticResource Text.Secondary}" FontSize="12" />
                                <TextBlock x:Name="UpdateLastCheckText" Text="Last automatic check: never" Foreground="{StaticResource Text.Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <Button x:Name="CheckForUpdatesButton"
                                        Content="Check for updates now"
                                        Height="32"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        MinWidth="170"
                                        Style="{StaticResource App.Button.Ghost}"
                                        Click="CheckForUpdatesButton_Click" />
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Settings24" FontSize="15" Margin="0,0,8,0" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                                    <TextBlock Text="Windows startup audit" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock x:Name="StartupAuditSummaryText" Text="Startup status will be loaded..." Foreground="{StaticResource Text.Secondary}" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock x:Name="StartupCurrentExeText" Text="Current exe: -" Foreground="{StaticResource Text.Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="StartupPrimaryEntryText" Text="Primary startup value: -" Foreground="{StaticResource Text.Muted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="Detected GitDeploy startup entries:" Foreground="{StaticResource Text.Muted}" FontSize="11" Margin="0,8,0,4" />
                                <TextBox x:Name="StartupEntriesTextBox"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="72"
                                         MaxHeight="110"
                                         FontSize="11"
                                         Background="{StaticResource Surface.Input}"
                                         BorderBrush="{StaticResource Border.Subtle}"
                                         Foreground="{StaticResource Text.Secondary}"
                                         FontFamily="{StaticResource FontFamily.Mono}" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="RefreshStartupAuditButton" Content="Refresh" Height="30" Padding="12,0" Margin="0,0,8,8" Style="{StaticResource App.Button.Ghost}" Click="RefreshStartupAuditButton_Click" />
                                    <Button x:Name="UseCurrentStartupButton" Content="Use this version" Height="30" Padding="12,0" Margin="0,0,8,8" Style="{StaticResource App.Button.Primary}" Click="UseCurrentStartupButton_Click" />
                                    <Button x:Name="RemoveStartupEntriesButton" Content="Remove startup entries" Height="30" Padding="12,0" Margin="0,0,0,8" Style="{StaticResource App.Button.Ghost}" Click="RemoveStartupEntriesButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Warning24" FontSize="15" Margin="0,0,8,0" Foreground="{StaticResource Status.Error}" VerticalAlignment="Center" />
                                    <TextBlock Text="Danger zone" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Status.Error}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <Border Background="{StaticResource Status.ErrorSurface}"
                                    BorderBrush="{StaticResource Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Remove this project from GitDeploy Pro only. Files stay on disk."
                                               Foreground="{StaticResource Text.Secondary}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8" />
                                    <TextBlock x:Name="DangerProjectPathText"
                                               Foreground="{StaticResource Text.Muted}"
                                               FontFamily="{StaticResource FontFamily.Mono}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"
                                               Text="No project selected." />
                                    <Button x:Name="RemoveProjectFromAppButton"
                                            Content="Remove project from app"
                                            Height="32"
                                            HorizontalAlignment="Left"
                                            Padding="14,0"
                                            Style="{StaticResource App.Button.Danger}"
                                            Click="RemoveProjectFromAppButton_Click" />
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>

                    <!-- TERMINAL -->
                    <StackPanel x:Name="SettingsPanelTerminal" Visibility="Collapsed">
                        <Border Style="{StaticResource Settings.ToolbarCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="TerminalAppearanceTitle"
                                           Text="Appearance"
                                           FontWeight="SemiBold"
                                           FontSize="15" />
                                <TextBlock x:Name="TerminalAppearanceHint"
                                           Text="Font size and text color for every terminal. Same for all projects."
                                           FontSize="11"
                                           Foreground="{StaticResource Text.Muted}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="TerminalFontLabel"
                                                   Text="Font size"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Text.Muted}"
                                                   Margin="0,0,0,6" />
                                        <ComboBox x:Name="SettingsTerminalFontCombo"
                                                  Height="34"
                                                  Style="{StaticResource App.InputComboBox}"
                                                  SelectionChanged="SettingsTerminalAppearance_Changed">
                                            <ComboBoxItem Content="10" />
                                            <ComboBoxItem Content="12" />
                                            <ComboBoxItem Content="14" />
                                            <ComboBoxItem Content="16" />
                                            <ComboBoxItem Content="18" />
                                            <ComboBoxItem Content="20" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="TerminalColorLabel"
                                                   Text="Text color"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Text.Muted}"
                                                   Margin="0,0,0,6" />
                                        <ComboBox x:Name="SettingsTerminalColorCombo"
                                                  Height="34"
                                                  Style="{StaticResource App.InputComboBox}"
                                                  SelectionChanged="SettingsTerminalAppearance_Changed">
                                            <ComboBoxItem Content="Gray" Tag="#D4D4D4" />
                                            <ComboBoxItem Content="White" Tag="#FFFFFF" />
                                            <ComboBoxItem Content="Green" Tag="#00FF00" />
                                            <ComboBoxItem Content="Cyan" Tag="#00FFFF" />
                                            <ComboBoxItem Content="Yellow" Tag="#FFFF00" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Settings.ToolbarCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Terminal suggestions"
                                           FontWeight="SemiBold"
                                           FontSize="15" />
                                <TextBlock Text="Autocomplete commands with ghost text · Global or per-project scope"
                                           FontSize="11"
                                           Foreground="{StaticResource Text.Muted}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <controls:TerminalSuggestionsSettingsPanel x:Name="TerminalSuggestionsPanel" />
                    </StackPanel>

                    <!-- SERVER -->
                    <StackPanel x:Name="SettingsPanelServer" Visibility="Collapsed">
                        <Border Style="{StaticResource Settings.ToolbarCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="Cloud24" FontSize="15" Margin="0,0,8,0" Foreground="{StaticResource Accent.Primary}" VerticalAlignment="Center" />
                                    <TextBlock Text="Connection profile" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Assign one or more FTP/SFTP profiles. The default is used by Commit and Sync."
                                           Foreground="{StaticResource Text.Muted}"
                                           FontSize="11"
                                           Margin="0,0,0,10"
                                           TextWrapping="Wrap" />
                                <ListBox x:Name="AssignedFtpProfilesList"
                                         MinHeight="72"
                                         MaxHeight="220"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Style="{StaticResource App.ListBox.Host}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="AssignedFtpProfilesList_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource App.ListBoxItem.Transparent}">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,8"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="AssignedFtpRow"
                                                    Background="{StaticResource Surface.Input}"
                                                    BorderBrush="{StaticResource Border.Subtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="13"
                                                                       Foreground="{StaticResource Text.Primary}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <Border Margin="8,0,0,0"
                                                                    Background="{StaticResource Status.SuccessSurface}"
                                                                    CornerRadius="4"
                                                                    Padding="6,2"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding DefaultBadgeVisibility}">
                                                                <TextBlock Text="Default"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource Status.Success}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Host}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource Text.Muted}"
                                                                   Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="★"
                                                                Width="28"
                                                                Height="28"
                                                                Padding="0"
                                                                Margin="0,0,4,0"
                                                                Style="{StaticResource App.IconButton}"
                                                                ToolTip="{loc:T deploy.tip.setFtpDefault}"
                                                                Click="SetDefaultFtpButton_Click"
                                                                IsEnabled="{Binding CanSetDefault}"/>
                                                        <Button Content="−"
                                                                Width="28"
                                                                Height="28"
                                                                Padding="0"
                                                                Style="{StaticResource App.IconButton}"
                                                                ToolTip="{loc:T deploy.tip.removeFtpProfile}"
                                                                Click="RemoveAssignedFtpButton_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                    <Setter TargetName="AssignedFtpRow" Property="Background" Value="{StaticResource Status.SuccessSurface}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="AssignedFtpEmptyText"
                                           Text="No FTP/SFTP profile assigned to this project."
                                           Foreground="{StaticResource Text.Muted}"
                                           FontSize="11"
                                           Margin="0,0,0,10"
                                           Visibility="Collapsed"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="AddFtpProfileComboBox"
                                              Grid.Column="0"
                                              Height="36"
                                              Style="{StaticResource App.InputComboBox}"
                                              DisplayMemberPath="DisplayName" />
                                    <Button x:Name="AddFtpProfileButton"
                                            Grid.Column="1"
                                            Content="Add"
                                            Height="36"
                                            Margin="8,0,0,0"
                                            Padding="12,0"
                                            Style="{StaticResource App.Button.Ghost}"
                                            ToolTip="{loc:T deploy.tip.addFtpProfile}"
                                            Click="AddFtpProfileButton_Click" />
                                    <Button x:Name="ManageConnectionsButton"
                                            Grid.Column="2"
                                            Content="Manage profiles"
                                            Height="36"
                                            Margin="8,0,0,0"
                                            Padding="12,0"
                                            Style="{StaticResource App.Button.Primary}"
                                            Click="ManageConnectionsButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Settings.ToolbarCard}" Background="{StaticResource Surface.Input}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Host" Grid.Row="0" Foreground="{StaticResource Text.Muted}" FontSize="11" Margin="0,0,0,8" />
                                <TextBlock x:Name="PreviewHostText" Grid.Row="0" Grid.Column="1" Foreground="{StaticResource Text.Primary}" FontWeight="SemiBold" FontSize="12" Text="-" />
                                <TextBlock Text="Protocol" Grid.Row="1" Foreground="{StaticResource Text.Muted}" FontSize="11" Margin="0,0,0,8" />
                                <TextBlock x:Name="PreviewProtocolText" Grid.Row="1" Grid.Column="1" Foreground="{StaticResource Text.Secondary}" FontSize="12" Text="-" />
                                <TextBlock Text="User" Grid.Row="2" Foreground="{StaticResource Text.Muted}" FontSize="11" Margin="0,0,0,8" />
                                <TextBlock x:Name="PreviewUserText" Grid.Row="2" Grid.Column="1" Foreground="{StaticResource Text.Secondary}" FontSize="12" Text="-" />
                                <TextBlock Text="Root path" Grid.Row="3" Foreground="{StaticResource Text.Muted}" FontSize="11" />
                                <TextBlock x:Name="PreviewPathText" Grid.Row="3" Grid.Column="1" Foreground="{StaticResource Status.Success}" FontSize="12" Text="-" />
                            </Grid>
                        </Border>

                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Wrench24" FontSize="15" Margin="0,0,8,0" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                                    <TextBlock Text="Setup wizard &amp; recovery" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <Button x:Name="ReSetupButton"
                                        Content="Re-run setup wizard"
                                        Height="34"
                                        HorizontalAlignment="Left"
                                        Padding="14,0"
                                        Style="{StaticResource App.Button.Ghost}"
                                        Click="ReSetupButton_Click" />
                                <Border Background="{StaticResource Status.InfoSurface}"
                                        BorderBrush="{StaticResource Border.Subtle}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Reinitialize project setup"
                                                   Foreground="{StaticResource Status.Info}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13" />
                                        <TextBlock Text="Remove setup artifacts, then run the wizard cleanly."
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,10" />
                                        <CheckBox x:Name="ResetGitInSettingsCheckBox" Content="Remove .git folder" Foreground="{StaticResource Text.Primary}" FontSize="12" Margin="0,0,0,6" />
                                        <CheckBox x:Name="ResetConfigInSettingsCheckBox" Content="Remove .gitdeploy.config" Foreground="{StaticResource Text.Primary}" FontSize="12" Margin="0,0,0,10" />
                                        <Button x:Name="ResetAndRunSetupButton"
                                                Content="Reset and run wizard"
                                                Height="34"
                                                HorizontalAlignment="Left"
                                                Padding="14,0"
                                                Style="{StaticResource App.Button.Danger}"
                                                Click="ResetAndRunSetupButton_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- GIT -->
                    <StackPanel x:Name="SettingsPanelGit" Visibility="Collapsed">
                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="BranchFork24" FontSize="15" Margin="0,0,8,0" Foreground="{StaticResource Accent.Primary}" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Git configuration" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Remote, branches, and deploy automation"
                                                   FontSize="10"
                                                   Foreground="{StaticResource Text.Muted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Text="Remote repository URL (origin)" Margin="0,0,0,6" Style="{StaticResource App.MutedTextStyle}" FontSize="11" />
                                <TextBox x:Name="RemoteUrlTextBox"
                                         Style="{StaticResource App.InputTextBox}"
                                         Foreground="{StaticResource Status.Info}"
                                         Margin="0,0,0,10" />
                                <TextBlock Text="SSH private key (for git@ remotes)"
                                           Margin="0,0,0,6"
                                           Style="{StaticResource App.MutedTextStyle}"
                                           FontSize="11" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SshKeyPathTextBox"
                                             Grid.Column="0"
                                             Style="{StaticResource App.InputTextBox}"
                                             VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="Browse"
                                            Height="32"
                                            Padding="12,0"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource App.Button.Ghost}"
                                            Click="BrowseSshKeyButton_Click" />
                                    <Button Grid.Column="2"
                                            Content="Test"
                                            Height="32"
                                            Padding="12,0"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource App.Button.Ghost}"
                                            Click="TestSshKeyButton_Click" />
                                </Grid>
                                <Button Content="Open SSH key helper"
                                        Height="30"
                                        HorizontalAlignment="Left"
                                        Padding="12,0"
                                        Margin="0,0,0,10"
                                        Style="{StaticResource App.Button.Ghost}"
                                        Click="OpenSshKeyHelperButton_Click" />
                                <Border x:Name="GitPushStatusBadge"
                                        Style="{StaticResource App.StatusBadge.Warning}"
                                        Margin="0,0,0,10"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Cloud24" FontSize="14" Margin="0,0,8,0" Foreground="{StaticResource Status.Warning}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="GitPushStatusText"
                                                   Text="Pending push"
                                                   FontSize="12"
                                                   Foreground="{StaticResource Status.Warning}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Default source branch" Margin="0,0,0,6" Style="{StaticResource App.MutedTextStyle}" FontSize="11" />
                                        <ComboBox x:Name="DefaultSourceBranchComboBox" Height="36" Style="{StaticResource App.InputComboBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Default target branch" Margin="0,0,0,6" Style="{StaticResource App.MutedTextStyle}" FontSize="11" />
                                        <ComboBox x:Name="DefaultTargetBranchComboBox" Height="36" Style="{StaticResource App.InputComboBox}" />
                                    </StackPanel>
                                </Grid>
                                <Button x:Name="RefreshBranchesButton"
                                        Content="Refresh branches"
                                        Height="30"
                                        HorizontalAlignment="Left"
                                        Padding="12,0"
                                        Margin="0,0,0,12"
                                        Style="{StaticResource App.Button.Ghost}"
                                        Click="RefreshBranchesButton_Click" />
                                <CheckBox x:Name="AutoInitGitCheckBox" Content="Auto-init Git if not exists" IsChecked="True" Foreground="{StaticResource Text.Secondary}" FontSize="12" Margin="0,3" />
                                <CheckBox x:Name="AutoCommitCheckBox" Content="Auto-commit before deploy" IsChecked="True" Foreground="{StaticResource Text.Secondary}" FontSize="12" Margin="0,3" />
                                <CheckBox x:Name="AutoPushCheckBox" Content="Auto-push after deploy" IsChecked="False" Foreground="{StaticResource Text.Secondary}" FontSize="12" Margin="0,3" />
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DismissCircle24" FontSize="15" Margin="0,0,8,0" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Ignored files" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="This project's .gitignore only — Add/Remove from Direct Upload stays in sync"
                                                   FontSize="10"
                                                   Foreground="{StaticResource Text.Muted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <ItemsControl x:Name="IgnorePatternItemsControl"
                                              Margin="0,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Surface.Raised}"
                                                    BorderBrush="{StaticResource Border.Subtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10,6"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding}"
                                                               VerticalAlignment="Center"
                                                               FontFamily="{StaticResource FontFamily.Mono}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource Log.Success}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="1"
                                                            Content="Remove"
                                                            Height="28"
                                                            MinWidth="78"
                                                            Padding="10,0"
                                                            Margin="8,0,0,0"
                                                            Tag="{Binding}"
                                                            Style="{StaticResource App.Button.Ghost}"
                                                            Click="RemoveIgnorePattern_Click" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="IgnorePatternEmptyText"
                                           Text="No ignore lines in this project."
                                           FontSize="11"
                                           Foreground="{StaticResource Text.Muted}"
                                           Margin="0,0,0,10"
                                           Visibility="Collapsed" />
                                <TextBox x:Name="ExcludePatternsTextBox"
                                         Style="{StaticResource App.InputTextBox.Multiline}"
                                         MinHeight="160"
                                         VerticalScrollBarVisibility="Auto"
                                         Foreground="{StaticResource Log.Success}"
                                         FontFamily="{StaticResource FontFamily.Mono}"
                                         FontSize="12"
                                         LostFocus="ExcludePatternsTextBox_LostFocus" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- THEMES -->
                    <StackPanel x:Name="SettingsPanelThemes" Visibility="Collapsed">
                        <Expander Style="{StaticResource Settings.Expander}" IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="PaintBrush24" FontSize="15" Margin="0,0,8,0" Foreground="{StaticResource Accent.Primary}" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="App theme" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Applies across the whole app and persists after restart"
                                                   FontSize="10"
                                                   Foreground="{StaticResource Text.Muted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <Border Background="{StaticResource Surface.Raised}"
                                        BorderBrush="{StaticResource Border.Subtle}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Theme pack guide"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Foreground="{StaticResource Text.Primary}" />
                                            <TextBlock Text="THEME_PACK_GUIDE.md ships with the app and lives in your Themes folder for users and tools."
                                                       FontSize="10"
                                                       Foreground="{StaticResource Text.Muted}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,12,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Open guide"
                                                Style="{StaticResource App.Button.Ghost}"
                                                Height="32"
                                                Padding="12,0"
                                                VerticalAlignment="Center"
                                                Click="OpenThemeGuide_Click"
                                                ToolTip="Open THEME_PACK_GUIDE.md" />
                                    </Grid>
                                </Border>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="AppThemeComboBox"
                                              Height="34"
                                              DisplayMemberPath="DisplayName"
                                              Style="{StaticResource App.InputComboBox}"
                                              SelectionChanged="AppThemeComboBox_SelectionChanged" />
                                    <Button Grid.Column="1"
                                            Content="Apply"
                                            Style="{StaticResource App.Button.Primary}"
                                            Height="34"
                                            Margin="8,0,0,0"
                                            Padding="16,0"
                                            Click="ApplyAppTheme_Click" />
                                </Grid>
                                <ListBox x:Name="ThemePacksListBox"
                                         MinHeight="200"
                                         MaxHeight="340"
                                         DisplayMemberPath="DisplayLabel"
                                         Background="{StaticResource Surface.Input}"
                                         BorderBrush="{StaticResource Border.Subtle}"
                                         Foreground="{StaticResource Text.Primary}"
                                         Margin="0,0,0,10"
                                         MouseDoubleClick="ThemePacksListBox_MouseDoubleClick" />
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="Import theme…"
                                            Style="{StaticResource App.Button.Secondary}"
                                            Height="32"
                                            Margin="0,0,8,8"
                                            Padding="12,0"
                                            Click="ImportTheme_Click" />
                                    <Button Content="Export selected…"
                                            Style="{StaticResource App.Button.Ghost}"
                                            Height="32"
                                            Margin="0,0,8,8"
                                            Padding="12,0"
                                            Click="ExportTheme_Click" />
                                    <Button Content="Delete custom"
                                            Style="{StaticResource App.Button.Ghost}"
                                            Height="32"
                                            Margin="0,0,8,8"
                                            Padding="12,0"
                                            Click="DeleteTheme_Click" />
                                    <Button Content="Open folder"
                                            Style="{StaticResource App.Button.Ghost}"
                                            Height="32"
                                            Margin="0,0,8,8"
                                            Padding="12,0"
                                            Click="OpenThemesFolder_Click" />
                                    <Button Content="Refresh"
                                            Style="{StaticResource App.Button.Ghost}"
                                            Height="32"
                                            Margin="0,0,8,8"
                                            Padding="12,0"
                                            Click="RefreshThemes_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="ThemePackStatusText"
                                           Foreground="{StaticResource Text.Muted}"
                                           FontSize="11"
                                           FontFamily="{StaticResource FontFamily.Mono}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Compact Deploy-style save footer -->
        <Border Grid.Row="2"
                Background="{StaticResource Surface.Shell}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8"
                Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Changes apply to the current project and global preferences."
                           Foreground="{StaticResource Text.Muted}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,12,0" />
                <Button Grid.Column="1"
                        Height="34"
                        MinWidth="140"
                        Padding="14,0"
                        Style="{StaticResource App.Button.Primary}"
                        Click="SaveSettings_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Save24"
                                       FontSize="14"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                        <TextBlock Text="Save settings"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
