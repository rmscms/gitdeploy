<Page x:Class="GitDeployPro.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      Title="SettingsPage"
      Background="{StaticResource Surface.Base}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
    <Grid Margin="{StaticResource Spacing.PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="⚙️" FontSize="36" VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel>
                <TextBlock Text="Settings" Style="{StaticResource App.PageTitleTextStyle}" />
                <TextBlock Text="Project, FTP profiles, and Git defaults in one place."
                           Style="{StaticResource App.PageSubtitleTextStyle}" />
            </StackPanel>
        </StackPanel>

        <TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Margin="0,0,0,18">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource App.TabItemStyle}" />
            </TabControl.Resources>

            <TabItem Header="General &amp; Local">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource App.CardStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="📁" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="Local Project Path"
                                           Style="{StaticResource App.SectionTitleTextStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="Select Project Folder:" Margin="0,8,0,6" Style="{StaticResource App.MutedTextStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="LocalPathTextBox"
                                         Grid.Column="0"
                                         Style="{StaticResource App.InputTextBox}" />
                                <Button x:Name="BrowseLocalButton"
                                        Grid.Column="1"
                                        Content="Browse"
                                        Width="90"
                                        Height="38"
                                        Margin="10,0,0,0"
                                        Style="{StaticResource App.Button.Ghost}"
                                        Click="BrowseLocalButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource App.CardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="🔧" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="Configuration File"
                                           Style="{StaticResource App.SectionTitleTextStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="Git ignore helper for project metadata."
                                       Style="{StaticResource App.MutedTextStyle}"
                                       Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="AddToGitIgnoreCheckBox"
                                          Content="Add config file to .gitignore"
                                          IsChecked="True"
                                          Foreground="{StaticResource Text.Secondary}"
                                          FontSize="13"
                                          VerticalAlignment="Center"
                                          Margin="0,6,10,6" />

                                <Button Content="Add Now"
                                        Height="28"
                                        Padding="10,0"
                                        Style="{StaticResource App.Button.Ghost}"
                                        Click="AddGitIgnore_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource App.CardStyle}" Margin="10,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="🚀" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="Startup behavior"
                                           Style="{StaticResource App.SectionTitleTextStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Control launch behavior for daily workflow."
                                       Style="{StaticResource App.MutedTextStyle}"
                                       Margin="0,0,0,10" />
                            <CheckBox x:Name="LaunchOnStartupCheckBox"
                                      Content="Launch GitDeploy Pro when Windows starts"
                                      Foreground="{StaticResource Text.Secondary}"
                                      FontSize="13" />
                            <CheckBox x:Name="ShowBackupLocalhostWarningCheckBox"
                                      Content="Show localhost warning in Backup Scheduler (127.0.0.1:3306 / root)"
                                      Foreground="{StaticResource Text.Secondary}"
                                      FontSize="13"
                                      Margin="0,8,0,0" />
                            <CheckBox x:Name="MinimizeToTrayCheckBox"
                                      Content="Minimize and close to system tray (use tray icon menu to Exit)"
                                      Foreground="{StaticResource Text.Secondary}"
                                      FontSize="13"
                                      Margin="0,8,0,0" />

                            <Border Background="{StaticResource Surface.Input}"
                                    BorderBrush="{StaticResource Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Software updates"
                                               Foreground="{StaticResource Text.Primary}"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                    <TextBlock x:Name="UpdateVersionText"
                                               Text="Current version: -"
                                               Foreground="{StaticResource Text.Secondary}"
                                               FontSize="12"
                                               Margin="0,6,0,0" />
                                    <TextBlock x:Name="UpdateLastCheckText"
                                               Text="Last automatic check: never"
                                               Foreground="{StaticResource Text.Muted}"
                                               FontSize="11"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap" />
                                    <Button x:Name="CheckForUpdatesButton"
                                            Content="Check for updates now"
                                            Height="34"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Left"
                                            MinWidth="180"
                                            Style="{StaticResource App.Button.Ghost}"
                                            Click="CheckForUpdatesButton_Click" />
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource Surface.Input}"
                                    BorderBrush="{StaticResource Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Windows startup audit"
                                               Foreground="{StaticResource Text.Primary}"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                    <TextBlock x:Name="StartupAuditSummaryText"
                                               Text="Startup status will be loaded..."
                                               Foreground="{StaticResource Text.Secondary}"
                                               FontSize="12"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="StartupCurrentExeText"
                                               Text="Current exe: -"
                                               Foreground="{StaticResource Text.Muted}"
                                               FontSize="11"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="StartupPrimaryEntryText"
                                               Text="Primary startup value: -"
                                               Foreground="{StaticResource Text.Muted}"
                                               FontSize="11"
                                               Margin="0,2,0,0"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="Detected GitDeploy startup entries:"
                                               Foreground="{StaticResource Text.Muted}"
                                               FontSize="11"
                                               Margin="0,8,0,4" />
                                    <TextBox x:Name="StartupEntriesTextBox"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             MinHeight="78"
                                             MaxHeight="120"
                                             FontSize="11"
                                             Foreground="{StaticResource Text.Secondary}"
                                             FontFamily="{StaticResource FontFamily.Mono}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="RefreshStartupAuditButton"
                                                Content="🔄 Refresh"
                                                Height="30"
                                                Padding="10,0"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource App.Button.Ghost}"
                                                Click="RefreshStartupAuditButton_Click" />
                                        <Button x:Name="UseCurrentStartupButton"
                                                Content="✅ Use this version"
                                                Height="30"
                                                Padding="10,0"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource App.Button.Primary}"
                                                Click="UseCurrentStartupButton_Click" />
                                        <Button x:Name="RemoveStartupEntriesButton"
                                                Content="🧹 Remove startup entries"
                                                Height="30"
                                                Padding="10,0"
                                                Style="{StaticResource App.Button.Ghost}"
                                                Click="RemoveStartupEntriesButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,18,0,0"
                                    Background="{StaticResource Status.ErrorSurface}"
                                    BorderBrush="{StaticResource Status.Error}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="⚠"
                                                   FontSize="20"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />
                                        <TextBlock Text="Danger Zone"
                                                   Style="{StaticResource App.SectionTitleTextStyle}"
                                                   Foreground="{StaticResource Status.Error}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Remove this project from GitDeploy Pro only. Your project files stay on disk and can be opened again later."
                                               Foreground="{StaticResource Text.Secondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10" />
                                    <TextBlock x:Name="DangerProjectPathText"
                                               Foreground="{StaticResource Text.Muted}"
                                               FontFamily="{StaticResource FontFamily.Mono}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12"
                                               Text="No project selected." />
                                    <Button x:Name="RemoveProjectFromAppButton"
                                            Content="Remove project from app"
                                            Height="34"
                                            HorizontalAlignment="Left"
                                            Padding="14,0"
                                            Style="{StaticResource App.Button.Danger}"
                                            Click="RemoveProjectFromAppButton_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Server (FTP/SFTP)">
                <Border Style="{StaticResource App.CardStyle}" Margin="0,18,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="🌐" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="Server Configuration"
                                           Style="{StaticResource App.SectionTitleTextStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="This project uses a central connection profile. No need to enter FTP details manually."
                                       Foreground="{StaticResource Text.Muted}"
                                       Margin="0,0,0,14"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="ConnectionProfileComboBox"
                                          Grid.Column="0"
                                          Style="{StaticResource App.InputComboBox}"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="ConnectionProfileComboBox_SelectionChanged" />

                                <Button x:Name="ManageConnectionsButton"
                                        Grid.Column="1"
                                        Content="📂 Manage Profiles"
                                        Height="40"
                                        Width="150"
                                        Margin="10,0,0,0"
                                        Style="{StaticResource App.Button.Primary}"
                                        Click="ManageConnectionsButton_Click" />
                            </Grid>

                            <Border Style="{StaticResource App.PanelStyle}" Padding="14" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Host:" Grid.Row="0" Grid.Column="0" Foreground="{StaticResource Text.Muted}" Margin="0,0,10,5" />
                                    <TextBlock x:Name="PreviewHostText" Grid.Row="0" Grid.Column="1" Foreground="{StaticResource Text.Primary}" FontWeight="SemiBold" Text="-" />

                                    <TextBlock Text="Protocol:" Grid.Row="1" Grid.Column="0" Foreground="{StaticResource Text.Muted}" Margin="0,0,10,5" />
                                    <TextBlock x:Name="PreviewProtocolText" Grid.Row="1" Grid.Column="1" Foreground="{StaticResource Text.Secondary}" Text="-" />

                                    <TextBlock Text="User:" Grid.Row="2" Grid.Column="0" Foreground="{StaticResource Text.Muted}" Margin="0,0,10,5" />
                                    <TextBlock x:Name="PreviewUserText" Grid.Row="2" Grid.Column="1" Foreground="{StaticResource Text.Secondary}" Text="-" />

                                    <TextBlock Text="Root Path:" Grid.Row="3" Grid.Column="0" Foreground="{StaticResource Text.Muted}" Margin="0,0,10,0" />
                                    <TextBlock x:Name="PreviewPathText" Grid.Row="3" Grid.Column="1" Foreground="{StaticResource Status.Success}" Text="-" />
                                </Grid>
                            </Border>

                            <StackPanel Margin="0,20,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ReSetupButton"
                                            Content="🛠 Re-Run Setup Wizard"
                                            Height="40"
                                            Width="190"
                                            Style="{StaticResource App.Button.Ghost}"
                                            Click="ReSetupButton_Click" />
                                </StackPanel>

                                <Border Background="{StaticResource Status.InfoSurface}"
                                        BorderBrush="{StaticResource Border.Subtle}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14"
                                        Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Reinitialize Project Setup"
                                                   Foreground="{StaticResource Status.Info}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14" />
                                        <TextBlock Text="For recovery: remove setup artifacts from this project folder, then run wizard cleanly."
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,10" />
                                        <CheckBox x:Name="ResetGitInSettingsCheckBox"
                                                  Content="Remove .git folder"
                                                  Foreground="{StaticResource Text.Primary}"
                                                  Margin="0,0,0,6" />
                                        <CheckBox x:Name="ResetConfigInSettingsCheckBox"
                                                  Content="Remove .gitdeploy.config"
                                                  Foreground="{StaticResource Text.Primary}"
                                                  Margin="0,0,0,10" />
                                        <Button x:Name="ResetAndRunSetupButton"
                                                Content="♻ Reset And Run Wizard"
                                                Height="36"
                                                Width="200"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource App.Button.Danger}"
                                                Click="ResetAndRunSetupButton_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="Git &amp; GitHub">
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="0.65*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource App.CardStyle}" Margin="0,0,14,0">
                        <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="📦" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="Git Configuration"
                                               Style="{StaticResource App.SectionTitleTextStyle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="Remote Repository URL (origin):" Margin="0,0,0,6" Style="{StaticResource App.MutedTextStyle}" />
                                <TextBox x:Name="RemoteUrlTextBox"
                                         Style="{StaticResource App.InputTextBox}"
                                         Foreground="{StaticResource Status.Info}"
                                         Margin="0,0,0,15" />
                                <Border x:Name="GitPushStatusBadge"
                                        Style="{StaticResource App.StatusBadge.Warning}"
                                        Margin="0,0,0,15"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="☁️" FontSize="16" Margin="0,0,8,0" Foreground="{StaticResource Status.Warning}" />
                                        <TextBlock x:Name="GitPushStatusText"
                                                   Text="Pending push"
                                                   FontSize="13"
                                                   Foreground="{StaticResource Status.Warning}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="15" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Default Source Branch:" Margin="0,0,0,6" Style="{StaticResource App.MutedTextStyle}" />
                                        <ComboBox x:Name="DefaultSourceBranchComboBox"
                                                  Style="{StaticResource App.InputComboBox}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Default Target Branch:" Margin="0,0,0,6" Style="{StaticResource App.MutedTextStyle}" />
                                        <ComboBox x:Name="DefaultTargetBranchComboBox"
                                                  Style="{StaticResource App.InputComboBox}" />
                                    </StackPanel>
                                </Grid>

                                <Button x:Name="RefreshBranchesButton"
                                        Content="🔄 Refresh Branches"
                                        Width="160"
                                        Height="32"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,15"
                                        Style="{StaticResource App.Button.Ghost}"
                                        Click="RefreshBranchesButton_Click" />

                                <CheckBox x:Name="AutoInitGitCheckBox"
                                          Content="Auto-init Git if not exists"
                                          IsChecked="True"
                                          Foreground="{StaticResource Text.Secondary}"
                                          FontSize="13"
                                          Margin="0,6" />

                                <CheckBox x:Name="AutoCommitCheckBox"
                                          Content="Auto-commit before deploy"
                                          IsChecked="True"
                                          Foreground="{StaticResource Text.Secondary}"
                                          FontSize="13"
                                          Margin="0,6" />

                                <CheckBox x:Name="AutoPushCheckBox"
                                          Content="Auto-push after deploy"
                                          IsChecked="False"
                                          Foreground="{StaticResource Text.Secondary}"
                                          FontSize="13"
                                          Margin="0,6" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource App.CardStyle}" Margin="0,0,0,10">
                        <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="🚫" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="Ignored Files"
                                               Style="{StaticResource App.SectionTitleTextStyle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="Exclude patterns (one per line):" Margin="0,0,0,8" Style="{StaticResource App.MutedTextStyle}" />
                                <TextBox x:Name="ExcludePatternsTextBox"
                                         Style="{StaticResource App.InputTextBox.Multiline}"
                                         MinHeight="260"
                                         VerticalScrollBarVisibility="Auto"
                                         Foreground="{StaticResource Log.Success}"
                                         FontFamily="{StaticResource FontFamily.Mono}"
                                         FontSize="12" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Background="{StaticResource Surface.Shell}"
                Padding="20"
                BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource Border.Subtle}"
                Margin="0,0,0,0">
            <Button Height="50"
                    FontSize="16"
                    FontWeight="Bold"
                    Style="{StaticResource App.Button.Primary}"
                    Click="SaveSettings_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="💾" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="SAVE ALL SETTINGS"
                               FontSize="15"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Border>
    </Grid>
    </ScrollViewer>
</Page>