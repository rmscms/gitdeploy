<Page x:Class="GitDeployPro.Pages.FtpExplorerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource Surface.Base}">
    <Page.Resources>
        <Style x:Key="FtpActionButtonStyle" TargetType="Button" BasedOn="{StaticResource App.Button.Toolbar}" />

        <Style x:Key="FtpPrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource FtpActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource Accent.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent.Primary}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="FtpNeutralActionButtonStyle" TargetType="Button" BasedOn="{StaticResource FtpActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource Surface.Input}"/>
        </Style>

        <Style x:Key="FtpSuccessActionButtonStyle" TargetType="Button" BasedOn="{StaticResource FtpActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource Status.Success}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Status.Success}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Inverse}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Page.Resources>
    <Grid Margin="{StaticResource Spacing.PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="220"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🗂️" FontSize="40" Margin="0,0,15,0" VerticalAlignment="Center" Foreground="{StaticResource Text.Primary}"/>
                <StackPanel>
                    <TextBlock Text="FTP Explorer" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                    <TextBlock x:Name="HeaderSubtitle"
                               Text="Browse your deployment servers"
                               FontSize="14"
                               Foreground="{StaticResource Text.Muted}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="🗖"
                        Style="{StaticResource DetachPageButtonStyle}"
                        Margin="0,0,10,0"
                        ToolTip="Open FTP Explorer in a new window"
                        Click="DetachFtpExplorerPage_Click"/>
                <Button Content="⚙ Manage Connections"
                        Style="{StaticResource FtpNeutralActionButtonStyle}"
                        Padding="16,0"
                        Click="ManageConnections_Click"/>
            </StackPanel>
        </Grid>

        <!-- Controls -->
        <Border Grid.Row="1"
                Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18"
                Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                            <TextBlock Text="Connection Profile" FontSize="13" Foreground="{StaticResource Text.Muted}" Margin="0,0,0,5"/>
                            <ComboBox x:Name="ConnectionsCombo"
                                      Height="36"
                                      Style="{StaticResource App.InputComboBox}"
                                      Padding="6,0"
                                      SelectionChanged="ConnectionsCombo_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="26"
                                                    Height="26"
                                                    CornerRadius="6"
                                                    Background="{Binding ProtocolBadgeColor}"
                                                    Margin="0,0,10,0">
                                                <TextBlock Text="{Binding ProtocolBadgeText}"
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Host}" FontSize="11" Foreground="{StaticResource Text.Muted}"/>
                                                <TextBlock Text="Project default"
                                                           FontSize="10"
                                                           Foreground="{StaticResource Status.Success}"
                                                           Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsProjectDefault}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock x:Name="ConnectionSummaryText" FontSize="12" Foreground="{StaticResource Status.Info}" Margin="0,6,0,0"/>
                            <TextBlock x:Name="MappingSummaryText"
                                       FontSize="12"
                                       Foreground="{StaticResource Status.Warning}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Button x:Name="ConnectButton"
                                    Content="🔗 Connect"
                                    Width="170"
                                    Height="34"
                                    Padding="14,0"
                                    Style="{StaticResource FtpPrimaryActionButtonStyle}"
                                    Click="ConnectButton_Click"
                                    Margin="0,0,10,0">
                            </Button>
                            <CheckBox x:Name="ShowHiddenCheckBox"
                                      Content="Show hidden files"
                                      Foreground="{StaticResource Text.Secondary}"
                                      Margin="0,4,0,0"
                                      Checked="ShowHiddenCheckBox_Changed"
                                      Unchecked="ShowHiddenCheckBox_Changed"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid Grid.Row="1" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Current Path" FontSize="13" Foreground="{StaticResource Text.Muted}" Margin="0,0,0,5"/>
                        <TextBox x:Name="PathTextBox"
                                 Height="34"
                                 IsReadOnly="True"
                                 Style="{StaticResource App.InputTextBox}"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="⬆ Up"
                            Margin="10,20,0,0"
                            Width="94"
                            Style="{StaticResource FtpNeutralActionButtonStyle}"
                            ToolTip="Go back to the parent directory"
                            Click="UpButton_Click"/>

                    <Button Grid.Column="2"
                            Content="🔄 Refresh"
                            Margin="10,20,0,0"
                            Width="110"
                            Style="{StaticResource FtpNeutralActionButtonStyle}"
                            Click="RefreshButton_Click"/>
                </Grid>

                <Grid Grid.Row="2" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Download to" FontSize="13" Foreground="{StaticResource Text.Muted}" Margin="0,0,0,5"/>
                        <TextBox x:Name="DownloadPathTextBox"
                                 Height="34"
                                 Style="{StaticResource App.InputTextBox}"
                                 IsReadOnly="True"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Browse..."
                            Margin="10,20,0,0"
                            Style="{StaticResource FtpNeutralActionButtonStyle}"
                            Click="BrowseDownloadPath_Click"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,20,0,0">
                        <Button x:Name="DownloadSelectedButton"
                                Content="⬇ Download Selected"
                                Padding="16,0"
                                Style="{StaticResource FtpSuccessActionButtonStyle}"
                                Click="DownloadSelectedButton_Click"/>
                        <Button x:Name="PauseDownloadButton"
                                Content="Pause"
                                Margin="8,0,0,0"
                                Width="88"
                                Style="{StaticResource FtpPrimaryActionButtonStyle}"
                                IsEnabled="False"
                                Click="PauseDownloadButton_Click"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                    <TextBlock x:Name="DownloadProgressText"
                               Text="Waiting for download..."
                               FontSize="12"
                               Foreground="{StaticResource Text.Muted}"
                               Margin="0,0,0,4"/>
                    <ProgressBar x:Name="DownloadProgressBar"
                                 Height="8"
                                 Value="0"
                                 Minimum="0"
                                 Maximum="100"
                                 Background="{StaticResource Surface.Input}"
                                 Foreground="{StaticResource Status.Success}"
                                 Margin="0,0,0,4"/>
                    <TextBlock x:Name="DownloadProgressDetailText"
                               Text=""
                               FontSize="11"
                               Foreground="{StaticResource Status.Info}"/>
                </StackPanel>

                <TextBlock x:Name="StatusText"
                           Grid.Row="4"
                           Margin="0,15,0,0"
                           FontSize="13"
                           Foreground="{StaticResource Text.Secondary}"
                           Text="Select a connection to begin."/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource Surface.Shell}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,8"
                Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Quick select:" Foreground="{StaticResource Text.Muted}" FontSize="13" VerticalAlignment="Center"/>
                <CheckBox x:Name="SelectAllCheckBox"
                          Content="Select all"
                          Margin="12,0,0,0"
                          Foreground="{StaticResource Text.Secondary}"
                          Cursor="Hand"
                          Click="SelectAllCheckBox_Click"/>
                <CheckBox x:Name="ClearSelectionCheckBox"
                          Content="Clear selection"
                          Margin="12,0,0,0"
                          Foreground="{StaticResource Text.Secondary}"
                          Cursor="Hand"
                          Click="ClearSelectionCheckBox_Click"/>
            </StackPanel>
        </Border>

        <!-- Explorer -->
        <ListView x:Name="EntriesListView"
                  Grid.Row="3"
                  MinHeight="160"
                  Style="{StaticResource App.ListView.Host}"
                  ItemContainerStyle="{StaticResource App.ListViewItem.Row}"
                  Foreground="{StaticResource Text.Primary}"
                  Margin="0,0,0,15"
                  MouseDoubleClick="EntriesListView_MouseDoubleClick"
                  PreviewMouseRightButtonDown="EntriesListView_PreviewMouseRightButtonDown">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Download" Click="DownloadMenuItem_Click"/>
                    <MenuItem Header="Rename" Click="RenameMenuItem_Click"/>
                    <MenuItem Header="Delete" Click="DeleteMenuItem_Click"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Select" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="IsEnabled" Value="True"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsParentLink}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Name" Width="260">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,8,0" Foreground="{Binding IconColor}"/>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text.Primary}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Type" Width="70" DisplayMemberBinding="{Binding Type}"/>
                    <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding SizeDisplay}"/>
                    <GridViewColumn Header="Modified" Width="160" DisplayMemberBinding="{Binding ModifiedDisplay}"/>
                    <GridViewColumn Header="Owner" Width="100" DisplayMemberBinding="{Binding Owner}"/>
                    <GridViewColumn Header="Group" Width="100" DisplayMemberBinding="{Binding Group}"/>
                    <GridViewColumn Header="Permissions" Width="120" DisplayMemberBinding="{Binding Permissions}"/>
                    <GridViewColumn Header="Actions" Width="140">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Download"
                                        Height="28"
                                        Padding="10,4"
                                        FontSize="12"
                                        Foreground="{StaticResource Text.Primary}"
                                        Cursor="Hand"
                                        Tag="{Binding}"
                                        Click="DownloadRowButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource App.Button.Primary}">
                                            <Setter Property="IsEnabled" Value="True"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsParentLink}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <GridSplitter Grid.Row="4"
                      Height="8"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="{StaticResource Border.Subtle}"
                      ShowsPreview="True"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      Cursor="SizeNS"/>

        <!-- Logs -->
        <Border Grid.Row="5"
                MinHeight="120"
                Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="📋" FontSize="18" Margin="0,0,10,0"/>
                    <TextBlock Text="Log" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                    <Button Content="🗑 Clear"
                            Margin="15,0,0,0"
                            Padding="12,2"
                            Style="{StaticResource App.Button.Ghost}"
                            Foreground="{StaticResource Text.Secondary}"
                            Click="ClearLog_Click"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="0,0,0,40">
                    <TextBox x:Name="LogTextBox"
                             Background="{StaticResource Surface.Input}"
                             Foreground="{StaticResource Log.Success}"
                             FontFamily="Consolas"
                             FontSize="12"
                             Padding="10"
                             Margin="0,0,0,30"
                             VerticalContentAlignment="Top"
                             IsReadOnly="True"
                             TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>

