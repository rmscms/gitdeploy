<Page x:Class="GitDeployPro.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="About"
      Background="{StaticResource Surface.Base}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="{StaticResource Spacing.PageMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="ℹ️" FontSize="36" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource App.PageTitleTextStyle}" />
                    <TextBlock Text="App version and software updates."
                               Style="{StaticResource App.PageSubtitleTextStyle}" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1"
                    Style="{StaticResource App.CardStyle}"
                    Padding="20"
                    MaxWidth="560"
                    HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="GitDeploy Pro"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Primary}" />
                    <TextBlock x:Name="VersionText"
                               Text="Version: -"
                               Margin="0,10,0,0"
                               FontSize="14"
                               Foreground="{StaticResource Text.Secondary}" />
                    <TextBlock x:Name="LastCheckText"
                               Text="Last automatic check: never"
                               Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="{StaticResource Text.Muted}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="InstallPathText"
                               Text="Install path: -"
                               Margin="0,10,0,0"
                               FontSize="12"
                               Foreground="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="RunningPathText"
                               Text="Running from: -"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="{StaticResource Text.Muted}"
                               TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button x:Name="CheckForUpdatesButton"
                                Content="Check for updates now"
                                Height="36"
                                MinWidth="200"
                                Style="{StaticResource App.Button.Primary}"
                                Click="CheckForUpdatesButton_Click" />
                        <Button x:Name="OpenInstallFolderButton"
                                Content="Open install folder"
                                Height="36"
                                Margin="10,0,0,0"
                                MinWidth="150"
                                Style="{StaticResource App.Button.Ghost}"
                                Click="OpenInstallFolderButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
