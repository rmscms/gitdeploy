<Page x:Class="GitDeployPro.Pages.ModemSmsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behaviors="clr-namespace:GitDeployPro.Behaviors"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:loc="clr-namespace:GitDeployPro.Services.Localization"
      Title="ModemSmsPage"
      Background="{StaticResource Surface.Base}">
    <Page.Resources>
        <Style x:Key="Sms.Tab" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="6,6,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource State.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Sms.Tab.Active" TargetType="Button" BasedOn="{StaticResource Sms.Tab}">
            <Setter Property="Foreground" Value="{DynamicResource Accent.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
            <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Sms.PageBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Surface.Input}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource State.Hover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Sms.PageBtn.Active" TargetType="Button" BasedOn="{StaticResource Sms.PageBtn}">
            <Setter Property="Background" Value="{DynamicResource Accent.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Page.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Surface.Shell}" BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource App.IconButton}" Width="32" Height="32" Margin="0,0,10,0" ToolTip="{loc:T sms.back}" Click="Back_Click">
                    <Path behaviors:AppIcon.Kind="arrow-left" behaviors:AppIcon.Size="16" />
                </Button>
                <Border Grid.Column="1" Width="40" Height="40" CornerRadius="12" Background="{DynamicResource Accent.Soft}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Path behaviors:AppIcon.Kind="chat" behaviors:AppIcon.Size="20" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Accent.Primary}" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T sms.title}" Style="{StaticResource App.PageTitleTextStyle}" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource App.PageSubtitleTextStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ComposeButton" Style="{StaticResource App.Button.Primary}" Height="34" Padding="14,0" Margin="0,0,8,0" Click="Compose_Click" ToolTip="{loc:T sms.tip.compose}">
                        <StackPanel Orientation="Horizontal">
                            <Path behaviors:AppIcon.Kind="plus" behaviors:AppIcon.Size="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:T sms.compose}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource App.IconButton}" Width="34" Height="34" ToolTip="{loc:T sms.refresh}" Click="Refresh_Click">
                        <Path behaviors:AppIcon.Kind="refresh" behaviors:AppIcon.Size="16" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Compose -->
        <Border x:Name="ComposePanel" Grid.Row="1" Style="{StaticResource App.CardStyle}" Padding="14" Margin="0,0,0,8" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="{loc:T sms.composeTitle}" Style="{StaticResource App.SectionTitleTextStyle}" FontSize="14" Margin="0,0,0,8" />
                <TextBlock Text="{loc:T sms.to}" Style="{StaticResource App.MutedTextStyle}" FontSize="11" Margin="0,0,0,4" />
                <TextBox x:Name="ComposePhone" Style="{StaticResource App.InputTextBox}" mah:TextBoxHelper.Watermark="09123456789" MaxWidth="320" HorizontalAlignment="Left" />
                <TextBlock Text="{loc:T sms.text}" Style="{StaticResource App.MutedTextStyle}" FontSize="11" Margin="0,10,0,4" />
                <TextBox x:Name="ComposeText" Style="{StaticResource App.InputTextBox.Multiline}" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" TextChanged="ComposeText_TextChanged" />
                <DockPanel Margin="0,10,0,0">
                    <TextBlock x:Name="ComposeCounter" DockPanel.Dock="Right" Style="{StaticResource App.CaptionTextStyle}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SendButton" Style="{StaticResource App.Button.Primary}" Height="32" MinWidth="110" Margin="0,0,8,0" Click="Send_Click" Content="{loc:T sms.send}" />
                        <Button Style="{StaticResource App.Button.Ghost}" Height="32" MinWidth="80" Click="CancelCompose_Click" Content="{loc:T sms.cancel}" />
                        <TextBlock x:Name="ComposeStatus" Style="{StaticResource App.MutedTextStyle}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="2" Style="{StaticResource App.CardStyle}" Padding="10,6" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="InboxTab" Style="{StaticResource Sms.Tab.Active}" Click="InboxTab_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:T sms.inbox}" />
                            <Border Background="{DynamicResource Surface.Input}" CornerRadius="8" Padding="6,0" Margin="6,0,0,0">
                                <TextBlock x:Name="InboxCount" FontSize="10" FontWeight="Bold" Text="0" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SentTab" Style="{StaticResource Sms.Tab}" Click="SentTab_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:T sms.sent}" />
                            <Border Background="{DynamicResource Surface.Input}" CornerRadius="8" Padding="6,0" Margin="6,0,0,0">
                                <TextBlock x:Name="SentCount" FontSize="10" FontWeight="Bold" Text="0" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <CheckBox x:Name="SelectAllCheck" Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Content="{loc:T sms.selectPage}"
                          Foreground="{StaticResource Text.Secondary}" FontSize="12" Click="SelectAll_Click" />

                <Border Grid.Column="2" Margin="14,2" Background="{StaticResource Surface.Input}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="8" Padding="8,0" MaxWidth="320" HorizontalAlignment="Left">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path behaviors:AppIcon.Kind="search" behaviors:AppIcon.Size="14" Margin="0,0,6,0" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Text.Muted}" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Text.Primary}" Height="30"
                                 VerticalContentAlignment="Center" FontSize="12" TextChanged="SearchBox_TextChanged" mah:TextBoxHelper.Watermark="{loc:T sms.search}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SelectEverythingButton" Style="{StaticResource App.Button.Ghost}" Height="30" Padding="10,0" Margin="0,0,8,0" FontSize="11" Click="SelectEverything_Click" ToolTip="{loc:T sms.tip.selectEverything}" />
                    <Button x:Name="DeleteButton" Style="{StaticResource App.Button.Danger}" Height="30" Padding="12,0" FontSize="11" IsEnabled="False" Click="DeleteSelected_Click" ToolTip="{loc:T sms.tip.delete}">
                        <StackPanel Orientation="Horizontal">
                            <Path behaviors:AppIcon.Kind="trash" behaviors:AppIcon.Size="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="DeleteLabel" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- List -->
        <Grid Grid.Row="3">
            <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                <StackPanel>
                    <Border x:Name="ErrorBanner" Style="{StaticResource App.StatusBadge.Warning}" HorizontalAlignment="Stretch" Margin="0,0,0,8" Visibility="Collapsed" Padding="12,8">
                        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Status.Warning}" TextWrapping="Wrap" FontSize="12" />
                    </Border>
                    <Border x:Name="AllSelectedBanner" Style="{StaticResource App.StatusBadge.Info}" HorizontalAlignment="Stretch" Margin="0,0,0,8" Visibility="Collapsed" Padding="12,8">
                        <TextBlock x:Name="AllSelectedText" Foreground="{StaticResource Status.Info}" FontSize="12" />
                    </Border>
                    <Border x:Name="EmptyState" Style="{StaticResource App.PanelStyle}" Padding="24" Visibility="Collapsed">
                        <TextBlock Text="{loc:T sms.empty}" Style="{StaticResource App.MutedTextStyle}" HorizontalAlignment="Center" />
                    </Border>

                    <ItemsControl x:Name="MessageList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Card" Background="{StaticResource Surface.Card}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,10,10,0" />
                                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20" Background="{Binding KindSurface}" BorderBrush="{Binding KindBrush}" BorderThickness="1" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="Bold" Foreground="{Binding KindBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="2">
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding DateText}" Style="{StaticResource App.CaptionTextStyle}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding From}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                                                <Border Background="{Binding KindSurface}" BorderBrush="{Binding KindBrush}" BorderThickness="1" CornerRadius="6" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding KindLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding KindBrush}" />
                                                </Border>
                                                <Ellipse Width="8" Height="8" Margin="8,0,0,0" Fill="{StaticResource Accent.Primary}" VerticalAlignment="Center" Visibility="{Binding UnreadVisibility}" ToolTip="{loc:T sms.unread}" />
                                            </DockPanel>

                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FlowDirection="{Binding TextFlow}" FontSize="13" LineHeight="21"
                                                       Foreground="{StaticResource Text.Secondary}" Margin="0,8,0,0" />

                                            <!-- Package -->
                                            <WrapPanel Margin="0,10,0,0" Visibility="{Binding PackageVisibility}">
                                                <Border Style="{StaticResource App.StatusBadge.Success}" Margin="0,0,6,4">
                                                    <TextBlock Text="{Binding PackageGbText}" FontWeight="Bold" Foreground="{StaticResource Status.Success}" />
                                                </Border>
                                                <Border Style="{StaticResource App.StatusBadge.Info}" Margin="0,0,6,4" Visibility="{Binding PackageDaysVisibility}">
                                                    <TextBlock Text="{Binding PackageDaysText}" Foreground="{StaticResource Status.Info}" />
                                                </Border>
                                                <Border Style="{StaticResource App.StatusBadge.Warning}" Margin="0,0,6,4" Visibility="{Binding PackageExpiryVisibility}">
                                                    <TextBlock Text="{Binding PackageExpiryText}" Foreground="{StaticResource Status.Warning}" />
                                                </Border>
                                                <Button Content="{Binding AddToPlanLabel}" IsEnabled="{Binding CanAddToPlan}" Style="{StaticResource App.Button.Secondary}" Height="26" Padding="10,0" FontSize="11" Margin="4,0,0,4" Tag="{Binding}" Click="AddToPlan_Click" />
                                            </WrapPanel>

                                            <!-- Usage -->
                                            <StackPanel Margin="0,10,0,0" Visibility="{Binding UsageVisibility}">
                                                <DockPanel Margin="0,0,0,4">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding UsagePercentText}" FontWeight="Bold" Foreground="{Binding KindBrush}" />
                                                    <TextBlock Text="{loc:T modem.card.used}" Style="{StaticResource App.CaptionTextStyle}" />
                                                </DockPanel>
                                                <ProgressBar Style="{StaticResource App.ProgressBar}" Height="6" Minimum="0" Maximum="100" Value="{Binding UsagePercent, Mode=OneWay}" />
                                            </StackPanel>

                                            <!-- Links -->
                                            <ItemsControl ItemsSource="{Binding Links}" Margin="0,8,0,0" Visibility="{Binding LinksVisibility}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource App.Button.Ghost}" Height="26" Padding="10,0" Margin="0,0,6,4" FontSize="11" Tag="{Binding Url}" Click="OpenLink_Click" ToolTip="{Binding Url}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path behaviors:AppIcon.Kind="globe" behaviors:AppIcon.Size="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Display}" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Orientation="Vertical" Margin="8,0,0,0">
                                            <Button Style="{StaticResource App.IconButton}" Width="28" Height="28" Tag="{Binding}" Click="CopyMessage_Click" ToolTip="{loc:T sms.copy}">
                                                <Path behaviors:AppIcon.Kind="copy" behaviors:AppIcon.Size="14" />
                                            </Button>
                                            <Button Style="{StaticResource App.IconButton}" Width="28" Height="28" Margin="0,4,0,0" Tag="{Binding}" Click="DeleteOne_Click" ToolTip="{loc:T sms.deleteOne}">
                                                <Path behaviors:AppIcon.Kind="trash" behaviors:AppIcon.Size="14" TextElement.Foreground="{DynamicResource Status.Error}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent.Primary}" />
                                        <Setter TargetName="Card" Property="Background" Value="{StaticResource Accent.Soft}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Height="3" VerticalAlignment="Top" Visibility="Collapsed" Style="{StaticResource App.ProgressBar}" />
        </Grid>

        <!-- Pagination -->
        <Border Grid.Row="4" Style="{StaticResource App.CardStyle}" Padding="10,8" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RangeText" Style="{StaticResource App.MutedTextStyle}" VerticalAlignment="Center" />
                <StackPanel x:Name="PagerPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T sms.perPage}" Style="{StaticResource App.MutedTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="PageSizeCombo" Width="72" Height="30" SelectionChanged="PageSize_SelectionChanged">
                        <ComboBoxItem Content="10" />
                        <ComboBoxItem Content="20" IsSelected="True" />
                        <ComboBoxItem Content="50" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
