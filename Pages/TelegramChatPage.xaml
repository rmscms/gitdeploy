<Page x:Class="GitDeployPro.Pages.TelegramChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:GitDeployPro.Services.Localization"
      Title="TelegramChatPage"
      Background="{StaticResource Surface.Base}">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="220" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource Surface.Shell}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="14,14,14,8">
                    <TextBlock Text="{loc:T telegram.title}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Primary}" />
                    <TextBlock Text="{loc:T telegram.subtitle}"
                               FontSize="11"
                               Foreground="{StaticResource Text.Muted}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>

                <TextBox x:Name="ThreadSearchBox"
                         Grid.Row="1"
                         Margin="12,0,12,10"
                         Style="{StaticResource App.InputTextBox}"
                         mah:TextBoxHelper.Watermark="{loc:T telegram.search}"
                         TextChanged="ThreadSearchBox_TextChanged" />

                <ListBox x:Name="ThreadsList"
                         Grid.Row="2"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="6,0,6,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ThreadsList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <EventSetter Event="MouseRightButtonUp" Handler="ThreadItem_MouseRightButtonUp" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row"
                                                Background="Transparent"
                                                CornerRadius="10"
                                                Padding="8,8"
                                                Cursor="Hand">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Chat.ThreadHover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Chat.ThreadHover}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="19"
                                        Background="{Binding AvatarBrush}"
                                        VerticalAlignment="Top"
                                        Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Initial}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Text.Primary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding LastPreview}"
                                               FontSize="11"
                                               Foreground="{StaticResource Text.Muted}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding TimeLabel}"
                                               FontSize="10"
                                               Foreground="{StaticResource Text.Muted}"
                                               HorizontalAlignment="Right" />
                                    <Border Background="{StaticResource Chat.Unread}"
                                            CornerRadius="9"
                                            Padding="6,1"
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Right"
                                            Visibility="{Binding UnreadVisibility}">
                                        <TextBlock Text="{Binding UnreadCount}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Chat.BubbleOutText}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Background="{StaticResource Surface.Shell}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="14,12"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ChatTitleText"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Primary}"
                                       Text="{loc:T telegram.pickThread}" />
                            <TextBlock x:Name="ChatStatusText"
                                       FontSize="11"
                                       Foreground="{StaticResource Text.Muted}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button x:Name="ClearChatButton"
                                    Content="{loc:T telegram.btnClear}"
                                    Margin="0,0,8,0"
                                    Padding="10,6"
                                    Style="{StaticResource App.Button.Secondary}"
                                    Click="ClearChatButton_Click"
                                    ToolTip="{loc:T telegram.clearLocalTooltip}" />
                            <Button x:Name="WipeTelegramButton"
                                    Content="{loc:T telegram.btnWipeTelegram}"
                                    Padding="10,6"
                                    Style="{StaticResource App.Button.Secondary}"
                                    Click="WipeTelegramButton_Click"
                                    ToolTip="{loc:T telegram.wipeTelegramTooltip}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ListBox x:Name="MessagesList"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="16,12"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         FlowDirection="LeftToRight">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,5" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border x:Name="Bubble"
                                        MaxWidth="460"
                                        CornerRadius="14"
                                        Padding="12,9"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource Chat.BubbleIn}">
                                    <StackPanel>
                                        <Image Source="{Binding PhotoImage}"
                                               MaxHeight="180"
                                               Stretch="Uniform"
                                               Cursor="Hand"
                                               Margin="0,0,0,8"
                                               Visibility="{Binding PhotoVisibility}"
                                               MouseLeftButtonUp="Photo_Click"
                                               Tag="{Binding PhotoPath}" />
                                        <TextBlock x:Name="BodyText"
                                                   Text="{Binding Text}"
                                                   TextWrapping="Wrap"
                                                   FontSize="13"
                                                   Foreground="{StaticResource Chat.BubbleInText}"
                                                   Visibility="{Binding TextVisibility}" />
                                        <TextBlock x:Name="TimeText"
                                                   Text="{Binding TimeLabel}"
                                                   FontSize="10"
                                                   Opacity="0.75"
                                                   Margin="0,6,0,0"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{StaticResource Chat.BubbleInText}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Bubble" Property="Background" Value="{StaticResource Chat.BubbleOut}" />
                                    <Setter TargetName="BodyText" Property="Foreground" Value="{StaticResource Chat.BubbleOutText}" />
                                    <Setter TargetName="TimeText" Property="Foreground" Value="{StaticResource Chat.BubbleOutText}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Center" />
                                    <Setter TargetName="Bubble" Property="Background" Value="{StaticResource Surface.Raised}" />
                                    <Setter TargetName="Bubble" Property="MaxWidth" Value="520" />
                                    <Setter TargetName="Bubble" Property="MinWidth" Value="220" />
                                    <Setter TargetName="BodyText" Property="Foreground" Value="{StaticResource Text.Muted}" />
                                    <Setter TargetName="BodyText" Property="TextAlignment" Value="Left" />
                                    <Setter TargetName="BodyText" Property="FlowDirection" Value="LeftToRight" />
                                    <Setter TargetName="TimeText" Property="Foreground" Value="{StaticResource Text.Muted}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2"
                        Padding="14,8"
                        Visibility="Collapsed"
                        x:Name="PendingPhotoBar"
                        Background="{StaticResource Surface.Raised}"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="0,1,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="{loc:T telegram.clearPhoto}"
                                Style="{StaticResource App.Button.Ghost}"
                                Height="28"
                                Click="ClearPendingPhoto_Click" />
                        <TextBlock x:Name="PendingPhotoText"
                                   Text="{loc:T telegram.photoAttached}"
                                   Foreground="{StaticResource Text.Secondary}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="3"
                        Padding="10,10"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="0,1,0,0"
                        Background="{StaticResource Chat.Composer}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource App.IconButton}"
                                Width="36"
                                Height="36"
                                ToolTip="{loc:T telegram.attach}"
                                Click="AttachPhoto_Click">
                            <ui:SymbolIcon Symbol="Attach24" FontSize="16" Foreground="{StaticResource Text.Secondary}" />
                        </Button>
                        <TextBox x:Name="ComposerBox"
                                 Grid.Column="1"
                                 Margin="8,0"
                                 MinHeight="36"
                                 MaxHeight="90"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource App.InputTextBox}"
                                 mah:TextBoxHelper.Watermark="{loc:T telegram.composerHint}"
                                 PreviewKeyDown="ComposerBox_PreviewKeyDown" />
                        <Button Grid.Column="2"
                                Height="36"
                                MinWidth="88"
                                Style="{StaticResource App.Button.Primary}"
                                Click="SendButton_Click">
                            <TextBlock Text="{loc:T telegram.send}" FontWeight="SemiBold" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
