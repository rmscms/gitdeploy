<Page x:Class="GitDeployPro.Pages.DeployPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:GitDeployPro.Controls"
      Title="DeployPage"
      Background="{StaticResource Surface.Base}">
    <Page.Resources>
        <Style x:Key="DeployRailButtonStyle" TargetType="Button" BasedOn="{StaticResource App.IconButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="DeployDockTabButtonStyle" TargetType="Button" BasedOn="{StaticResource App.Button.Ghost}">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Page.Resources>

    <Grid x:Name="DeployShellRoot" Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftRailColumn" Width="40" />
            <ColumnDefinition x:Name="LeftDockColumn" Width="0" />
            <ColumnDefinition x:Name="LeftSplitterColumn" Width="0" />
            <ColumnDefinition x:Name="DeployMainColumn" Width="*" MinWidth="280" />
            <ColumnDefinition x:Name="DeployRemoteSplitterColumn" Width="0" />
            <ColumnDefinition x:Name="DeployRemotePanelColumn" Width="0" />
            <ColumnDefinition x:Name="RightRailColumn" Width="40" />
        </Grid.ColumnDefinitions>

        <!-- Left icon rail (above terminal maximize overlay so it stays clickable) -->
        <Border Grid.Column="0"
                Panel.ZIndex="60"
                Background="{StaticResource Surface.Shell}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center">
                <Button x:Name="ToggleDirectUploadDockButton"
                        Style="{StaticResource DeployRailButtonStyle}"
                        Content="📤"
                        ToolTip="Direct Upload"
                        Click="ToggleDirectUploadDockButton_Click" />
                <Button x:Name="OpenBottomTerminalButton"
                        Style="{StaticResource DeployRailButtonStyle}"
                        Content="💻"
                        ToolTip="Terminal"
                        Click="OpenBottomTerminalButton_Click" />
                <Button x:Name="OpenBottomLogsButton"
                        Style="{StaticResource DeployRailButtonStyle}"
                        Content="📋"
                        ToolTip="Deploy Logs"
                        Click="OpenBottomLogsButton_Click" />
            </StackPanel>
        </Border>

        <!-- Left dock: Direct Upload -->
        <Border x:Name="LeftDockContainer"
                Grid.Column="1"
                Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="0,0,1,0"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Background="{StaticResource Surface.Shell}"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="0,0,0,1"
                        Padding="10,8">
                    <Grid>
                        <TextBlock Text="Direct Upload"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Primary}"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🔄"
                                    Style="{StaticResource DeployRailButtonStyle}"
                                    Width="28"
                                    Height="28"
                                    ToolTip="Refresh from disk"
                                    Click="RefreshDirectUploadDock_Click" />
                            <Button Content="✕"
                                    Style="{StaticResource DeployRailButtonStyle}"
                                    Width="28"
                                    Height="28"
                                    ToolTip="Collapse"
                                    Click="CollapseDirectUploadDock_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
                <controls:DirectUploadWorkspaceControl x:Name="DirectUploadDock"
                                                       Grid.Row="1"
                                                       CompactMode="True" />
            </Grid>
        </Border>

        <GridSplitter x:Name="LeftDockSplitter"
                      Grid.Column="2"
                      Width="8"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Background="#3A465C"
                      ShowsPreview="False"
                      Cursor="SizeWE"
                      Panel.ZIndex="30"
                      Visibility="Collapsed" />

        <!-- Center workspace (bottom Logs/Terminal lives in full-width overlay below) -->
        <Grid x:Name="CenterWorkspace" Grid.Column="3" Margin="8,0,8,0">
            <Grid x:Name="CenterContentHost" Margin="0,0,0,36">
            <ScrollViewer x:Name="CenterContentScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="180" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="🚀" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Deploy Project" Style="{StaticResource App.PageTitleTextStyle}" FontSize="18" />
                            <TextBlock Text="Compare, deploy, and sync in one flow."
                                       Style="{StaticResource App.PageSubtitleTextStyle}"
                                       FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Slim branch bar: source → target + action (all controls preserved) -->
                    <Border Grid.Row="1"
                            Background="{StaticResource Surface.Card}"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,8"
                            Margin="0,0,0,12">
                        <Grid x:Name="BranchRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="120" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="120" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" MinWidth="160" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="From"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Text.Muted}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <ComboBox x:Name="SourceBranchComboBox"
                                          Grid.Column="1"
                                          Height="32"
                                          Style="{StaticResource App.InputComboBox}"
                                          SelectionChanged="BranchComboBox_SelectionChanged" />
                                <Button x:Name="NewBranchButton"
                                        Grid.Column="2"
                                        Content="+"
                                        Width="28"
                                        Height="28"
                                        Margin="6,0,0,0"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        ToolTip="Create New Branch"
                                        Style="{StaticResource App.Button.Ghost}"
                                        Click="NewBranchButton_Click" />
                            </Grid>

                            <TextBlock Grid.Column="1"
                                       Text="→"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Muted}"
                                       VerticalAlignment="Center"
                                       Margin="10,0" />

                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="To"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Text.Muted}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <ComboBox x:Name="TargetBranchComboBox"
                                          Grid.Column="1"
                                          Height="32"
                                          Style="{StaticResource App.InputComboBox}"
                                          SelectionChanged="BranchComboBox_SelectionChanged" />
                            </Grid>

                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                <Button x:Name="ActionButton"
                                        Content="🔍 COMPARE"
                                        MinWidth="168"
                                        Height="34"
                                        Padding="14,0"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource App.Button.Secondary}"
                                        Click="ActionButton_Click" />
                                <Border x:Name="DeployPushBadge"
                                        Style="{StaticResource App.StatusBadge.Warning}"
                                        Margin="0,6,0,0"
                                        HorizontalAlignment="Stretch"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="☁️" FontSize="11" Margin="0,0,6,0" Foreground="{StaticResource Status.Warning}" />
                                        <TextBlock x:Name="DeployPushBadgeText"
                                                   Text="Pending push"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Status.Warning}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Style="{StaticResource App.CardStyle}"
                            Margin="0,0,0,12"
                            Padding="{StaticResource Spacing.CardPaddingDense}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="Changed Files"
                                                   Style="{StaticResource App.SectionTitleTextStyle}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />
                                        <CheckBox x:Name="SelectAllCheckBox"
                                                  Content="Select All"
                                                  FontSize="12"
                                                  Foreground="{StaticResource Text.Muted}"
                                                  VerticalAlignment="Center"
                                                  IsChecked="True"
                                                  Click="SelectAll_Click" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            x:Name="DeployButton"
                                            Content="🔄 SYNC"
                                            Width="180"
                                            Height="34"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Style="{StaticResource App.Button.Primary}"
                                            Visibility="Collapsed"
                                            IsEnabled="False"
                                            Click="DeployButton_Click" />
                                </Grid>
                                <TextBlock x:Name="StatusText"
                                           Text="Ready to compare changes..."
                                           FontSize="13"
                                           Foreground="{StaticResource Text.Muted}"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <ListBox x:Name="FilesListBox"
                                     Grid.Row="1"
                                     ItemContainerStyle="{StaticResource App.ListBoxItem.Transparent}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SelectionMode="Single"
                                     SelectionChanged="FilesListBox_SelectionChanged"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     MinHeight="160">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Surface.Raised}"
                                                BorderBrush="{StaticResource Border.Subtle}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12,10"
                                                Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,12,0" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📄" FontSize="16" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="13"
                                                               Foreground="{StaticResource Text.Secondary}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Button Content="VS"
                                                            Margin="8,0,0,0"
                                                            Padding="8,2"
                                                            FontSize="11"
                                                            Style="{StaticResource App.Button.Ghost}"
                                                            Tag="{Binding}"
                                                            Click="OpenCodeButton_Click" />
                                                </StackPanel>
                                                <Border Grid.Column="2"
                                                        Background="{Binding StatusColor}"
                                                        CornerRadius="4"
                                                        Padding="8,3">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource Text.Primary}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Style="{StaticResource App.CardStyle}"
                            Padding="{StaticResource Spacing.CardPaddingDense}">
                        <StackPanel>
                            <TextBlock x:Name="ProgressText"
                                       Text="Waiting..."
                                       Style="{StaticResource App.MutedTextStyle}"
                                       Margin="0,0,0,8" />
                            <ProgressBar x:Name="DeployProgressBar"
                                         Height="8"
                                         Value="0"
                                         Maximum="100"
                                         Background="{StaticResource Surface.Input}"
                                         Foreground="{StaticResource Accent.Primary}"
                                         BorderThickness="0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- Editor stays inside center content only (not over rails / bottom dock). -->
            <Border x:Name="CenterEditorOverlayHost"
                    Visibility="Collapsed"
                    Background="{StaticResource Surface.Base}"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6"
                    Panel.ZIndex="40" />
            </Grid>
        </Grid>

        <GridSplitter x:Name="RemoteDockSplitter"
                      Grid.Column="4"
                      Width="8"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Background="#3A465C"
                      ShowsPreview="False"
                      Cursor="SizeWE"
                      Panel.ZIndex="30"
                      Visibility="Collapsed" />

        <!-- Right dock: FTP -->
        <Border x:Name="RemoteWorkspaceContainer"
                Grid.Column="5"
                Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1,0,0,0"
                Padding="8"
                Visibility="Collapsed">
            <controls:DeployRemoteWorkspaceControl x:Name="DeployRemoteWorkspace" />
        </Border>

        <!-- Right icon rail (above bottom overlay so it stays clickable) -->
        <Border Grid.Column="6"
                Panel.ZIndex="60"
                Background="{StaticResource Surface.Shell}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1,0,0,0">
            <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center">
                <Button x:Name="ToggleRemoteWorkspaceButton"
                        Style="{StaticResource DeployRailButtonStyle}"
                        Content="🗂"
                        ToolTip="FTP / Remote Host"
                        Click="ToggleRemoteWorkspaceButton_Click" />
            </StackPanel>
        </Border>

        <!-- Full-width bottom overlay: Logs + Terminal (over Direct Upload + FTP) -->
        <Grid x:Name="BottomDockShell"
              Grid.Column="0"
              Grid.ColumnSpan="7"
              Height="220"
              MinHeight="28"
              MaxHeight="900"
              Margin="40,0,40,0"
              VerticalAlignment="Bottom"
              Panel.ZIndex="55">
            <Grid.RowDefinitions>
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="BottomDockResizeGrip"
                    Grid.Row="0"
                    Background="#3A465C"
                    Cursor="SizeNS"
                    ToolTip="Drag to resize"
                    MouseLeftButtonDown="BottomDockResizeGrip_MouseLeftButtonDown"
                    MouseMove="BottomDockResizeGrip_MouseMove"
                    MouseLeftButtonUp="BottomDockResizeGrip_MouseLeftButtonUp"
                    LostMouseCapture="BottomDockResizeGrip_LostMouseCapture" />
            <Border x:Name="BottomDockContainer"
                    Grid.Row="1"
                    Background="{StaticResource Surface.Card}"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="0,1,0,0"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource Surface.Shell}"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="0,0,0,1"
                            Padding="10,0,8,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BottomLogsTabButton"
                                        Content="Logs"
                                        Style="{StaticResource DeployDockTabButtonStyle}"
                                        ToolTip="Deployment logs"
                                        Click="BottomLogsTabButton_Click" />
                                <Button x:Name="BottomTerminalTabButton"
                                        Content="Terminal"
                                        Style="{StaticResource DeployDockTabButtonStyle}"
                                        ToolTip="SSH / local terminal"
                                        Click="BottomTerminalTabButton_Click" />
                                <Button x:Name="ClearLogsButton"
                                        Content="Clear"
                                        Style="{StaticResource DeployDockTabButtonStyle}"
                                        ToolTip="Clear deployment logs"
                                        Click="ClearLogs_Click" />
                            </StackPanel>
                            <Button x:Name="BottomCollapseButton"
                                    Content="−"
                                    Style="{StaticResource DeployRailButtonStyle}"
                                    Width="24"
                                    Height="22"
                                    FontSize="14"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    ToolTip="Collapse bottom panel"
                                    Click="ToggleBottomDockButton_Click" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="DeployLogsRow" Height="*" />
                            <RowDefinition x:Name="DeployTerminalRow" Height="0" />
                        </Grid.RowDefinitions>
                        <Border x:Name="BottomLogsPanel"
                                Grid.Row="0"
                                Style="{StaticResource App.LogContainerStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="Deploy Logs"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Text.Secondary}"
                                           Margin="8,6,8,0" />
                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              x:Name="LogScrollViewer"
                                              Padding="8,4,8,16">
                                    <TextBlock x:Name="LogTextBlock"
                                               FontFamily="{StaticResource FontFamily.Mono}"
                                               FontSize="12"
                                               Foreground="{StaticResource Log.Success}"
                                               TextWrapping="Wrap"
                                               Text="Waiting for deployment..."
                                               Margin="0,0,0,8" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <Border x:Name="BottomTerminalPanel"
                                Grid.Row="1"
                                Visibility="Collapsed">
                            <controls:TerminalControl x:Name="DeployTerminal" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
