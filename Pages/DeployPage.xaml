<Page x:Class="GitDeployPro.Pages.DeployPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:controls="clr-namespace:GitDeployPro.Controls"
      Title="DeployPage"
      Background="{StaticResource Surface.Base}">
    <Grid Margin="{StaticResource Spacing.PageMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="DeployMainColumn" Width="*" />
            <ColumnDefinition x:Name="DeployRemoteSplitterColumn" Width="6" />
            <ColumnDefinition x:Name="DeployRemotePanelColumn" Width="470" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="220" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" MinHeight="170" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
            <TextBlock Text="🚀" FontSize="36" VerticalAlignment="Center" Margin="0,0,14,0" />
            <StackPanel>
                <TextBlock Text="Deploy Project" Style="{StaticResource App.PageTitleTextStyle}" />
                <TextBlock Text="Compare changes, deploy, then sync workflow in one trusted flow."
                           Style="{StaticResource App.PageSubtitleTextStyle}" />
            </StackPanel>
            <Button Content="🗖"
                    Width="44"
                    Height="36"
                    Margin="18,0,0,0"
                    Style="{StaticResource DetachPageButtonStyle}"
                    ToolTip="Open Deploy page in a new window"
                    Click="DetachDeployPage_Click" />
            <Button x:Name="ToggleRemoteWorkspaceButton"
                    Content="🧭 Remote"
                    Height="36"
                    Padding="12,0"
                    Margin="8,0,0,0"
                    Style="{StaticResource App.Button.Ghost}"
                    ToolTip="Show/Hide remote workspace"
                    Click="ToggleRemoteWorkspaceButton_Click" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="210" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource App.CardStyle}">
                <StackPanel>
                    <TextBlock Text="Source Branch (Local):"
                               Style="{StaticResource App.MutedTextStyle}"
                               Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SourceBranchComboBox"
                                  Grid.Column="0"
                                  Style="{StaticResource App.InputComboBox}"
                                  SelectionChanged="BranchComboBox_SelectionChanged" />
                        <Button x:Name="NewBranchButton"
                                Grid.Column="1"
                                Content="➕"
                                Width="34"
                                Height="40"
                                Margin="6,0,0,0"
                                ToolTip="Create New Branch"
                                Style="{StaticResource App.Button.Ghost}"
                                Click="NewBranchButton_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Grid.Column="1"
                       Text="➜"
                       FontSize="22"
                       Foreground="{StaticResource Text.Muted}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

            <Border Grid.Column="2" Style="{StaticResource App.CardStyle}">
                <StackPanel>
                    <TextBlock Text="Target Branch (Local):"
                               Style="{StaticResource App.MutedTextStyle}"
                               Margin="0,0,0,8" />
                    <ComboBox x:Name="TargetBranchComboBox"
                              Style="{StaticResource App.InputComboBox}"
                              SelectionChanged="BranchComboBox_SelectionChanged" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="4">
                <Button x:Name="ActionButton"
                        Content="🔍 COMPARE"
                        Height="76"
                        FontSize="16"
                        FontWeight="Bold"
                        Style="{StaticResource App.Button.Secondary}"
                        Click="ActionButton_Click" />

                <Border x:Name="DeployPushBadge"
                        Style="{StaticResource App.StatusBadge.Warning}"
                        Margin="0,10,0,0"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="☁️" FontSize="14" Margin="0,0,6,0" Foreground="{StaticResource Status.Warning}" />
                        <TextBlock x:Name="DeployPushBadgeText"
                                   Text="Pending push"
                                   FontSize="12"
                                   Foreground="{StaticResource Status.Warning}"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource App.CardStyle}"
                Margin="0,0,0,20"
                Padding="{StaticResource Spacing.CardPaddingDense}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="Changed Files"
                                       Style="{StaticResource App.SectionTitleTextStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0" />

                            <CheckBox x:Name="SelectAllCheckBox"
                                      Content="Select All"
                                      FontSize="13"
                                      Foreground="{StaticResource Text.Muted}"
                                      VerticalAlignment="Center"
                                      IsChecked="True"
                                      Click="SelectAll_Click" />
                        </StackPanel>

                        <Button Grid.Column="3"
                                x:Name="DeployButton"
                                Content="🔄 SYNC"
                                Width="230"
                                Height="40"
                                FontSize="14"
                                FontWeight="Bold"
                                Style="{StaticResource App.Button.Primary}"
                                Visibility="Collapsed"
                                IsEnabled="False"
                                Click="DeployButton_Click" />
                    </Grid>

                    <TextBlock x:Name="StatusText"
                              Text="Ready to compare changes..."
                              FontSize="14"
                              Foreground="{StaticResource Text.Muted}"
                              Margin="0,6,0,0" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="FilesListBox"
                                 ItemContainerStyle="{StaticResource App.ListBoxItem.Transparent}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionMode="Single"
                                 SelectionChanged="FilesListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Surface.Raised}"
                                            BorderBrush="{StaticResource Border.Subtle}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12,10"
                                            Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"
                                                      Margin="0,0,14,0">
                                                <CheckBox.LayoutTransform>
                                                    <ScaleTransform ScaleX="1.15" ScaleY="1.15" />
                                                </CheckBox.LayoutTransform>
                                            </CheckBox>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📄" FontSize="17" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource Text.Secondary}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Button Content="VS"
                                                        Margin="10,0,0,0"
                                                        Padding="8,2"
                                                        FontSize="11"
                                                        Style="{StaticResource App.Button.Ghost}"
                                                        Tag="{Binding}"
                                                        Click="OpenCodeButton_Click" />
                                            </StackPanel>

                                            <Border Grid.Column="2"
                                                    Background="{Binding StatusColor}"
                                                    CornerRadius="4"
                                                    Padding="8,3"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource Text.Primary}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Style="{StaticResource App.CardStyle}"
                Margin="0,0,0,14"
                Padding="{StaticResource Spacing.CardPaddingDense}">
            <StackPanel>
                <TextBlock x:Name="ProgressText"
                           Text="Waiting..."
                           Style="{StaticResource App.MutedTextStyle}"
                           Margin="0,0,0,8" />
                <ProgressBar x:Name="DeployProgressBar"
                             Height="9"
                             Value="0"
                             Maximum="100"
                             Background="{StaticResource Surface.Input}"
                             Foreground="{StaticResource Accent.Primary}"
                             BorderThickness="0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="5"
                Style="{StaticResource App.CardStyle}"
                Padding="{StaticResource Spacing.CardPaddingDense}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="📋" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="Deployment Logs"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Primary}"
                               VerticalAlignment="Center" />
                    <Button Content="🗑️ Clear Logs"
                            Margin="15,0,0,0"
                            Height="30"
                            Padding="12,0"
                            FontSize="11"
                            Style="{StaticResource App.Button.Ghost}"
                            Click="ClearLogs_Click" />
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource App.LogContainerStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  x:Name="LogScrollViewer"
                                  Padding="0,0,0,40">
                        <TextBlock x:Name="LogTextBlock"
                                   FontFamily="{StaticResource FontFamily.Mono}"
                                   FontSize="12"
                                   Foreground="{StaticResource Log.Success}"
                                   TextWrapping="Wrap"
                                   Text="Waiting for deployment..."
                                   Margin="0,0,0,30" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="4"
                      Height="8"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Rows"
                      Background="{StaticResource Border.Subtle}"
                      ShowsPreview="True"
                      Cursor="SizeNS" />

        <GridSplitter Grid.Column="1"
                      Grid.RowSpan="6"
                      Width="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      Background="{StaticResource Border.Subtle}"
                      ShowsPreview="True"
                      Cursor="SizeWE" />

        <Border x:Name="RemoteWorkspaceContainer"
                Grid.Column="2"
                Grid.RowSpan="6"
                Margin="12,0,0,0"
                Style="{StaticResource App.CardStyle}"
                Padding="10">
            <controls:DeployRemoteWorkspaceControl x:Name="DeployRemoteWorkspace" />
        </Border>
    </Grid>
</Page>
