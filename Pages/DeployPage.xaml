<Page x:Class="GitDeployPro.Pages.DeployPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:GitDeployPro.Controls"
      xmlns:loc="clr-namespace:GitDeployPro.Services.Localization"
      Title="DeployPage"
      Background="{StaticResource Surface.Base}">
    <Page.Resources>
        <Style x:Key="DeployRailButtonStyle" TargetType="Button" BasedOn="{StaticResource App.IconButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="100" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
        </Style>
        <!-- JetBrains-like tool-window tabs: flat text + accent underline when active -->
        <Style x:Key="DeployDockTabButtonStyle" TargetType="Button" BasedOn="{StaticResource App.Button.Ghost}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="TabChrome"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Underline"
                                    Height="2"
                                    VerticalAlignment="Bottom"
                                    Margin="6,0"
                                    Background="Transparent"
                                    CornerRadius="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DeployDockTabButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource DeployDockTabButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="TabChrome"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <Border Height="2"
                                    VerticalAlignment="Bottom"
                                    Margin="6,0"
                                    Background="{StaticResource Accent.Primary}"
                                    CornerRadius="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DeployDockIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DeployDockTabButtonStyle}">
            <Setter Property="Width" Value="26" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
        </Style>
        <!-- PhpStorm-like terminal split controls: larger hit target + clearer chevron -->
        <Style x:Key="DeployTerminalSplitButtonStyle" TargetType="Button" BasedOn="{StaticResource DeployDockTabButtonStyle}">
            <Setter Property="Width" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,1,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        </Style>
        <Style x:Key="DeployTerminalPickerChevronStyle" TargetType="Button" BasedOn="{StaticResource DeployTerminalSplitButtonStyle}">
            <Setter Property="Width" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
            <Setter Property="ToolTip" Value="{loc:T deploy.tip.newTerminalSession}" />
        </Style>
    </Page.Resources>

    <Grid x:Name="DeployShellRoot" Margin="8,6,8,6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftRailColumn" Width="52" MinWidth="52" MaxWidth="52" />
            <ColumnDefinition x:Name="LeftDockColumn" Width="0" />
            <ColumnDefinition x:Name="LeftSplitterColumn" Width="0" />
            <ColumnDefinition x:Name="DeployMainColumn" Width="*" MinWidth="280" />
            <ColumnDefinition x:Name="DeployRemoteSplitterColumn" Width="0" />
            <ColumnDefinition x:Name="DeployRemotePanelColumn" Width="0" />
            <ColumnDefinition x:Name="RightRailColumn" Width="52" MinWidth="52" MaxWidth="52" />
        </Grid.ColumnDefinitions>

        <!-- Left icon rail (above terminal maximize overlay so it stays clickable) -->
        <Border Grid.Column="0"
                Panel.ZIndex="60"
                Background="{StaticResource Surface.Shell}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="4,10,4,0" HorizontalAlignment="Center">
                <Button x:Name="ToggleDirectUploadDockButton"
                        Style="{StaticResource DeployRailButtonStyle}"
                        Content="📤"
                        ToolTip="{loc:T deploy.tip.directUpload}"
                        Click="ToggleDirectUploadDockButton_Click" />
                <Button x:Name="OpenBottomTerminalButton"
                        Style="{StaticResource DeployRailButtonStyle}"
                        Content="&gt;_"
                        FontFamily="Consolas"
                        FontSize="12"
                        FontWeight="Bold"
                        ToolTip="{loc:T deploy.tip.terminal}"
                        Click="OpenBottomTerminalButton_Click" />
                <Button x:Name="OpenBottomLogsButton"
                        Style="{StaticResource DeployRailButtonStyle}"
                        Content="📋"
                        ToolTip="{loc:T deploy.tip.deployLogs}"
                        Click="OpenBottomLogsButton_Click" />
            </StackPanel>
        </Border>

        <!-- Left dock: Direct Upload -->
        <Border x:Name="LeftDockContainer"
                Grid.Column="1"
                Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="0,0,1,0"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Background="{StaticResource Surface.Shell}"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="0,0,0,1"
                        Padding="8,6">
                    <!-- Wrap so action icons drop under the title when the dock is narrow. -->
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="Direct Upload"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{StaticResource Text.Primary}"
                                   VerticalAlignment="Center"
                                   Margin="0,2,10,2" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ToggleUploadActionsButton"
                                    Content="🚀"
                                    Style="{StaticResource DeployRailButtonStyle}"
                                    Width="32"
                                    Height="32"
                                    MinWidth="32"
                                    MinHeight="32"
                                    Margin="0,0,4,0"
                                    ToolTip="{loc:T deploy.tip.uploadActions}"
                                    Click="ToggleUploadActionsButton_Click" />
                            <Button Content="🔄"
                                    Style="{StaticResource DeployRailButtonStyle}"
                                    Width="32"
                                    Height="32"
                                    MinWidth="32"
                                    MinHeight="32"
                                    Margin="0,0,4,0"
                                    ToolTip="{loc:T deploy.tip.refreshDisk}"
                                    Click="RefreshDirectUploadDock_Click" />
                            <Button Content="✕"
                                    Style="{StaticResource DeployRailButtonStyle}"
                                    Width="32"
                                    Height="32"
                                    MinWidth="32"
                                    MinHeight="32"
                                    Margin="0"
                                    ToolTip="{loc:T deploy.tip.collapseUpload}"
                                    Click="CollapseDirectUploadDock_Click" />
                        </StackPanel>
                    </WrapPanel>
                </Border>
                <controls:DirectUploadWorkspaceControl x:Name="DirectUploadDock"
                                                       Grid.Row="1"
                                                       CompactMode="True" />
            </Grid>
        </Border>

        <GridSplitter x:Name="LeftDockSplitter"
                      Grid.Column="2"
                      Width="8"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Background="{StaticResource Border.Strong}"
                      ShowsPreview="False"
                      Cursor="SizeWE"
                      Panel.ZIndex="30"
                      Visibility="Collapsed" />

        <!-- Center workspace (bottom Logs/Terminal lives in full-width overlay below) -->
        <Grid x:Name="CenterWorkspace" Grid.Column="3" Margin="10,0,10,0">
            <Grid x:Name="CenterContentHost" Margin="0,0,0,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="180" />
                </Grid.RowDefinitions>

                    <!-- Compact deploy toolbar: branches collapsed by default + rollback -->
                    <Border Grid.Row="0"
                            Background="{StaticResource Surface.Card}"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,6"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BranchSummaryButton"
                                            Style="{StaticResource App.Button.Ghost}"
                                            Height="32"
                                            Padding="10,0"
                                            Click="BranchSummaryButton_Click"
                                            ToolTip="{loc:T deploy.tip.branchToggle}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🌿"
                                                       FontSize="12"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:Name="BranchSummaryText"
                                                       Text="master → production"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Text.Primary}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:Name="BranchSummaryChevron"
                                                       Text=" ▾"
                                                       FontSize="11"
                                                       Foreground="{StaticResource Text.Muted}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="RollbackButton"
                                            Content="↩ Rollback"
                                            Height="32"
                                            Margin="8,0,0,0"
                                            Padding="12,0"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Style="{StaticResource App.Button.Ghost}"
                                            Foreground="{StaticResource Status.Warning}"
                                            ToolTip="{loc:T deploy.tip.rollback}"
                                            Click="RollbackButton_Click" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <CheckBox x:Name="SkipReviewCheckBox"
                                              Margin="0,0,0,6"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              FontSize="11"
                                              FontWeight="SemiBold"
                                              Foreground="{StaticResource Text.Secondary}"
                                              Visibility="Collapsed"
                                              ToolTip="{loc:T deploy.tip.skipReview}"
                                              Checked="SkipReviewCheckBox_Changed"
                                              Unchecked="SkipReviewCheckBox_Changed">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡"
                                                       FontSize="11"
                                                       Margin="0,0,5,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource Status.Warning}" />
                                            <TextBlock Text="Skip review"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource Text.Secondary}" />
                                        </StackPanel>
                                    </CheckBox>
                                    <Button x:Name="ActionButton"
                                            Content="🔍 COMPARE"
                                            MinWidth="168"
                                            Height="34"
                                            Padding="14,0"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Style="{StaticResource App.Button.Secondary}"
                                            Click="ActionButton_Click" />
                                    <Button x:Name="DeployButton"
                                            Content="🔄 SYNC"
                                            MinWidth="168"
                                            Height="34"
                                            Margin="0,6,0,0"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Style="{StaticResource App.Button.Primary}"
                                            Visibility="Collapsed"
                                            IsEnabled="False"
                                            Click="DeployButton_Click" />
                                    <Border x:Name="DeployPushBadge"
                                            Style="{StaticResource App.StatusBadge.Warning}"
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Stretch"
                                            Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="☁️" FontSize="11" Margin="0,0,6,0" Foreground="{StaticResource Status.Warning}" />
                                            <TextBlock x:Name="DeployPushBadgeText"
                                                       Text="Pending push"
                                                       FontSize="11"
                                                       Foreground="{StaticResource Status.Warning}"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Border x:Name="BranchDetailsPanel"
                                    Grid.Row="1"
                                    Margin="0,8,0,0"
                                    Padding="8,8,8,4"
                                    Background="{StaticResource Surface.Shell}"
                                    BorderBrush="{StaticResource Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="Collapsed">
                                <Grid x:Name="BranchRow">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="120" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="120" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="From"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Text.Muted}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <ComboBox x:Name="SourceBranchComboBox"
                                                  Grid.Column="1"
                                                  Height="32"
                                                  Style="{StaticResource App.InputComboBox}"
                                                  SelectionChanged="BranchComboBox_SelectionChanged" />
                                        <Button x:Name="NewBranchButton"
                                                Grid.Column="2"
                                                Content="+"
                                                Width="28"
                                                Height="28"
                                                Margin="6,0,0,0"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                ToolTip="{loc:T deploy.tip.createBranch}"
                                                Style="{StaticResource App.Button.Ghost}"
                                                Click="NewBranchButton_Click" />
                                    </Grid>

                                    <TextBlock Grid.Column="1"
                                               Text="→"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Text.Muted}"
                                               VerticalAlignment="Center"
                                               Margin="10,0" />

                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="To"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Text.Muted}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <ComboBox x:Name="TargetBranchComboBox"
                                                  Grid.Column="1"
                                                  Height="32"
                                                  Style="{StaticResource App.InputComboBox}"
                                                  SelectionChanged="BranchComboBox_SelectionChanged" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                    <ScrollViewer x:Name="CenterContentScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" MinHeight="160" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource App.CardStyle}"
                            Margin="0,0,0,12"
                            Padding="{StaticResource Spacing.CardPaddingDense}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,6">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Changed Files"
                                                   Style="{StaticResource App.SectionTitleTextStyle}"
                                                   FontSize="15"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />
                                        <CheckBox x:Name="SelectAllCheckBox"
                                                  Content="Select All"
                                                  FontSize="12"
                                                  Foreground="{StaticResource Text.Muted}"
                                                  VerticalAlignment="Center"
                                                  IsChecked="True"
                                                  Click="SelectAll_Click" />
                                        <Button x:Name="RefreshGitWorkingSetButton"
                                                Content="&#xE72C;"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="14"
                                                Style="{StaticResource DeployRailButtonStyle}"
                                                Foreground="{StaticResource Accent.Primary}"
                                                Width="28"
                                                Height="28"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                ToolTip="{loc:T deploy.tip.refreshGitWorkingSet}"
                                                Click="RefreshGitWorkingSet_Click" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="StatusText"
                                           Text="Ready to compare changes..."
                                           FontSize="12"
                                           Foreground="{StaticResource Text.Muted}"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <ListBox x:Name="FilesListBox"
                                     Grid.Row="1"
                                     ItemContainerStyle="{StaticResource App.ListBoxItem.Transparent}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SelectionMode="Single"
                                     SelectionChanged="FilesListBox_SelectionChanged"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     MinHeight="160">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Surface.Raised}"
                                                BorderBrush="{StaticResource Border.Subtle}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,5"
                                                Margin="0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📄" FontSize="13" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource Text.Secondary}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Button Content="VS"
                                                            Margin="6,0,0,0"
                                                            Padding="6,1"
                                                            FontSize="10"
                                                            Style="{StaticResource App.Button.Ghost}"
                                                            ToolTip="{loc:T deploy.tip.openInVs}"
                                                            Tag="{Binding}"
                                                            Click="OpenCodeButton_Click" />
                                                </StackPanel>
                                                <Border Grid.Column="2"
                                                        Background="{Binding StatusColor}"
                                                        CornerRadius="4"
                                                        Padding="6,2">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource Text.Primary}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Style="{StaticResource App.CardStyle}"
                            Padding="{StaticResource Spacing.CardPaddingDense}">
                        <StackPanel>
                            <TextBlock x:Name="ProgressText"
                                       Text="Waiting..."
                                       Style="{StaticResource App.MutedTextStyle}"
                                       Margin="0,0,0,8" />
                            <ProgressBar x:Name="DeployProgressBar"
                                         Height="8"
                                         Value="0"
                                         Maximum="100"
                                         Background="{StaticResource Surface.Input}"
                                         Foreground="{StaticResource Accent.Primary}"
                                         BorderThickness="0" />
                        </StackPanel>
                    </Border>
                        </Grid>
                    </ScrollViewer>

                    <Border x:Name="CenterEditorOverlayHost"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"
                            Background="{StaticResource Surface.Base}"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="6"
                            Panel.ZIndex="40"
                            Margin="0,0,0,0" />
                    </Grid>
            </Grid>
        </Grid>

        <GridSplitter x:Name="RemoteDockSplitter"
                      Grid.Column="4"
                      Width="8"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Background="{StaticResource Border.Strong}"
                      ShowsPreview="False"
                      Cursor="SizeWE"
                      Panel.ZIndex="30"
                      Visibility="Collapsed" />

        <!-- Right dock: FTP -->
        <Border x:Name="RemoteWorkspaceContainer"
                Grid.Column="5"
                Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1,0,0,0"
                Padding="8"
                Visibility="Collapsed">
            <controls:DeployRemoteWorkspaceControl x:Name="DeployRemoteWorkspace" />
        </Border>

        <!-- Right icon rail (above bottom overlay so it stays clickable) -->
        <Border Grid.Column="6"
                Panel.ZIndex="60"
                Background="{StaticResource Surface.Shell}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1,0,0,0">
            <StackPanel Margin="4,10,4,0" HorizontalAlignment="Center">
                <Button x:Name="ToggleRemoteWorkspaceButton"
                        Style="{StaticResource DeployRailButtonStyle}"
                        Content="🗂"
                        ToolTip="{loc:T deploy.tip.remoteHost}"
                        Click="ToggleRemoteWorkspaceButton_Click" />
            </StackPanel>
        </Border>

        <!-- Full-width bottom overlay: Logs + Terminal (over Direct Upload + FTP) -->
        <Grid x:Name="BottomDockShell"
              Grid.Column="0"
              Grid.ColumnSpan="7"
              Height="360"
              MinHeight="28"
              MaxHeight="900"
              Margin="60,0,60,0"
              VerticalAlignment="Bottom"
              Panel.ZIndex="55">
            <Grid.RowDefinitions>
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="BottomDockResizeGrip"
                    Grid.Row="0"
                    Background="{StaticResource Border.Strong}"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="0,1,0,0"
                    Cursor="SizeNS"
                    ToolTip="{loc:T deploy.resizeBottom}"
                    MouseLeftButtonDown="BottomDockResizeGrip_MouseLeftButtonDown"
                    MouseMove="BottomDockResizeGrip_MouseMove"
                    MouseLeftButtonUp="BottomDockResizeGrip_MouseLeftButtonUp"
                    LostMouseCapture="BottomDockResizeGrip_LostMouseCapture" />
            <Border x:Name="BottomDockContainer"
                    Grid.Row="1"
                    Background="{StaticResource Surface.Shell}"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource Surface.Shell}"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="0,0,0,1"
                            Padding="8,0">
                        <Grid>
                            <DockPanel LastChildFill="True" VerticalAlignment="Stretch">
                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button x:Name="ClearLogsButton"
                                            Content="Clear"
                                            Style="{StaticResource DeployDockIconButtonStyle}"
                                            Width="Auto"
                                            MinWidth="0"
                                            Padding="8,0"
                                            FontSize="11"
                                            ToolTip="{loc:T deploy.tip.clearLogs}"
                                            Click="ClearLogs_Click" />
                                    <Button x:Name="BottomCollapseButton"
                                            Content="−"
                                            Style="{StaticResource DeployDockIconButtonStyle}"
                                            FontSize="14"
                                            Margin="2,0,0,0"
                                            ToolTip="{loc:T deploy.tip.collapseBottom}"
                                            Click="ToggleBottomDockButton_Click" />
                                </StackPanel>

                                <TextBlock DockPanel.Dock="Left"
                                           Text="Console"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Text.Muted}"
                                           VerticalAlignment="Center"
                                           Margin="2,0,10,0" />

                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              VerticalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
                                        <Button x:Name="BottomLogsTabButton"
                                                Content="Logs"
                                                Style="{StaticResource DeployDockTabButtonStyle}"
                                                ToolTip="{loc:T deploy.tip.logsTab}"
                                                Click="BottomLogsTabButton_Click" />
                                        <StackPanel x:Name="TerminalSessionTabsPanel"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Stretch" />
                                        <Button x:Name="NewTerminalTabButton"
                                                Content="+"
                                                Style="{StaticResource DeployTerminalSplitButtonStyle}"
                                                FontWeight="SemiBold"
                                                ToolTip="{loc:T deploy.tip.newLocalTerminal}"
                                                Click="NewTerminalTabButton_Click" />
                                        <Button x:Name="NewTerminalMenuButton"
                                                Style="{StaticResource DeployTerminalPickerChevronStyle}"
                                                Click="NewTerminalMenuButton_Click">
                                            <Viewbox Width="9" Height="9" Stretch="Uniform">
                                                <Path Data="M0,0 L8,0 L4,6 Z"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </Viewbox>
                                        </Button>
                                        <Popup x:Name="NewTerminalPickerPopup"
                                               PlacementTarget="{Binding ElementName=NewTerminalMenuButton}"
                                               Placement="Top"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade"
                                               Opened="NewTerminalPickerPopup_Opened">
                                            <Border Background="{StaticResource Surface.Raised}"
                                                    BorderBrush="{StaticResource Border.Strong}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="8"
                                                    MinWidth="300"
                                                    MaxWidth="420"
                                                    MaxHeight="360">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="18" Opacity="0.35" Color="Black" ShadowDepth="3" />
                                                </Border.Effect>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                                        <TextBox x:Name="NewTerminalSearchBox"
                                                                 Height="30"
                                                                 Padding="8,4"
                                                                 FontSize="12"
                                                                 Style="{StaticResource App.InputTextBox}"
                                                                 VerticalContentAlignment="Center"
                                                                 TextChanged="NewTerminalSearchBox_TextChanged"
                                                                 PreviewKeyDown="NewTerminalSearchBox_PreviewKeyDown" />
                                                        <TextBlock x:Name="NewTerminalSearchHint"
                                                                   Text="Search Local or server…"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource Text.Muted}"
                                                                   Margin="12,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   IsHitTestVisible="False" />
                                                    </Grid>
                                                    <ListBox x:Name="NewTerminalPickerList"
                                                             Grid.Row="1"
                                                             MaxHeight="280"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                             MouseDoubleClick="NewTerminalPickerList_MouseDoubleClick"
                                                             KeyDown="NewTerminalPickerList_KeyDown">
                                                        <ListBox.ItemContainerStyle>
                                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource App.ListBoxItem.Transparent}">
                                                                <Setter Property="Padding" Value="8,6" />
                                                                <Setter Property="Margin" Value="0,1" />
                                                                <Setter Property="Cursor" Value="Hand" />
                                                                <EventSetter Event="PreviewMouseLeftButtonUp" Handler="NewTerminalPickerItem_PreviewMouseLeftButtonUp" />
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Button Grid.Column="0"
                                                                            Content="{Binding FavoriteGlyph}"
                                                                            Width="28"
                                                                            Height="28"
                                                                            Padding="0"
                                                                            Margin="0,0,4,0"
                                                                            FontSize="14"
                                                                            Foreground="{Binding FavoriteBrush}"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            Cursor="Hand"
                                                                            VerticalAlignment="Center"
                                                                            Visibility="{Binding FavoriteStarVisibility}"
                                                                            ToolTip="{Binding FavoriteToolTip}"
                                                                            Click="NewTerminalFavoriteButton_Click" />
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Title}"
                                                                                   FontSize="13"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource Text.Primary}"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding Subtitle}"
                                                                                   FontSize="11"
                                                                                   Foreground="{StaticResource Text.Muted}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Visibility="{Binding SubtitleVisibility}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Grid>
                                            </Border>
                                        </Popup>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="DeployLogsRow" Height="*" />
                            <RowDefinition x:Name="DeployTerminalRow" Height="0" />
                        </Grid.RowDefinitions>
                        <Border x:Name="BottomLogsPanel"
                                Grid.Row="0"
                                Background="{StaticResource Surface.Base}"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="0"
                                ClipToBounds="True">
                            <TextBox x:Name="LogTextBox"
                                     Style="{StaticResource App.LogTextBox}"
                                     Foreground="{StaticResource Text.Primary}"
                                     Text="Waiting for deployment...">
                                <TextBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy" Click="LogCopyMenu_Click" InputGestureText="Ctrl+C" />
                                        <MenuItem Header="Select All" Click="LogSelectAllMenu_Click" InputGestureText="Ctrl+A" />
                                        <Separator />
                                        <MenuItem Header="Clear" Click="ClearLogs_Click" />
                                    </ContextMenu>
                                </TextBox.ContextMenu>
                            </TextBox>
                        </Border>
                        <Border x:Name="BottomTerminalPanel"
                                Grid.Row="1"
                                Visibility="Collapsed">
                            <Grid x:Name="DeployTerminalHost" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
