<Page x:Class="GitDeployPro.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      Title="DashboardPage"
      Background="{StaticResource Surface.Base}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
        <StackPanel Margin="{StaticResource Spacing.PageMargin}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <TextBlock Text="📊" FontSize="30" VerticalAlignment="Center" Margin="0,0,14,0" />
                <StackPanel>
                    <TextBlock Text="Dashboard" Style="{StaticResource App.PageTitleTextStyle}" />
                    <TextBlock Text="At-a-glance project status, changes, and shortcuts."
                               Style="{StaticResource App.PageSubtitleTextStyle}" />
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource App.CardStyle}" Margin="{StaticResource Spacing.CardMargin}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="📁" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="Project Information"
                                   Style="{StaticResource App.SectionTitleTextStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="ProjectPathText"
                               Text="Path: Loading..."
                               Style="{StaticResource App.BodyTextStyle}"
                               Margin="0,4" />
                    <TextBlock x:Name="CurrentBranchText"
                               Text="Current Branch: master"
                               Style="{StaticResource App.BodyTextStyle}"
                               Margin="0,4" />
                    <Border x:Name="PushStatusBadge"
                            Style="{StaticResource App.StatusBadge.Warning}"
                            Margin="0,10,0,0"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☁️" FontSize="15" Margin="0,0,8,0" Foreground="{StaticResource Status.Warning}" />
                            <TextBlock x:Name="PushStatusText"
                                       Text="Push pending"
                                       FontSize="13"
                                       Foreground="{StaticResource Status.Warning}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource App.CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Changed Files"
                                   Style="{StaticResource App.CaptionTextStyle}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />
                        <TextBlock x:Name="ChangedFilesCount"
                                   Text="-"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource Accent.Primary}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource App.CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Total Commits"
                                   Style="{StaticResource App.CaptionTextStyle}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />
                        <TextBlock x:Name="CommitsCount"
                                   Text="-"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource Status.Success}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource App.CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Last Deploy"
                                   Style="{StaticResource App.CaptionTextStyle}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />
                        <TextBlock x:Name="LastDeployText"
                                   Text="-"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource Text.Primary}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Quick Actions"
                       Style="{StaticResource App.SectionTitleTextStyle}"
                       Margin="0,0,0,12" />

            <WrapPanel Margin="0,0,0,20">
                <Button MinWidth="170"
                        Margin="0,0,10,10"
                        Style="{StaticResource App.Button.Toolbar}"
                        Background="{StaticResource Accent.Primary}"
                        BorderBrush="{StaticResource Accent.Primary}"
                        Click="QuickDeploy_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🚀" Margin="0,0,8,0" />
                        <TextBlock Text="Start Deploy" />
                    </StackPanel>
                </Button>
                <Button MinWidth="170"
                        Margin="0,0,10,10"
                        Style="{StaticResource App.Button.Toolbar}"
                        Click="RefreshGit_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🔄" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh Git" />
                    </StackPanel>
                </Button>
                <Button MinWidth="170"
                        Margin="0,0,10,10"
                        Style="{StaticResource App.Button.Toolbar}"
                        Click="RunSetupWizard_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🛠" Margin="0,0,8,0" />
                        <TextBlock Text="Run Setup" />
                    </StackPanel>
                </Button>
                <Button MinWidth="170"
                        Margin="0,0,10,10"
                        Style="{StaticResource App.Button.Toolbar}"
                        Click="OpenSettings_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⚙️" Margin="0,0,8,0" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </Button>
            </WrapPanel>

            <TextBlock Text="Recent Activity"
                       Style="{StaticResource App.SectionTitleTextStyle}"
                       Margin="0,0,0,12" />
            <Border Style="{StaticResource App.CardStyle}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="📋" FontSize="16" Margin="0,0,10,0" />
                    <TextBlock Text="No recent activity found."
                               Style="{StaticResource App.MutedTextStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
