<Page x:Class="GitDeployPro.Pages.DatabasePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1366"
      Title="DatabasePage"
      Background="{StaticResource Surface.Base}">
    <Grid Background="{StaticResource Surface.Base}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Menu Bar -->
        <Border Grid.Row="0" Background="{StaticResource Surface.Card}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Primary Toolbar -->
                <Border Grid.Row="0" Background="{StaticResource Surface.Shell}" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Actions -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="NewConnectionButton" Height="34" Padding="14,0" Style="{StaticResource App.Button.Primary}" Foreground="{StaticResource Text.Primary}" Click="NewConnectionButton_Click" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➕" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="New Connection" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Background="{StaticResource Border.Subtle}" Margin="12,4"/>

                            <Button x:Name="SavedConnectionsButton" Height="34" Padding="14,0" Style="{StaticResource App.Button.Ghost}" Foreground="{StaticResource Text.Secondary}" Click="SavedConnectionsButton_Click" Cursor="Hand" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Saved"/>
                                    <TextBlock x:Name="SavedCountBadge" Text=" (0)" Foreground="{StaticResource Text.Muted}"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="LocalhostButton" Height="34" Padding="14,0" Style="{StaticResource App.Button.Success}" Foreground="{StaticResource Text.Inverse}" Click="LocalhostButton_Click" Cursor="Hand" ToolTip="Quick connect to localhost MySQL">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏠" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Localhost"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Center: Connection Status -->
                        <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusIndicator" Width="10" Height="10" Fill="{StaticResource Text.Muted}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ConnectionStatusText" Text="Not Connected" Foreground="{StaticResource Text.Muted}" FontSize="13"/>
                                <TextBlock x:Name="ActiveDatabaseText" Text="" Foreground="{StaticResource Accent.Primary}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Right Actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="RefreshButton" Height="34" Padding="12,0" Style="{StaticResource App.Button.Ghost}" Foreground="{StaticResource Text.Secondary}" Click="RefreshSchemaButton_Click" IsEnabled="False" Cursor="Hand" ToolTip="Refresh Schema">
                                <TextBlock Text="🔄" FontSize="14"/>
                            </Button>
                            <Button x:Name="SettingsButton" Height="34" Padding="12,0" Style="{StaticResource App.Button.Ghost}" Foreground="{StaticResource Text.Secondary}" Click="OpenConnectionManager_Click" Cursor="Hand" Margin="8,0,0,0" ToolTip="Connection Manager">
                                <TextBlock Text="⚙️" FontSize="14"/>
                            </Button>
                            <Button x:Name="DisconnectButton" Height="34" Padding="14,0" Style="{StaticResource App.Button.Danger}" Foreground="{StaticResource Text.Primary}" Click="DisconnectButton_Click" IsEnabled="False" Cursor="Hand" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏏" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Disconnect"/>
                                </StackPanel>
                            </Button>
                            <Button Content="🗖"
                                    Style="{StaticResource DetachPageButtonStyle}"
                                    Height="34"
                                    Width="40"
                                    Margin="8,0,0,0"
                                    ToolTip="Open in new window"
                                    Click="DetachDatabasePage_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Secondary Toolbar: Database & Table Selectors -->
                <Border x:Name="SelectorBar" Grid.Row="1" Background="{StaticResource Surface.Card}" Padding="12,8" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="🛢️ Database:" Grid.Column="0" Foreground="{StaticResource Text.Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="DatabaseSelector" Grid.Column="1" Height="30" SelectionChanged="DatabaseSelector_SelectionChanged"/>

                        <TextBlock Text="📋 Table:" Grid.Column="3" Foreground="{StaticResource Text.Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Grid Grid.Column="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="TableSearchBox"
                                     Grid.Row="0"
                                     Height="26"
                                     Margin="0,0,0,4"
                                     mah:TextBoxHelper.Watermark="Search tables"
                                     TextChanged="TableSearchBox_TextChanged"/>
                            <ComboBox x:Name="TableSelector"
                                      Grid.Row="1"
                                      Height="30"
                                      SelectionChanged="TableSelector_SelectionChanged"/>
                        </Grid>

                        <Button x:Name="TableActionsButton"
                                Grid.Column="5"
                                Content="⋮"
                                FontSize="18"
                                Width="34"
                                Height="34"
                                Margin="8,0,0,0"
                                Style="{StaticResource App.Button.Ghost}"
                                Foreground="{StaticResource Text.Secondary}"
                                Cursor="Hand"
                                Click="TableActionsButton_Click"
                                IsEnabled="False">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Truncate table" Click="TruncateTableMenuItem_Click"/>
                                    <MenuItem Header="Empty table (DELETE all rows)" Click="EmptyTableMenuItem_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Button x:Name="ToolbarProcessButton"
                                Grid.Column="6"
                                Content="SHOW PROCESSLIST"
                                Margin="12,0,0,0"
                                Padding="16,4"
                                Style="{StaticResource App.Button.Ghost}"
                                Foreground="{StaticResource Text.Secondary}"
                                Cursor="Hand"
                                ToolTip="Open the server process monitor"
                                Click="OpenProcessMonitorWindowFromToolbar_Click"/>

                        <ProgressBar x:Name="QueryProgress" Grid.Column="8" Width="150" Height="6" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <!-- Disconnected State -->
            <Grid x:Name="DisconnectedState" Visibility="Visible">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#171A1F" Offset="0"/>
                        <GradientStop Color="#232A35" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="500">
                    <TextBlock Text="🗄️" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="Database Studio" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Text.Primary}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Connect to MySQL/MariaDB databases, browse tables, run queries and manage your data with ease." Foreground="{StaticResource Text.Muted}" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" LineHeight="22"/>
                    
                    <Border Margin="0,40,0,0" Background="{StaticResource Surface.Card}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="12" Padding="24">
                        <StackPanel>
                            <TextBlock Text="Quick Start" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,16"/>
                            
                            <Button Height="44" Style="{StaticResource App.Button.Primary}" Foreground="{StaticResource Text.Primary}" Click="LocalhostButton_Click" Cursor="Hand" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏠" FontSize="16" Margin="0,0,10,0"/>
                                    <TextBlock Text="Connect to Localhost (127.0.0.1)" FontSize="14"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Height="44" Style="{StaticResource App.Button.Ghost}" Foreground="{StaticResource Text.Secondary}" Click="NewConnectionButton_Click" Cursor="Hand" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➕" FontSize="16" Margin="0,0,10,0"/>
                                    <TextBlock Text="New Custom Connection" FontSize="14"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Height="44" Style="{StaticResource App.Button.Ghost}" Foreground="{StaticResource Text.Secondary}" Click="SavedConnectionsButton_Click" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁" FontSize="16" Margin="0,0,10,0"/>
                                    <TextBlock Text="Open Saved Connection" FontSize="14"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Connected State: Database Content -->
            <ScrollViewer x:Name="DatabaseScrollViewer"
                          Visibility="Collapsed"
                          Margin="16"
                          VerticalScrollBarVisibility="Auto">
                <Grid x:Name="DatabaseContent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="140"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                <!-- Query Editor -->
                <Border Grid.Row="0" Background="{StaticResource Surface.Shell}" CornerRadius="8" Padding="6" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="8,4,0,6">
                            <TextBlock x:Name="TableTitleText" Text="SQL Editor" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text.Muted}"/>
                            <TextBlock Text=" · Ctrl+Space for autocomplete" FontSize="11" Foreground="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <avalon:TextEditor x:Name="SqlEditor" 
                                           Grid.Row="1"
                                           FontFamily="{StaticResource FontFamily.Mono}"
                                           FontSize="14"
                                           Background="{StaticResource Surface.Input}"
                                           Foreground="{StaticResource Text.Secondary}"
                                           ShowLineNumbers="True"
                                           LineNumbersForeground="{StaticResource Text.Muted}"
                                           HorizontalScrollBarVisibility="Auto"
                                           VerticalScrollBarVisibility="Auto"
                                           WordWrap="False"/>
                    </Grid>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
                    <Button x:Name="RunQueryButton"
                            Height="36"
                            Padding="20,0"
                            Style="{StaticResource App.Button.Primary}"
                            Foreground="{StaticResource Text.Primary}"
                            Click="RunQueryButton_Click"
                            FontWeight="SemiBold"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▶" Margin="0,0,8,0"/>
                            <TextBlock Text="Run Query"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ClearQueryButton" Content="Clear" Height="36" Padding="16,0" Style="{StaticResource App.Button.Ghost}" Foreground="{StaticResource Text.Secondary}" Click="ClearQueryButton_Click" Margin="10,0,0,0" Cursor="Hand"/>
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Timeout:" Foreground="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="TimeoutSelector"
                                  Width="120"
                                  SelectedValuePath="Tag"
                                  SelectionChanged="TimeoutSelector_SelectionChanged">
                            <ComboBoxItem Content="30 seconds" Tag="30"/>
                            <ComboBoxItem Content="60 seconds" Tag="60" IsSelected="True"/>
                            <ComboBoxItem Content="120 seconds" Tag="120"/>
                            <ComboBoxItem Content="5 minutes" Tag="300"/>
                            <ComboBoxItem Content="10 minutes" Tag="600"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <!-- Results Grid -->
                <Border Grid.Row="2" Background="{StaticResource Surface.Card}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="10">
                    <DataGrid x:Name="ResultsGrid"
                              Style="{StaticResource App.DataGrid}"
                              AutoGenerateColumns="True"
                              BorderThickness="0" />
                </Border>

                <!-- Create + Import row -->
                <Grid Grid.Row="3" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="0.95*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Create database card -->
                    <Border Grid.Column="0" Background="{StaticResource Surface.Card}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,12,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Create database" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                                <Border Background="{StaticResource Accent.Primary}" CornerRadius="4" Padding="6,2" Margin="12,0,0,0">
                                    <TextBlock Text="New" Foreground="White" FontSize="11"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Provision a schema on the connected server with your preferred charset + collation."
                                       Margin="0,4,0,12"
                                       Foreground="{StaticResource Text.Muted}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Database name"
                                           Width="140"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Text.Secondary}"/>
                                <TextBox x:Name="CreateDbNameBox"
                                         Width="220"
                                         Height="30"
                                         VerticalContentAlignment="Center"
                                         mah:TextBoxHelper.Watermark="e.g. project_live"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                <TextBlock Text="Charset"
                                           Width="140"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Text.Secondary}"/>
                                <ComboBox x:Name="CreateDbCharsetCombo"
                                          Width="220"
                                          Height="30"
                                          DisplayMemberPath="DisplayLabel"
                                          SelectionChanged="CreateDbCharsetCombo_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                                <TextBlock Text="Collation"
                                           Width="140"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Text.Secondary}"/>
                                <ComboBox x:Name="CreateDbCollationCombo"
                                          Width="220"
                                          Height="30"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CreateDatabaseButton"
                                        Content="Create database"
                                        Width="170"
                                        Height="36"
                                        Style="{StaticResource App.Button.Primary}"
                                        Foreground="{StaticResource Text.Primary}"
                                        FontWeight="SemiBold"
                                        Click="CreateDatabaseButton_Click"/>
                                <TextBlock x:Name="CreateDbStatusText"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Status.Info}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Import card -->
                    <Border Grid.Column="1" Background="{StaticResource Surface.Card}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="12,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Database import" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                                <Border Background="{StaticResource Accent.Secondary}" CornerRadius="4" Padding="6,2" Margin="12,0,0,0">
                                    <TextBlock Text="Beta" Foreground="White" FontSize="11"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Import .sql / .zip / .tar.gz backups directly into the active connection."
                                       Margin="0,4,0,12"
                                       Foreground="{StaticResource Text.Muted}"/>

                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="ImportFilePathBox"
                                         Width="420"
                                         Height="32"
                                         Margin="0,0,10,0"
                                         VerticalContentAlignment="Center"/>
                                <Button Content="Browse..."
                                        Width="110"
                                        Height="32"
                                        Style="{StaticResource App.Button.Primary}"
                                        Foreground="{StaticResource Text.Primary}"
                                        Click="BrowseImportFile_Click"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Target database"
                                           Width="140"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Text.Secondary}"/>
                                <ComboBox x:Name="ImportTargetCombo"
                                          Width="220"
                                          Height="30"
                                          IsEditable="False"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Import mode"
                                           Width="140"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Text.Secondary}"/>
                                <ComboBox x:Name="ImportModeCombo"
                                          Width="220"
                                          Height="30"
                                          SelectedIndex="1">
                                    <ComboBoxItem Content="Standard" Tag="Standard"/>
                                    <ComboBoxItem Content="Fast (disable checks)" Tag="Fast"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <CheckBox x:Name="ImportDropDatabaseCheck"
                                          Content="Drop &amp; recreate database before import"
                                          Foreground="{StaticResource Text.Primary}"/>
                                <CheckBox x:Name="ImportDisableFkCheck"
                                          Content="Disable foreign key checks"
                                          Margin="20,0,0,0"
                                          Foreground="{StaticResource Text.Primary}"
                                          IsChecked="True"/>
                                <CheckBox x:Name="ImportContinueOnErrorCheck"
                                          Content="Continue on errors"
                                          Margin="20,0,0,0"
                                          Foreground="{StaticResource Text.Primary}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="StartImportButton"
                                        Content="Start import"
                                        Width="150"
                                        Height="36"
                                        Style="{StaticResource App.Button.Success}"
                                        Foreground="{StaticResource Text.Inverse}"
                                        FontWeight="SemiBold"
                                        Click="StartImportButton_Click"/>
                                <Button x:Name="CancelImportButton"
                                        Content="Cancel"
                                        Width="120"
                                        Height="36"
                                        Margin="10,0,0,0"
                                        Style="{StaticResource App.Button.Danger}"
                                        Foreground="{StaticResource Text.Primary}"
                                        Click="CancelImportButton_Click"
                                        IsEnabled="False"/>
                            </StackPanel>

                            <ProgressBar x:Name="ImportProgressBar"
                                         Height="6"
                                         Margin="0,14,0,0"
                                         Visibility="Collapsed"/>
                            <TextBlock x:Name="ImportProgressText"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,6,0,0"/>
                            <TextBox x:Name="ImportLogBox"
                                     Margin="0,12,0,0"
                                     Height="120"
                                     Background="{StaticResource Surface.Input}"
                                     Foreground="{StaticResource Text.Secondary}"
                                     BorderThickness="0"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock x:Name="ResultStatusText" Grid.Row="4" Margin="0,10,0,0" Foreground="{StaticResource Text.Muted}"/>
                </Grid>
            </ScrollViewer>

            <!-- Loading Overlay -->
            <Border x:Name="LoadingOverlay" Background="{StaticResource Surface.Overlay}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⏳" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LoadingText" Text="Connecting..." Foreground="{StaticResource Text.Primary}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
