<mah:MetroWindow x:Class="GitDeployPro.Pages.BackupArtifactsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="Project backup artifacts"
                 Width="1140"
                 Height="560"
                 Background="{StaticResource Surface.Base}"
                 WindowStartupLocation="CenterOwner">
    <mah:MetroWindow.Resources>
        <Style x:Key="ArtifactStateTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
        </Style>
    </mah:MetroWindow.Resources>

    <Grid Margin="{StaticResource Spacing.CardPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Project backup artifacts"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Text.Primary}"
                       VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="⟳ Refresh"
                        Style="{StaticResource App.Button.Ghost}"
                        BorderBrush="{StaticResource Border.Strong}"
                        Margin="0,0,8,0"
                        Padding="10,6"
                        Click="RefreshButton_Click"/>
                <Button Content="🗁 Open File Explorer"
                        Style="{StaticResource App.Button.Primary}"
                        Padding="12,6"
                        Click="OpenExplorerButton_Click"/>
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="{Binding ArtifactFilesPathLabel}"
                       Style="{StaticResource App.CaptionTextStyle}"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ArtifactFilesStatus}"
                       Foreground="{StaticResource Text.Muted}"
                       FontSize="11"/>
        </StackPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding ProjectBackupFiles}"
                  SelectedItem="{Binding SelectedProjectBackupFile, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  Style="{StaticResource App.DataGrid}"
                  BorderThickness="0"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Captured time" Binding="{Binding CapturedAt}" Width="160"/>
                <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="140"/>

                <DataGridTemplateColumn Header="File" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FileName}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding FullPath}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Type" Binding="{Binding ArtifactType}" Width="90"/>

                <DataGridTemplateColumn Header="Verify" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ArtifactStateTextStyle}">
                                        <Setter Property="Text" Value="✖"/>
                                        <Setter Property="Foreground" Value="{StaticResource Status.Error}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                                <Setter Property="Text" Value="✔"/>
                                                <Setter Property="Foreground" Value="{StaticResource Status.Success}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Size" Binding="{Binding SizeLabel}" Width="100"/>
                <DataGridTextColumn Header="Last modified" Binding="{Binding LastModified}" Width="170"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</mah:MetroWindow>
