<Page x:Class="GitDeployPro.Pages.GitPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Git &amp; GitHub Integration"
      Background="{StaticResource Surface.Base}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
        <Grid Margin="{StaticResource Spacing.PageMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="🐱" FontSize="40" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="{StaticResource Text.Primary}"/>
                    <StackPanel>
                        <TextBlock Text="GitHub Integration" Style="{StaticResource App.PageTitleTextStyle}" />
                        <TextBlock Text="Repository sync, pull, push and release tags in one panel."
                                   Style="{StaticResource App.PageSubtitleTextStyle}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="🗖"
                            Style="{StaticResource DetachPageButtonStyle}"
                            Margin="0,0,8,0"
                            ToolTip="Open in new window"
                            Click="DetachGitPage_Click"/>

                    <Button x:Name="CloneRepoButton"
                            Height="40"
                            Padding="18,0"
                            Style="{StaticResource App.Button.Toolbar}"
                            Click="CloneRepoButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔗" FontSize="16" Margin="0,0,10,0" Foreground="{StaticResource Status.Info}"/>
                            <TextBlock Text="Clone / Connect" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource App.CardStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Remote Repository (origin):" Style="{StaticResource App.MutedTextStyle}" Margin="0,0,0,5"/>
                        <TextBlock x:Name="RemoteUrlText" Text="Loading..." Foreground="{StaticResource Status.Info}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="BranchText" Text="Current Branch: -" Foreground="{StaticResource Text.Secondary}" FontSize="13" Margin="0,10,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PullButton"
                                Content="⬇ Pull"
                                Width="100"
                                Height="40"
                                Margin="0,0,10,0"
                                Style="{StaticResource App.Button.Ghost}"
                                Click="PullButton_Click" />

                        <Button x:Name="PushButton"
                                Content="⬆ Push"
                                Width="100"
                                Height="40"
                                Style="{StaticResource App.Button.Primary}"
                                Click="PushButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource App.CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="🏷️" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Tags" Style="{StaticResource App.SectionTitleTextStyle}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ListBox x:Name="TagsListBox"
                                 Grid.Row="1"
                                 Style="{StaticResource App.ListBox.Host}"
                                 ItemContainerStyle="{StaticResource App.ListBoxItem.Card}"
                                 Foreground="{StaticResource Text.Primary}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                        <Button x:Name="PushTagsButton"
                                Grid.Row="2"
                                Content="⬆ Push All Tags"
                                Height="36"
                                Margin="0,15,0,0"
                                Style="{StaticResource App.Button.Toolbar}"
                                Click="PushTagsButton_Click" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource App.CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="➕" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Create New Tag" Style="{StaticResource App.SectionTitleTextStyle}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Tag Name (e.g. v1.0.0):" Style="{StaticResource App.MutedTextStyle}" Margin="0,0,0,6"/>
                        <TextBox x:Name="TagNameBox"
                                 Style="{StaticResource App.InputTextBox}"
                                 Margin="0,0,0,15"/>

                        <TextBlock Text="Description (Message):" Style="{StaticResource App.MutedTextStyle}" Margin="0,0,0,6"/>
                        <TextBox x:Name="TagMessageBox"
                                 Style="{StaticResource App.InputTextBox.Multiline}"
                                 MinHeight="80"
                                 Margin="0,0,0,20"/>

                        <Button x:Name="CreateTagButton"
                                Content="Create &amp; Push Tag"
                                Height="42"
                                Style="{StaticResource App.Button.Success}"
                                Click="CreateTagButton_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>

