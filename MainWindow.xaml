<Window x:Class="GitDeployPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Title="GitDeploy Pro"
        Height="650"
        Width="1100"
        Icon="icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        BorderThickness="0"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TitlebarControlButtonStyle" TargetType="Button" BasedOn="{StaticResource App.IconButton}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ControlBorder"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ControlBorder" Property="Background" Value="{StaticResource State.Hover}" />
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitlebarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitlebarControlButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Status.Error}" />
                    <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProjectPopupActionButtonStyle" TargetType="Button" BasedOn="{StaticResource App.Button.Ghost}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="{StaticResource State.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dense JetBrains-style nav popup rows -->
        <Style x:Key="NavPopupItemStyle" TargetType="Button" BasedOn="{StaticResource App.Button.Ghost}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource State.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            CornerRadius="16"
            Background="{StaticResource Surface.Base}"
            BorderBrush="{StaticResource Border.Subtle}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="ShellRootGrid" Grid.Row="0" Background="{StaticResource Surface.Base}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Compact JetBrains-style title bar -->
                <Border Grid.Row="0"
                        Background="{StaticResource Surface.Shell}"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0">
                            <Button x:Name="NavMenuButton"
                                    Style="{StaticResource App.IconButton}"
                                    Width="34"
                                    Height="30"
                                    Margin="0,0,6,0"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Background="Transparent"
                                    Foreground="{StaticResource Text.Primary}"
                                    Click="NavMenuButton_Click"
                                    MouseEnter="NavMenuButton_MouseEnter"
                                    MouseLeave="NavMenuButton_MouseLeave"
                                    ToolTip="Menu">
                                <TextBlock Text="☰"
                                           FontSize="15"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Button>

                            <Button x:Name="ProjectSelectorBtn"
                                    Style="{StaticResource App.Button.Ghost}"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Height="34"
                                    Padding="10,4"
                                    Margin="0,0,6,0"
                                    Click="ProjectSelectorBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="ProjectAvatarBorder"
                                            Width="20"
                                            Height="20"
                                            CornerRadius="6"
                                            Margin="0,0,8,0"
                                            Background="{StaticResource Accent.Primary}">
                                        <TextBlock x:Name="ProjectInitialText"
                                                   Text="P"
                                                   Foreground="{StaticResource Text.Primary}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="ProjectNameText"
                                               Text="MyProject"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Text.Primary}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="▼"
                                               FontSize="10"
                                               VerticalAlignment="Center"
                                               Margin="8,2,0,0"
                                               Foreground="{StaticResource Text.Muted}" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="OpenExplorerBtn"
                                    Style="{StaticResource App.IconButton}"
                                    Width="32"
                                    Height="30"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Background="Transparent"
                                    Foreground="{StaticResource Text.Primary}"
                                    Click="OpenExplorer_Click"
                                    ToolTip="Open in Explorer">
                                <TextBlock Text="📁"
                                           FontSize="15"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>

                        <!-- Navigation popup (hamburger) -->
                        <Popup x:Name="NavMenuPopup"
                               PlacementTarget="{Binding ElementName=NavMenuButton}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               Opened="NavMenuPopup_Opened">
                            <Border Background="{StaticResource Surface.Raised}"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource Border.Strong}"
                                    CornerRadius="8"
                                    Padding="6"
                                    MinWidth="240">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" Opacity="0.4" Color="Black" ShadowDepth="4" />
                                </Border.Effect>
                                <StackPanel x:Name="NavMenuItemsPanel">
                                    <Button x:Name="NavItemDashboard"
                                            Style="{StaticResource NavPopupItemStyle}"
                                            Tag="dashboard"
                                            Click="Dashboard_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📊" FontSize="13" Width="22" Margin="0,0,8,0" Foreground="{StaticResource Text.Muted}" />
                                            <TextBlock Text="Dashboard" FontSize="12.5" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="NavItemDeploy"
                                            Style="{StaticResource NavPopupItemStyle}"
                                            Tag="deploy"
                                            Click="Deploy_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🚀" FontSize="13" Width="22" Margin="0,0,8,0" Foreground="{StaticResource Text.Muted}" />
                                            <TextBlock Text="Deploy" FontSize="12.5" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="NavItemDirectUpload"
                                            Style="{StaticResource NavPopupItemStyle}"
                                            Tag="direct-upload"
                                            Click="DirectUpload_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📤" FontSize="13" Width="22" Margin="0,0,8,0" Foreground="{StaticResource Text.Muted}" />
                                            <TextBlock Text="Direct Upload" FontSize="12.5" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="NavItemDatabase"
                                            Style="{StaticResource NavPopupItemStyle}"
                                            Tag="database"
                                            Click="Database_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🛢️" FontSize="13" Width="22" Margin="0,0,8,0" Foreground="{StaticResource Text.Muted}" />
                                            <TextBlock Text="Database" FontSize="12.5" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="NavItemGit"
                                            Style="{StaticResource NavPopupItemStyle}"
                                            Tag="git"
                                            Click="Git_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🐱" FontSize="13" Width="22" Margin="0,0,8,0" Foreground="{StaticResource Text.Muted}" />
                                            <TextBlock Text="Git &amp; GitHub" FontSize="12.5" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="NavItemTerminal"
                                            Style="{StaticResource NavPopupItemStyle}"
                                            Tag="terminal"
                                            Click="Terminal_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💻" FontSize="13" Width="22" Margin="0,0,8,0" Foreground="{StaticResource Text.Muted}" />
                                            <TextBlock Text="Terminal" FontSize="12.5" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="NavItemBackup"
                                            Style="{StaticResource NavPopupItemStyle}"
                                            Tag="backup-scheduler"
                                            Click="BackupScheduler_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🗓️" FontSize="13" Width="22" Margin="0,0,8,0" Foreground="{StaticResource Text.Muted}" />
                                                <TextBlock Text="Backup Plans"
                                                           FontSize="12.5"
                                                           Foreground="{StaticResource Text.Primary}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Margin="10,0,0,0"
                                                    Padding="7,1"
                                                    CornerRadius="9"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding BackupMenuBadgeBackground, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <TextBlock Text="{Binding BackupMenuBadgeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding BackupMenuBadgeForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="NavItemHistory"
                                            Style="{StaticResource NavPopupItemStyle}"
                                            Tag="history"
                                            Click="History_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📜" FontSize="13" Width="22" Margin="0,0,8,0" Foreground="{StaticResource Text.Muted}" />
                                            <TextBlock Text="History" FontSize="12.5" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Separator Background="{StaticResource Border.Subtle}" Margin="4,6" Height="1" />

                                    <Button x:Name="NavItemSettings"
                                            Style="{StaticResource NavPopupItemStyle}"
                                            Tag="settings"
                                            Click="Settings_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚙️" FontSize="13" Width="22" Margin="0,0,8,0" Foreground="{StaticResource Text.Muted}" />
                                            <TextBlock Text="Settings" FontSize="12.5" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="NavItemAbout"
                                            Style="{StaticResource NavPopupItemStyle}"
                                            Tag="about"
                                            Click="About_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="ℹ️" FontSize="13" Width="22" Margin="0,0,8,0" Foreground="{StaticResource Text.Muted}" />
                                            <TextBlock Text="About" FontSize="12.5" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Project recent menu -->
                        <Popup x:Name="ProjectMenuPopup"
                               PlacementTarget="{Binding ElementName=ProjectSelectorBtn}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="{StaticResource Surface.Raised}"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource Border.Strong}"
                                    CornerRadius="12"
                                    Padding="8"
                                    MinWidth="300">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" Opacity="0.35" Color="Black" ShadowDepth="4" />
                                </Border.Effect>
                                <StackPanel>
                                    <Button Style="{StaticResource ProjectPopupActionButtonStyle}" Click="OpenProject_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📂" FontSize="14" Margin="0,0,10,0" Foreground="{StaticResource Accent.Primary}" />
                                            <TextBlock Text="Open project..." FontSize="13" Foreground="{StaticResource Text.Primary}" />
                                        </StackPanel>
                                    </Button>
                                    <Separator Background="{StaticResource Border.Subtle}" Margin="2,6" />
                                    <TextBlock Text="Recent Projects"
                                               FontSize="11"
                                               Foreground="{StaticResource Text.Muted}"
                                               Margin="10,4,0,6" />
                                    <ItemsControl x:Name="RecentProjectsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ProjectPopupActionButtonStyle}"
                                                        Click="RecentProject_Click"
                                                        Tag="{Binding Path}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="24"
                                                                Height="24"
                                                                CornerRadius="6"
                                                                Margin="0,0,10,0"
                                                                Background="{Binding ColorBrush}">
                                                            <TextBlock Text="{Binding Initial}"
                                                                       Foreground="{StaticResource Text.Primary}"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Text.Primary}" />
                                                            <TextBlock Text="{Binding Path}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource Text.Muted}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="320" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Content="─"
                                    Style="{StaticResource TitlebarControlButtonStyle}"
                                    Click="Minimize_Click" />
                            <Button Content="☐"
                                    Style="{StaticResource TitlebarControlButtonStyle}"
                                    Click="Maximize_Click" />
                            <Button Content="✕"
                                    Style="{StaticResource TitlebarCloseButtonStyle}"
                                    Click="Close_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Frame x:Name="ContentFrame"
                       Grid.Row="1"
                       NavigationUIVisibility="Hidden"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            </Grid>

            <!-- Update footer stays inside the window client area (above OS taskbar). -->
            <Border x:Name="UpdateFooterBar"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Background="{StaticResource Surface.Shell}"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="0,1,0,0"
                    Padding="14,10"
                    MinHeight="52">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateFooterTitle"
                                   Text="Downloading update..."
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Primary}" />
                        <ProgressBar x:Name="UpdateFooterProgress"
                                     Height="6"
                                     Margin="0,8,0,0"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0" />
                        <TextBlock x:Name="UpdateFooterDetail"
                                   Margin="0,6,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Muted}"
                                   TextWrapping="Wrap"
                                   Text="" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <Button x:Name="UpdateFooterCancelButton"
                                Content="Cancel"
                                MinWidth="88"
                                Height="32"
                                Margin="0,0,8,0"
                                Style="{StaticResource App.Button.Ghost}"
                                Click="UpdateFooterCancelButton_Click" />
                        <Button x:Name="UpdateFooterRestartButton"
                                Content="Restart now"
                                MinWidth="110"
                                Height="32"
                                Style="{StaticResource App.Button.Primary}"
                                Visibility="Collapsed"
                                Click="UpdateFooterRestartButton_Click" />
                        <Button x:Name="UpdateFooterLaterButton"
                                Content="Later"
                                MinWidth="80"
                                Height="32"
                                Margin="8,0,0,0"
                                Style="{StaticResource App.Button.Ghost}"
                                Visibility="Collapsed"
                                Click="UpdateFooterLaterButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
