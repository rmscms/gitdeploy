<Window x:Class="GitDeployPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Title="GitDeploy Pro"
        Height="650"
        Width="1100"
        Icon="icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        BorderThickness="0"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TitlebarControlButtonStyle" TargetType="Button" BasedOn="{StaticResource App.IconButton}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ControlBorder"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ControlBorder" Property="Background" Value="#253043" />
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitlebarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitlebarControlButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Status.Error}" />
                    <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProjectPopupActionButtonStyle" TargetType="Button" BasedOn="{StaticResource App.Button.Ghost}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#2D3950" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            CornerRadius="16"
            Background="{StaticResource Surface.Base}"
            BorderBrush="{StaticResource Border.Subtle}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border x:Name="SidebarPanel"
                    Grid.Column="0"
                    Background="{StaticResource Surface.Shell}"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Margin="18,26,18,22"
                            Background="#1D2B42"
                            BorderBrush="{StaticResource Border.Strong}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="44"
                                        Height="44"
                                        CornerRadius="12"
                                        Background="{StaticResource Accent.Primary}">
                                    <TextBlock Text="🚀"
                                               FontSize="20"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="12,2,0,0">
                                    <TextBlock Text="GitDeploy Pro"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Text.Primary}" />
                                    <TextBlock Text="Hybrid Fluent Workspace"
                                               FontSize="11"
                                               Foreground="{StaticResource Text.Muted}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="10,0,10,12">
                        <StackPanel>
                            <Button Style="{StaticResource App.SidebarNavButton}" Click="Dashboard_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊" FontSize="15" Margin="0,0,12,0" Foreground="{StaticResource Text.Muted}" />
                                    <TextBlock Text="Dashboard" FontSize="13" Foreground="{StaticResource Text.Secondary}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource App.SidebarNavButton}" Click="Deploy_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚀" FontSize="15" Margin="0,0,12,0" Foreground="{StaticResource Text.Muted}" />
                                    <TextBlock Text="Deploy" FontSize="13" Foreground="{StaticResource Text.Secondary}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource App.SidebarNavButton}" Click="DirectUpload_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📤" FontSize="15" Margin="0,0,12,0" Foreground="{StaticResource Text.Muted}" />
                                    <TextBlock Text="Direct Upload" FontSize="13" Foreground="{StaticResource Text.Secondary}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource App.SidebarNavButton}" Click="FtpExplorer_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗂️" FontSize="15" Margin="0,0,12,0" Foreground="{StaticResource Text.Muted}" />
                                    <TextBlock Text="FTP Explorer" FontSize="13" Foreground="{StaticResource Text.Secondary}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource App.SidebarNavButton}" Click="Database_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛢️" FontSize="15" Margin="0,0,12,0" Foreground="{StaticResource Text.Muted}" />
                                    <TextBlock Text="Database" FontSize="13" Foreground="{StaticResource Text.Secondary}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource App.SidebarNavButton}" Click="Git_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🐱" FontSize="15" Margin="0,0,12,0" Foreground="{StaticResource Text.Muted}" />
                                    <TextBlock Text="Git &amp; GitHub" FontSize="13" Foreground="{StaticResource Text.Secondary}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource App.SidebarNavButton}" Click="Terminal_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💻" FontSize="15" Margin="0,0,12,0" Foreground="{StaticResource Text.Muted}" />
                                    <TextBlock Text="Terminal" FontSize="13" Foreground="{StaticResource Text.Secondary}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource App.SidebarNavButton}" Click="BackupScheduler_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗓️" FontSize="15" Margin="0,0,12,0" Foreground="{StaticResource Text.Muted}" />
                                    <TextBlock Text="Backup Plans"
                                               FontSize="13"
                                               Foreground="{StaticResource Text.Secondary}"
                                               VerticalAlignment="Center" />
                                    <Border Margin="8,0,0,0"
                                            Padding="8,2"
                                            CornerRadius="10"
                                            VerticalAlignment="Center"
                                            Background="{Binding BackupMenuBadgeBackground, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock Text="{Binding BackupMenuBadgeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding BackupMenuBadgeForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource App.SidebarNavButton}" Click="History_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📜" FontSize="15" Margin="0,0,12,0" Foreground="{StaticResource Text.Muted}" />
                                    <TextBlock Text="History" FontSize="13" Foreground="{StaticResource Text.Secondary}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource App.SidebarNavButton}" Click="Settings_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️" FontSize="15" Margin="0,0,12,0" Foreground="{StaticResource Text.Muted}" />
                                    <TextBlock Text="Settings" FontSize="13" Foreground="{StaticResource Text.Secondary}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Content area -->
            <Grid Grid.Column="1" Background="{StaticResource Surface.Base}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource Surface.Shell}"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0">
                            <Button x:Name="SidebarToggleButton"
                                    Style="{StaticResource App.IconButton}"
                                    Width="34"
                                    Height="30"
                                    Margin="0,0,6,0"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Background="Transparent"
                                    Foreground="{StaticResource Text.Primary}"
                                    Click="SidebarToggleButton_Click"
                                    MouseEnter="SidebarToggleButton_MouseEnter"
                                    MouseLeave="SidebarToggleButton_MouseLeave"
                                    ToolTip="Toggle Sidebar">
                                <TextBlock x:Name="SidebarToggleIcon"
                                           Text="☰"
                                           FontSize="15"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Button>

                            <Button x:Name="ProjectSelectorBtn"
                                    Style="{StaticResource App.Button.Ghost}"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Height="34"
                                    Padding="10,4"
                                    Margin="0,0,6,0"
                                    Click="ProjectSelectorBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="ProjectAvatarBorder"
                                            Width="20"
                                            Height="20"
                                            CornerRadius="6"
                                            Margin="0,0,8,0"
                                            Background="{StaticResource Accent.Primary}">
                                        <TextBlock x:Name="ProjectInitialText"
                                                  Text="P"
                                                  Foreground="{StaticResource Text.Primary}"
                                                  FontSize="11"
                                                  FontWeight="Bold"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="ProjectNameText"
                                              Text="MyProject"
                                              FontSize="13"
                                              FontWeight="SemiBold"
                                              Foreground="{StaticResource Text.Primary}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="▼"
                                              FontSize="10"
                                              VerticalAlignment="Center"
                                              Margin="8,2,0,0"
                                              Foreground="{StaticResource Text.Muted}" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="OpenExplorerBtn"
                                    Style="{StaticResource App.IconButton}"
                                    Width="32"
                                    Height="30"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Background="Transparent"
                                    Foreground="{StaticResource Text.Primary}"
                                    Click="OpenExplorer_Click"
                                    ToolTip="Open in Explorer">
                                <TextBlock Text="📁"
                                           FontSize="15"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>

                        <Popup x:Name="ProjectMenuPopup"
                               PlacementTarget="{Binding ElementName=ProjectSelectorBtn}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="{StaticResource Surface.Raised}"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource Border.Strong}"
                                    CornerRadius="12"
                                    Padding="8"
                                    MinWidth="300">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" Opacity="0.35" Color="Black" ShadowDepth="4" />
                                </Border.Effect>
                                <StackPanel>
                                    <Button Style="{StaticResource ProjectPopupActionButtonStyle}" Click="OpenProject_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📂" FontSize="14" Margin="0,0,10,0" Foreground="{StaticResource Accent.Primary}" />
                                            <TextBlock Text="Open project..." FontSize="13" Foreground="{StaticResource Text.Primary}" />
                                        </StackPanel>
                                    </Button>
                                    <Separator Background="{StaticResource Border.Subtle}" Margin="2,6" />
                                    <TextBlock Text="Recent Projects"
                                               FontSize="11"
                                               Foreground="{StaticResource Text.Muted}"
                                               Margin="10,4,0,6" />
                                    <ItemsControl x:Name="RecentProjectsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ProjectPopupActionButtonStyle}"
                                                        Click="RecentProject_Click"
                                                        Tag="{Binding Path}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="24"
                                                                Height="24"
                                                                CornerRadius="6"
                                                                Margin="0,0,10,0"
                                                                Background="{Binding ColorBrush}">
                                                            <TextBlock Text="{Binding Initial}"
                                                                      Foreground="{StaticResource Text.Primary}"
                                                                      FontSize="12"
                                                                      FontWeight="Bold"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Text.Primary}" />
                                                            <TextBlock Text="{Binding Path}"
                                                                      FontSize="11"
                                                                      Foreground="{StaticResource Text.Muted}"
                                                                      TextTrimming="CharacterEllipsis"
                                                                      MaxWidth="320" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Content="─"
                                    Style="{StaticResource TitlebarControlButtonStyle}"
                                    Click="Minimize_Click" />
                            <Button Content="☐"
                                    Style="{StaticResource TitlebarControlButtonStyle}"
                                    Click="Maximize_Click" />
                            <Button Content="✕"
                                    Style="{StaticResource TitlebarCloseButtonStyle}"
                                    Click="Close_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Frame x:Name="ContentFrame"
                       Grid.Row="1"
                       NavigationUIVisibility="Hidden"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            </Grid>
        </Grid>
    </Border>
</Window>
