<Window x:Class="GitDeployPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:behaviors="clr-namespace:GitDeployPro.Behaviors"
        xmlns:loc="clr-namespace:GitDeployPro.Services.Localization"
        Title="GitDeploy Pro"
        Height="650"
        Width="1100"
        Icon="pack://application:,,,/gitDeployPro.ico"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        BorderThickness="0"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="HeaderNavIconButtonStyle" TargetType="Button" BasedOn="{StaticResource App.IconButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="100" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                ToolTip="{TemplateBinding ToolTip}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconBorder" Property="Background" Value="{StaticResource State.Hover}" />
                                <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitlebarControlButtonStyle" TargetType="Button" BasedOn="{StaticResource App.IconButton}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="100" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ControlBorder"
                                Background="{TemplateBinding Background}"
                                ToolTip="{TemplateBinding ToolTip}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ControlBorder" Property="Background" Value="{StaticResource State.Hover}" />
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitlebarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitlebarControlButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Status.Error}" />
                    <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProjectPopupActionButtonStyle" TargetType="Button" BasedOn="{StaticResource App.Button.Ghost}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="{StaticResource State.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dense JetBrains-style nav popup rows -->
        <Style x:Key="NavPopupItemStyle" TargetType="Button" BasedOn="{StaticResource App.Button.Ghost}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource State.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="ShellRootBorder"
            Margin="10"
            CornerRadius="16"
            Background="{DynamicResource Surface.Base}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Grid>
            <Border CornerRadius="15" BorderThickness="1" BorderBrush="{DynamicResource Shell.Glow}" IsHitTestVisible="False" Panel.ZIndex="10" />
            <Grid x:Name="ShellRootGrid">
                <Grid.Background>
                    <DrawingBrush Stretch="Fill">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="{DynamicResource Surface.Base}">
                                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1" /></GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing>
                                    <GeometryDrawing.Brush>
                                        <RadialGradientBrush Center="0.1,0" GradientOrigin="0.1,0" RadiusX="0.6" RadiusY="0.6">
                                            <GradientStop Color="{DynamicResource Color.Shell.AmbientA}" Offset="0" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </RadialGradientBrush>
                                    </GeometryDrawing.Brush>
                                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1" /></GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing>
                                    <GeometryDrawing.Brush>
                                        <RadialGradientBrush Center="0.95,1" GradientOrigin="0.95,1" RadiusX="0.6" RadiusY="0.6">
                                            <GradientStop Color="{DynamicResource Color.Shell.AmbientB}" Offset="0" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </RadialGradientBrush>
                                    </GeometryDrawing.Brush>
                                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1" /></GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Grid.Background>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Compact JetBrains-style title bar -->
                <Border Grid.Row="0"
                        Background="{StaticResource Surface.Shell}"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0">
                            <Button x:Name="NavMenuButton"
                                    Style="{StaticResource App.IconButton}"
                                    Width="34"
                                    Height="30"
                                    Margin="0,0,6,0"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Background="Transparent"
                                    Foreground="{StaticResource Text.Primary}"
                                    Click="NavMenuButton_Click"
                                    MouseEnter="NavMenuButton_MouseEnter"
                                    MouseLeave="NavMenuButton_MouseLeave"
                                    ToolTip="{loc:T nav.tip.menu}"
                                    ToolTipService.InitialShowDelay="400">
                                <Path behaviors:AppIcon.Kind="menu" behaviors:AppIcon.Size="16" />
                            </Button>

                            <Button x:Name="ProjectSelectorBtn"
                                    Style="{StaticResource App.Button.Ghost}"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Height="34"
                                    Padding="10,4"
                                    Margin="0,0,6,0"
                                    ToolTip="{loc:T nav.tip.project}"
                                    Click="ProjectSelectorBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="ProjectAvatarBorder"
                                            Width="20"
                                            Height="20"
                                            CornerRadius="6"
                                            Margin="0,0,8,0"
                                            Background="{StaticResource Accent.Primary}">
                                        <TextBlock x:Name="ProjectInitialText"
                                                   Text="P"
                                                   Foreground="{StaticResource Text.Primary}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="ProjectNameText"
                                               Text="MyProject"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Text.Primary}"
                                               VerticalAlignment="Center" />
                                    <Path behaviors:AppIcon.Kind="chevron-down" behaviors:AppIcon.Size="12" Margin="8,2,0,0" TextElement.Foreground="{DynamicResource Text.Muted}" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="HeaderDeployBtn"
                                    Style="{StaticResource HeaderNavIconButtonStyle}"
                                    Margin="2,0,6,0"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="Deploy_Click"
                                    ToolTip="{loc:T nav.tip.deploy}">
                                <Path behaviors:AppIcon.Kind="rocket" behaviors:AppIcon.Size="16" />
                            </Button>
                            <Button x:Name="OpenExplorerBtn"
                                    Style="{StaticResource HeaderNavIconButtonStyle}"
                                    Margin="0,0,6,0"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="OpenExplorer_Click"
                                    ToolTip="{loc:T nav.tip.openExplorer}">
                                <Path behaviors:AppIcon.Kind="folder-open" behaviors:AppIcon.Size="16" />
                            </Button>
                            <Button x:Name="HeaderLocalTerminalBtn"
                                    Style="{StaticResource HeaderNavIconButtonStyle}"
                                    Margin="0,0,6,0"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="HeaderLocalTerminal_Click"
                                    ToolTip="{loc:T nav.tip.localTerminal}">
                                <Path behaviors:AppIcon.Kind="terminal" behaviors:AppIcon.Size="16" />
                            </Button>
                            <Button x:Name="HeaderSettingsBtn"
                                    Style="{StaticResource HeaderNavIconButtonStyle}"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="Settings_Click"
                                    ToolTip="{loc:T nav.tip.settings}">
                                <Path behaviors:AppIcon.Kind="settings" behaviors:AppIcon.Size="16" />
                            </Button>
                            <Button x:Name="HeaderDatabaseBtn"
                                    Style="{StaticResource HeaderNavIconButtonStyle}"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="Database_Click"
                                    ToolTip="{loc:T nav.tip.databaseBackup}">
                                <Path behaviors:AppIcon.Kind="database" behaviors:AppIcon.Size="16" />
                            </Button>
                            <Button x:Name="HeaderCheckUpdatesBtn"
                                    Visibility="Collapsed"
                                    Style="{StaticResource HeaderNavIconButtonStyle}"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="CheckForUpdates_Click"
                                    ToolTip="{loc:T nav.tip.checkUpdates}">
                                <Path behaviors:AppIcon.Kind="refresh" behaviors:AppIcon.Size="16" />
                            </Button>
                        </StackPanel>

                        <!-- Navigation popup (hamburger) -->
                        <Popup x:Name="NavMenuPopup"
                               PlacementTarget="{Binding ElementName=NavMenuButton}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               Opened="NavMenuPopup_Opened"
                               Closed="NavMenuPopup_Closed">
                            <Border Background="{StaticResource Surface.Raised}"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource Border.Strong}"
                                    CornerRadius="8"
                                    Padding="6"
                                    MinWidth="240">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" Opacity="0.4" Color="Black" ShadowDepth="4" />
                                </Border.Effect>
                                <StackPanel x:Name="NavMenuItemsPanel">
                                    <Button ToolTip="{loc:T ui.tip.NavItemDeploy}" x:Name="NavItemDeploy"
                                            Style="{StaticResource NavPopupItemStyle}"
                                            Tag="deploy"
                                            Click="Deploy_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path behaviors:AppIcon.Kind="rocket" behaviors:AppIcon.Size="15" Margin="0,0,8,0" Opacity="0.75" />
                                            <TextBlock Text="{loc:T nav.deploy}" FontSize="12.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button ToolTip="{loc:T ui.tip.NavItemDashboard}" x:Name="NavItemDashboard"
                                            Style="{StaticResource NavPopupItemStyle}"
                                            Tag="dashboard"
                                            Click="Dashboard_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path behaviors:AppIcon.Kind="activity" behaviors:AppIcon.Size="15" Margin="0,0,8,0" Opacity="0.75" />
                                            <TextBlock Text="{loc:T nav.dashboard}" FontSize="12.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button ToolTip="{loc:T ui.tip.NavItemDirectUpload}" x:Name="NavItemDirectUpload"
                                            Style="{StaticResource NavPopupItemStyle}"
                                            Tag="direct-upload"
                                            Click="DirectUpload_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path behaviors:AppIcon.Kind="upload" behaviors:AppIcon.Size="15" Margin="0,0,8,0" Opacity="0.75" />
                                            <TextBlock Text="{loc:T nav.directUpload}" FontSize="12.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button ToolTip="{loc:T ui.tip.NavItemDatabase}" x:Name="NavItemDatabase"
                                            Style="{StaticResource NavPopupItemStyle}"
                                            Tag="database"
                                            Click="Database_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path behaviors:AppIcon.Kind="database" behaviors:AppIcon.Size="15" Margin="0,0,8,0" Opacity="0.75" />
                                            <TextBlock Text="{loc:T nav.database}" FontSize="12.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button ToolTip="{loc:T ui.tip.NavItemGit}" x:Name="NavItemGit"
                                            Style="{StaticResource NavPopupItemStyle}"
                                            Tag="git"
                                            Click="Git_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path behaviors:AppIcon.Kind="git-branch" behaviors:AppIcon.Size="15" Margin="0,0,8,0" Opacity="0.75" />
                                            <TextBlock Text="{loc:T nav.gitHub}" FontSize="12.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button ToolTip="{loc:T ui.tip.NavItemBackup}" x:Name="NavItemBackup"
                                            Style="{StaticResource NavPopupItemStyle}"
                                            Tag="backup-scheduler"
                                            Click="BackupScheduler_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Path behaviors:AppIcon.Kind="calendar" behaviors:AppIcon.Size="15" Margin="0,0,8,0" Opacity="0.75" />
                                                <TextBlock Text="{loc:T nav.backupPlans}"
                                                           FontSize="12.5"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Margin="10,0,0,0"
                                                    Padding="7,1"
                                                    CornerRadius="9"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding BackupMenuBadgeBackground, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <TextBlock Text="{Binding BackupMenuBadgeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding BackupMenuBadgeForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Button ToolTip="{loc:T ui.tip.NavItemHistory}" x:Name="NavItemHistory"
                                            Style="{StaticResource NavPopupItemStyle}"
                                            Tag="history"
                                            Click="History_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path behaviors:AppIcon.Kind="history" behaviors:AppIcon.Size="15" Margin="0,0,8,0" Opacity="0.75" />
                                            <TextBlock Text="{loc:T nav.history}" FontSize="12.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button ToolTip="{loc:T ui.tip.NavItemTelegram}" x:Name="NavItemTelegram"
                                            Style="{StaticResource NavPopupItemStyle}"
                                            Tag="telegram"
                                            Click="Telegram_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path behaviors:AppIcon.Kind="chat" behaviors:AppIcon.Size="15" Margin="0,0,8,0" Opacity="0.75" />
                                            <TextBlock Text="{loc:T nav.telegram}" FontSize="12.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Separator Background="{StaticResource Border.Subtle}" Margin="4,6" Height="1" />

                                    <Button ToolTip="{loc:T ui.tip.NavItemSettings}" x:Name="NavItemSettings"
                                            Style="{StaticResource NavPopupItemStyle}"
                                            Tag="settings"
                                            Click="Settings_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path behaviors:AppIcon.Kind="settings" behaviors:AppIcon.Size="15" Margin="0,0,8,0" Opacity="0.75" />
                                            <TextBlock Text="{loc:T nav.settings}" FontSize="12.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="NavItemCheckUpdates"
                                            Style="{StaticResource NavPopupItemStyle}"
                                            Tag="check-updates"
                                            Click="CheckForUpdates_Click"
                                            ToolTip="{loc:T nav.tip.checkUpdatesMenu}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path behaviors:AppIcon.Kind="refresh" behaviors:AppIcon.Size="15" Margin="0,0,8,0" Opacity="0.75" />
                                            <TextBlock Text="{loc:T about.checkUpdates}" FontSize="12.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button ToolTip="{loc:T ui.tip.NavItemAbout}" x:Name="NavItemAbout"
                                            Style="{StaticResource NavPopupItemStyle}"
                                            Tag="about"
                                            Click="About_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path behaviors:AppIcon.Kind="info" behaviors:AppIcon.Size="15" Margin="0,0,8,0" Opacity="0.75" />
                                            <TextBlock Text="{loc:T nav.about}" FontSize="12.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Separator Background="{StaticResource Border.Subtle}" Margin="4,6" Height="1" />

                                    <Button ToolTip="{loc:T ui.tip.NavItemExit}" x:Name="NavItemExit"
                                            Style="{StaticResource NavPopupItemStyle}"
                                            Tag="exit"
                                            Click="Exit_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path behaviors:AppIcon.Kind="power" behaviors:AppIcon.Size="15" Margin="0,0,8,0" TextElement.Foreground="{DynamicResource Status.Error}" />
                                            <TextBlock Text="{loc:T common.exit}" FontSize="12.5" Foreground="{DynamicResource Status.Error}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <TextBlock x:Name="NavAppVersionText"
                                               Text="Version —"
                                               FontSize="11"
                                               Foreground="{StaticResource Text.Muted}"
                                               Margin="12,2,12,4"
                                               HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Project recent menu -->
                        <Popup x:Name="ProjectMenuPopup"
                               PlacementTarget="{Binding ElementName=ProjectSelectorBtn}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="{StaticResource Surface.Raised}"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource Border.Strong}"
                                    CornerRadius="12"
                                    Padding="8"
                                    MinWidth="300">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" Opacity="0.35" Color="Black" ShadowDepth="4" />
                                </Border.Effect>
                                <StackPanel>
                                    <Button ToolTip="{loc:T ui.tip.OpenProject}" Style="{StaticResource ProjectPopupActionButtonStyle}" Click="OpenProject_Click">
                                        <Grid MinWidth="260">
                                            <StackPanel Orientation="Horizontal">
                                            <Path behaviors:AppIcon.Kind="folder-open" behaviors:AppIcon.Size="16" Margin="0,0,10,0" TextElement.Foreground="{DynamicResource Accent.Primary}" />
                                            <TextBlock Text="Open project..." FontSize="13" Foreground="{StaticResource Text.Primary}" />
                                        </StackPanel>
                                            <TextBlock Text="Ctrl+O" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Text.Muted}" />
                                        </Grid>
                                    </Button>
                                    <Separator Background="{StaticResource Border.Subtle}" Margin="2,6" />
                                    <TextBlock Text="Recent Projects"
                                               FontSize="11"
                                               Foreground="{StaticResource Text.Muted}"
                                               Margin="10,4,0,6" />
                                    <ItemsControl x:Name="RecentProjectsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button ToolTip="{loc:T ui.tip.RecentProject}" Style="{StaticResource ProjectPopupActionButtonStyle}"
                                                        Click="RecentProject_Click"
                                                        Tag="{Binding Path}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="24"
                                                                Height="24"
                                                                CornerRadius="6"
                                                                Margin="0,0,10,0"
                                                                Background="{Binding ColorBrush}">
                                                            <TextBlock Text="{Binding Initial}"
                                                                       Foreground="{StaticResource Text.Primary}"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Text.Primary}" />
                                                            <TextBlock Text="{Binding Path}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource Text.Muted}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="320" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button ToolTip="{loc:T ui.tip.MoreProjectsButton}" x:Name="MoreProjectsButton"
                                            Style="{StaticResource ProjectPopupActionButtonStyle}"
                                            Click="MoreProjects_Click"
                                            Visibility="Collapsed"
                                            Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path behaviors:AppIcon.Kind="search" behaviors:AppIcon.Size="16" Margin="0,0,10,0" TextElement.Foreground="{DynamicResource Accent.Primary}" />
                                            <TextBlock x:Name="MoreProjectsButtonText"
                                                       Text="More / Search…"
                                                       FontSize="13"
                                                       Foreground="{StaticResource Text.Primary}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button x:Name="HeaderUpdatePill"
                                    Click="CheckForUpdates_Click"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"
                                    ToolTip="{loc:T nav.tip.checkUpdates}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Pill"
                                                Height="26"
                                                Padding="10,0"
                                                CornerRadius="13"
                                                BorderThickness="1"
                                                BorderBrush="{StaticResource Accent.Soft}"
                                                Background="{StaticResource Accent.Soft}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Accent.Primary}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path behaviors:AppIcon.Kind="refresh" behaviors:AppIcon.Size="13" Margin="0,0,6,0" TextElement.Foreground="{DynamicResource Accent.Primary}" />
                                    <TextBlock x:Name="HeaderUpdatePillText" Text="v" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent.Primary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource TitlebarControlButtonStyle}"
                                    Click="Minimize_Click"
                                    ToolTip="{loc:T window.tip.minimize}">
                                <Path behaviors:AppIcon.Kind="minus" behaviors:AppIcon.Size="14" />
                            </Button>
                            <Button Style="{StaticResource TitlebarControlButtonStyle}"
                                    Click="Maximize_Click"
                                    ToolTip="{loc:T window.tip.maximize}">
                                <Path behaviors:AppIcon.Kind="square" behaviors:AppIcon.Size="13" />
                            </Button>
                            <Button Style="{StaticResource TitlebarCloseButtonStyle}"
                                    Click="Close_Click"
                                    ToolTip="{loc:T window.tip.close}">
                                <Path behaviors:AppIcon.Kind="x" behaviors:AppIcon.Size="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Frame x:Name="ContentFrame"
                       Grid.Row="1"
                       NavigationUIVisibility="Hidden"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            </Grid>
        </Grid>
    </Border>
</Window>
