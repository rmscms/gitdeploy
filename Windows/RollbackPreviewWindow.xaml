<Window x:Class="GitDeployPro.Windows.RollbackPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GitDeployPro.Controls"
        Title="Rollback Preview"
        Height="720"
        Width="1100"
        MinHeight="560"
        MinWidth="900"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">
    <Border Background="{StaticResource Surface.Raised}"
            CornerRadius="14"
            BorderBrush="{StaticResource Border.Strong}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="8" Opacity="0.4" />
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="↩"
                               FontSize="26"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Status.Warning}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Rollback commit"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Text.Primary}" />
                        <TextBlock Text="Browse older commits, preview file diffs, rollback one file or the whole commit."
                                   FontSize="12"
                                   Foreground="{StaticResource Text.Muted}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <Button Content="✕"
                        Width="30"
                        Height="30"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        Foreground="{StaticResource Text.Muted}"
                        BorderThickness="0"
                        FontSize="16"
                        Cursor="Hand"
                        Click="Cancel_Click" />
            </Grid>

            <Border Grid.Row="1"
                    Background="{StaticResource Surface.Card}"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="NewerCommitButton"
                                Content="← Newer"
                                Height="28"
                                Padding="10,0"
                                Margin="0,0,6,0"
                                Style="{StaticResource App.Button.Ghost}"
                                FontSize="11"
                                Click="NewerCommitButton_Click"
                                ToolTip="Go to a newer commit" />
                        <Button x:Name="OlderCommitButton"
                                Content="Older →"
                                Height="28"
                                Padding="10,0"
                                Style="{StaticResource App.Button.Ghost}"
                                FontSize="11"
                                Click="OlderCommitButton_Click"
                                ToolTip="Go further back in history" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Left"
                                    Background="{StaticResource Status.WarningSurface}"
                                    CornerRadius="4"
                                    Padding="8,3"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="CommitHashText"
                                           Text="—"
                                           FontFamily="{StaticResource FontFamily.Mono}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Status.Warning}" />
                            </Border>
                            <TextBlock x:Name="CommitMessageText"
                                       Text="Loading…"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Primary}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock x:Name="CommitMetaText"
                                   Margin="0,6,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Muted}"
                                   Text="" />
                    </StackPanel>

                    <TextBlock x:Name="CommitPositionText"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource Text.Muted}"
                               Text="" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" MinWidth="280" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.35*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource Surface.Card}"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="2,0,2,8">
                            <TextBlock Text="Files in commit"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Secondary}" />
                            <TextBlock x:Name="FileCountText"
                                       DockPanel.Dock="Right"
                                       HorizontalAlignment="Right"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Text.Primary}"
                                       Text="0" />
                        </DockPanel>
                        <ListBox x:Name="FilesListBox"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemContainerStyle="{StaticResource App.ListBoxItem.Transparent}"
                                 SelectionChanged="FilesListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Surface.Raised}"
                                            BorderBrush="{StaticResource Border.Subtle}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,7"
                                            Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Icon}"
                                                       FontSize="13"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayPath}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource Text.Secondary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{Binding DisplayPath}" />
                                            <Border Grid.Column="2"
                                                    Background="{Binding StatusBrush}"
                                                    CornerRadius="4"
                                                    Padding="7,2"
                                                    Margin="8,0,0,0">
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource Text.Primary}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Background="{StaticResource Surface.Card}"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="4">
                    <controls:DiffViewer x:Name="FileDiffViewer"
                                         EmptyMessage="Select a file to preview the code diff" />
                </Border>
            </Grid>

            <CheckBox x:Name="RedeployCheckBox"
                      Grid.Row="3"
                      Margin="0,12,0,0"
                      IsChecked="True"
                      FontSize="12"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource Text.Secondary}"
                      Content="Also redeploy affected files to FTP after rollback" />

            <DockPanel Grid.Row="4" Margin="0,14,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        x:Name="RollbackFileButton"
                        Content="↩ Rollback this file"
                        Height="36"
                        MinWidth="170"
                        Style="{StaticResource App.Button.Ghost}"
                        FontWeight="SemiBold"
                        IsEnabled="False"
                        ToolTip="Create a new commit that undoes only the selected file"
                        Click="RollbackFileButton_Click" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel"
                            Height="36"
                            MinWidth="100"
                            Margin="0,0,10,0"
                            Style="{StaticResource App.Button.Ghost}"
                            Click="Cancel_Click" />
                    <Button x:Name="ConfirmButton"
                            Content="↩ Rollback whole commit"
                            Height="36"
                            MinWidth="200"
                            Style="{StaticResource App.Button.Primary}"
                            FontWeight="Bold"
                            ToolTip="git revert the selected commit, then push"
                            Click="RollbackCommitButton_Click" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
