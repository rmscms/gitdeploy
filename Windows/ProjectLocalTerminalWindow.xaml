<mah:MetroWindow x:Class="GitDeployPro.Windows.ProjectLocalTerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GitDeployPro.Controls"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:GitDeployPro.Services.Localization"
        Title="{loc:T terminal.projectLocalTitle}"
        Height="560"
        Width="920"
        MinHeight="360"
        MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface.Base}"
        Foreground="{StaticResource Text.Primary}"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        BorderThickness="1"
        BorderBrush="{StaticResource Border.Subtle}"
        ShowIconOnTitleBar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="10" Height="10" CornerRadius="5" Background="#13A10E" Margin="0,0,10,0" />
                    <TextBlock Text="{loc:T terminal.projectLocalBadge}"
                               FontWeight="SemiBold"
                               FontSize="12.5"
                               Foreground="{StaticResource Text.Primary}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="PathText"
                           Grid.Column="1"
                           Margin="16,0,12,0"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="#16C60C"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

                <Button Grid.Column="2"
                        Style="{StaticResource App.Button.Ghost}"
                        Height="28"
                        Padding="10,0"
                        Click="RestartShell_Click"
                        ToolTip="{loc:T terminal.projectLocalRestartTip}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" Margin="0,0,6,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="{loc:T terminal.projectLocalRestart}" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="#0C0C0C"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="0"
                Margin="0">
            <controls:TerminalControl x:Name="LocalTerminal" ShowCommandBar="True" />
        </Border>
    </Grid>
</mah:MetroWindow>
