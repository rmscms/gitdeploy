<Window x:Class="GitDeployPro.Windows.HistoryDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deployment Details" Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{StaticResource Surface.Raised}" 
            CornerRadius="14" 
            BorderBrush="{StaticResource Border.Strong}" 
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="8" Opacity="0.45"/>
        </Border.Effect>

        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📋" FontSize="28" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock Text="Deployment Details" 
                              FontSize="24" 
                              FontWeight="Bold" 
                              Foreground="{StaticResource Text.Primary}"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" Content="✕" 
                        Width="30" Height="30" 
                        Background="Transparent" 
                        Foreground="{StaticResource Text.Muted}" 
                        BorderThickness="0"
                        FontSize="16"
                        Cursor="Hand"
                        Click="Close_Click"/>
            </Grid>

            <!-- Info Summary -->
            <Border Grid.Row="1" Background="{StaticResource Surface.Card}" CornerRadius="10" Padding="20" Margin="0,0,0,20" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Status" FontSize="13" Foreground="{StaticResource Text.Muted}" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StatusIcon" Text="✅" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusText" Text="Success" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Status.Success}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Branch" FontSize="13" Foreground="{StaticResource Text.Muted}" Margin="0,0,0,5"/>
                        <TextBlock x:Name="BranchText" Text="master" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Date" FontSize="13" Foreground="{StaticResource Text.Muted}" Margin="0,0,0,5"/>
                        <TextBlock x:Name="DateText" Text="2024/11/27 14:30" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- File List -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Changed Files (12)" 
                          FontSize="16" 
                          FontWeight="SemiBold" 
                          Foreground="{StaticResource Text.Primary}"
                          Margin="0,0,0,15"/>

                <Border Grid.Row="1" Background="{StaticResource Surface.Card}" CornerRadius="10" Padding="15" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FilesListContainer">
                            <!-- Items will be added dynamically -->
                            <TextBlock Text="Loading files..." Foreground="{StaticResource Text.Muted}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,0,0">
                <Button Content="Rollback to this version" 
                        Height="40" 
                        Padding="20,0"
                        Style="{StaticResource App.Button.Danger}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Margin="0,0,15,0"
                        Click="Rollback_Click"/>

                <Button Content="Close" 
                        Height="40" 
                        Width="100"
                        Style="{StaticResource App.Button.Primary}"
                        FontSize="13"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

