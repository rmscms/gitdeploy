<mah:MetroWindow x:Class="GitDeployPro.Windows.PathMappingModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Title="Path Mapping"
        Width="640"
        MinWidth="560"
        MinHeight="420"
        MaxHeight="640"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Surface.Base}"
        Foreground="{StaticResource Text.Primary}"
        WindowTitleBrush="{StaticResource Surface.Card}"
        NonActiveWindowTitleBrush="{StaticResource Surface.Card}">
    <mah:MetroWindow.Resources>
        <Style x:Key="Mapping.IconButton" TargetType="Button" BasedOn="{StaticResource App.Button.Ghost}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="Mapping.IconButton.Danger" TargetType="Button" BasedOn="{StaticResource Mapping.IconButton}">
            <Setter Property="Foreground" Value="{StaticResource Status.Error}" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </mah:MetroWindow.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="ProfileNameText"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Text.Primary}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="ClickedPathText"
                       Margin="0,4,0,0"
                       FontSize="12"
                       FontFamily="{StaticResource FontFamily.Mono}"
                       Foreground="{StaticResource Text.Muted}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8"
                MinHeight="120"
                MaxHeight="240">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="4,0,4,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Local"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Muted}" />
                    <TextBlock Grid.Column="1"
                               Text="Remote"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Muted}" />
                    <TextBlock Grid.Column="2"
                               Text=""
                               FontSize="11" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="MappingsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1" MinHeight="28">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding LocalPath}"
                                               FontSize="12"
                                               FontFamily="{StaticResource FontFamily.Mono}"
                                               Foreground="{StaticResource Text.Primary}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="4,0,8,0"
                                               ToolTip="{Binding LocalPath}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding RemotePath}"
                                               FontSize="12"
                                               FontFamily="{StaticResource FontFamily.Mono}"
                                               Foreground="{StaticResource Text.Secondary}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,8,0"
                                               ToolTip="{Binding RemotePath}" />
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button Content="✎"
                                                Style="{StaticResource Mapping.IconButton}"
                                                Tag="{Binding}"
                                                Click="EditMapping_Click"
                                                ToolTip="Edit mapping" />
                                        <Button Content="🗑"
                                                Style="{StaticResource Mapping.IconButton.Danger}"
                                                Tag="{Binding}"
                                                Click="DeleteMapping_Click"
                                                ToolTip="Delete mapping" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyHintText"
                           Grid.Row="1"
                           Text="No mappings yet. Save below to add the first one for this folder."
                           FontSize="12"
                           Foreground="{StaticResource Text.Muted}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="16"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Background="{StaticResource Surface.Raised}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="FormTitleText"
                           Text="New mapping"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Text.Primary}"
                           Margin="0,0,0,8" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Local (project folder)"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="LocalPathBox"
                                 Style="{StaticResource App.InputTextBox}"
                                 Height="32"
                                 mah:TextBoxHelper.Watermark="/" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Remote (FTP folder)"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="RemotePathBox"
                                 Style="{StaticResource App.InputTextBox}"
                                 Height="32"
                                 FontFamily="{StaticResource FontFamily.Mono}"
                                 mah:TextBoxHelper.Watermark="/public_html" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">
                    <Button x:Name="SaveMappingButton"
                            Content="Save mapping"
                            Width="130"
                            Height="32"
                            Margin="0,0,8,0"
                            Style="{StaticResource App.Button.Primary}"
                            Click="SaveMapping_Click" />
                    <Button Content="Cancel"
                            Width="90"
                            Height="32"
                            Style="{StaticResource App.Button.Ghost}"
                            Click="CancelForm_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Close"
                    Width="90"
                    Height="32"
                    Style="{StaticResource App.Button.Ghost}"
                    IsCancel="True"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
