<Window x:Class="GitDeployPro.Windows.CloneRepoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clone Repository" Height="520" Width="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{StaticResource Surface.Raised}"
            CornerRadius="14"
            BorderBrush="{StaticResource Border.Strong}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="8" Opacity="0.45"/>
        </Border.Effect>

        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="🔗" FontSize="28" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <StackPanel>
                        <TextBlock Text="Clone or Connect Repository"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Text.Primary}"/>
                        <TextBlock Text="Build the remote URL automatically and pick a destination."
                                   Foreground="{StaticResource Text.Muted}"
                                   FontSize="13"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="✕"
                        Grid.Column="1"
                        Width="36"
                        Height="36"
                        Background="Transparent"
                        Foreground="{StaticResource Text.Muted}"
                        BorderThickness="0"
                        FontSize="16"
                        Cursor="Hand"
                        Click="Close_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource State.Hover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="Repository (owner/name or full URL)"
                           Foreground="{StaticResource Text.Secondary}"
                           FontSize="14"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="RepoInputTextBox"
                         Height="40"
                         Style="{StaticResource App.InputTextBox}"
                         Padding="10"
                         FontSize="13"
                         Margin="0,6,0,2"
                         TextChanged="RepoInputTextBox_TextChanged"/>
                <TextBlock Text="Example: rmscms/gitdeploy or https://github.com/rmscms/gitdeploy.git"
                           Foreground="{StaticResource Text.Muted}"
                           FontSize="12"
                           Margin="0,0,0,16"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Host" Foreground="{StaticResource Text.Secondary}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox x:Name="HostTextBox"
                                 Height="36"
                                 Style="{StaticResource App.InputTextBox}"
                                 Padding="10,0"
                                 FontSize="13"
                                 TextChanged="HostTextBox_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Protocol" Foreground="{StaticResource Text.Secondary}" FontSize="13" FontWeight="SemiBold"/>
                        <ComboBox x:Name="ProtocolComboBox"
                                  Height="36"
                                  Style="{StaticResource App.InputComboBox}"
                                  SelectionChanged="ProtocolComboBox_SelectionChanged">
                            <ComboBoxItem Content="HTTPS" IsSelected="True"/>
                            <ComboBoxItem Content="SSH"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Remote URL Preview"
                           Foreground="{StaticResource Text.Secondary}"
                           FontSize="14"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="PreviewUrlTextBox"
                         Height="40"
                         Style="{StaticResource App.InputTextBox}"
                         Foreground="{StaticResource Status.Info}"
                         Padding="10"
                         FontSize="13"
                         Margin="0,6,0,16"
                         IsReadOnly="True"/>

                <TextBlock Text="Local Target Folder"
                           Foreground="{StaticResource Text.Secondary}"
                           FontSize="14"
                           FontWeight="SemiBold"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="LocalPathTextBox"
                             Grid.Column="0"
                             Height="40"
                             Style="{StaticResource App.InputTextBox}"
                             Padding="10"
                             FontSize="13"
                             TextChanged="LocalPathTextBox_TextChanged"/>
                    <Button Content="Use Default"
                            Grid.Column="1"
                            Height="40"
                            Margin="10,0,0,0"
                            Padding="12,0"
                            Style="{StaticResource App.Button.Ghost}"
                            Foreground="{StaticResource Text.Secondary}"
                            Cursor="Hand"
                            Click="UseDefaultPath_Click"/>
                    <Button Content="Browse"
                            Grid.Column="2"
                            Height="40"
                            Margin="10,0,0,0"
                            Padding="20,0"
                            Style="{StaticResource App.Button.Success}"
                            Foreground="{StaticResource Text.Inverse}"
                            Cursor="Hand"
                            Click="BrowseLocalButton_Click"/>
                </Grid>
                <TextBlock Text="We will create this folder if needed."
                           Foreground="{StaticResource Text.Muted}"
                           FontSize="12"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Cancel"
                        Height="42"
                        Width="110"
                        Margin="0,0,15,0"
                        Style="{StaticResource App.Button.Ghost}"
                        Foreground="{StaticResource Text.Secondary}"
                        Cursor="Hand"
                        Click="Close_Click"/>
                <Button x:Name="CloneButton"
                        Content="🚀 Clone Now"
                        Height="42"
                        Width="150"
                        Style="{StaticResource App.Button.Primary}"
                        Foreground="{StaticResource Text.Primary}"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="CloneButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

