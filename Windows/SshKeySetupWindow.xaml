<mah:MetroWindow x:Class="GitDeployPro.Windows.SshKeySetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Title="SSH key for Git"
        Width="560"
        MinHeight="420"
        MaxHeight="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Surface.Base}"
        Foreground="{StaticResource Text.Primary}"
        WindowTitleBrush="{StaticResource Surface.Card}"
        NonActiveWindowTitleBrush="{StaticResource Surface.Card}"
        Loaded="Window_Loaded">
    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Connect Git over SSH"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Text.Primary}"/>
            <TextBlock x:Name="SubtitleText"
                       Text="Find an existing key, or generate one and add it on GitHub / GitLab."
                       FontSize="12"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource Text.Secondary}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{StaticResource Surface.Raised}"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Status"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Muted}"
                                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="StatusText"
                                   Text="Checking SSH on this PC..."
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource Text.Primary}"/>
                        <TextBlock x:Name="DetailsText"
                                   FontSize="11"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   FontFamily="{StaticResource FontFamily.Mono}"
                                   Foreground="{StaticResource Text.Muted}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Private key"
                           FontSize="11"
                           Margin="0,0,0,6"
                           Style="{StaticResource App.MutedTextStyle}"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="KeyPathTextBox"
                             Grid.Column="0"
                             Style="{StaticResource App.InputTextBox}"
                             VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="Browse"
                            Width="88"
                            Height="32"
                            Margin="8,0,0,0"
                            Style="{StaticResource App.Button.Ghost}"
                            Click="BrowseButton_Click"/>
                    <Button Grid.Column="2"
                            Content="Generate"
                            Width="96"
                            Height="32"
                            Margin="8,0,0,0"
                            Style="{StaticResource App.Button.Ghost}"
                            Click="GenerateButton_Click"/>
                </Grid>

                <TextBlock Text="Public key (.pub)"
                           FontSize="11"
                           Margin="0,0,0,6"
                           Style="{StaticResource App.MutedTextStyle}"/>
                <TextBox x:Name="PublicKeyTextBox"
                         Style="{StaticResource App.InputTextBox.Multiline}"
                         Height="72"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         FontFamily="{StaticResource FontFamily.Mono}"
                         FontSize="11"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="Copy public key"
                            Height="32"
                            Padding="12,0"
                            Style="{StaticResource App.Button.Ghost}"
                            Click="CopyPublicKeyButton_Click"/>
                    <Button x:Name="OpenHostKeysButton"
                            Content="Open GitHub SSH keys"
                            Height="32"
                            Padding="12,0"
                            Margin="8,0,0,0"
                            Style="{StaticResource App.Button.Ghost}"
                            Click="OpenHostKeysButton_Click"/>
                </StackPanel>

                <TextBlock TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{StaticResource Text.Secondary}"
                           Margin="0,0,0,4">
                    <Run Text="Paste the public key on the host, then Test. Passphrase keys need Windows OpenSSH Authentication Agent, or generate a key without a passphrase."/>
                </TextBlock>
                <TextBlock x:Name="HostKeysHintText"
                           FontSize="11"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Accent.Primary}"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TestResultText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{StaticResource Text.Secondary}"/>
            <Button Grid.Column="1"
                    Content="Cancel"
                    Width="90"
                    Height="32"
                    Margin="8,0,8,0"
                    Style="{StaticResource App.Button.Ghost}"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
            <Button x:Name="TestButton"
                    Grid.Column="2"
                    Content="Test connection"
                    Width="140"
                    Height="32"
                    Style="{StaticResource App.Button.Primary}"
                    Foreground="{StaticResource Text.Primary}"
                    IsDefault="True"
                    Click="TestButton_Click"/>
        </Grid>
    </Grid>
</mah:MetroWindow>
