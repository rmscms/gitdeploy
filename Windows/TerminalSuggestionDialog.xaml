<mah:MetroWindow x:Class="GitDeployPro.Windows.TerminalSuggestionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Title="Terminal command"
        MinHeight="360"
        MaxHeight="520"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Surface.Base}"
        Foreground="{StaticResource Text.Primary}"
        WindowTitleBrush="{StaticResource Surface.Card}"
        NonActiveWindowTitleBrush="{StaticResource Surface.Card}">
    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Scope for this command"
                   FontWeight="SemiBold"
                   FontSize="13"
                   Margin="0,0,0,8" />
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <RadioButton x:Name="GlobalScopeRadio"
                         Content="Global — available in all projects"
                         GroupName="Scope"
                         IsChecked="True"
                         Foreground="{StaticResource Text.Secondary}"
                         FontSize="12"
                         Margin="0,0,0,6" />
            <RadioButton x:Name="ProjectScopeRadio"
                         GroupName="Scope"
                         Foreground="{StaticResource Text.Secondary}"
                         FontSize="12" />
            <TextBlock x:Name="ProjectScopeHint"
                       Text="This project only"
                       Foreground="{StaticResource Text.Muted}"
                       FontSize="11"
                       Margin="22,4,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Command" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
        <TextBox x:Name="CommandTextBox"
                 Grid.Row="3"
                 Style="{StaticResource App.InputTextBox}"
                 FontFamily="{StaticResource FontFamily.Mono}"
                 Height="32"
                 Margin="0,0,0,12"
                 KeyDown="Input_KeyDown" />

        <TextBlock Grid.Row="4" Text="Description" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
        <TextBox x:Name="DescriptionTextBox"
                 Grid.Row="5"
                 Style="{StaticResource App.InputTextBox}"
                 Height="32"
                 Margin="0,0,0,12"
                 KeyDown="Input_KeyDown" />

        <TextBlock Grid.Row="6" Text="Category" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
        <ComboBox x:Name="CategoryComboBox"
                  Grid.Row="7"
                  Style="{StaticResource App.InputComboBox}"
                  Height="32"
                  Margin="0,0,0,16"
                  IsEditable="True" />

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="Save"
                    Width="90"
                    Height="32"
                    Margin="0,0,10,0"
                    Style="{StaticResource App.Button.Primary}"
                    IsDefault="True"
                    Click="OkButton_Click" />
            <Button Content="Cancel"
                    Width="90"
                    Height="32"
                    Style="{StaticResource App.Button.Ghost}"
                    IsCancel="True"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
