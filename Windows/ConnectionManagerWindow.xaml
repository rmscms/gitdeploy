<mah:MetroWindow x:Class="GitDeployPro.Windows.ConnectionManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:GitDeployPro.Behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:local="clr-namespace:GitDeployPro.Models"
        xmlns:loc="clr-namespace:GitDeployPro.Services.Localization"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Deployment - Connection Manager" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface.Base}" Foreground="{StaticResource Text.Primary}"
        ResizeMode="CanResizeWithGrip"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        WindowTitleBrush="{StaticResource Surface.Card}"
        NonActiveWindowTitleBrush="{StaticResource Surface.Card}"
        BorderThickness="1"
        BorderBrush="{StaticResource Border.Subtle}">

    <Window.Resources>
        <!-- Removed problematic ObjectDataProvider and Converter -->
        
        <Style TargetType="TextBox" BasedOn="{StaticResource App.InputTextBox}" />
        <Style TargetType="PasswordBox" BasedOn="{StaticResource App.InputPasswordBox}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource App.InputComboBox}" />
        <Style TargetType="CheckBox" BasedOn="{StaticResource App.CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="{StaticResource Border.Strong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Inverse}"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{StaticResource Accent.Primary}"
                                    CornerRadius="6,6,0,0"
                                    Padding="10,4">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"/>
                            </Border>
                            <Border Grid.Row="1"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{StaticResource Surface.Card}"
                                    CornerRadius="0,0,6,6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="OuterCircle"
                                    Grid.Column="0"
                                    Width="16"
                                    Height="16"
                                    CornerRadius="8"
                                    BorderThickness="1.4"
                                    BorderBrush="{StaticResource Border.Subtle}"
                                    Background="{StaticResource Surface.Input}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                                <Border x:Name="InnerDot"
                                        Width="8"
                                        Height="8"
                                        CornerRadius="4"
                                        Opacity="0"
                                        Background="{StaticResource Accent.Primary}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OuterCircle" Property="BorderBrush" Value="{StaticResource Accent.Primary}"/>
                                <Setter TargetName="InnerDot" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterCircle" Property="BorderBrush" Value="{StaticResource Accent.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarIconActionButton" TargetType="Button" BasedOn="{StaticResource App.IconButton}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="PasswordRevealButtonStyle" TargetType="Button" BasedOn="{StaticResource App.IconButton}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource Surface.Input}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar: List of Connections -->
        <Border Grid.Column="0" Background="{StaticResource Surface.Card}" BorderThickness="0,0,1,0" BorderBrush="{StaticResource Border.Subtle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="14,14,14,8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="Connections"
                                   Foreground="{StaticResource Text.Primary}"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <Border Background="{StaticResource Surface.Input}"
                                CornerRadius="6"
                                Padding="6,2"
                                Margin="8,0,0,0">
                            <TextBlock Text="{Binding ElementName=ConnectionsList, Path=Items.Count}"
                                       Foreground="{StaticResource Text.Muted}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1" Margin="12,0,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ConnectionSearchBox"
                             Grid.Column="0"
                             Height="34"
                             Padding="10,0"
                             mah:TextBoxHelper.Watermark="Search by name, host, db..."
                             TextChanged="ConnectionSearchBox_TextChanged"/>
                    <Button Grid.Column="1"
                            x:Name="ClearSearchButton"
                            Content="✕"
                            Width="34"
                            Height="34"
                            Margin="8,0,0,0"
                            Style="{StaticResource App.IconButton}"
                            ToolTip="Clear search"
                            Click="ClearSearchButton_Click"/>
                </Grid>

                <ListBox x:Name="ConnectionsList" Grid.Row="2"
                         Background="Transparent"
                         BorderThickness="0"
                         Style="{StaticResource App.ListBox.Host}"
                         behaviors:ContextMenuSelectionBehavior.Enable="True"
                         SelectionMode="Single" SelectionChanged="ConnectionsList_SelectionChanged"
                         Margin="10,0,10,6">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ConnectionRowCard"
                                    Background="{StaticResource Surface.Input}"
                                    BorderBrush="{StaticResource Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,0,0,8">
                                <Grid Background="Transparent">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Duplicate" Click="DuplicateConnection_Click">
                                            <MenuItem.Icon>
                                                <TextBlock Text="📄"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Remove" Click="DeleteConnection_Context_Click">
                                            <MenuItem.Icon>
                                                <TextBlock Text="🗑️"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Badge -->
                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="4" Margin="0,0,10,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource Status.Success}"/> <!-- Default: FTP (Green) -->
                                            <Style.Triggers>
                                                <!-- SSH (Purple) -->
                                                <DataTrigger Binding="{Binding UseSSH}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Accent.Secondary}"/>
                                                </DataTrigger>
                                                <!-- Database badge (Blue) -->
                                                <DataTrigger Binding="{Binding DbType}" Value="{x:Static local:DatabaseType.MySQL}">
                                                    <Setter Property="Background" Value="{StaticResource Status.Info}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DbType}" Value="{x:Static local:DatabaseType.MariaDB}">
                                                    <Setter Property="Background" Value="{StaticResource Status.Info}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DbType}" Value="{x:Static local:DatabaseType.PostgreSQL}">
                                                    <Setter Property="Background" Value="{StaticResource Status.Info}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DbType}" Value="{x:Static local:DatabaseType.SQLServer}">
                                                    <Setter Property="Background" Value="{StaticResource Status.Info}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DbType}" Value="{x:Static local:DatabaseType.MongoDB}">
                                                    <Setter Property="Background" Value="{StaticResource Status.Info}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DbType}" Value="{x:Static local:DatabaseType.Redis}">
                                                    <Setter Property="Background" Value="{StaticResource Status.Info}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DbType}" Value="{x:Static local:DatabaseType.SQLite}">
                                                    <Setter Property="Background" Value="{StaticResource Status.Info}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    
                                    <TextBlock Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="F"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UseSSH}" Value="True">
                                                        <Setter Property="Text" Value="S"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DbType}" Value="{x:Static local:DatabaseType.MySQL}">
                                                        <Setter Property="Text" Value="D"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DbType}" Value="{x:Static local:DatabaseType.MariaDB}">
                                                        <Setter Property="Text" Value="D"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DbType}" Value="{x:Static local:DatabaseType.PostgreSQL}">
                                                        <Setter Property="Text" Value="D"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DbType}" Value="{x:Static local:DatabaseType.SQLServer}">
                                                        <Setter Property="Text" Value="D"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DbType}" Value="{x:Static local:DatabaseType.MongoDB}">
                                                        <Setter Property="Text" Value="D"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DbType}" Value="{x:Static local:DatabaseType.Redis}">
                                                        <Setter Property="Text" Value="D"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DbType}" Value="{x:Static local:DatabaseType.SQLite}">
                                                        <Setter Property="Text" Value="D"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- Name -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{StaticResource Text.Primary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Host}"
                                               FontSize="11"
                                               Foreground="{StaticResource Text.Muted}"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Width="28"
                                        Height="28"
                                        MinWidth="0"
                                        MinHeight="0"
                                        Padding="0"
                                        Margin="8,0,0,0"
                                        FontSize="14"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        VerticalAlignment="Center"
                                        PreviewMouseLeftButtonDown="FavoriteConnectionButton_PreviewMouseLeftButtonDown">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource App.IconButton}">
                                            <Setter Property="Width" Value="28"/>
                                            <Setter Property="Height" Value="28"/>
                                            <Setter Property="MinWidth" Value="0"/>
                                            <Setter Property="MinHeight" Value="0"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Content" Value="☆"/>
                                            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
                                            <Setter Property="ToolTip" Value="{loc:T connection.tip.favorite}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Content" Value="★"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Status.Warning}"/>
                                                    <Setter Property="ToolTip" Value="{loc:T connection.tip.unfavorite}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                    <Setter TargetName="ConnectionRowCard" Property="BorderBrush" Value="{StaticResource Accent.Primary}" />
                                    <Setter TargetName="ConnectionRowCard" Property="Background" Value="{StaticResource Surface.Raised}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Toolbar (Add/Remove) -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Background="{StaticResource Surface.Shell}" Height="42" VerticalAlignment="Center" Margin="8,0,8,0">
                    <Button x:Name="AddButton" Content="+" Style="{StaticResource SidebarIconActionButton}" Foreground="{StaticResource Text.Secondary}" Click="AddButton_Click" ToolTip="Add New Connection"/>
                    <Button x:Name="DeleteButton" Content="−" Style="{StaticResource SidebarIconActionButton}" Foreground="{StaticResource Text.Secondary}" Click="DeleteButton_Click" ToolTip="Remove Connection"/>
                    <Button Content="📥 Import Navicat"
                            Margin="8,0,0,0"
                            Padding="12,0"
                            Background="Transparent"
                            Foreground="{StaticResource Status.Success}"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Import Navicat export (*.ncx / *.xml)"
                            Click="ImportNavicatButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right Panel: Details Form -->
        <Grid Grid.Column="1" x:Name="EditPanel" IsEnabled="False" Background="{StaticResource Surface.Base}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Name Header -->
                <RowDefinition Height="*"/>    <!-- Tabs -->
                <RowDefinition Height="Auto"/> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- Name Header -->
            <Border Grid.Row="0" Padding="25,20,25,15" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Border.Subtle}">
                <StackPanel>
                    <TextBlock Text="Connection Name:" Foreground="{StaticResource Text.Muted}" Margin="0,0,0,5" FontSize="12"/>
                    <TextBox x:Name="NameBox"
                             FontSize="16"
                             FontWeight="SemiBold"
                             Height="42"
                             Padding="10,0"
                             CaretBrush="{StaticResource Text.Primary}"
                             Foreground="{StaticResource Text.Primary}"
                             Background="{StaticResource Surface.Input}"
                             BorderBrush="{StaticResource Border.Subtle}"
                             BorderThickness="1"
                             mah:TextBoxHelper.Watermark="Connection name" />
                </StackPanel>
            </Border>

            <!-- Tabs -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="15">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Padding" Value="20,10"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Grid>
                                        <Border x:Name="Border" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent">
                                            <ContentPresenter x:Name="ContentSite"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center"
                                                            ContentSource="Header"
                                                            Margin="12,2,12,2"/>
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Accent.Primary}"/>
                                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- SSH/FTP Tab -->
                <TabItem Header="Remote Host (SSH/FTP)">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                        <StackPanel>
                            <!-- Type Selection -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Protocol:"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <RadioButton x:Name="FtpRadio" Content="FTP" GroupName="Protocol" IsChecked="True" Foreground="{StaticResource Text.Primary}" Margin="0,0,20,0"/>
                                    <RadioButton x:Name="SftpRadio" Content="SFTP (SSH)" GroupName="Protocol" Foreground="{StaticResource Text.Primary}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Host & Port -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Host / IP:"/>
                                <TextBox x:Name="HostBox" Grid.Column="1" Margin="0,0,15,0"/>
                                <Label Grid.Column="2" Content="Port:"/>
                                <TextBox x:Name="PortBox" Grid.Column="3" TextAlignment="Center"/>
                            </Grid>

                            <!-- Credentials -->
                            <GroupBox Header="Authentication"
                                      Margin="0,0,0,20"
                                      Padding="10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="Username:"/>
                                        <TextBox x:Name="UserBox" Grid.Column="1"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="Password:"/>
                                        <Grid Grid.Column="1" Margin="0,0,8,0">
                                            <PasswordBox x:Name="PassBox" PasswordChanged="PassBox_PasswordChanged"/>
                                            <TextBox x:Name="PassRevealTextBox"
                                                     Visibility="Collapsed"
                                                     TextChanged="PassRevealTextBox_TextChanged"/>
                                        </Grid>
                                        <Button x:Name="PassRevealButton"
                                                Grid.Column="2"
                                                Content="👁"
                                                Style="{StaticResource PasswordRevealButtonStyle}"
                                                ToolTip="Show/Hide password"
                                                Click="PassRevealButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <!-- Test Connection (under Authentication) -->
                            <StackPanel Margin="0,0,0,20">
                                <Button x:Name="TestRemoteButton"
                                        Content="⚡ Test Connection"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource App.Button.Primary}"
                                        Height="32"
                                        MinWidth="140"
                                        Padding="14,0"
                                        Click="TestButton_Click"/>
                                <TextBlock x:Name="RemoteTestStatusText"
                                           Text=""
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource Text.Secondary}"
                                           FontSize="12"/>
                            </StackPanel>

                            <!-- Root Path & URL -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="15"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <Label Grid.Row="0" Content="Root Path:"/>
                                <TextBox x:Name="RootPathBox" Grid.Row="0" Grid.Column="1"/>
                                <Button Grid.Row="0" Grid.Column="2" Content="📁 Browse" Margin="10,0,0,0" 
                                        Style="{StaticResource ModernButtonStyle}" Height="30" Padding="10,0"
                                        Click="BrowseButton_Click"/>

                                <Label Grid.Row="2" Content="Web URL:"/>
                                <TextBox x:Name="WebUrlBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                         ToolTip="Example: http://mysite.com"/>
                            </Grid>

                            <!-- SSH startup commands (terminal land path / custom shell) -->
                            <StackPanel Margin="0,0,0,20">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="{loc:T connection.sshStartupCommand}"/>
                                    <TextBox x:Name="SshStartupCommandBox"
                                             Grid.Column="1"
                                             Style="{StaticResource App.InputTextBox.Multiline}"
                                             MinHeight="72"
                                             MaxHeight="140"
                                             VerticalScrollBarVisibility="Auto"
                                             mah:TextBoxHelper.Watermark="cd /var/www/myproject"
                                             ToolTip="{loc:T connection.sshStartupCommandTip}"/>
                                    <Button Grid.Column="2"
                                            Content="{loc:T connection.fillStartupFromRootPath}"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Top"
                                            Style="{StaticResource ModernButtonStyle}"
                                            Height="30"
                                            Padding="10,0"
                                            ToolTip="{loc:T connection.fillStartupFromRootPathTip}"
                                            Click="FillStartupFromRootPathButton_Click"/>
                                </Grid>
                                <CheckBox x:Name="RunSshStartupCommandCheck"
                                          Content="{loc:T connection.runSshStartupCommand}"
                                          IsChecked="True"
                                          ToolTip="{loc:T connection.runSshStartupCommandTip}"/>
                            </StackPanel>

                            <!-- Advanced Options -->
                            <Expander Header="Advanced Options" Foreground="{StaticResource Text.Secondary}" Margin="0,10,0,0">
                                <StackPanel Margin="25,15,0,0">
                                    <CheckBox x:Name="PassiveModeCheck" Content="Passive mode" IsChecked="True" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="ShowHiddenCheck" Content="Show hidden files (.env, .htaccess, etc.)" IsChecked="True" FontWeight="Bold" Foreground="{StaticResource Status.Success}" Margin="0,0,0,10"/>
                                    
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="Keep Alive (sec):" Margin="-5,0,10,0"/>
                                        <TextBox x:Name="KeepAliveBox" Width="80" Text="300" TextAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Database Tab -->
                <TabItem Header="Database 🛢️">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                        <StackPanel>
                            <Border Background="{StaticResource Surface.Card}" CornerRadius="5" Padding="15" Margin="0,0,0,20">
                                <TextBlock Text="ℹ️ Database connections are tunneled securely through the SSH connection defined in the first tab. No need to open database ports to the public internet." 
                                           TextWrapping="Wrap" Foreground="{StaticResource Text.Muted}" FontSize="13"/>
                            </Border>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Database Type:"/>
                                <ComboBox x:Name="DbTypeCombo" Grid.Column="1"/>
                            </Grid>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Host:" ToolTip="Usually 127.0.0.1 (relative to the server)"/>
                                <TextBox x:Name="DbHostBox" Grid.Column="1" Text="127.0.0.1" Margin="0,0,15,0"/>
                                <Label Grid.Column="2" Content="Port:"/>
                                <TextBox x:Name="DbPortBox" Grid.Column="3" Text="3306" TextAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Database Name:"/>
                                <TextBox x:Name="DbNameBox" Grid.Column="1" ToolTip="The name of the database schema"/>
                            </Grid>

                            <GroupBox Header="Database Authentication"
                                      Margin="0,0,0,20"
                                      Padding="10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="Username:"/>
                                        <TextBox x:Name="DbUserBox" Grid.Column="1" Text="root"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="Password:"/>
                                        <Grid Grid.Column="1" Margin="0,0,8,0">
                                            <PasswordBox x:Name="DbPassBox" PasswordChanged="DbPassBox_PasswordChanged"/>
                                            <TextBox x:Name="DbPassRevealTextBox"
                                                     Visibility="Collapsed"
                                                     TextChanged="DbPassRevealTextBox_TextChanged"/>
                                        </Grid>
                                        <Button x:Name="DbPassRevealButton"
                                                Grid.Column="2"
                                                Content="👁"
                                                Style="{StaticResource PasswordRevealButtonStyle}"
                                                ToolTip="Show/Hide password"
                                                Click="DbPassRevealButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <StackPanel>
                                <Button x:Name="TestDatabaseButton"
                                        Content="🔌 Test Database Connection"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Background="{StaticResource Accent.Primary}"
                                        Click="TestDatabase_Click"/>
                                <TextBlock x:Name="DatabaseTestStatusText"
                                           Text=""
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource Text.Secondary}"
                                           FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Mappings Tab -->
                <TabItem Header="Path Mappings">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Route a local folder (relative to the project root) to a remote directory. The first mapping becomes the Direct Upload root."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource Text.Muted}"
                                   Margin="0,0,0,10"/>

                        <Border Grid.Row="1" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="6" Background="{StaticResource Surface.Shell}">
                            <ListView x:Name="PathMappingsList"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      SelectionChanged="PathMappingsList_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Local Folder" Width="200" DisplayMemberBinding="{Binding LocalPath}"/>
                                        <GridViewColumn Header="Remote Path" Width="240" DisplayMemberBinding="{Binding RemotePath}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                            <StackPanel Width="220" Margin="0,0,10,0">
                                <TextBlock Text="Local Folder (relative, e.g. site)" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                                <TextBox x:Name="LocalMappingTextBox" mah:TextBoxHelper.Watermark="site" />
                            </StackPanel>
                            <StackPanel Width="260" Margin="0,0,10,0">
                                <TextBlock Text="Remote Path (e.g. /public_html)" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                                <TextBox x:Name="RemoteMappingTextBox" mah:TextBoxHelper.Watermark="/public_html"/>
                            </StackPanel>
                            <Button Content="Save Mapping"
                                    Width="130"
                                    Margin="0,22,10,0"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Background="{StaticResource Accent.Primary}"
                                    Click="SaveMappingButton_Click"/>
                            <Button Content="Delete"
                                    Width="90"
                                    Margin="0,22,0,0"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Background="{StaticResource Status.Error}"
                                    Click="DeleteMappingButton_Click"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Footer Actions -->
            <Border Grid.Row="2" Background="{StaticResource Surface.Shell}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Border.Subtle}" Padding="20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Save Connection" Width="140" Height="35" Margin="0,0,15,0" 
                            Style="{StaticResource App.Button.Primary}"
                            Click="SaveButton_Click"/>
                    <Button Content="Cancel" Width="100" Height="35" 
                            Style="{StaticResource App.Button.Ghost}"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Overlay for Empty State (Now controlled by code-behind) -->
        <Grid x:Name="EmptyStateOverlay"
              Grid.Column="1"
              Panel.ZIndex="50">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource Surface.Raised}"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22"
                    MaxWidth="380">
                <StackPanel>
                    <TextBlock Text="Connection details panel"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Primary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Select a connection from the left list or create a new one to start editing host, auth, database, and path mappings."
                               Margin="0,10,0,0"
                               FontSize="12"
                               Foreground="{StaticResource Text.Muted}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                    <Button Content="+ Create new connection"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource App.Button.Primary}"
                            Click="AddButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Remote test modal overlay (Wizard-like, unified visual language) -->
        <Grid x:Name="RemoteTestOverlay"
              Grid.ColumnSpan="2"
              Background="{StaticResource Surface.Overlay}"
              Visibility="Collapsed"
              Panel.ZIndex="100">
            <Border Width="460"
                    Padding="20"
                    Background="{StaticResource Surface.Raised}"
                    BorderBrush="{StaticResource Border.Strong}"
                    BorderThickness="1"
                    CornerRadius="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="Black"
                                      BlurRadius="30"
                                      ShadowDepth="8"
                                      Opacity="0.42" />
                </Border.Effect>
                <StackPanel>
                    <ProgressBar IsIndeterminate="True"
                                 Width="240"
                                 Height="10"
                                 Background="{StaticResource Surface.Input}"
                                 Foreground="{StaticResource Accent.Primary}"
                                 BorderThickness="0"
                                 HorizontalAlignment="Center"/>
                    <TextBlock Text="Please wait, testing remote connection..."
                               Foreground="{StaticResource Text.Primary}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,8"/>
                    <TextBlock x:Name="RemoteTestOverlayStatusText"
                               Text="Initializing test..."
                               Foreground="{StaticResource Text.Secondary}"
                               FontSize="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14"/>
                    <Button x:Name="RemoteTestOverlayCancelButton"
                            Content="Cancel Test"
                            Width="120"
                            Height="32"
                            HorizontalAlignment="Center"
                            Style="{StaticResource App.Button.Ghost}"
                            Click="CancelRemoteTestButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Database test modal overlay (same UX as remote test) -->
        <Grid x:Name="DatabaseTestOverlay"
              Grid.ColumnSpan="2"
              Background="{StaticResource Surface.Overlay}"
              Visibility="Collapsed"
              Panel.ZIndex="101">
            <Border Width="460"
                    Padding="20"
                    Background="{StaticResource Surface.Raised}"
                    BorderBrush="{StaticResource Border.Strong}"
                    BorderThickness="1"
                    CornerRadius="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="Black"
                                      BlurRadius="30"
                                      ShadowDepth="8"
                                      Opacity="0.42" />
                </Border.Effect>
                <StackPanel>
                    <ProgressBar IsIndeterminate="True"
                                 Width="240"
                                 Height="10"
                                 Background="{StaticResource Surface.Input}"
                                 Foreground="{StaticResource Accent.Primary}"
                                 BorderThickness="0"
                                 HorizontalAlignment="Center"/>
                    <TextBlock Text="Please wait, testing database connection..."
                               Foreground="{StaticResource Text.Primary}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,8"/>
                    <TextBlock x:Name="DatabaseTestOverlayStatusText"
                               Text="Initializing database test..."
                               Foreground="{StaticResource Text.Secondary}"
                               FontSize="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14"/>
                    <Button x:Name="DatabaseTestOverlayCancelButton"
                            Content="Cancel Test"
                            Width="120"
                            Height="32"
                            HorizontalAlignment="Center"
                            Style="{StaticResource App.Button.Ghost}"
                            Click="CancelDatabaseTestButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</mah:MetroWindow>