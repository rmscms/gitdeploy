<Window x:Class="GitDeployPro.Windows.InitGitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Initialize Git Repository" Height="450" Width="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{StaticResource Surface.Raised}" 
            CornerRadius="14" 
            BorderBrush="{StaticResource Border.Strong}" 
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="8" Opacity="0.45"/>
        </Border.Effect>

        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🌱" FontSize="28" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock Text="Initialize Git Repository" 
                              FontSize="24" 
                              FontWeight="Bold" 
                              Foreground="{StaticResource Text.Primary}"
                              VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Set up version control for this project." 
                          Foreground="{StaticResource Text.Muted}" 
                          Margin="48,5,0,0" 
                          FontSize="14"/>
            </StackPanel>

            <!-- Content -->
            <StackPanel Grid.Row="1">
                <!-- Branches -->
                <TextBlock Text="Select Branches to Create:" Foreground="{StaticResource Text.Secondary}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Border Background="{StaticResource Surface.Card}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="10" Padding="15">
                    <WrapPanel>
                        <CheckBox x:Name="MainBranchCheck" Content="main" IsChecked="True" Margin="0,0,20,10"/>
                        <CheckBox x:Name="MasterBranchCheck" Content="master" Margin="0,0,20,10"/>
                        <CheckBox x:Name="BetaBranchCheck" Content="beta" Margin="0,0,20,10"/>
                        <CheckBox x:Name="DevBranchCheck" Content="development" Margin="0,0,20,10"/>
                    </WrapPanel>
                </Border>

                <!-- Remote -->
                <TextBlock Text="Remote Repository URL (Optional):" Foreground="{StaticResource Text.Secondary}" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,10"/>
                <TextBox x:Name="RemoteUrlTextBox" 
                        Style="{StaticResource App.InputTextBox}" 
                        Height="40"
                        Foreground="{StaticResource Status.Info}"
                        Padding="10"
                        FontSize="13"/>
                <TextBlock Text="e.g. https://github.com/username/repo.git" Foreground="{StaticResource Text.Muted}" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" 
                        Height="40" 
                        Width="100" 
                        Margin="0,0,15,0"
                        Style="{StaticResource App.Button.Ghost}"
                        FontSize="14"
                        Cursor="Hand"
                        Click="Close_Click"/>

                <Button x:Name="InitButton"
                        Content="🚀 Initialize &amp; Create" 
                        Height="40" 
                        Padding="20,0"
                        Style="{StaticResource App.Button.Success}"
                        Foreground="{StaticResource Text.Inverse}"
                        FontSize="14"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="Init_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

