<Window x:Class="GitDeployPro.Windows.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's New"
        Width="520"
        Height="420"
        MinWidth="460"
        MinHeight="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Surface.Base}"
        ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border Width="42"
                    Height="42"
                    CornerRadius="12"
                    Background="{StaticResource Status.SuccessSurface}"
                    Margin="0,0,12,0">
                <TextBlock Text="✨"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="What's New"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Text.Primary}" />
                <TextBlock x:Name="VersionText"
                           Margin="0,4,0,0"
                           FontSize="13"
                           Foreground="{StaticResource Status.Success}"
                           Text="Version" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Margin="0,14,0,0"
                   FontSize="13"
                   Foreground="{StaticResource Text.Secondary}"
                   Text="Thanks for updating. Here’s what changed in this release:"
                   TextWrapping="Wrap" />

        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ChangelogList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,10" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="•"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Accent.Primary}"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Top" />
                                <TextBlock Text="{Binding}"
                                           FontSize="13"
                                           Foreground="{StaticResource Text.Primary}"
                                           TextWrapping="Wrap" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="3"
                HorizontalAlignment="Right"
                MinWidth="130"
                Height="36"
                Margin="0,16,0,0"
                Style="{StaticResource App.Button.Primary}"
                Content="Got it"
                IsDefault="True"
                Click="GotItButton_Click" />
    </Grid>
</Window>
