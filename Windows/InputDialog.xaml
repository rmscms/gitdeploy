<mah:MetroWindow x:Class="GitDeployPro.Windows.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Title="NEW FOLDER" Width="450"
        MinHeight="200" MaxHeight="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Surface.Base}"
        Foreground="{StaticResource Text.Primary}"
        WindowTitleBrush="{StaticResource Surface.Card}"
        NonActiveWindowTitleBrush="{StaticResource Surface.Card}">
    <Grid Margin="20,18,20,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock x:Name="PromptTextBlock" Grid.Row="0"
                   Foreground="{StaticResource Text.Primary}"
                   FontSize="13"
                   Margin="0,0,0,12"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"/>
        
        <TextBox x:Name="InputTextBox" Grid.Row="1" Height="32" Margin="0,0,0,18"
                 Padding="8,6"
                 FontSize="13"
                 KeyDown="InputTextBox_KeyDown"/>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
            <Button x:Name="OkButton" Content="OK" Width="90" Height="32" Margin="0,0,10,0"
                    Style="{StaticResource App.Button.Primary}" Foreground="{StaticResource Text.Primary}" Cursor="Hand"
                    FontSize="13" FontWeight="SemiBold"
                    Click="OkButton_Click" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Height="32"
                    Style="{StaticResource App.Button.Ghost}" Foreground="{StaticResource Text.Secondary}" Cursor="Hand"
                    FontSize="13" FontWeight="SemiBold"
                    Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
