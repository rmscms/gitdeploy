<Window x:Class="GitDeployPro.Windows.CodeViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Code Viewer"
        Height="720"
        Width="1200"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface.Base}"
        ResizeMode="CanResize"
        WindowStyle="None">
    <Border BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="10" Margin="10" Background="{StaticResource Surface.Shell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource Surface.Card}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical" Margin="16,6">
                    <TextBlock x:Name="TitleText" FontSize="15" Foreground="{StaticResource Text.Primary}" FontWeight="Bold" />
                    <TextBlock x:Name="SubTitleText" FontSize="12" Foreground="{StaticResource Text.Muted}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="EditToggleButton"
                            Content="Enable Edit"
                            Width="120"
                            Height="30"
                            Margin="0,0,8,0"
                            Style="{StaticResource App.Button.Secondary}"
                            Foreground="{StaticResource Text.Primary}"
                            Click="EditToggleButton_Click"/>
                    <Button x:Name="SaveButton"
                            Content="Save"
                            Width="90"
                            Height="30"
                            Margin="0,0,8,0"
                            Style="{StaticResource App.Button.Primary}"
                            Foreground="{StaticResource Text.Primary}"
                            Click="SaveButton_Click"/>
                    <Button x:Name="CopyButton"
                            Content="Copy"
                            Width="80"
                            Height="30"
                            Margin="0,0,8,0"
                            Style="{StaticResource App.Button.Ghost}"
                            Foreground="{StaticResource Text.Secondary}"
                            Click="CopyButton_Click"/>
                    <Button x:Name="CloseButton"
                            Content="Close"
                            Width="80"
                            Height="30"
                            Style="{StaticResource App.Button.Danger}"
                            Foreground="{StaticResource Text.Primary}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <wv:WebView2 x:Name="CodeWebView"
                         Grid.Row="1"
                         Margin="0"
                         DefaultBackgroundColor="#FF1E1E1E" />
        </Grid>
    </Border>
</Window>

