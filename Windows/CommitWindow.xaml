<Window x:Class="GitDeployPro.Windows.CommitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GitDeployPro.Controls"
        Title="Review &amp; Commit" Height="760" Width="1150"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <Style x:Key="CommitListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Surface.Raised}"
            CornerRadius="14"
            BorderBrush="{StaticResource Border.Strong}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="8" Opacity="0.45"/>
        </Border.Effect>

        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📝" FontSize="28" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock Text="Uncommitted Changes" 
                              FontSize="24" 
                              FontWeight="Bold" 
                              Foreground="{StaticResource Text.Primary}"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" Content="✕" 
                        Width="30" Height="30" 
                        Background="Transparent" 
                        Foreground="{StaticResource Text.Muted}" 
                        BorderThickness="0"
                        FontSize="16"
                        Cursor="Hand"
                        Click="Close_Click"/>
            </Grid>

            <!-- File List -->
            <Border Grid.Row="1" Background="{StaticResource Surface.Card}" CornerRadius="10" Padding="15" Margin="0,0,0,20" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Pending Changes: " FontSize="14" Foreground="{StaticResource Text.Secondary}"/>
                        <TextBlock x:Name="TotalChangesText" Text="0 Files" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="1.3*"/>
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                            <ListBox x:Name="FilesListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource CommitListItemStyle}"
                                     SelectionMode="Single"
                                     SelectionChanged="FilesListBox_SelectionChanged"
                                     PreviewMouseRightButtonDown="FilesListBox_PreviewMouseRightButtonDown"
                                     MouseDoubleClick="FilesListBox_MouseDoubleClick">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Add to .gitignore"
                                                  Click="AddToGitIgnoreMenuItem_Click"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="ItemCard"
                                                Background="{StaticResource Surface.Input}" 
                                                CornerRadius="4" 
                                                Padding="10" 
                                                Margin="0,0,0,8"
                                                BorderBrush="{StaticResource Border.Subtle}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" 
                                                        Background="{Binding StatusColor}" 
                                                        CornerRadius="3" 
                                                        Padding="6,2"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" 
                                                              FontSize="11" 
                                                              FontWeight="Bold" 
                                                              Foreground="{StaticResource Text.Primary}"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" 
                                                              FontSize="13" 
                                                              Foreground="{StaticResource Text.Secondary}"
                                                              VerticalAlignment="Center"
                                                              TextTrimming="CharacterEllipsis"/>
                                                    <Button Content="VS"
                                                            Margin="10,0,0,0"
                                                            Padding="8,2"
                                                            Height="26"
                                                            FontSize="11"
                                                            Foreground="{StaticResource Text.Primary}"
                                                            Background="{StaticResource Surface.Shell}"
                                                            BorderBrush="{StaticResource Border.Strong}"
                                                            BorderThickness="1"
                                                            Cursor="Hand"
                                                            Tag="{Binding}"
                                                            Click="OpenCodeButton_Click"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Button Content="📂" 
                                                            Width="32" Height="32"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            ToolTip="Show in Explorer"
                                                            Tag="{Binding Name}"
                                                            Click="ShowInExplorer_Click"/>
                                                    
                                                    <Button Content="🗑️" 
                                                            Width="32" Height="32"
                                                            Margin="5,0,0,0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            ToolTip="Delete File"
                                                            Tag="{Binding Name}"
                                                            Click="DeleteFile_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                <Setter TargetName="ItemCard" Property="BorderBrush" Value="{StaticResource Accent.Primary}" />
                                                <Setter TargetName="ItemCard" Property="Background" Value="{StaticResource Surface.Raised}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>

                        <controls:DiffViewer Grid.Column="2"
                                             x:Name="CommitDiffViewer"
                                             Title="Diff preview"
                                             EmptyMessage="Select a file to review its diff"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Commit Message -->
            <StackPanel Grid.Row="2" Margin="0,0,0,20">
                <TextBlock Text="Commit Message:" FontSize="13" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,8"/>
                <TextBox x:Name="CommitMessageTextBox" 
                        Height="80" 
                        TextWrapping="Wrap" 
                        AcceptsReturn="True"
                        Background="{StaticResource Surface.Input}"
                        Foreground="{StaticResource Text.Primary}"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="1"
                        Padding="10"
                        FontSize="13"/>
            </StackPanel>

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" 
                        Height="40" 
                        Width="100" 
                        Margin="0,0,15,0"
                        Style="{StaticResource App.Button.Ghost}"
                        FontSize="13"
                        Cursor="Hand"
                        Click="Close_Click"/>

                <Button x:Name="CommitAndDeployButton"
                        Content="⚡ DEPLOY → COMMIT + PUSH" 
                        Height="40" 
                        Width="260"
                        Style="{StaticResource App.Button.Primary}"
                        FontSize="13"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="CommitAndDeploy_Click"/>

            </StackPanel>
        </Grid>
    </Border>
</Window>


