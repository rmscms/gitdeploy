<mah:MetroWindow x:Class="GitDeployPro.Windows.TerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GitDeployPro.Controls"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:GitDeployPro.Services.Localization"
        Title="Terminal" Height="600" Width="900"
        Background="{StaticResource Surface.Base}"
        Foreground="{StaticResource Text.Primary}"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        BorderThickness="1"
        BorderBrush="{StaticResource Border.Subtle}"
        WindowStartupLocation="Manual">
    
    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button" BasedOn="{StaticResource App.Button.Toolbar}" />
        <Style x:Key="Terminal.IconButton" TargetType="Button" BasedOn="{StaticResource App.IconButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="Terminal.IconButton.Accent" TargetType="Button" BasedOn="{StaticResource Terminal.IconButton}">
            <Setter Property="BorderBrush" Value="{StaticResource Accent.Primary}" />
            <Setter Property="Foreground" Value="{StaticResource Accent.Primary}" />
        </Style>
        <Style x:Key="Terminal.IconButton.Danger" TargetType="Button" BasedOn="{StaticResource Terminal.IconButton}">
            <Setter Property="BorderBrush" Value="{StaticResource Status.Error}" />
            <Setter Property="Foreground" Value="{StaticResource Status.Error}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="Auto"/> <!-- Presets -->
            <RowDefinition Height="*"/>    <!-- Terminal -->
        </Grid.RowDefinitions>

        <!-- SSH Connection Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource Surface.Card}" Padding="10" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Border.Subtle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="SSH Connection:" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <ComboBox x:Name="SshProfilesCombo" Width="250" Height="28" 
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="SshProfilesCombo_SelectionChanged">
                    <ComboBox.Resources>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="#333337"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                    </ComboBox.Resources>
                </ComboBox>

                <Button Content="🔌 Quick Connect" Margin="10,0,0,0" Height="28" Padding="10,0"
                        Style="{StaticResource App.Button.Primary}" Foreground="{StaticResource Text.Primary}"
                        Click="QuickConnect_Click"/>

                <Button Content="⚙️ Manage Profiles" Margin="10,0,0,0" Height="28" Padding="10,0"
                        Style="{StaticResource App.Button.Ghost}" Foreground="{StaticResource Text.Secondary}"
                        Click="ManageProfiles_Click"/>
            </StackPanel>
        </Border>

        <!-- Command Presets -->
        <Border Grid.Row="1" Background="{StaticResource Surface.Shell}" Padding="10" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="PresetComboBox"
                              Grid.Column="0"
                              Height="34"
                              DisplayMemberPath="Title"
                              SelectedValuePath="Id"
                              Margin="0,0,8,0"
                              ToolTip="{loc:T terminal.tip.presetList}"/>
                    <Button Grid.Column="1"
                            Style="{StaticResource Terminal.IconButton.Accent}"
                            ToolTip="{loc:T terminal.tip.insertPreset}"
                            Click="UsePreset_Click">
                        <ui:SymbolIcon Symbol="ClipboardPaste24" Filled="False" FontSize="16"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Grid.Column="2"
                            Style="{StaticResource Terminal.IconButton.Danger}"
                            ToolTip="{loc:T terminal.tip.deletePreset}"
                            Click="DeletePreset_Click">
                        <ui:SymbolIcon Symbol="Delete24" Filled="False" FontSize="16"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <CheckBox x:Name="BroadcastAllCheckBox"
                              Grid.Column="3"
                              Content="Send to all"
                              Foreground="{StaticResource Text.Secondary}"
                              VerticalAlignment="Center"
                              Margin="4,0,0,0"
                              ToolTip="{loc:T terminal.tip.broadcast}"/>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PresetTitleBox"
                             mah:TextBoxHelper.Watermark="Title"
                             Grid.Column="0"
                             Margin="0,0,8,0"
                             ToolTip="{loc:T terminal.tip.presetTitle}"/>
                    <TextBox x:Name="PresetCommandBox"
                             mah:TextBoxHelper.Watermark="Command"
                             Grid.Column="1"
                             Margin="0,0,8,0"
                             ToolTip="{loc:T terminal.tip.presetCommand}"/>
                    <Button Grid.Column="2"
                            Style="{StaticResource Terminal.IconButton.Accent}"
                            Margin="0"
                            ToolTip="{loc:T terminal.tip.savePreset}"
                            Click="AddPresetButton_Click">
                        <ui:SymbolIcon Symbol="Save24" Filled="False" FontSize="16"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <controls:TerminalControl x:Name="MyTerminal" Grid.Row="2"/>
    </Grid>
</mah:MetroWindow>
