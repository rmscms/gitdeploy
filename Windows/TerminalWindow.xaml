<mah:MetroWindow x:Class="GitDeployPro.Windows.TerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GitDeployPro.Controls"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Title="Terminal" Height="600" Width="900"
        Background="{StaticResource Surface.Base}"
        Foreground="{StaticResource Text.Primary}"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        BorderThickness="1"
        BorderBrush="{StaticResource Border.Subtle}"
        WindowStartupLocation="Manual">
    
    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button" BasedOn="{StaticResource App.Button.Toolbar}" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="Auto"/> <!-- Presets -->
            <RowDefinition Height="*"/>    <!-- Terminal -->
        </Grid.RowDefinitions>

        <!-- SSH Connection Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource Surface.Card}" Padding="10" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Border.Subtle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="SSH Connection:" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <ComboBox x:Name="SshProfilesCombo" Width="250" Height="28" 
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="SshProfilesCombo_SelectionChanged">
                    <ComboBox.Resources>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="#333337"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                    </ComboBox.Resources>
                </ComboBox>

                <Button Content="🔌 Quick Connect" Margin="10,0,0,0" Height="28" Padding="10,0"
                        Style="{StaticResource App.Button.Primary}" Foreground="{StaticResource Text.Primary}"
                        Click="QuickConnect_Click"/>

                <Button Content="⚙️ Manage Profiles" Margin="10,0,0,0" Height="28" Padding="10,0"
                        Style="{StaticResource App.Button.Ghost}" Foreground="{StaticResource Text.Secondary}"
                        Click="ManageProfiles_Click"/>
            </StackPanel>
        </Border>

        <!-- Command Presets -->
        <Border Grid.Row="1" Background="{StaticResource Surface.Shell}" Padding="10" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="PresetComboBox"
                              Grid.Column="0"
                              Height="28"
                              DisplayMemberPath="Title"
                              SelectedValuePath="Id"
                              Margin="0,0,12,0"/>
                    <Button Content="Insert"
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            Padding="14,4"
                            Style="{StaticResource App.Button.Primary}"
                            Foreground="{StaticResource Text.Primary}"
                            Cursor="Hand"
                            Click="UsePreset_Click"/>
                    <Button Content="Delete"
                            Grid.Column="2"
                            Margin="0,0,8,0"
                            Padding="14,4"
                            Style="{StaticResource App.Button.Danger}"
                            Foreground="{StaticResource Text.Primary}"
                            Cursor="Hand"
                            Click="DeletePreset_Click"/>
                    <CheckBox x:Name="BroadcastAllCheckBox"
                              Grid.Column="3"
                              Content="Send to all open terminals"
                              Foreground="{StaticResource Text.Secondary}"
                              VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PresetTitleBox"
                             mah:TextBoxHelper.Watermark="Title"
                             Grid.Column="0"
                             Margin="0,0,12,0"/>
                    <TextBox x:Name="PresetCommandBox"
                             mah:TextBoxHelper.Watermark="Command"
                             Grid.Column="1"
                             Margin="0,0,12,0"/>
                    <Button Content="Save"
                            Grid.Column="2"
                            Padding="14,4"
                            Style="{StaticResource App.Button.Primary}"
                            Foreground="{StaticResource Text.Primary}"
                            Cursor="Hand"
                            Click="AddPresetButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <controls:TerminalControl x:Name="MyTerminal" Grid.Row="2"/>
    </Grid>
</mah:MetroWindow>
