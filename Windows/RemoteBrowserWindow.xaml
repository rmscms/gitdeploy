<Window x:Class="GitDeployPro.Windows.RemoteBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Browser" Height="550" Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{StaticResource Surface.Raised}" 
            CornerRadius="14" 
            BorderBrush="{StaticResource Border.Strong}" 
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="8" Opacity="0.45"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📂" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Select Remote Folder" 
                              FontSize="20" 
                              FontWeight="Bold" 
                              Foreground="{StaticResource Text.Primary}"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" Content="✕" 
                        Width="30" Height="30" 
                        Background="Transparent" 
                        Foreground="{StaticResource Text.Muted}" 
                        BorderThickness="0"
                        FontSize="16"
                        Cursor="Hand"
                        Click="Close_Click"/>
            </Grid>

            <!-- Current Path -->
            <TextBox Grid.Row="1" 
                     x:Name="PathTextBox"
                     Height="35" 
                     Text="/" 
                     Style="{StaticResource App.InputTextBox}"
                     Padding="10,0"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,10"
                     IsReadOnly="True"/>

            <!-- File List -->
            <Border Grid.Row="2" Background="{StaticResource Surface.Card}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="10" Padding="10">
                <ListBox x:Name="FileListBox" 
                         Style="{StaticResource App.ListBox.Host}"
                         Foreground="{StaticResource Text.Primary}"
                         MouseDoubleClick="FileListBox_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="{Binding Icon}" FontSize="18" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Cancel" 
                        Height="40" 
                        Width="100" 
                        Margin="0,0,10,0"
                        Style="{StaticResource App.Button.Ghost}"
                        Foreground="{StaticResource Text.Secondary}"
                        FontSize="14"
                        Cursor="Hand"
                        Click="Close_Click"/>

                <Button Content="Select" 
                        Height="40" 
                        Width="100"
                        Style="{StaticResource App.Button.Primary}"
                        Foreground="{StaticResource Text.Primary}"
                        FontSize="14"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="Select_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

