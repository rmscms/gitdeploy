<mah:MetroWindow x:Class="GitDeployPro.Windows.EditorHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Title="Editor"
        Width="960"
        Height="720"
        MinWidth="640"
        MinHeight="420"
        ShowInTaskbar="True"
        ResizeMode="CanResizeWithGrip"
        ShowIconOnTitleBar="False"
        TitleCharacterCasing="Normal"
        TitleForeground="{StaticResource Text.Primary}"
        Background="{StaticResource Surface.Base}"
        Foreground="{StaticResource Text.Primary}"
        WindowTitleBrush="{StaticResource Surface.Card}"
        NonActiveWindowTitleBrush="{StaticResource Surface.Shell}"
        BorderBrush="{StaticResource Border.Subtle}"
        BorderThickness="1"
        GlowBrush="{x:Null}"
        WindowStartupLocation="CenterOwner">
    <Border x:Name="EditorHost"
            Background="{StaticResource Surface.Base}" />
</mah:MetroWindow>
