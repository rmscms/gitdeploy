<Window x:Class="GitDeployPro.Windows.ProjectSetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Title="Project Setup Wizard" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{StaticResource Surface.Raised}" CornerRadius="14" BorderBrush="{StaticResource Border.Strong}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="8" Opacity="0.45"/>
        </Border.Effect>

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="🚀 Project Setup" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                <TextBlock Text="Configure Git and Deployment for your new project." Foreground="{StaticResource Text.Muted}" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Content Area -->
            <Border Grid.Row="1" Background="{StaticResource Surface.Card}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="10" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#1F2A35" CornerRadius="8" Padding="14" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="0. Recovery / Reinitialize (Optional)" FontSize="15" FontWeight="SemiBold" Foreground="#90CAF9"/>
                                <TextBlock Text="Use this when setup is broken and you need a clean rebuild for this project folder." Foreground="#B0BEC5" Margin="0,6,0,10" TextWrapping="Wrap"/>
                                <CheckBox x:Name="ResetGitFolderCheckBox"
                                          Content="Remove .git folder before setup"
                                          Foreground="White"
                                          Margin="0,0,0,6"
                                          Checked="ResetOption_Checked"
                                          Unchecked="ResetOption_Checked"/>
                                <CheckBox x:Name="ResetConfigFileCheckBox"
                                          Content="Remove .gitdeploy.config before setup"
                                          Foreground="White"
                                          Checked="ResetOption_Checked"
                                          Unchecked="ResetOption_Checked"/>
                                <TextBlock x:Name="ResetHintText"
                                           Text="No reset selected."
                                           FontSize="11"
                                           Foreground="#90A4AE"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Step 1: Git Source -->
                        <TextBlock Text="1. Git Repository Source" FontSize="16" FontWeight="SemiBold" Foreground="#4FC3F7" Margin="0,0,0,10"/>
                        <StackPanel Margin="15,0,0,20">
                            <RadioButton x:Name="LocalGitRadio" GroupName="GitSource" Content="Local Repository (Initialize new)" IsChecked="True" Foreground="White" Margin="0,0,0,10" Checked="GitSource_Checked"/>
                            <StackPanel x:Name="LocalGitPanel" Margin="25,0,0,15">
                                <TextBlock Text="Initial Branch Name:" Foreground="#CCCCCC" Margin="0,0,0,5"/>
                                <TextBox x:Name="LocalBranchName" Text="master" Width="200" HorizontalAlignment="Left" Background="#3A3A3A" Foreground="White" Padding="5"/>
                            </StackPanel>

                            <RadioButton x:Name="RemoteGitRadio" GroupName="GitSource" Content="Remote Repository (Clone/Connect)" Foreground="White" Margin="0,0,0,10" Checked="GitSource_Checked"/>
                            <StackPanel x:Name="RemoteGitPanel" Margin="25,0,0,5" Visibility="Collapsed">
                                <TextBlock Text="Remote URL (HTTPS/SSH):" Foreground="#CCCCCC" Margin="0,0,0,5"/>
                                <TextBox x:Name="RemoteUrlBox" Width="400" HorizontalAlignment="Left" Background="#3A3A3A" Foreground="White" Padding="5"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Step 2: FTP Configuration (New Profile Based) -->
                        <TextBlock Text="2. Deployment Target (FTP/SFTP)" FontSize="16" FontWeight="SemiBold" Foreground="#4FC3F7" Margin="0,0,0,10"/>
                        <CheckBox x:Name="EnableFtpCheck" Content="Enable FTP Deployment" Foreground="White" Margin="15,0,0,10" Checked="EnableFtp_Checked" Unchecked="EnableFtp_Checked"/>
                        
                        <StackPanel x:Name="FtpConfigPanel" Margin="40,0,0,20" Visibility="Collapsed">
                             <TextBlock Text="Select Connection Profile:" Foreground="#CCCCCC" Margin="0,0,0,5"/>
                             <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <ComboBox x:Name="ConnectionProfileComboBox" 
                                          Grid.Column="0"
                                          Height="38"
                                          Background="#3A3A3A"
                                          Foreground="White"
                                          BorderBrush="#555555"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="ConnectionProfileComboBox_SelectionChanged"
                                          FontSize="14"
                                          Padding="10,5"/>

                                <Button x:Name="ManageProfilesButton"
                                        Grid.Column="1"
                                        Content="➕ Manage Profiles" 
                                        Height="38" 
                                        Width="140"
                                        Margin="10,0,0,0"
                                        Background="#007ACC"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontSize="13"
                                        Cursor="Hand"
                                        Click="ManageProfilesButton_Click"/>
                             </Grid>

                            <!-- Selected Profile Info (Read Only) -->
                            <Border Background="#1E1E1E" CornerRadius="6" Padding="15" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Host:" Grid.Row="0" Grid.Column="0" Foreground="#888888" Margin="0,0,10,5"/>
                                    <TextBlock x:Name="PreviewHostText" Grid.Row="0" Grid.Column="1" Foreground="White" FontWeight="Bold" Text="-"/>

                                    <TextBlock Text="Protocol:" Grid.Row="1" Grid.Column="0" Foreground="#888888" Margin="0,0,10,5"/>
                                    <TextBlock x:Name="PreviewProtocolText" Grid.Row="1" Grid.Column="1" Foreground="White" Text="-"/>

                                    <TextBlock Text="User:" Grid.Row="2" Grid.Column="0" Foreground="#888888" Margin="0,0,10,5"/>
                                    <TextBlock x:Name="PreviewUserText" Grid.Row="2" Grid.Column="1" Foreground="White" Text="-"/>

                                    <TextBlock Text="Root Path:" Grid.Row="3" Grid.Column="0" Foreground="#888888" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="PreviewPathText" Grid.Row="3" Grid.Column="1" Foreground="#4EC9B0" Text="-"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Step 3: Branch Strategy -->
                        <TextBlock Text="3. Branch Strategy" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Status.Info}" Margin="0,0,0,10"/>
                        <StackPanel Margin="15,0,0,0">
                            <TextBlock Text="Source Branch (Development):" Foreground="#CCCCCC" Margin="0,0,0,5"/>
                            <ComboBox x:Name="SourceBranchCombo" Width="200" HorizontalAlignment="Left" IsEditable="True" Text="master" Margin="0,0,0,10">
                                <ComboBoxItem Content="master"/>
                                <ComboBoxItem Content="main"/>
                                <ComboBoxItem Content="beta"/>
                            </ComboBox>
                            
                            <TextBlock Text="Target Branch (Production/Deploy):" Foreground="#CCCCCC" Margin="0,0,0,5"/>
                            <ComboBox x:Name="TargetBranchCombo" Width="200" HorizontalAlignment="Left" IsEditable="True" Text="production">
                                <ComboBoxItem Content="production"/>
                                <ComboBoxItem Content="main"/>
                                <ComboBoxItem Content="master"/>
                            </ComboBox>
                            <TextBlock Text="Files will be deployed from Target Branch." FontSize="11" Foreground="#808080" Margin="0,5,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Footer -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Width="100" Height="40" Style="{StaticResource App.Button.Ghost}" Foreground="{StaticResource Text.Secondary}" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button x:Name="FinishButton" Content="Finish &amp; Setup" Width="150" Height="40" Style="{StaticResource App.Button.Success}" Foreground="{StaticResource Text.Inverse}" FontWeight="Bold" Click="Finish_Click"/>
            </StackPanel>

            <!-- Loading Overlay -->
            <Grid x:Name="OverlayGrid" Grid.RowSpan="3" Background="{StaticResource Surface.Overlay}" Visibility="Collapsed" Margin="-30">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="10" Background="{StaticResource Surface.Input}" Foreground="{StaticResource Accent.Primary}" BorderThickness="0"/>
                    <TextBlock Text="Please wait, setting up project..." Foreground="{StaticResource Text.Primary}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,10"/>
                    <Border Width="560" Height="140" Background="{StaticResource Surface.Shell}" CornerRadius="10" Padding="10" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1">
                        <ScrollViewer x:Name="OverlayLogScrollViewer" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LogText" Text="Initializing..." Foreground="{StaticResource Text.Secondary}" FontSize="12" TextWrapping="Wrap" FontFamily="{StaticResource FontFamily.Mono}"/>
                        </ScrollViewer>
                    </Border>
                    <Button x:Name="CopyErrorDetailsButton"
                            Content="Copy Error Details"
                            Width="160"
                            Height="34"
                            Margin="0,12,0,0"
                            Style="{StaticResource App.Button.Ghost}"
                            Foreground="{StaticResource Text.Secondary}"
                            Visibility="Collapsed"
                            Click="CopyErrorDetailsButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>