<Window x:Class="GitDeployPro.Windows.ProjectSetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Setup Wizard" Height="620" Width="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{StaticResource Surface.Raised}" CornerRadius="14" BorderBrush="{StaticResource Border.Strong}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="8" Opacity="0.45"/>
        </Border.Effect>

        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock x:Name="WizardTitleText" Text="🚀 Project Setup" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                    <TextBlock x:Name="WizardSubtitleText"
                               Text="Configure Git and Deployment for your new project."
                               Foreground="{StaticResource Text.Muted}"
                               FontSize="13"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="StepCaptionText"
                               Text="Step 1 of 4 — Recovery"
                               Foreground="{StaticResource Text.Secondary}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,10,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top" MinWidth="150">
                    <TextBlock x:Name="WizardLangLabel"
                               Text="Language"
                               FontSize="11"
                               Foreground="{StaticResource Text.Muted}"
                               Margin="0,0,0,4"/>
                    <ComboBox x:Name="WizardLanguageCombo"
                              Height="34"
                              Width="150"
                              Style="{StaticResource App.InputComboBox}"
                              SelectionChanged="WizardLanguageCombo_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Step tabs -->
            <Border Grid.Row="1"
                    Background="{StaticResource Surface.Card}"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,8"
                    Margin="0,0,0,14">
                <UniformGrid Columns="4" Rows="1">
                    <Button x:Name="TabRecoveryButton" Style="{StaticResource App.Button.Ghost}" Height="44" Margin="2,0" Click="StepTab_Click" Tag="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border x:Name="TabRecoveryBadge" Width="22" Height="22" CornerRadius="11" Background="{StaticResource Accent.Primary}" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="1" Foreground="{StaticResource Text.Inverse}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TabRecoveryTitle" Text="Recovery" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Text.Primary}"/>
                                <TextBlock x:Name="TabRecoveryHint" Text="Optional reset" FontSize="10" Foreground="{StaticResource Text.Muted}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TabGitButton" Style="{StaticResource App.Button.Ghost}" Height="44" Margin="2,0" Click="StepTab_Click" Tag="1" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border x:Name="TabGitBadge" Width="22" Height="22" CornerRadius="11" Background="{StaticResource Surface.Input}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="2" Foreground="{StaticResource Text.Secondary}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TabGitTitle" Text="Git" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
                                <TextBlock x:Name="TabGitHint" Text="Repository" FontSize="10" Foreground="{StaticResource Text.Muted}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TabDeployButton" Style="{StaticResource App.Button.Ghost}" Height="44" Margin="2,0" Click="StepTab_Click" Tag="2" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border x:Name="TabDeployBadge" Width="22" Height="22" CornerRadius="11" Background="{StaticResource Surface.Input}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="3" Foreground="{StaticResource Text.Secondary}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TabDeployTitle" Text="Deploy" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
                                <TextBlock x:Name="TabDeployHint" Text="FTP / SFTP" FontSize="10" Foreground="{StaticResource Text.Muted}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TabBranchesButton" Style="{StaticResource App.Button.Ghost}" Height="44" Margin="2,0" Click="StepTab_Click" Tag="3" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border x:Name="TabBranchesBadge" Width="22" Height="22" CornerRadius="11" Background="{StaticResource Surface.Input}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="4" Foreground="{StaticResource Text.Secondary}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TabBranchesTitle" Text="Branches" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
                                <TextBlock x:Name="TabBranchesHint" Text="Source / target" FontSize="10" Foreground="{StaticResource Text.Muted}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Border>

            <!-- Step pages -->
            <Border Grid.Row="2" Background="{StaticResource Surface.Card}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="10" Padding="20">
                <Grid>
                    <!-- Step 0: Recovery -->
                    <ScrollViewer x:Name="StepRecoveryPanel" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="RecoveryTitleText" Text="Recovery / Reinitialize" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="RecoveryDescText" Text="Optional. Use this when setup is broken and you need a clean rebuild for this project folder."
                                       Foreground="{StaticResource Text.Muted}" Margin="0,0,0,16" TextWrapping="Wrap"/>
                            <Border Background="{StaticResource Surface.Shell}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <CheckBox x:Name="ResetGitFolderCheckBox"
                                              Content="Remove .git folder before setup"
                                              Foreground="{StaticResource Text.Primary}"
                                              Margin="0,0,0,8"
                                              Checked="ResetOption_Checked"
                                              Unchecked="ResetOption_Checked"/>
                                    <CheckBox x:Name="ResetConfigFileCheckBox"
                                              Content="Remove .gitdeploy.config before setup"
                                              Foreground="{StaticResource Text.Primary}"
                                              Checked="ResetOption_Checked"
                                              Unchecked="ResetOption_Checked"/>
                                    <TextBlock x:Name="ResetHintText"
                                               Text="No reset selected."
                                               FontSize="11"
                                               Foreground="{StaticResource Text.Muted}"
                                               Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Step 1: Git -->
                    <ScrollViewer x:Name="StepGitPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="GitTitleText" Text="Git Repository Source" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="GitDescText" Text="Choose how this project folder should connect to Git."
                                       Foreground="{StaticResource Text.Muted}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                            <RadioButton x:Name="LocalGitRadio" GroupName="GitSource" Content="Local Repository (Initialize new)" IsChecked="True"
                                         Foreground="{StaticResource Text.Primary}" Margin="0,0,0,10" Checked="GitSource_Checked"/>
                            <StackPanel x:Name="LocalGitPanel" Margin="24,0,0,16">
                                <TextBlock x:Name="InitialBranchLabel" Text="Initial Branch Name:" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,6"/>
                                <TextBox x:Name="LocalBranchName" Text="master" Width="220" HorizontalAlignment="Left"
                                         Style="{StaticResource App.InputTextBox}" Padding="8,6"/>
                            </StackPanel>

                            <RadioButton x:Name="RemoteGitRadio" GroupName="GitSource" Content="Remote Repository (Clone/Connect)"
                                         Foreground="{StaticResource Text.Primary}" Margin="0,0,0,10" Checked="GitSource_Checked"/>
                            <StackPanel x:Name="RemoteGitPanel" Margin="24,0,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="RemoteUrlLabel" Text="Remote URL (HTTPS/SSH):" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,6"/>
                                <TextBox x:Name="RemoteUrlBox" Width="480" MaxWidth="560" HorizontalAlignment="Left"
                                         Style="{StaticResource App.InputTextBox}" Padding="8,6"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Step 2: Deploy -->
                    <ScrollViewer x:Name="StepDeployPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="DeployTitleText" Text="Deployment Target (FTP/SFTP)" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="DeployDescText" Text="Optional. Enable FTP/SFTP if this project deploys to a remote host."
                                       Foreground="{StaticResource Text.Muted}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                            <CheckBox x:Name="EnableFtpCheck" Content="Enable FTP Deployment"
                                      Foreground="{StaticResource Text.Primary}" Margin="0,0,0,12"
                                      Checked="EnableFtp_Checked" Unchecked="EnableFtp_Checked"/>

                            <StackPanel x:Name="FtpConfigPanel" Visibility="Collapsed">
                                <TextBlock x:Name="SelectProfileLabel" Text="Select Connection Profile:" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ConnectionProfileComboBox"
                                              Grid.Column="0"
                                              Height="38"
                                              Style="{StaticResource App.InputComboBox}"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="ConnectionProfileComboBox_SelectionChanged"
                                              FontSize="14"
                                              Padding="10,5"/>
                                    <Button x:Name="ManageProfilesButton"
                                            Grid.Column="1"
                                            Content="➕ Manage Profiles"
                                            Height="38"
                                            MinWidth="150"
                                            Margin="10,0,0,0"
                                            Style="{StaticResource App.Button.Primary}"
                                            Click="ManageProfilesButton_Click"/>
                                </Grid>

                                <Border Background="{StaticResource Surface.Shell}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PreviewHostLabel" Text="Host:" Grid.Row="0" Grid.Column="0" Foreground="{StaticResource Text.Muted}" Margin="0,0,12,6"/>
                                        <TextBlock x:Name="PreviewHostText" Grid.Row="0" Grid.Column="1" Foreground="{StaticResource Text.Primary}" FontWeight="SemiBold" Text="-"/>
                                        <TextBlock x:Name="PreviewProtocolLabel" Text="Protocol:" Grid.Row="1" Grid.Column="0" Foreground="{StaticResource Text.Muted}" Margin="0,0,12,6"/>
                                        <TextBlock x:Name="PreviewProtocolText" Grid.Row="1" Grid.Column="1" Foreground="{StaticResource Text.Primary}" Text="-"/>
                                        <TextBlock x:Name="PreviewUserLabel" Text="User:" Grid.Row="2" Grid.Column="0" Foreground="{StaticResource Text.Muted}" Margin="0,0,12,6"/>
                                        <TextBlock x:Name="PreviewUserText" Grid.Row="2" Grid.Column="1" Foreground="{StaticResource Text.Primary}" Text="-"/>
                                        <TextBlock x:Name="PreviewPathLabel" Text="Root Path:" Grid.Row="3" Grid.Column="0" Foreground="{StaticResource Text.Muted}" Margin="0,0,12,0"/>
                                        <TextBlock x:Name="PreviewPathText" Grid.Row="3" Grid.Column="1" Foreground="{StaticResource Status.Success}" Text="-"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Step 3: Branches -->
                    <ScrollViewer x:Name="StepBranchesPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="BranchesTitleText" Text="Branch Strategy" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="BranchesDescText" Text="Pick development and production branches. Deploy uses the target branch."
                                       Foreground="{StaticResource Text.Muted}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                            <TextBlock x:Name="SourceBranchLabel" Text="Source Branch (Development):" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="SourceBranchCombo" Width="220" HorizontalAlignment="Left" IsEditable="True" Text="master" Margin="0,0,0,14"
                                      Style="{StaticResource App.InputComboBox}">
                                <ComboBoxItem Content="master"/>
                                <ComboBoxItem Content="main"/>
                                <ComboBoxItem Content="beta"/>
                            </ComboBox>

                            <TextBlock x:Name="TargetBranchLabel" Text="Target Branch (Production/Deploy):" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="TargetBranchCombo" Width="220" HorizontalAlignment="Left" IsEditable="True" Text="production"
                                      Style="{StaticResource App.InputComboBox}">
                                <ComboBoxItem Content="production"/>
                                <ComboBoxItem Content="main"/>
                                <ComboBoxItem Content="master"/>
                            </ComboBox>
                            <TextBlock x:Name="BranchesFootnoteText" Text="Files will be deployed from the Target Branch."
                                       FontSize="11" Foreground="{StaticResource Text.Muted}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Footer -->
            <Grid Grid.Row="3" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="BackButton"
                            Content="← Back"
                            Width="100"
                            Height="40"
                            Style="{StaticResource App.Button.Ghost}"
                            Foreground="{StaticResource Text.Secondary}"
                            IsEnabled="False"
                            Click="Back_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SkipButton"
                            Content="Skip"
                            Width="100"
                            Height="40"
                            Style="{StaticResource App.Button.Ghost}"
                            Foreground="{StaticResource Text.Secondary}"
                            Margin="0,0,10,0"
                            Visibility="Collapsed"
                            Click="Skip_Click"
                            ToolTip="Create a minimal .gitdeploy.config and continue without full setup"/>
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Width="100"
                            Height="40"
                            Style="{StaticResource App.Button.Ghost}"
                            Foreground="{StaticResource Text.Secondary}"
                            Margin="0,0,10,0"
                            Click="Cancel_Click"/>
                    <Button x:Name="NextButton"
                            Content="Next →"
                            Width="110"
                            Height="40"
                            Style="{StaticResource App.Button.Primary}"
                            Margin="0,0,10,0"
                            Click="Next_Click"/>
                    <Button x:Name="FinishButton"
                            Content="Finish &amp; Setup"
                            Width="150"
                            Height="40"
                            Style="{StaticResource App.Button.Success}"
                            Foreground="{StaticResource Text.Inverse}"
                            FontWeight="Bold"
                            Visibility="Collapsed"
                            Click="Finish_Click"/>
                </StackPanel>
            </Grid>

            <!-- Loading Overlay -->
            <Grid x:Name="OverlayGrid"
                  Grid.RowSpan="4"
                  Background="{StaticResource Surface.Overlay}"
                  Visibility="Collapsed"
                  Margin="-28"
                  Panel.ZIndex="100">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Setting up project..."
                               Foreground="{StaticResource Text.Primary}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,8">
                        <ProgressBar x:Name="SetupProgressBar"
                                     Width="240"
                                     Height="10"
                                     Minimum="0"
                                     Maximum="5"
                                     Value="0"
                                     IsIndeterminate="True"
                                     Background="{StaticResource Surface.Input}"
                                     Foreground="{StaticResource Accent.Primary}"
                                     BorderThickness="0"/>
                        <TextBlock x:Name="SetupProgressSummary"
                                   Text=""
                                   Foreground="{StaticResource Status.Success}"
                                   Margin="12,0,0,0"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="SetupProgressStatus"
                               Text="Please wait..."
                               Foreground="{StaticResource Text.Secondary}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,14"
                               TextWrapping="Wrap"
                               MaxWidth="560"/>
                    <Border Width="560" Height="140" Background="{StaticResource Surface.Shell}" CornerRadius="10" Padding="10" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1">
                        <ScrollViewer x:Name="OverlayLogScrollViewer" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LogText" Text="Initializing..." Foreground="{StaticResource Text.Secondary}" FontSize="12" TextWrapping="Wrap" FontFamily="{StaticResource FontFamily.Mono}"/>
                        </ScrollViewer>
                    </Border>
                    <Button x:Name="CopyErrorDetailsButton"
                            Content="Copy Error Details"
                            Width="160"
                            Height="34"
                            Margin="0,12,0,0"
                            Style="{StaticResource App.Button.Ghost}"
                            Foreground="{StaticResource Text.Secondary}"
                            Visibility="Collapsed"
                            Click="CopyErrorDetailsButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
