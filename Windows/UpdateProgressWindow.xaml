<Window x:Class="GitDeployPro.Windows.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:GitDeployPro.Behaviors"
        Title="Downloading update"
        Width="420"
        Height="180"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Surface.Base}"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border Width="32" Height="32" CornerRadius="9" Margin="0,0,10,0"
                    Background="{DynamicResource Accent.Soft}">
                <Path behaviors:AppIcon.Kind="download"
                      behaviors:AppIcon.Size="16"
                      TextElement.Foreground="{DynamicResource Accent.Primary}" />
            </Border>
            <TextBlock Text="Downloading update..."
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Text.Primary}" />
        </StackPanel>

        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Margin="0,10,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource Text.Secondary}"
                   Text="Preparing download..." />

        <ProgressBar x:Name="DownloadProgress"
                     Grid.Row="2"
                     Style="{StaticResource App.ProgressBar}"
                     Margin="0,16,0,0"
                     Minimum="0"
                     Maximum="100"
                     IsIndeterminate="True" />
    </Grid>
</Window>
