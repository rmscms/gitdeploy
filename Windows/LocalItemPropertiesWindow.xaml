<mah:MetroWindow x:Class="GitDeployPro.Windows.LocalItemPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Title="Properties"
        Width="520"
        MinWidth="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Surface.Base}"
        Foreground="{StaticResource Text.Primary}"
        WindowTitleBrush="{StaticResource Surface.Card}"
        NonActiveWindowTitleBrush="{StaticResource Surface.Card}">
    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock x:Name="IconText"
                       FontSize="22"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="NameText"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Text.Primary}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="KindText"
                           FontSize="12"
                           Foreground="{StaticResource Text.Muted}"
                           Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Location" FontSize="12" Foreground="{StaticResource Text.Muted}" Margin="0,4,8,4" />
                <TextBlock x:Name="LocationText" Grid.Row="0" Grid.Column="1" FontFamily="{StaticResource FontFamily.Mono}" FontSize="12" Foreground="{StaticResource Text.Primary}" TextWrapping="Wrap" Margin="0,4,0,4" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Path" Foreground="{StaticResource Text.Muted}" FontSize="12" Margin="0,4,8,4" />
                <TextBlock x:Name="PathText" Grid.Row="1" Grid.Column="1" FontFamily="{StaticResource FontFamily.Mono}" FontSize="12" Foreground="{StaticResource Text.Primary}" TextWrapping="Wrap" Margin="0,4,0,4" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Size" Foreground="{StaticResource Text.Muted}" FontSize="12" Margin="0,4,8,4" />
                <TextBlock x:Name="SizeText" Grid.Row="2" Grid.Column="1" FontSize="12" Foreground="{StaticResource Text.Primary}" TextWrapping="Wrap" Margin="0,4,0,4" />

                <TextBlock x:Name="ContainsLabel" Grid.Row="3" Grid.Column="0" Text="Contains" Foreground="{StaticResource Text.Muted}" FontSize="12" Margin="0,4,8,4" Visibility="Collapsed" />
                <TextBlock x:Name="ContainsText" Grid.Row="3" Grid.Column="1" FontSize="12" Foreground="{StaticResource Text.Primary}" TextWrapping="Wrap" Margin="0,4,0,4" Visibility="Collapsed" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Created" Foreground="{StaticResource Text.Muted}" FontSize="12" Margin="0,4,8,4" />
                <TextBlock x:Name="CreatedText" Grid.Row="4" Grid.Column="1" FontSize="12" Foreground="{StaticResource Text.Primary}" Margin="0,4,0,4" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Modified" Foreground="{StaticResource Text.Muted}" FontSize="12" Margin="0,4,8,4" />
                <TextBlock x:Name="ModifiedText" Grid.Row="5" Grid.Column="1" FontSize="12" Foreground="{StaticResource Text.Primary}" Margin="0,4,0,4" />

                <TextBlock x:Name="ExtensionLabel" Grid.Row="6" Grid.Column="0" Text="Extension" Foreground="{StaticResource Text.Muted}" FontSize="12" Margin="0,4,8,4" />
                <TextBlock x:Name="ExtensionText" Grid.Row="6" Grid.Column="1" FontSize="12" Foreground="{StaticResource Text.Primary}" Margin="0,4,0,4" />

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Attributes" Foreground="{StaticResource Text.Muted}" FontSize="12" Margin="0,4,8,4" />
                <TextBlock x:Name="AttributesText" Grid.Row="7" Grid.Column="1" FontSize="12" Foreground="{StaticResource Text.Primary}" TextWrapping="Wrap" Margin="0,4,0,4" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Copy path"
                    Width="110"
                    Height="32"
                    Margin="0,0,8,0"
                    Style="{StaticResource App.Button.Ghost}"
                    Click="CopyPath_Click" />
            <Button Content="Close"
                    Width="90"
                    Height="32"
                    Style="{StaticResource App.Button.Primary}"
                    IsDefault="True"
                    IsCancel="True"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
