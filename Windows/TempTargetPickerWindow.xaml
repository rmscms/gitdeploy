<mah:MetroWindow x:Class="GitDeployPro.Windows.TempTargetPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GitDeployPro.Services.Localization"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Title="{loc:T tmap.pick.title}"
        Width="520"
        MinWidth="460"
        MaxHeight="620"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Surface.Base}"
        Foreground="{StaticResource Text.Primary}"
        WindowTitleBrush="{StaticResource Surface.Card}"
        NonActiveWindowTitleBrush="{StaticResource Surface.Card}">
    <Grid Margin="20,16,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Text.Primary}" />
            <TextBlock x:Name="HintText" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource Text.Muted}" TextWrapping="Wrap" />
            <StackPanel x:Name="MultiTools" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="{loc:T tmap.pick.all}" ToolTip="{loc:T tmap.pick.tip.all}" Height="28" Padding="12,0" Margin="0,0,8,0" Style="{StaticResource App.Button.Ghost}" Click="SelectAll_Click" />
                <Button Content="{loc:T tmap.pick.none}" ToolTip="{loc:T tmap.pick.tip.none}" Height="28" Padding="12,0" Style="{StaticResource App.Button.Ghost}" Click="SelectNone_Click" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="360">
            <ItemsControl x:Name="TargetsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource App.PanelStyle}" Padding="12,9" Margin="0,0,0,6" Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="Row_MouseLeftButtonUp">
                            <DockPanel LastChildFill="True">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0" Click="Check_Click" Tag="{Binding}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Text.Primary}" />
                                    <TextBlock Text="{Binding RemotePath}" FontFamily="{StaticResource FontFamily.Mono}" FontSize="11" Foreground="{StaticResource Text.Muted}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="{loc:T tmap.pick.cancel}" Height="34" MinWidth="90" Margin="8,0,0,0" Style="{StaticResource App.Button.Ghost}" Click="Cancel_Click" />
            <Button x:Name="OkButton" DockPanel.Dock="Right" Height="34" MinWidth="150" Style="{StaticResource App.Button.Primary}" Click="Ok_Click" />
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{StaticResource Text.Muted}" FontSize="12" />
        </DockPanel>
    </Grid>
</mah:MetroWindow>
