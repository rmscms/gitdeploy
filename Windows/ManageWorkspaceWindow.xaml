<mah:MetroWindow x:Class="GitDeployPro.Windows.ManageWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:loc="clr-namespace:GitDeployPro.Services.Localization"
        Title="{loc:T telegram.workspace.manageTitle}"
        Width="520"
        MinHeight="360"
        MaxHeight="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Surface.Base}"
        Foreground="{StaticResource Text.Primary}"
        WindowTitleBrush="{StaticResource Surface.Card}"
        NonActiveWindowTitleBrush="{StaticResource Surface.Card}">
    <Grid Margin="18,16,18,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:T telegram.workspace.manageHint}"
                   FontSize="12"
                   Foreground="{StaticResource Text.Muted}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <TextBlock Grid.Row="1"
                   Text="{loc:T telegram.workspace.primaryLabel}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource Text.Primary}"
                   Margin="0,0,0,4" />

        <TextBox x:Name="PrimaryPathBox"
                 Grid.Row="2"
                 IsReadOnly="True"
                 Style="{StaticResource App.InputTextBox}"
                 Margin="0,0,0,12"
                 TextWrapping="Wrap" />

        <Border Grid.Row="3"
                Background="{StaticResource Surface.Shell}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{loc:T telegram.workspace.extraLabel}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Text.Primary}"
                           Margin="4,4,4,8" />
                <ListBox x:Name="ExtrasList"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionMode="Single" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    Margin="0,12,0,0">
            <Button Content="{loc:T telegram.workspace.add}"
                    Style="{StaticResource App.Button.Secondary}"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    Click="AddButton_Click" />
            <Button Content="{loc:T telegram.workspace.remove}"
                    Style="{StaticResource App.Button.Ghost}"
                    Padding="12,6"
                    Click="RemoveButton_Click" />
        </StackPanel>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="{loc:T telegram.workspace.save}"
                    Style="{StaticResource App.Button.Primary}"
                    Width="100"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="SaveButton_Click"
                    IsDefault="True" />
            <Button Content="{loc:T telegram.workspace.cancel}"
                    Style="{StaticResource App.Button.Ghost}"
                    Width="100"
                    Height="32"
                    Click="CancelButton_Click"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
