<Window x:Class="GitDeployPro.Windows.DiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GitDeployPro.Controls"
        Title="Compare Changes" Height="780" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{StaticResource Surface.Raised}" 
            CornerRadius="14" 
            BorderBrush="{StaticResource Border.Strong}" 
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="8" Opacity="0.45"/>
        </Border.Effect>

        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔍" FontSize="28" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock Text="Review Changes" 
                              FontSize="24" 
                              FontWeight="Bold" 
                              Foreground="{StaticResource Text.Primary}"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" Content="✕" 
                        Width="30" Height="30" 
                        Background="Transparent" 
                        Foreground="{StaticResource Text.Muted}" 
                        BorderThickness="0"
                        FontSize="16" 
                        Cursor="Hand"
                        Click="Close_Click"/>
            </Grid>

            <!-- File List -->
            <Border Grid.Row="1" Background="{StaticResource Surface.Card}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <CheckBox x:Name="SelectAllCheckBox"
                                 Content="Select All"
                                 FontSize="14"
                                 Foreground="#CCCCCC"
                                 VerticalAlignment="Center"
                                 IsChecked="True"
                                 Margin="0,0,15,0"
                                 Click="SelectAll_Click"/>
                        
                        <TextBlock x:Name="TotalChangesText" Text="5 Files" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="1.3*"/>
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                            <ListBox x:Name="FilesListBox"
                                     ItemContainerStyle="{StaticResource App.ListBoxItem.Transparent}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SelectionMode="Single"
                                     SelectionChanged="FilesListBox_SelectionChanged"
                                     MouseDoubleClick="FilesListBox_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Surface.Input}" 
                                                CornerRadius="4" 
                                                Padding="10" 
                                                Margin="0,0,0,8"
                                                BorderBrush="{StaticResource Border.Subtle}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" 
                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,10,0"/>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" 
                                                              FontSize="13" 
                                                              Foreground="{StaticResource Text.Secondary}"
                                                              VerticalAlignment="Center"
                                                              TextTrimming="CharacterEllipsis"/>
                                                    <Button Content="VS"
                                                            Margin="10,0,0,0"
                                                            Padding="8,2"
                                                            FontSize="11"
                                                            Style="{StaticResource App.Button.Ghost}"
                                                            Cursor="Hand"
                                                            Tag="{Binding}"
                                                            Click="OpenCodeButton_Click"/>
                                                </StackPanel>

                                                <Border Grid.Column="2" 
                                                        Background="{Binding StatusColor}" 
                                                        CornerRadius="3" 
                                                        Padding="6,2"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" 
                                                              FontSize="11" 
                                                              FontWeight="Bold" 
                                                              Foreground="White"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>

                        <controls:DiffViewer Grid.Column="2"
                                             x:Name="CompareDiffViewer"
                                             Title="Diff preview"
                                             EmptyMessage="Pick a file to preview differences"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" 
                        Height="40" 
                        Width="100" 
                        Margin="0,0,15,0"
                        Style="{StaticResource App.Button.Ghost}"
                        FontSize="14"
                        Cursor="Hand"
                        Click="Close_Click"/>

                <Button Content="🚀 DEPLOY SELECTED" 
                        Height="40" 
                        Padding="20,0"
                        Style="{StaticResource App.Button.Primary}"
                        Foreground="{StaticResource Text.Primary}"
                        FontSize="14"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="Confirm_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
