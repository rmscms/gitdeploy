<mah:MetroWindow x:Class="GitDeployPro.Windows.TransferMonitorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:ctl="clr-namespace:GitDeployPro.Controls"
                 Title="Transfer report"
                 Width="460"
                 Height="540"
                 MinWidth="380"
                 MinHeight="360"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResize"
                 ShowInTaskbar="True"
                 ShowActivated="False"
                 Topmost="False"
                 Background="{StaticResource Surface.Base}"
                 Foreground="{DynamicResource Text.Primary}"
                 WindowTitleBrush="{DynamicResource Surface.Card}"
                 NonActiveWindowTitleBrush="{DynamicResource Surface.Card}">
    <mah:MetroWindow.Resources>
        <ctl:WorkerStateStringConverter x:Key="WorkerStateConv"/>
        <ctl:WorkerProgressConverter x:Key="WorkerProgressConv"/>
    </mah:MetroWindow.Resources>
    <Grid Margin="16,14,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="SessionTitle"
                   Text="Transfer"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Text.Primary}"/>
        <TextBlock x:Name="HeadlineText"
                   Grid.Row="1"
                   Margin="0,4,0,0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Status.Info}"
                   Text="Waiting…"/>

        <ProgressBar x:Name="OverallBar"
                     Grid.Row="2"
                     Margin="0,10,0,0"
                     Style="{StaticResource App.ProgressBar}"
                     Minimum="0"
                     Maximum="100"
                     Value="0"/>

        <TextBlock x:Name="PercentText"
                   Grid.Row="3"
                   Margin="0,6,0,0"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Accent.Primary}"
                   Text=""/>

        <Border Grid.Row="4"
                Margin="0,12,0,0"
                Padding="10,8"
                CornerRadius="8"
                Background="{DynamicResource Surface.Card}"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Workers (live slots)"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.Primary}"/>
                <ItemsControl x:Name="WorkerList" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ctl:WorkerCard Margin="0,0,0,6"
                                            Title="{Binding IdLabel}"
                                            Description="{Binding FileName}"
                                            StatsText="{Binding Detail}"
                                            IconKind="upload"
                                            ShowControls="False"
                                            State="{Binding State, Converter={StaticResource WorkerStateConv}, Mode=OneWay}"
                                            Progress="{Binding State, Converter={StaticResource WorkerProgressConv}, Mode=OneWay}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="5"
                Margin="0,10,0,0"
                Padding="10,8"
                CornerRadius="8"
                Background="{DynamicResource Surface.Input}"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Live log"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.Primary}"/>
                <ScrollViewer x:Name="LogScroll"
                              Grid.Row="1"
                              Margin="0,6,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText"
                               TextWrapping="Wrap"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="{DynamicResource Text.Secondary}"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock Grid.Row="6"
                   Margin="0,10,0,0"
                   FontSize="11"
                   Foreground="{DynamicResource Text.Muted}"
                   Text="Close does not cancel the transfer"/>
    </Grid>
</mah:MetroWindow>
