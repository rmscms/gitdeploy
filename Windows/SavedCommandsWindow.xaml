<mah:MetroWindow x:Class="GitDeployPro.Windows.SavedCommandsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:controls="clr-namespace:GitDeployPro.Controls"
        Title="Saved commands"
        Width="560"
        Height="156"
        MinWidth="420"
        MinHeight="136"
        MaxHeight="240"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        ShowIconOnTitleBar="False"
        ShowMaxRestoreButton="False"
        ShowMinButton="False"
        TitleCharacterCasing="Normal"
        TitleForeground="{StaticResource Text.Primary}"
        Background="{StaticResource Surface.Card}"
        Foreground="{StaticResource Text.Primary}"
        WindowTitleBrush="{StaticResource Surface.Card}"
        NonActiveWindowTitleBrush="{StaticResource Surface.Shell}"
        BorderBrush="{StaticResource Border.Subtle}"
        BorderThickness="1"
        GlowBrush="{x:Null}"
        WindowStartupLocation="Manual">
    <controls:SavedCommandsPanel x:Name="Panel" />
</mah:MetroWindow>
