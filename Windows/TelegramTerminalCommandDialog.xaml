<mah:MetroWindow x:Class="GitDeployPro.Windows.TelegramTerminalCommandDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Title="Telegram terminal preset"
        MinHeight="420"
        MaxHeight="620"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Surface.Base}"
        Foreground="{StaticResource Text.Primary}"
        WindowTitleBrush="{StaticResource Surface.Card}"
        NonActiveWindowTitleBrush="{StaticResource Surface.Card}">
    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="ProjectHintText"
                   Text="Project scope"
                   Foreground="{StaticResource Text.Muted}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <TextBlock Grid.Row="1" Text="Button label (description)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
        <TextBox x:Name="DescriptionTextBox"
                 Grid.Row="2"
                 Style="{StaticResource App.InputTextBox}"
                 Height="32"
                 Margin="0,0,0,12"
                 KeyDown="Input_KeyDown" />

        <TextBlock Grid.Row="3" Text="Command (single line, trusted)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
        <TextBox x:Name="CommandTextBox"
                 Grid.Row="4"
                 Style="{StaticResource App.InputTextBox}"
                 FontFamily="{StaticResource FontFamily.Mono}"
                 AcceptsReturn="False"
                 TextWrapping="Wrap"
                 MinHeight="64"
                 MaxHeight="120"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,12"
                 KeyDown="Input_KeyDown" />

        <CheckBox x:Name="NotifyBeforeRunCheckBox"
                  Grid.Row="5"
                  Content="Send Telegram notice before running (recommended for restart)"
                  Foreground="{StaticResource Text.Secondary}"
                  FontSize="12"
                  Margin="0,0,0,8"
                  IsChecked="True" />

        <TextBlock Grid.Row="6" Text="Notice text (optional)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
        <TextBox x:Name="NotifyMessageTextBox"
                 Grid.Row="7"
                 Style="{StaticResource App.InputTextBox}"
                 Height="32"
                 Margin="0,0,0,16"
                 KeyDown="Input_KeyDown" />

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="Save"
                    Width="90"
                    Height="32"
                    Margin="0,0,10,0"
                    Style="{StaticResource App.Button.Primary}"
                    IsDefault="True"
                    Click="OkButton_Click" />
            <Button Content="Cancel"
                    Width="90"
                    Height="32"
                    Style="{StaticResource App.Button.Ghost}"
                    IsCancel="True"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
