<Window x:Class="GitDeployPro.Windows.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="Transparent"
        Width="320"
        Height="120"
        Topmost="True"
        Focusable="False">
    <Border CornerRadius="12"
            Background="{StaticResource Surface.Card}"
            BorderBrush="{StaticResource Border.Subtle}"
            BorderThickness="1"
            Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#66000000"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       Text="Backup completed"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Text.Primary}"/>
            <TextBlock x:Name="MessageText"
                       Text="digitalpart-backup finished successfully."
                       Margin="0,8,0,0"
                       Foreground="{StaticResource Text.Secondary}"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>

