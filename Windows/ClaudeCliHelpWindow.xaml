<Window x:Class="GitDeployPro.Windows.ClaudeCliHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Claude Code CLI"
        Width="600"
        Height="470"
        MinWidth="480"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Surface.Base}"
        ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Border Width="42"
                    Height="42"
                    CornerRadius="12"
                    Background="{StaticResource Status.InfoSurface}"
                    Margin="0,0,12,0">
                <ui:SymbolIcon Symbol="Bot24"
                               FontSize="20"
                               Foreground="{StaticResource Status.Info}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Text.Primary}" />
                <TextBlock x:Name="SubtitleText"
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{StaticResource Text.Muted}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="StepsText"
                           FontSize="12"
                           LineHeight="20"
                           Foreground="{StaticResource Text.Secondary}"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Background="{StaticResource Surface.Raised}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,10">
            <TextBlock x:Name="TestResultText"
                       FontSize="11"
                       Foreground="{StaticResource Text.Secondary}"
                       TextWrapping="Wrap"
                       MinHeight="20" />
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="LoginButton"
                    MinWidth="120"
                    Height="36"
                    Margin="0,0,8,0"
                    Style="{StaticResource App.Button.Primary}"
                    Click="LoginButton_Click" />
            <Button x:Name="TestButton"
                    MinWidth="100"
                    Height="36"
                    Margin="0,0,8,0"
                    Style="{StaticResource App.Button.Secondary}"
                    Click="TestButton_Click" />
            <Button x:Name="DocsButton"
                    MinWidth="90"
                    Height="36"
                    Margin="0,0,8,0"
                    Style="{StaticResource App.Button.Ghost}"
                    Click="DocsButton_Click" />
            <Button x:Name="CloseButton"
                    MinWidth="100"
                    Height="36"
                    Style="{StaticResource App.Button.Ghost}"
                    IsDefault="True"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
