<mah:MetroWindow x:Class="GitDeployPro.Windows.BackupTasksWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GitDeployPro.Services.Localization"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:models="clr-namespace:GitDeployPro.Models"
                 xmlns:ctl="clr-namespace:GitDeployPro.Controls"
                 Title="Active Backups"
                 Width="900"
                 Height="560"
                 ResizeMode="CanResizeWithGrip"
                 BorderThickness="0"
                 WindowStartupLocation="CenterOwner"
                 Background="{StaticResource Surface.Base}"
                 Foreground="{DynamicResource Text.Primary}">
    <mah:MetroWindow.Resources>
        <ctl:BackupTaskStateConverter x:Key="BackupStateConv"/>
    </mah:MetroWindow.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Running tasks"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ActiveTasks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,0,0,8" LastChildFill="True">
                            <Button ToolTip="{loc:T ui.tip.StopTask}" DockPanel.Dock="Right"
                                    Content="Stop"
                                    Margin="8,0,0,0"
                                    Padding="12,4"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource App.Button.Danger}"
                                    IsEnabled="{Binding IsCancelable}"
                                    Click="StopTask_Click"/>
                            <ctl:WorkerCard Title="{Binding ScheduleName}"
                                            Description="{Binding Stage}"
                                            StatsText="{Binding ProgressSummary}"
                                            IconKind="database"
                                            ShowControls="False"
                                            State="{Binding State, Converter={StaticResource BackupStateConv}}"
                                            Progress="{Binding Percent}"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2"
                   Text="Recent activity"
                   Margin="0,16,0,8"
                   FontSize="20"
                   FontWeight="SemiBold"/>

        <ListView Grid.Row="3"
                  ItemsSource="{Binding RecentTasks}"
                  Style="{StaticResource App.ListView.Host}"
                  Foreground="{DynamicResource Text.Primary}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="When" Width="130" DisplayMemberBinding="{Binding FinishedLocal, StringFormat={}{0:G}}"/>
                    <GridViewColumn Header="Schedule" Width="180" DisplayMemberBinding="{Binding ScheduleName}"/>
                    <GridViewColumn Header="Mode" Width="90" DisplayMemberBinding="{Binding Mode}"/>
                    <GridViewColumn Header="Result" Width="280">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Message}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Log.Success}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static models:BackupTaskState.Failed}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Error}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static models:BackupTaskState.Cancelled}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</mah:MetroWindow>

